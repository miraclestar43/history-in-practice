 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头第二段密集排列了四个月份节点（六年四月、五月、七月、明年正月）和三个新人名（曾纪泽、锦棠、金顺）。其中金顺只是为了说明“不是同一人”才出现，读者此时还用不上这些信息，开头因此显得拥挤。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "七月，詔宗棠入都備顧問，以錦棠代之"
    }
   ],
   "proposed": "hook.1 保留奏疏要点、改约结果和最终交还伊犁。“七月入都、锦棠接替”及关于金顺的括注移到 story.6/story.8，在锦棠、金顺首次随三路部署出现时再作区分。"
  },
  {
   "id": "V2",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "背景段开头先写一位未具名、且文中自承与伊犁之事关系不明的“帕夏”，读者要先读完这段旁支，才看到与主题直接相关的“俄取伊犁”。",
   "evidence": [
    {
     "id": "QSG4122-E2",
     "quote": "俄以回數擾其邊境，遽引兵逐回，取伊犁"
    }
   ],
   "proposed": "把“俄方因回众扰边出兵、占伊犁、言将代取乌鲁木齐”提到段首，帕夏与英俄插手的背景后置为补充句，内容不删。"
  },
  {
   "id": "V3",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "中文正文其余各处均称“左宗棠”，此处改用“宗棠”，称呼不统一。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "詔宗棠入都備顧問"
    }
   ],
   "proposed": "“朝廷诏宗棠入都备顾问”改为“朝廷诏左宗棠入都备顾问”。"
  },
  {
   "id": "V4",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "末句“条约是签了，崇厚却遭纠劾，议久不决”与前一句“崇厚为朝士所纠，朝廷议论长久不能决定”内容重复，中英文都是如此。",
   "evidence": [],
   "proposed": "末句压缩为“条约是签了，事情却悬在半空。”英文同步改为“The treaty had been signed, yet the whole affair hung in mid-air.”"
  },
  {
   "id": "V5",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "“想「欲藉通商深入腹地」”中，“想”与引文里的“欲”语义重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "改为“俄国政府广设领事，「欲藉通商深入腹地」”，删去“想”。"
  }
 ],
 "overall": "定稿的事实、引文、编年、因果限定与中英对应均有证据支持，可以通过。仅有开头信息密度、背景段顺序和称呼统一几处易读性与文风小问题，建议顺手调整。"
}