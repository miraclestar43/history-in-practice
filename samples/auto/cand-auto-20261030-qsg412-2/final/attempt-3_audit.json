 "issues": [
  {
   "id": "F1",
   "path": "sections.context.2",
   "category": "unsupported",
   "severity": "fix",
   "problem": "断言原文对左宗棠的权衡「只记了这一句话，没有更多」（EN: \"preserves only that single sentence and nothing more\"）。证据中引语以「开头而未闭合，说明证据片段在此截断，原文可能还有下文；现有证据不能支持「没有更多」。",
   "evidence": [
    {
     "id": "QSG4122-E16",
     "quote": "宗棠曰：「不可。師不以正，彼有辭矣"
    }
   ],
   "proposed": "改为「至于他当时怎么权衡，本文所据材料只录了这一句，不作推测。」EN: \"As for how he weighed the decision, the material used here gives only this line, and we do not speculate beyond it.\""
  },
  {
   "id": "F2",
   "path": "sections.today.1",
   "category": "parity",
   "severity": "fix",
   "problem": "中文为「切换的时间和成本算清楚」，时间与成本是两项；英文 \"cost out the timing of a switch\" 把两项并成一项，中英不对等。",
   "evidence": [],
   "proposed": "EN 改为 \"work out the timing and the cost of a switch\"。"
  },
  {
   "id": "F3",
   "path": "sections.limits.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "「成书在传主身后」/\"compiled after his death\" 涉及传主卒年，证据包未载。证据只给出成书年份1928，且正文的年号未换算，读者无从据证据判断成书是否在传主身后。",
   "evidence": [
    {
     "id": "QSG4122-E1",
     "quote": "趙爾巽等《清史稿·左宗棠傳》（1928，维基文库本）"
    }
   ],
   "proposed": "改为「成书于1928年，晚于所述事件」或直接写「成书于1928年」；EN 相应改为 \"compiled in 1928\"。"
  },
  {
   "id": "F4",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与 F3 相同：「成书在传主身后」/\"compiled after his death\" 证据包未载。",
   "evidence": [
    {
     "id": "QSG4122-E1",
     "quote": "趙爾巽等《清史稿·左宗棠傳》（1928，维基文库本）"
    }
   ],
   "proposed": "改为「成书于1928年」；EN 改为 \"compiled in 1928\"。"
  },
  {
   "id": "F5",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "「想「欲藉通商深入腹地」」中「想」与引文里的「欲」语义重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "删去「想」，写作「俄国政府广设领事，「欲藉通商深入腹地」」。"
  },
  {
   "id": "F6",
   "path": "sections.context.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "证据「俄以回數擾其邊境」以叙述口吻直陈原因；正文「以……为由」、EN \"cited\" 把它写成俄方声称的借口，给原文添加了定性。",
   "evidence": [
    {
     "id": "QSG4122-E2",
     "quote": "俄以回數擾其邊境，遽引兵逐回，取伊犁"
    }
   ],
   "proposed": "中文改为「俄方则因回众屡扰其边境，出兵逐回……」；EN 改为 \"Russia, because Muslim raiders repeatedly harassed its border, sent troops...\"。"
  }
 ],
