 "issues": [
  {
   "id": "V1",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "称原文对左宗棠的权衡「只记了这一句话，没有更多」（EN: \"preserves only that single sentence and nothing more\"）。证据中左宗棠的引语以「開头，却没有闭合的」，说明该段话在证据片段处被截断，原文很可能还有下文。现有证据不能支持「没有更多」的断言。",
   "evidence": [
    {
     "id": "QSG4122-E16",
     "quote": "宗棠曰：「不可。師不以正，彼有辭矣"
    }
   ],
   "proposed": "改为「至于他当时怎么权衡，本文所据材料只录了这一句，不作推测。」EN: \"As for how he weighed the decision, the material used here gives only this line, and we do not speculate beyond it.\""
  },
  {
   "id": "V2",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "同一段内两次重复「崇厚为朝士所纠／遭纠劾、议久不决」，中英文都显得冗赘。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "删去末句中的重复部分，改为「条约是签了，事情却悬在半空。」EN 同步删减为 \"The treaty had been signed, yet the whole affair hung in mid-air.\""
  },
  {
   "id": "V3",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "「想「欲藉通商深入腹地」」中，「想」与引文里的「欲」语义重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "删去「想」，改为「俄国政府广设领事，「欲藉通商深入腹地」」。"
  },
  {
   "id": "V4",
   "path": "sections.story.7",
   "category": "style",
   "severity": "note",
   "problem": "「宗棠輿櫬發肅州」是逐字照录的原文，但没有加「」，与 sections.hook.1 中加引号的处理不一致。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "六年四月，宗棠輿櫬發肅州，五月，抵哈密"
    }
   ],
   "proposed": "改为加引号的形式「宗棠「輿櫬發肅州」」，或改写成白话转述。"
  },
  {
   "id": "V5",
   "path": "sections.today.1",
   "category": "parity",
   "severity": "fix",
   "problem": "中文为「切换的时间和成本算清楚」，英文 \"cost out the timing of a switch\" 把「时间」与「成本」并成一项，中英文不对等。",
   "evidence": [],
   "proposed": "EN 改为 \"work out the timing and the cost of a switch\"。"
  }
 ],
 "overall": "定稿整体有证据支撑，引文逐字无误，推断均已标注为解释；需修正 context.2 中「原文没有更多」这一超出证据的断言，并补齐 today.1 的中英对等，其余只是文风小节。"
}