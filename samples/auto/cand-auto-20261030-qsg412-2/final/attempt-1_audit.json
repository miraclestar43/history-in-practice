 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "英文写 \"argued it out for months\"，证据只说「議久不決」，没有给出“数月”这一时间跨度；中文「久争不决」则无此问题，两种语言也因此不一致。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "議久不決"
    }
   ],
   "proposed": "英文改为 \"the court debated it at length without reaching a decision\""
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "「纷纷纠弹」/\"one after another\" 在原文之外添加了接连、众多的情状。原文只作「為朝士所糾」。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "為朝士所糾"
    }
   ],
   "proposed": "中文改为「为朝士所纠」；英文改为 \"it was denounced by court officials\""
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "本段标为 record。「难处不在于要不要伊犁……还得有让对方重新坐下来的筹码」是作者对利害的分析，证据中没有，却被当作记录叙述。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "為朝士所糾，議久不決"
    }
   ],
   "proposed": "在该句前加「一种解释是」/\"One reading is that\"，或删去这一句"
  },
  {
   "id": "F4",
   "path": "sections.context.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文 \"kept envoys in touch with Britain and Russia\" 丢掉了「结援」中求援、结盟的含义，与中文和原文不一致。",
   "evidence": [
    {
     "id": "QSG4122-E1",
     "quote": "通使結援英、俄"
    }
   ],
   "proposed": "英文改为 \"sent envoys to seek support from Britain and Russia\""
  },
  {
   "id": "F5",
   "path": "sections.context.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "伊犁之变时分兵屯肃州（E3）与俄土交战时金顺请袭伊犁（E16）分属传中不同时间点。正文用「俄方正与土耳其交战」/\"was then at war\" 紧接前文，读来像是同一时间。",
   "evidence": [
    {
     "id": "QSG4122-E3",
     "quote": "而是時有伊犁之變"
    },
    {
     "id": "QSG4122-E16",
     "quote": "時俄方與土耳其戰"
    }
   ],
   "proposed": "中文改为「后来俄方与土耳其交战时，金顺请……」；英文改为 \"Later, when Russia was at war with Turkey, ...\""
  },
  {
   "id": "F6",
   "path": "sections.context.3",
   "category": "causality",
   "severity": "fix",
   "problem": "「朝廷于是遣……崇厚使俄」/\"accordingly\" 把左宗棠的请求写成遣使的原因。证据只分别记载了这两件事，没有说明二者有因果。",
   "evidence": [
    {
     "id": "QSG4122-E4",
     "quote": "並請與俄議還伊犁、交叛人二事"
    },
    {
     "id": "QSG4122-E5",
     "quote": "詔遣全權大臣崇厚使俄"
    }
   ],
   "proposed": "删去「于是」/\"accordingly\"，改为「其后朝廷诏遣全权大臣崇厚使俄」/\"The court then sent...\""
  },
  {
   "id": "F7",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "「签它的人却被自己人否定了合法性」/\"had his authority questioned\" 超出了证据：原文只说条约被朝士纠弹，没有说签约人的合法性被否定。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "改为「条约是签了，却为朝士所纠，议久不决」；英文改为 \"the treaty had been signed, yet court officials denounced it and the debate stalled\""
  },
  {
   "id": "F8",
   "path": "sections.story.2",
   "category": "facts",
   "severity": "fix",
   "problem": "「议定把……给俄国」/\"had further agreed to hand\"：原文是「議畀」，即议欲给予，不能写成已成定案。",
   "evidence": [
    {
     "id": "QSG4122-E7",
     "quote": "今崇厚又議畀俄陬爾果斯河及帖克斯河"
    }
   ],
   "proposed": "中文改为「崇厚又议将……给俄国」；英文改为 \"had further proposed to hand Russia\""
  },
  {
   "id": "F9",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "「被看穿的是怕打仗」/\"what they had spotted was our fear of war\" 等于承认俄方判断正确。原文作「妄忖」，即俄方妄自揣度，奏疏的意思恰好相反。",
   "evidence": [
    {
     "id": "QSG4122-E9",
     "quote": "妄忖吾國或厭用兵"
    }
   ],
   "proposed": "中文改为「既然对方妄忖我方厌战」；英文改为 \"If the Russians had wrongly presumed we were weary of war\""
  },
  {
   "id": "F10",
   "path": "sections.story.6",
   "category": "chronology",
   "severity": "fix",
   "problem": "「同时左宗棠自请出屯哈密」/\"At the same time\" 与原文不符。原文作「於是」，表示此事在崇厚得罪、曾纪泽使俄之后，而不是与之同时。",
   "evidence": [
    {
     "id": "QSG4122-E12",
     "quote": "於是宗棠乃自請出屯哈密"
    }
   ],
   "proposed": "中文改为「于是左宗棠自请出屯哈密」；英文改为 \"Thereupon Zuo volunteered...\""
  },
  {
   "id": "F11",
   "path": "sections.story.6",
   "category": "unsupported",
   "severity": "fix",
   "problem": "「这是部署总数，不是实际开战的兵力」是证据之外的断言。原文只记合计人数，没有说明实际投入了多少兵力、是否开战。",
   "evidence": [
    {
     "id": "QSG4122-E12",
     "quote": "合馬步卒四萬餘人"
    }
   ],
   "proposed": "改为「原文只记这一合计数，未记实际投入兵力」；英文相应改为 \"The source gives only this combined figure.\""
  },
  {
   "id": "F12",
   "path": "sections.story.7",
   "category": "parity",
   "severity": "fix",
   "problem": "中文漏掉了兵船出海「用震撼京師」的目的，英文则有 \"to shake the capital\"，两种语言不一致。",
   "evidence": [
    {
     "id": "QSG4122-E14",
     "quote": "別以兵船翔海上，用震撼京師"
    }
   ],
   "proposed": "中文改为「另派兵船在海上出没，用以震撼京师」"
  },
  {
   "id": "F13",
   "path": "sections.story.7",
   "category": "style",
   "severity": "note",
   "problem": "「宗棠輿櫬發肅州」整句照抄原文的繁体文字，却没有加引号，读者分不清是叙述还是引文。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "宗棠輿櫬發肅州"
    }
   ],
   "proposed": "加「」作为引文，或改写为简体叙述"
  },
  {
   "id": "F14",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "「史书只记了和议成、交还伊犁」/\"records only\" 不准确。史书在和议成之前还写了「俄亦懾我兵威，恐事遂決裂」，即对俄方动机有所叙述，正文的说法遗漏了这一点。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "而俄亦懾我兵威，恐事遂決裂"
    }
   ],
   "proposed": "补一句：史书另称「俄亦懾我兵威」，但与和议成只是并置叙述"
  },
  {
   "id": "F15",
   "path": "sections.limits.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "「先之以议论」「师不以正」用了简体字，与证据原文不是逐字一致。",
   "evidence": [
    {
     "id": "QSG4122-E10",
     "quote": "先之以議論"
    },
    {
     "id": "QSG4122-E16",
     "quote": "師不以正"
    }
   ],
   "proposed": "改为「先之以議論」「師不以正」"
  },
  {
   "id": "F16",
   "path": "sections.limits.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文全文的引号内都是作者的英译，却没有任何地方告诉读者这些是译述，容易被当作原文引语。",
   "evidence": [],
   "proposed": "英文加一句：\"Quoted passages in English are the author's translations of the classical Chinese.\""
  },
  {
   "id": "F17",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "「想「欲藉通商……」」中“想”与“欲”语义重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "删去「想」"
  },
  {
   "id": "F18",
   "path": "sections.story.4",
   "category": "facts",
   "severity": "fix",
   "problem": "转述写成「俄方认定我方或厌用兵」，丢掉了原文「妄忖」中“妄”这一层，即这是俄方没有根据的揣度。",
   "evidence": [
    {
     "id": "QSG4122-E9",
     "quote": "妄忖吾國或厭用兵"
    }
   ],
   "proposed": "改为「俄方妄自揣度我方或厌用兵」；英文 \"They had read us as\" 改为 \"They had wrongly presumed us\""
  }
 ],
