 "issues": [
  {
   "id": "F1",
   "path": "title",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文标题用「」引作「不可许」（简体）。全文其他引语均按证据繁体逐字引用，这里与证据原文字形不一致，不算逐字引语。",
   "evidence": [
    {
     "id": "QSG4122-E7",
     "quote": "此界務之不可許者也"
    }
   ],
   "proposed": "改为「不可許」要写成条目……；英文标题不变。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "「為朝士所糾」承接主语崇厚，被纠劾的是崇厚。稿件写成条约本身「为朝士所纠」，英文也作\"It was denounced by court officials\"，把纠劾对象从人换成了约。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "中文改为「……崇厚为朝士所纠，议了很久，议不出结果」；英文改为\"Chong Hou was censured by court officials, and the debate dragged on toward no conclusion.\""
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "「送回朝廷」/\"sent home to the capital\"在证据中没有记载。证据只记崇厚使俄、遽定约、被纠、议久不决。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "詔遣全權大臣崇厚使俄"
    }
   ],
   "proposed": "删去「送回朝廷」/\"had been sent home to the capital\"，改为「一份由全权大臣使俄谈成的条约」/\"A treaty concluded by a plenipotentiary envoy sent to Russia\"。"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "causality",
   "severity": "fix",
   "problem": "本段把奏上、嘉许、出屯哈密、和议成、交还伊犁一路串下来，中间略去了七月宗棠被诏入都、由锦棠代之。读者容易误以为左宗棠抵哈密直接带来和议。证据只记先后，没有记因果。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "七月，詔宗棠入都備顧問，以錦棠代之"
    }
   ],
   "proposed": "在「明年正月」前补「七月，他奉诏入都备顾问，由锦棠接替。」英文同步补\"In the seventh month he was summoned to the capital and Jintang took his place.\""
  },
  {
   "id": "F5",
   "path": "sections.context.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "原文是「是時有伊犁之變」，即当时有伊犁之变，并未说分兵屯肃州在伊犁之变之后。「伊犁之变后」/\"After the Ili crisis\"改变了时间关系。",
   "evidence": [
    {
     "id": "QSG4122-E3",
     "quote": "而是時有伊犁之變，詔宗棠分兵屯肅州"
    }
   ],
   "proposed": "中文改为「其时有伊犁之变，朝廷诏……」；英文改为\"At the time of the Ili crisis, the court ordered…\""
  },
  {
   "id": "F6",
   "path": "sections.context.3",
   "category": "facts",
   "severity": "fix",
   "problem": "末句「朝廷诏遣全权大臣崇厚使俄」/\"The court sent Chong Hou…\"出自E5，但本段证据只列E4，该句缺少对应证据。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "詔遣全權大臣崇厚使俄"
    }
   ],
   "proposed": "在本段证据中补列QSG4122-E5，或把该句移入sections.story.0。"
  },
  {
   "id": "F7",
   "path": "sections.story.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "被纠劾者应为崇厚。中文「约成之后为朝士所纠」「条约是签了，却为朝士所纠」与英文\"the court officials impeached it\"\"court officials denounced it\"都写成纠劾条约；\"impeached\"用于条约也不通。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾"
    }
   ],
   "proposed": "中文改为「约成之后，崇厚为朝士所纠……」，后句改为「条约是签了，崇厚却遭纠劾，议久不决」；英文改为\"Chong Hou was then censured by court officials, and the debate went on without decision.\"，后句同步改。"
  },
  {
   "id": "F8",
   "path": "sections.story.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "「名义上的收复，实利还在对方手里」/\"The recovery would be nominal, and the real profit would stay on the other side\"是作者的引申，原文只说还伊犁于俄无损、我得只是荒郊。在record段落里以事实口吻写出，未标为解释。",
   "evidence": [
    {
     "id": "QSG4122-E6",
     "quote": "是俄還伊犁，於俄無損，我得伊犁，僅一荒郊"
    }
   ],
   "proposed": "改为「作者的一种解释是：名义上的收复，实利仍在对方」/\"One reading is that the recovery would be nominal…\""
  },
  {
   "id": "F9",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "「想「欲藉通商深入腹地」」中「想」与引文里的「欲」语义重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "删去「想」，作「俄国政府广设领事，「欲藉通商深入腹地」」。"
  },
  {
   "id": "F10",
   "path": "sections.story.5",
   "category": "causality",
   "severity": "fix",
   "problem": "「既然对方妄忖我方厌战，对策就要……」/\"If the Russians had wrongly presumed…, the answer had to…\"把E9与E10写成因果推导。原文没有这样连接，属于作者推断却未标注。",
   "evidence": [
    {
     "id": "QSG4122-E10",
     "quote": "為今之計，當先之以議論"
    }
   ],
   "proposed": "改为「奏中提出的对策是：……」；如保留因果连接，标为「作者认为」/\"The author reads this as a response to…\""
  },
  {
   "id": "F11",
   "path": "sections.analysis.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "「朝廷随后命曾纪泽更前约，崇厚得罪去」把顺序写反了。原文是崇厚得罪去在前，命曾纪泽使俄在后。英文同样颠倒。",
   "evidence": [
    {
     "id": "QSG4122-E11",
     "quote": "崇厚得罪去，命曾紀澤使俄，更前約"
    }
   ],
   "proposed": "改为「随后崇厚得罪去，朝廷命曾纪泽使俄更前约」；英文改为\"That Chong Hou was then punished and dismissed, and Zeng Jize sent to revise the earlier treaty, is on the record.\""
  }
 ],
