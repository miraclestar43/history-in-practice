 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "原文「為朝士所糾」的主语是崇厚（定约者被纠劾），稿件写成条约本身「为朝士所纠」/\"It was denounced by court officials\"，把被纠的对象从人换成了约。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "中文改为「……送回朝廷，崇厚为朝士所纠，议了很久，议不出结果」；英文改为\"Chong Hou was censured by court officials, and the debate dragged on toward no conclusion.\""
  },
  {
   "id": "V2",
   "path": "sections.context.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "末句「朝廷诏遣全权大臣崇厚使俄」出自E5，但本段证据只列了E4，该句缺少对应证据。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "詔遣全權大臣崇厚使俄"
    }
   ],
   "proposed": "在本段证据中补列QSG4122-E5；或把该句移到sections.story.0。"
  },
  {
   "id": "V3",
   "path": "sections.story.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "「為朝士所糾」的对象是崇厚。中文「约成之后为朝士所纠」「条约是签了，却为朝士所纠」与英文\"the court officials impeached it\"\"court officials denounced it\"都把被纠劾者写成了条约；\"impeached\"用于条约也不通。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "中文改为「约成之后，崇厚为朝士所纠……」；英文改为\"Chong Hou was then censured by court officials, and the debate went on without decision.\""
  },
  {
   "id": "V4",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "「为朝士所纠，议久不决」在同一段内重复出现两次，英文也同样重复。",
   "evidence": [],
   "proposed": "删去末句中重复的部分，只保留「条约是签了，事情悬在半空」及对应英文。"
  },
  {
   "id": "V5",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "「想「欲藉通商深入腹地」」中「想」与「欲」语义重复。引文本身是逐字的。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "改为「俄国政府广设领事，「欲藉通商深入腹地」」。"
  }
 ],
 "overall": "定稿整体有据，引文逐字可核，推断均已标为解释，中英文一致；需修正两处把「為朝士所糾」的对象由崇厚误作条约的写法，并为context.3补列E5证据，另有两处文风小问题。"
}