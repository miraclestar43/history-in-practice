 "issues": [
  {
   "id": "F1",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都称材料“未写明他与伊犁之事的直接关系”，并说这一句“只交代英、俄各自插手的背景”。补入的 E19 明确记载：帕夏攻败妥明后，“遂並有北路伊犁諸城，收其賦入”；随后俄国才“逐回，取伊犁”。现写法与证据相反。改写时须注意：证据中俄国出兵的理由是“以回數擾其邊境”，不能写成帕夏占伊犁直接导致俄国出兵。",
   "evidence": [
    {
     "id": "QSG4122-E19",
     "quote": "帕夏既攻敗妥明降之，遂並有北路伊犁諸城，收其賦入"
    },
    {
     "id": "QSG4122-E19",
     "quote": "俄以回數擾其邊境，遽引兵逐回，取伊犁"
    }
   ],
   "proposed": "删去“本文所据材料未录其名，也未写明他与伊犁之事的直接关系；这一句只交代英、俄各自插手的背景”。改为：帕夏攻败据乌鲁木齐的妥明后，并有北路伊犁诸城，收其赋入；他通使结援英、俄……其后俄方以回众屡扰其边境为由，出兵逐回，占了伊犁。英文同步修改。"
  },
  {
   "id": "F2",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "fix",
   "problem": "帕夏第一次出现时只写“能役使回众的首领”，没有交代他的出身，也没有说明他占据了哪些地方。读者看不出他与伊犁有什么关系，也就不明白俄国为何出兵、伊犁原本在谁手里。这正是本节标题“伊犁在谁手里”要回答的问题。",
   "evidence": [
    {
     "id": "QSG4122-E19",
     "quote": "塞外回酋曰帕夏，本安集延部之和碩伯克也"
    },
    {
     "id": "QSG4122-E19",
     "quote": "據喀什噶爾，稍蠶食南八城"
    }
   ],
   "proposed": "首次出现时补一句身份：帕夏本是安集延部的和硕伯克，据喀什噶尔、蚕食南八城，又并有北路伊犁诸城。妥明等枝节可略，保留与伊犁有关的部分即可。"
  },
  {
   "id": "F3",
   "path": "sections.context.3",
   "category": "readability",
   "severity": "fix",
   "problem": "“交叛人”在文中没有交代是谁，读者无从理解这项议题。英文 defectors（投诚者、变节者）与“叛人”含义不符。另外，按 E20，提出议还伊犁时新疆南北其余各城已经收复，本段没有交代这一背景，读者看不出为何此时只剩伊犁这一处问题。",
   "evidence": [
    {
     "id": "QSG4122-E4",
     "quote": "並請與俄議還伊犁、交叛人二事"
    },
    {
     "id": "QSG4122-E20",
     "quote": "伯克胡里既納白彥虎，乃效力攻漢城。大軍至，复遁走俄。西四城相繼下"
    }
   ],
   "proposed": "中文补：叛人指收纳了白彦虎、兵败后遁入俄境的伯克胡里等人；其时南疆东、西四城已相继收复。英文把 defectors 改为 the rebels who had fled into Russia，并同步补入上述背景。"
  },
  {
   "id": "F4",
   "path": "sections.analysis.2",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文用引号标出原文「俄亦懾我兵威，恐事遂決裂」。英文却写成不带引号的转述，并沿用了史书的第一人称 our，读者会误以为这是作者本人的说法和立场。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "而俄亦懾我兵威，恐事遂決裂"
    }
   ],
   "proposed": "英文改为：it says, in a phrase translated here, that \"Russia, too, was awed by our military might and feared an outright rupture\"。也可改用第三人称转述，写作 awed by the Qing forces。"
  },
  {
   "id": "F5",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都称“交还伊犁之外还议了什么，原文未载”。但证据记载了另外几项议题：左宗棠请议的交叛人，以及俄方所提的通商、分界、偿款三端。说“崇厚约的完整条款未载”成立，说“除伊犁外议了什么未载”不成立。",
   "evidence": [
    {
     "id": "QSG4122-E4",
     "quote": "並請與俄議還伊犁、交叛人二事"
    },
    {
     "id": "QSG4122-E5",
     "quote": "俄以通商、分界、償款三端相要"
    }
   ],
   "proposed": "改为：原文记有议题，即左宗棠所请的还伊犁、交叛人，以及俄方以通商、分界、偿款三端相要；崇厚所定约的完整条款与曾纪泽改约的具体内容原文未载，本文不补写。英文同步修改。"
  },
  {
   "id": "F6",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "中文这里写“诏宗棠入都”，其他各处都称“左宗棠”或“他”。同一人的称呼不统一。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "詔宗棠入都備顧問"
    }
   ],
   "proposed": "改为“诏左宗棠入都备顾问”。"
  },
  {
   "id": "F7",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "“想「欲藉通商深入腹地」”中，“想”与引文里的“欲”意思重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "删去“想”，写作“俄国政府广设领事，「欲藉通商深入腹地」”。"
  },
  {
   "id": "F8",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "英文 Suzhou 指肃州，但英文读者通常会以为是江苏的苏州。context.1 和 story.7 也有同样问题。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "宗棠輿櫬發肅州"
    }
   ],
   "proposed": "首次出现时写作 Suzhou (Jiuquan, in Gansu)，或加注 Suzhou in Gansu，此后沿用 Suzhou。"
  }
 ],
