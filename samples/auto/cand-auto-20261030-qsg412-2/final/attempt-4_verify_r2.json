 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "锦棠在原文中只出现名、不出现姓，稿中直接写“锦棠”。英文中“Jintang”与东路统兵的“Jin Shun”（金顺）读起来像同姓，story.6 两人并列时更难分清；中文读者也看不出“锦棠”只是名。",
   "evidence": [
    {
     "id": "QSG4122-E12",
     "quote": "以金順出精河為東路，張曜沿特克斯河為中路，錦棠經布魯特游牧為西路"
    },
    {
     "id": "QSG4122-E15",
     "quote": "以錦棠代之"
    }
   ],
   "proposed": "首次出现时（hook.1）写作 zh“锦棠（原文只称其名）”、en“Jintang (the source gives only his given name; not to be confused with Jin Shun)”，之后在 story.6、story.8 统一沿用此称呼。不补外部姓氏。"
  },
  {
   "id": "V2",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "英文“Suzhou”（肃州）首次出现时没有说明，英文读者容易误认为江苏的苏州。",
   "evidence": [
    {
     "id": "QSG4122-E3",
     "quote": "詔宗棠分兵屯肅州"
    }
   ],
   "proposed": "en 首次出现处改为“the garrison town of Suzhou (肃州)”，hook.1、story.7 沿用 Suzhou。"
  },
  {
   "id": "V3",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "中文其余各处都称“左宗棠”，此处改用“宗棠”，同一人的称呼不一致。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "七月，詔宗棠入都備顧問"
    }
   ],
   "proposed": "改为“朝廷诏左宗棠入都备顾问”。"
  },
  {
   "id": "V4",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "context 开头先写一位稿件自己也说与伊犁之事关系不明的“帕夏”。读者在理解局面时用不上这条信息，反而推迟了“俄占伊犁”这一关键背景。",
   "evidence": [
    {
     "id": "QSG4122-E1",
     "quote": "英人陰助之，欲令別立為國，用捍蔽俄"
    },
    {
     "id": "QSG4122-E2",
     "quote": "遽引兵逐回，取伊犁"
    }
   ],
   "proposed": "把“俄方出兵逐回、占伊犁、言将代取乌鲁木齐”移到段首，帕夏一句压缩后放在段末作为补充背景，保留“材料未写明其与伊犁之事的关系”这一限定。"
  },
  {
   "id": "V5",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头连续堆了四月、五月、七月、明年正月四个时间点，“六年”还没有说明是哪个年号。读者在这时用不上这些时间，开头显得拥挤。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "六年四月，宗棠輿櫬發肅州，五月，抵哈密"
    },
    {
     "id": "QSG4122-E15",
     "quote": "明年正月，和議成，交還伊犁"
    }
   ],
   "proposed": "hook.1 只保留“自请出屯哈密……最终和议成、交还伊犁”的主线，把具体月份留到 story.7、story.8 交代。"
  },
  {
   "id": "V6",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "“想「欲藉通商深入腹地」”中“想”与“欲”语义重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "删去“想”，改为“俄国政府广设领事，「欲藉通商深入腹地」”。"
  }
 ],
 "overall": "定稿逐字段核对通过：事实、引文、解释标注与中英一致性均有证据支撑。需修一处易读性问题，即锦棠在英文中易与金顺混淆的称呼；其余为说明性小改。"
}