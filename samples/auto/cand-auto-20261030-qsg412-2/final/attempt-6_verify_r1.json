 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头第二段连续堆叠六年四月、五月、七月、明年正月等年月。段中还在读者尚未认识「锦棠」「金顺」时插入括注，说明两人不是同一人，读者暂时用不上这些信息。开头讲清问题本身不受影响，但人物与年份过密。交接细节在 story.6 和 story.8 中已完整交代。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "七月，詔宗棠入都備顧問，以錦棠代之"
    }
   ],
   "proposed": "hook.1 可删去「七月……接替」一句及其括注，改为「此后他奉诏入都，明年正月和议成，交还伊犁」。锦棠与金顺的区分留到 story.6 首次列出三路时再说明。英文同步修改。"
  },
  {
   "id": "V2",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "「拨款五百万」「借外国债五百万」没有交代单位，原文也未记单位。读者容易把它和 story.1 的「卢布五百万元」混为一类。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "為撥款五百萬，敕自借外國債五百萬"
    }
   ],
   "proposed": "在数字后加注「（原文未记单位）」，英文同步写作 \"five million (the source gives no unit)\"。不要补写具体币种。"
  }
 ],
 "overall": "逐字段核对后，事实、引文、归属、因果与中英对照均有证据支持，未发现需阻断或必须修改的问题；开头能让读者说清困境，只有两处易读性小问题可酌情调整。"
