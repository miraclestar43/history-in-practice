 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "chronology",
   "severity": "fix",
   "problem": "英文版写成奏疏本身\"volunteered to take command at Hami\"。中文版把上奏与自请出屯哈密并列，同样容易被读成同一时刻。按原文，自请出屯哈密发生在朝廷嘉许奏疏、崇厚得罪、命曾纪泽使俄之后（「於是」），并不在奏疏之内。",
   "evidence": [
    {
     "id": "QSG4122-E11",
     "quote": "上壯其言，嘉許之。崇厚得罪去，命曾紀澤使俄，更前約"
    },
    {
     "id": "QSG4122-E12",
     "quote": "於是宗棠乃自請出屯哈密，規复伊犁"
    }
   ],
   "proposed": "中文改为「……给出议论与战阵两步的方案；奏上获嘉许后，又自请出屯哈密」。英文改为\"...set out a two-stage plan of negotiation followed by battle; after the memorial was commended, he volunteered to take command at Hami.\""
  },
  {
   "id": "V2",
   "path": "sections.hook.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "「僵局之中，左宗棠上奏……并自请出屯哈密」把自请出屯哈密并入上奏这一动作。原文中，这一请求在朝廷嘉许、命曾纪泽更约之后才提出。",
   "evidence": [
    {
     "id": "QSG4122-E11",
     "quote": "上壯其言，嘉許之。崇厚得罪去，命曾紀澤使俄，更前約"
    },
    {
     "id": "QSG4122-E12",
     "quote": "於是宗棠乃自請出屯哈密"
    }
   ],
   "proposed": "中文改为「……主张『先之以議論……堅忍而求勝』。奏上获嘉许，他随即自请出屯哈密。」英文同步改为\"...The throne commended it, and he then asked leave to move his headquarters to Hami.\""
  },
  {
   "id": "V3",
   "path": "sections.analysis.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "此段把「再用自请出屯哈密」写成这道奏疏结构的一部分，并作为奏疏获得分量的原因之一。原文中，自请出屯是在奏疏获嘉许、崇厚得罪之后才发生的，不能用来解释奏疏的说服力。",
   "evidence": [
    {
     "id": "QSG4122-E11",
     "quote": "上壯其言，嘉許之。崇厚得罪去"
    },
    {
     "id": "QSG4122-E12",
     "quote": "於是宗棠乃自請出屯哈密"
    }
   ],
   "proposed": "中文改为「……把方案写成顺序——先议论、后战阵。奏疏获嘉许之后，他又自请出屯哈密，把第二步落到具体的人和地上。」英文同步改为\"...After the memorial was commended, he volunteered to hold Hami, making the second step concrete.\""
  },
  {
   "id": "V4",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "「为朝士所纠……议久不决」在同一段里连说两遍，英文也重复了一遍（\"impeached it ... denounced it and the debate stalled\"），读来冗余。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "中文删去第二处，改为「约成之后为朝士所纠，议久不决，事情悬在半空。」英文相应合并为一句。"
  }
 ],
 "overall": "引文和数字都与证据一致，解释也均已标明；需要改的是三处把「自请出屯哈密」并入奏疏的时序错位，另有一处冗余文风问题，修改后可发。"
}