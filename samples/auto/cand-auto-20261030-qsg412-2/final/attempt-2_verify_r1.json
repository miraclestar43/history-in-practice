 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "中文称「堅忍而求勝」为「四个字」，但这句引文实为五个字（堅、忍、而、求、勝），计数错误。英文作 \"those words\"，不受影响。",
   "evidence": [
    {
     "id": "QSG4122-E10",
     "quote": "次決之以戰陣，堅忍而求勝"
    }
   ],
   "proposed": "将「「堅忍而求勝」四个字背后」改为「「堅忍而求勝」这五个字背后」，或改为「「堅忍而求勝」一句背后」。"
  },
  {
   "id": "V2",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "「崇厚为朝士所纠，议久不决」在同一段内重复叙述了两次，末句与前句几乎同义，读来冗余。中英两版都有此问题。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約，為朝士所糾，議久不決"
    }
   ],
   "proposed": "末句可压缩为「条约已签，事情却悬在半空。」英文相应改为 \"The treaty was signed, yet the whole affair hung in mid-air.\""
  }
 ],
 "overall": "定稿史实、引文、署名与推断标注基本可靠，中英对应完整；仅 analysis.1 有一处字数计数错误需修正，另有一处纯文风冗余可酌改。"
