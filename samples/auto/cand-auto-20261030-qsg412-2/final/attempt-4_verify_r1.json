 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头第一句就让左宗棠出场，但没有交代他的身份，也没有说明他与伊犁、新疆的关系。同一段也没说伊犁在新疆。不了解背景的读者说不清为什么由他来请议还伊犁。",
   "evidence": [
    {
     "id": "QSG4122-E4",
     "quote": "條上新疆建行省事宜，並請與俄議還伊犁"
    },
    {
     "id": "QSG4122-E6",
     "quote": "自俄踞伊犁，蠶食不已，新疆乃有日蹙百里之勢"
    },
    {
     "id": "QSG4122-E12",
     "quote": "宗棠乃自請出屯哈密，規复伊犁"
    }
   ],
   "proposed": "中文改为：「俄国此前出兵占了新疆的伊犁；统兵经营新疆的左宗棠请与俄议还伊犁……」。英文同步改为：\"Russia had earlier sent troops in and seized Ili, in Xinjiang. Zuo Zongtang, the commander in charge of Xinjiang affairs, asked…\"。不要补写史源未载的官衔。"
  },
  {
   "id": "V2",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "fix",
   "problem": "「帕夏」第一次出现时没有说明他是谁、与伊犁之事有何关系，读者在开头就多了一个来历不明的人物。",
   "evidence": [
    {
     "id": "QSG4122-E1",
     "quote": "帕夏能屬役回眾，通使結援英、俄，購兵械自備"
    }
   ],
   "proposed": "中文改为：「传中所称的「帕夏」，是当地一位能役使回众的首领（原文未载其名），他通使结援英、俄……」。英文同步改为：\"the figure the biography calls the Pasha, a local leader who could command the Muslim population (the source gives no name)…\"。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头连排了六年四月、五月、七月、明年正月四个时间点，年号又没有点明，读者还用不上这些信息。「锦棠」只出现名、不带姓，像是另一位新人物。英文Suzhou容易与苏州混淆。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "六年四月，宗棠輿櫬發肅州，五月，抵哈密"
    },
    {
     "id": "QSG4122-E15",
     "quote": "以錦棠代之"
    }
   ],
   "proposed": "hook只保留「出屯哈密、后奉召入都、次年和议成、交还伊犁」的骨架，具体月份留在story.7和story.8。「锦棠」首次出现时注明「原文只称其名」。英文首次出现时写作 Suzhou (Suzhou in Gansu, not the eastern city)。"
  },
  {
   "id": "V4",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "中文这里写「宗棠」，全文其他地方都写「左宗棠」，称呼不统一。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "詔宗棠入都備顧問"
    }
   ],
   "proposed": "改为「朝廷诏左宗棠入都备顾问」。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "「五百万」没有单位，读者不知道比较的是什么。原文的单位也未明（诏中称「千萬金」）。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "國家何惜千萬金。為撥款五百萬，敕自借外國債五百萬"
    }
   ],
   "proposed": "补一句「原文未注单位，诏中合称「千萬金」」，中英文同步。"
  },
  {
   "id": "V6",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "「想「欲藉通商深入腹地」」中，「想」与引文里的「欲」意思重复。",
   "evidence": [
    {
     "id": "QSG4122-E8",
     "quote": "欲藉通商深入腹地"
    }
   ],
   "proposed": "改为「俄国政府广设领事，奏中称其「欲藉通商深入腹地」」。"
  },
  {
   "id": "V7",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "「崇厚为朝士所纠、议久不决」在同一段里重复说了两遍。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "為朝士所糾，議久不決"
    }
   ],
   "proposed": "删去末句的重复部分，只保留「条约已签，事情悬在半空」。英文同步删减。"
  }
 ],
 "overall": "事实、引文、编年、因果与中英对应均有证据支持，可以放行。但开头需要交代左宗棠的身份和伊犁所在，并说明「帕夏」是谁（两处readability/fix），其余为易读性与文风小改。"
}