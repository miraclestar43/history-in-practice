 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "锦棠首次出现时没有说明称呼方式。英文中的 Jintang 与东路统兵的 Jin Shun（金顺）读起来像同姓之人，story.6 两人并列时更难分清。原文只写「錦棠」二字，证据并未说明这是名还是其他称呼，所以不宜断言“原文只给名”。",
   "evidence": [
    {
     "id": "QSG4122-E12",
     "quote": "錦棠經布魯特游牧為西路"
    },
    {
     "id": "QSG4122-E15",
     "quote": "以錦棠代之"
    },
    {
     "id": "QSG4122-E12",
     "quote": "以金順出精河為東路"
    }
   ],
   "proposed": "hook.1 首次出现时，zh 写“锦棠（原文仅作此称）”，en 写“Jintang (as the source calls him; a different man from Jin Shun)”。story.6、story.8 统一沿用 Jintang，不补外部姓氏。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头用诏书语「以西事自任」介绍左宗棠，一般读者不易懂。英文 taken the western affairs upon himself 也较晦涩。hook.1 又重复了一次。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "宗棠以西事自任"
    }
   ],
   "proposed": "hook.0 保留“统兵经营新疆”作为身份说明，「以西事自任」改为注明出处的引语或删去重复；hook.1 不再重复此语。"
  },
  {
   "id": "F3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头连续堆叠“六年四月、五月、七月、明年正月”等年月，读者在此处还用不上这些时间点。",
   "evidence": [],
   "proposed": "hook.1 只保留“自请出屯哈密—奉诏入都—明年和议成、交还伊犁”的顺序，具体月份留到 story.7、story.8。"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "英文 Suzhou（肃州）容易被读者误认为另一个更著名的同音地名 Suzhou。hook.1 与 story.7 都有此问题。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "宗棠輿櫬發肅州"
    }
   ],
   "proposed": "英文首次出现时写作“Suzhou (肅州)”，以原文汉字区分，不补外部地理信息。"
  },
  {
   "id": "F5",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "context 第一段先讲未具名、与伊犁关系不明的「帕夏」，读者暂时用不上。这会冲淡“俄国占伊犁”这一关键背景。",
   "evidence": [
    {
     "id": "QSG4122-E2",
     "quote": "遽引兵逐回，取伊犁"
    }
   ],
   "proposed": "把俄取伊犁一句移到段首；帕夏部分压缩为一句背景，保留“材料未写明其与伊犁之事的关系”的限定。"
  },
  {
   "id": "F6",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "中文此处突然改称「宗棠」，全文其他地方用“左宗棠”，称呼不统一。",
   "evidence": [
    {
     "id": "QSG4122-E15",
     "quote": "詔宗棠入都備顧問"
    }
   ],
   "proposed": "改为“朝廷诏左宗棠入都备顾问”。"
  },
  {
   "id": "F7",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "“五百万”没有单位，读者不知道比较的是什么。原文本身也未写单位。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "為撥款五百萬，敕自借外國債五百萬"
    }
   ],
   "proposed": "在数字后加“（原文未写单位）”/“(the source gives no unit)”。"
  },
  {
   "id": "F8",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "“崇厚为朝士所纠、议久不决”在同一段内说了两遍。",
   "evidence": [],
   "proposed": "删去末句的重复部分，只保留“事情悬在半空”。"
  },
  {
   "id": "F9",
   "path": "sections.story.3",
   "category": "style",
   "severity": "note",
   "problem": "“想「欲藉通商深入腹地」”中“想”与“欲”语义重复。",
   "evidence": [],
   "proposed": "改为“意在「藉通商深入腹地」”，或去掉“想”。"
  }
 ],
