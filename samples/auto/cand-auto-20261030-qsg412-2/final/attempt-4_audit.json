 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头没有交代俄国已占伊犁、崇厚赴俄是为议还伊犁。不了解背景的读者读到“难处不在于要不要伊犁”时，不知道伊犁是什么、为何落在俄国手里、条约谈的是什么，也就说不清问题为何难。这些背景要到 context.0、context.3 才出现。",
   "evidence": [
    {
     "id": "QSG4122-E2",
     "quote": "俄以回數擾其邊境，遽引兵逐回，取伊犁"
    },
    {
     "id": "QSG4122-E4",
     "quote": "並請與俄議還伊犁、交叛人二事"
    }
   ],
   "proposed": "在 hook.0 首句前补一句有据背景（中英同步），如：“俄国此前出兵占了伊犁；朝廷派全权大臣崇厚赴俄，议还伊犁。”其后接“崇厚遽定约……”。"
  },
  {
   "id": "F2",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "左宗棠首次出现时未说明身份及其与新疆事务的关系。“锦棠”只有名、无身份，读者不知是谁。“六年四月”未说明是原文年号纪年。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "宗棠以西事自任"
    },
    {
     "id": "QSG4122-E12",
     "quote": "錦棠經布魯特游牧為西路"
    }
   ],
   "proposed": "左宗棠首次出现处写为“以西事自任的左宗棠”（英文同步）。锦棠写为“西路统兵的锦棠”。“六年四月”后加“（原文年号纪年）”。"
  },
  {
   "id": "F3",
   "path": "sections.hook.1",
   "category": "causality",
   "severity": "fix",
   "problem": "开头把“出屯哈密→入都→和议成、交还伊犁”连续排列，略去了崇厚得罪去、命曾纪泽使俄更前约一节。读者容易把左宗棠出兵读成和议成的原因，而证据只记先后。",
   "evidence": [
    {
     "id": "QSG4122-E11",
     "quote": "崇厚得罪去，命曾紀澤使俄，更前約"
    }
   ],
   "proposed": "在“奏上获嘉许”后补“崇厚得罪去，朝廷命曾纪泽使俄改约”（英文同步），使改约交涉出现在和议成之前。"
  },
  {
   "id": "F4",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "fix",
   "problem": "“帕夏”首次出现未说明是谁、与伊犁交涉有何关系，读者无从判断此人的角色。",
   "evidence": [
    {
     "id": "QSG4122-E1",
     "quote": "帕夏能屬役回眾"
    }
   ],
   "proposed": "写为“传中所称的「帕夏」，能役使回众……”，并点明此句只交代英俄各自插手的背景。若与伊犁问题无直接关系，可后移，不放在开头。"
  },
  {
   "id": "F5",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "fix",
   "problem": "金顺首次出现未说明身份。读者不知他是左宗棠麾下统兵者（story.6 才写到他领东路）。",
   "evidence": [
    {
     "id": "QSG4122-E16",
     "quote": "金順請乘虛襲伊犁"
    },
    {
     "id": "QSG4122-E12",
     "quote": "以金順出精河為東路"
    }
   ],
   "proposed": "改为“左宗棠部下统兵的金顺请求乘虚袭击伊犁”（英文同步）。"
  },
  {
   "id": "F6",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“错过一次得手的机会”/“a chance of success”预设偷袭会成功。证据只记“乘虛襲伊犁”的请求，没有成败。",
   "evidence": [
    {
     "id": "QSG4122-E16",
     "quote": "金順請乘虛襲伊犁"
    }
   ],
   "proposed": "改为“错过一次乘虚出兵的机会”/“let an opening to strike slip by”。"
  },
  {
   "id": "F7",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "“崇厚为朝士所纠……议久不决”在同段内重复两次，且与 hook.0 重复，中英文皆然。",
   "evidence": [],
   "proposed": "删去末句的重复叙述，保留“事情悬在半空”的结语。"
  },
  {
   "id": "F8",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“concluded the treaty on the spot”中的“on the spot”证据无据，中文也没有对应内容。证据只有“遽”（仓促）。",
   "evidence": [
    {
     "id": "QSG4122-E5",
     "quote": "崇厚遽定約"
    }
   ],
   "proposed": "删去“on the spot”，作“Chong Hou concluded the treaty, and quickly”。"
  },
  {
   "id": "F9",
   "path": "sections.story.7",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文“宗棠輿櫬發肅州”是证据原文逐字照录，却没有加引号，与 hook.1 的引法不一致，读者分不清哪些是原文、哪些是转述。",
   "evidence": [
    {
     "id": "QSG4122-E13",
     "quote": "宗棠輿櫬發肅州"
    }
   ],
   "proposed": "改为“六年四月，左宗棠「輿櫬發肅州」，五月抵哈密”，或改用白话转述。"
  },
  {
   "id": "F10",
   "path": "sections.story.8",
   "category": "causality",
   "severity": "fix",
   "problem": "“从一道奏疏到一纸和约，中间隔着数次调动、增兵与告警”把奏疏与和约写成一条链，略去了曾纪泽使俄改约这一交涉环节，暗示和约由奏疏与军事调动促成。",
   "evidence": [
    {
     "id": "QSG4122-E11",
     "quote": "命曾紀澤使俄，更前約"
    }
   ],
   "proposed": "改为“从一道奏疏到一纸和约，中间有曾纪泽使俄改约，也有数次调动、增兵与告警”（英文同步）。"
  },
  {
   "id": "F11",
   "path": "sections.analysis.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "借款五百万与“出塞凡二十月，新疆南北城尽复”记的是西征之初及收复新疆，时间在伊犁交涉之前。正文却直接拿来说明伊犁奏疏中“堅忍而求勝”背后的运道饷项，未交代时间差，读者会以为这些钱粮用于伊犁对峙。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "始西征"
    },
    {
     "id": "QSG4122-E18",
     "quote": "出塞凡二十月"
    },
    {
     "id": "QSG4122-E10",
     "quote": "堅忍而求勝"
    }
   ],
   "proposed": "写明“这是更早西征收复新疆时的事”。作者推断改为“一种解释是，此前西征靠馈运饶给成事，提出‘堅忍而求勝’时可以此为凭”，不把两者写成同一时期。"
  },
  {
   "id": "F12",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "“拨款五百万、借债五百万”未说明单位（原文未载），读者可能与上文卢布五百万元混淆。limits.1 照录数字清单也漏了这两个数。",
   "evidence": [
    {
     "id": "QSG4122-E17",
     "quote": "為撥款五百萬，敕自借外國債五百萬"
    }
   ],
   "proposed": "注明“原文未载单位”，并把这两个数字补入 limits.1 的照录清单。"
  },
  {
   "id": "F13",
   "path": "sections.story.7",
   "category": "readability",
   "severity": "note",
   "problem": "中文正文对左宗棠在“左宗棠”与“宗棠”之间交替称呼（hook.1、story.7、story.8），简称不稳定。",
   "evidence": [],
   "proposed": "首次全名后统一用“左宗棠”或“左”，引语内保留原文“宗棠”。"
  }
 ],
