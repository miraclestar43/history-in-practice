 "issues": [
  {
   "id": "F1",
   "path": "sections.story.5",
   "category": "parity",
   "severity": "fix",
   "problem": "中文漏写“南路恟惧”，但句末又说“放回俘虏与南疆恟惧，传记写在一处”，指向一件文中没有交代的事。英文写了 Panic spread through the south，中英不一致。",
   "evidence": [
    {
     "id": "QSG4121-E8",
     "quote": "悉釋所擒纏回，縱之歸。南路恟懼，翼日，收托克遜城"
    }
   ],
   "proposed": "中文改为“……悉释所擒缠回，纵之归。南路恟惧；次日收托克逊城……”，不添因果。"
  },
  {
   "id": "F2",
   "path": "sections.story.5",
   "category": "style",
   "severity": "note",
   "problem": "中文“托克遜”用了繁体字，与 story.3 的“托克逊”不统一。",
   "evidence": [],
   "proposed": "统一作“托克逊”。"
  },
  {
   "id": "F3",
   "path": "sections.analysis.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文 cowed by our military prestige 沿用了传记的清廷口吻“我”，但没有加引号，读来像作者本人站在清方立场下判断。",
   "evidence": [
    {
     "id": "QSG4121-E18",
     "quote": "俄亦懾我兵威，恐事遂決裂"
    }
   ],
   "proposed": "改为 the biography says Russia too was \"cowed by our military might\"（加引号表明是原文口吻），或写作 cowed by the Qing army's might。"
  },
  {
   "id": "F4",
   "path": "sections.analysis.4",
   "category": "parity",
   "severity": "fix",
   "problem": "中文删去了“争言富强”。英文译作 talking of wealth and strength among themselves，把“争言富强”与“私议”混在一起，among themselves 没有原文依据。中英两版不对等。",
   "evidence": [
    {
     "id": "QSG4121-E22",
     "quote": "海外諸國爭言富強，雖中國屢平大難，彼猶私議以為脆弱也"
    }
   ],
   "proposed": "中文补为“海外诸国争言富强，虽见中国屡平大难，仍私议以为脆弱”。英文改为 the overseas powers, all vying to talk of wealth and power, still privately judged China frail……"
  },
  {
   "id": "F5",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "正文写“俄还伊犁于俄无损”，却删去了奏折中支撑这一判断的前提：俄方索要偿款卢布五百万元。读者因此无从理解为何“于俄无损”。中英两版都缺。",
   "evidence": [
    {
     "id": "QSG4121-E14",
     "quote": "及我索地，則索償盧布五百萬元。是俄還伊犁，於俄無損"
    }
   ],
   "proposed": "中文补“及我索地，俄索偿卢布五百万元，故俄还伊犁于俄无损”；英文相应补 Russia demanded five million rubles in compensation, so returning Ili cost it nothing。"
  },
  {
   "id": "F6",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头出现“关陇”“出关”“高宗”（英文 Guanlong, beyond the pass, emperor Gaozong），都没有说明。不了解背景的读者能看出朝中在争西征与海防、两头都要钱，但这些名词会造成阻滞。",
   "evidence": [],
   "proposed": "简短说明：关陇指陕甘一带；“出关”即出关西进新疆；高宗为乾隆。不增加史实。"
  },
  {
   "id": "F7",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "背景段一次堆出安集延、喀什噶尔、南路诸城、乌鲁木齐、妥明、北路伊犁诸城，其中妥明在后文不再出现，读者暂时用不上。",
   "evidence": [],
   "proposed": "保留“先据南疆、再并北疆（含伊犁）”的层级，把妥明一句压缩为“又攻败据乌鲁木齐的另一股回众”。"
  },
  {
   "id": "F8",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李鸿章首次出现时没有说明身份及其与此事的关系，只写“言之尤力”。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    }
   ],
   "proposed": "写明他是主张罢西征、专力海防一方中最力者，不补证据外的官职。"
  },
  {
   "id": "F9",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "“锦棠”只用名不用姓，与“左宗棠”的称法不一致，读者可能误以为姓“锦”。英文 Suzhou 容易与江苏苏州混淆。",
   "evidence": [],
   "proposed": "注明传记只称其名“锦棠”。英文 Suzhou 加注 (in Gansu) 或写作 Suzhou (Jiuquan)，不加其他史实。"
  },
  {
   "id": "F10",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "中文在“左宗棠”与“宗棠”之间交替（story.6/7、analysis.0 用“宗棠”），偶有读者会误为两人。",
   "evidence": [],
   "proposed": "引语外的叙述统一用“左宗棠”，引语内保留原文。"
  }
 ],
