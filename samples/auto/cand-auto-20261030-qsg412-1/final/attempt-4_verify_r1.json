 "issues": [
  {
   "id": "V1",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "fix",
   "problem": "中文稿在这里首次引入将领“锦棠”。传记只记他的名，正文也直接写作“锦棠”。左宗棠在后文多处被简称为“宗棠”（story.6、story.7、analysis.0、analysis.4），两个名字同带“棠”字，不了解背景的读者容易误以为是同一人或亲属。英文稿以 Zuo / Jintang 区分，问题不大。",
   "evidence": [
    {
     "id": "QSG4121-E6",
     "quote": "五月，錦棠北逾天山"
    },
    {
     "id": "QSG4121-E18",
     "quote": "詔宗棠入都備顧問，以錦棠代之"
    }
   ],
   "proposed": "首次出现时写作“西征将领锦棠（传记只称其名，与左宗棠是两个人）”，之后稳定称“锦棠”。全文提到左宗棠时，叙述句统一用“左宗棠”或“左”，不再用“宗棠”；引文原字保留。"
  },
  {
   "id": "V2",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "fix",
   "problem": "叙述句“宗棠歎曰”用名称呼左宗棠，与将领“锦棠”易混，也与前文的“左宗棠”交替出现，像两个人。",
   "evidence": [
    {
     "id": "QSG4121-E9",
     "quote": "宗棠歎曰"
    }
   ],
   "proposed": "改为“左宗棠叹道：「今時有可乘，乃為畫地縮守之策乎？」”，引文不动。"
  },
  {
   "id": "V3",
   "path": "sections.story.7",
   "category": "readability",
   "severity": "fix",
   "problem": "“宗棠曰”“宗棠露布以闻”在叙述中用名称呼，问题与 V1、V2 相同，读者分不清宗棠与锦棠。",
   "evidence": [
    {
     "id": "QSG4121-E10",
     "quote": "宗棠曰：「不可。師不以正，彼有辭矣。」"
    }
   ],
   "proposed": "叙述部分改称“左宗棠”，例如“左宗棠说：「不可。……」”“左宗棠露布以闻”。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "fix",
   "problem": "“宗棠条上新疆建行省事宜”用名称呼左宗棠，与“锦棠”易混。",
   "evidence": [
    {
     "id": "QSG4121-E12",
     "quote": "四年正月，條上新疆建行省事宜"
    }
   ],
   "proposed": "改为“左宗棠条上新疆建行省事宜”。"
  },
  {
   "id": "V5",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李鸿章首次出现时没有交代身份。证据中只见他率江苏军，与海防之议无直接关系，因此不宜补写证据之外的头衔。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    },
    {
     "id": "QSG4121-E27",
     "quote": "李鴻章江蘇軍入浙攻嘉善"
    }
   ],
   "proposed": "可写作“主张海防的一方中，传记点名李鸿章「言之尤力」”，不要补写其官职。"
  },
  {
   "id": "V6",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "英文“Suzhou”容易被读者理解为江南的苏州（苏州）。此处是西北的肃州。",
   "evidence": [
    {
     "id": "QSG4121-E6",
     "quote": "二年三月，次肅州"
    }
   ],
   "proposed": "英文改为“Suzhou (肃州, the frontier town in the northwest, not the city near Shanghai)”或类似说明，analysis.2 中同步。"
  },
  {
   "id": "V7",
   "path": "sections.analysis.4",
   "category": "readability",
   "severity": "note",
   "problem": "“及宗棠平帕夏”在叙述句中用名称呼，问题与 V1 相同，但此处上下文较清楚。",
   "evidence": [
    {
     "id": "QSG4121-E22",
     "quote": "及宗棠平帕夏"
    }
   ],
   "proposed": "改为“及左宗棠平帕夏”。"
  }
 ],
 "overall": "史实、引文、归属、纪年、因果与解释标注均与证据一致，中英文无缺失；需修正的是中文稿“宗棠”与“锦棠”称呼易混、导致读者分不清人物的易读性问题，修正后可放行。"
}