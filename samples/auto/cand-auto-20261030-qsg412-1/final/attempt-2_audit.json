 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头第一次出现左宗棠和帕夏时，都没有说明身份。读者不知道左宗棠是率军西征的统帅，也不知道帕夏是占据新疆的塞外回酋。帕夏直接出现在引语「許帕夏自立為國稱籓」里，读完开头说不清“谁遇到了什么问题、为什么难”：西征与海防争的是同一笔钱，而罢西征就等于把新疆让给帕夏。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "宗棠既平關隴，將出關，而海防議起"
    },
    {
     "id": "QSG4121-E1",
     "quote": "塞外回酋曰帕夏"
    }
   ],
   "proposed": "首句改为“光绪元年，率西军刚平定关陇的左宗棠正要出关……”。在引「許帕夏自立為國稱籓」之前，用半句交代帕夏是据有新疆南北的塞外回酋（详见下节）。英文同步修改。"
  },
  {
   "id": "F2",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "fix",
   "problem": "一段之内连续出现安集延、敖罕、和硕伯克（hoşbeg）、喀什噶尔、南八城、乌鲁木齐、妥明、伊犁等名称。其中多数对理解“停不停”用不上，读者分不清哪些地方要紧，理解开头受阻。",
   "evidence": [
    {
     "id": "QSG4121-E1",
     "quote": "帕夏畏俄逼，闌入邊"
    },
    {
     "id": "QSG4121-E1",
     "quote": "英人陰助之，欲令別立為國，用捍蔽俄"
    }
   ],
   "proposed": "压缩来历部分：写“帕夏原是中亚安集延部首领，因俄国进逼越境入新疆，先据南疆，又打败占据乌鲁木齐的妥明，兼有北路”。敖罕灭亡、和硕伯克等细节删去或后置。保留英人阴助、欲令立国以挡俄这一要点，不删改变判断的事实。英文同步修改。"
  },
  {
   "id": "F3",
   "path": "sections.context.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "“北边动手更快 / The north moved faster”是一个比较先后快慢的说法。证据只记「當是時」，没有说明俄国取伊犁比谁、早多少。",
   "evidence": [
    {
     "id": "QSG4121-E2",
     "quote": "當是時，俄以回數擾其邊境"
    }
   ],
   "proposed": "改为“北边，俄国也动了手。/ In the north, Russia acted too.”"
  },
  {
   "id": "F4",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“传记只记事，未作此分析 / the biography records events and offers no such analysis”与证据不符。传记记有左宗棠本人对英、俄两头的分析，也有史家的评断性文字。",
   "evidence": [
    {
     "id": "QSG4121-E4",
     "quote": "不西為英並，即北折而入俄耳"
    },
    {
     "id": "QSG4121-E19",
     "quote": "宗棠用兵善審機，不常其方略"
    }
   ],
   "proposed": "末句只保留“这是作者的推断。/ That is the author's inference.”"
  },
  {
   "id": "F5",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "鸿章第一次出现时没有姓氏和身份。英文括注“(the record gives only the name Hongzhang)”是错的，传记另有全名“李鴻章”。中英文在这一点上也不一致：中文无括注，英文有。",
   "evidence": [
    {
     "id": "QSG4121-E27",
     "quote": "七月，李鴻章江蘇軍入浙攻嘉善"
    },
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    }
   ],
   "proposed": "中文写作“传记说李鸿章「鴻章言之尤力」”或“李鸿章言之尤力”。英文删去括注，写“Li Hongzhang”。"
  },
  {
   "id": "F6",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“鸿章（原文只称其名）/ Hongzhang (the record gives only this name)”与证据不符，传记写有全名李鸿章；后文“鸿章言之尤力”也应统一称呼。",
   "evidence": [
    {
     "id": "QSG4121-E27",
     "quote": "七月，李鴻章江蘇軍入浙攻嘉善"
    }
   ],
   "proposed": "中英文都删去括注，改为“李鸿章 / Li Hongzhang”，句子其余部分保留。"
  },
  {
   "id": "F7",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "fix",
   "problem": "锦棠第一次出现时只有名字，没有身份。白彦虎也是首次出现，没有交代他与帕夏的关系。读者分不清人物。",
   "evidence": [
    {
     "id": "QSG4121-E18",
     "quote": "以錦棠代之"
    },
    {
     "id": "QSG4121-E6",
     "quote": "錦棠北逾天山"
    },
    {
     "id": "QSG4121-E1",
     "quote": "白彥虎竄處烏城，仍隸帕夏"
    }
   ],
   "proposed": "写作“西征军将领锦棠（后来接替左宗棠督军）……原据乌鲁木齐、隶属帕夏的白彦虎遁走托克逊”。英文同步修改。"
  },
  {
   "id": "F8",
   "path": "sections.analysis.5",
   "category": "facts",
   "severity": "fix",
   "problem": "“传记只记事 / the biography records events only”不准确。传记含评断性文字；本段“兵不减、饷照旧”的核心本是传记所记左宗棠原话，不全是作者的归纳。",
   "evidence": [
    {
     "id": "QSG4121-E4",
     "quote": "防邊兵不可減，糜餉自若"
    },
    {
     "id": "QSG4121-E26",
     "quote": "其威望在人如此"
    }
   ],
   "proposed": "末句改为“三个判断依据是作者的归纳；成本结构一点的核心出自传记所记左宗棠原话。”英文同步修改。"
  },
  {
   "id": "F9",
   "path": "sections.analysis.4",
   "category": "facts",
   "severity": "fix",
   "problem": "教堂高楼的传言属于京师民间舆论，却被放在“外部的看法也变了 / opinion abroad shifted”之下，容易让读者误以为是外国人的反应。另外，传记紧接着以「其威望在人如此」作结，随即转写同僚厌苦、他引疾乞退；本段只取威望一面，没有交代这一转折。",
   "evidence": [
    {
     "id": "QSG4121-E23",
     "quote": "民間讙言左侯至，樓即毀矣"
    },
    {
     "id": "QSG4121-E26",
     "quote": "其威望在人如此。然值軍機、譯署，同列頗厭苦之。"
    },
    {
     "id": "QSG4121-E25",
     "quote": "授軍機大臣，兼值譯署"
    }
   ],
   "proposed": "把教堂一事与外国看法分开，标明这是京师民间传言。可补一句：传记称其入京后授军机大臣兼值译署，“同列颇厌苦之”，他亦引疾乞退。英文同步修改。"
  },
  {
   "id": "F10",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "全文中文对同一人交替使用“左宗棠”和“宗棠”（如 story.6“宗棠歎曰”、analysis.0“宗棠条上”），不熟悉古人称名习惯的读者可能疑为两人。此为全文性问题，挂在本字段下记录。",
   "evidence": [],
   "proposed": "中文正文统一用“左宗棠”或“左”，只在引语中保留“宗棠”。"
  }
 ],
