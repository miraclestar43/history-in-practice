 "issues": [
  {
   "id": "F1",
   "path": "sections.limits.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "中英文都写“没有同时期奏疏原文、上谕原件，也没有李鸿章、帕夏、俄方、崇厚一方的记载可作对勘”/“There are no contemporary memorials… no edicts… and no account from…”。读者容易理解为这些文献并不存在，证据包无法支持这种断言。另外，传记本身就节引了奏疏和诏书，现写法还掩盖了这一点。",
   "evidence": [
    {
     "id": "QSG4121-E14",
     "quote": "宗棠奏曰"
    },
    {
     "id": "QSG4121-E19",
     "quote": "詔曰"
    }
   ],
   "proposed": "改为只说明本文的查阅范围。中文：“本文未查阅同时期奏疏原文、上谕原件，也未查阅李鸿章、帕夏、俄方、崇厚一方的记载；传中所引奏疏、诏书为史家节录。”英文作对应修改：“This piece did not consult original memorials, edict originals, or accounts by Li Hongzhang, Pasha, the Russian side or Chong Hou; the memorial and edict wording quoted in the biography are the compilers' excerpts.”"
  },
  {
   "id": "F2",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与F1相同。中文“无同期奏疏、上谕或对方记载可作对勘”和英文“there are no contemporary memorials, edicts or opposing accounts to check against”都断言文献不存在，超出证据；而且传记中已有节引的奏疏和诏书。",
   "evidence": [
    {
     "id": "QSG4121-E14",
     "quote": "宗棠奏曰"
    },
    {
     "id": "QSG4121-E19",
     "quote": "詔曰"
    }
   ],
   "proposed": "中文改为“本文未查阅同期奏疏、上谕原件或对方记载，传中所引奏、诏为史家节录”。英文改为“this piece did not consult original memorials, edicts or opposing accounts; the memorials and edicts quoted in the biography are the compilers' excerpts”。"
  },
  {
   "id": "F3",
   "path": "sections.story.7",
   "category": "readability",
   "severity": "note",
   "problem": "本段从金顺请袭伊犁直接跳到“大军还定乌什”和“伯克胡里既纳白彦虎”，略去了中间八月分两路进军、白彦虎经库车、阿克苏逃往喀什噶尔一节。读者上一次见到白彦虎时，他逃往的是托克逊，因此看不出他怎么到了喀什噶尔，也看不出“还定”中的“还”从何说起。",
   "evidence": [
    {
     "id": "QSG4121-E29",
     "quote": "白彥虎走庫車，趨阿克蘇，錦棠遮擊之，轉遁喀什噶爾。"
    }
   ],
   "proposed": "在“随后大军还定乌什”之前补一句，并在段落证据中加入QSG4121-E29：“八月，锦棠分正、奇两路进兵；白彦虎走库车、趋阿克苏，被锦棠截击，转逃喀什噶尔。”英文同步补入。"
  },
  {
   "id": "F4",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李鸿章在本段第一次出现，没有交代他与本事的关系，读者不知道他为何值得单独点名。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    }
   ],
   "proposed": "首次出现时只用证据已有的信息说明身份，例如“主张海防一方中言之最力的李鸿章”。不要补入证据以外的官职。"
  },
  {
   "id": "F5",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "正文叙述中“左宗棠”与“宗棠”交替使用（story.2“授左宗棠…”与“宗棠议”，story.6、story.7“宗棠歎曰／宗棠曰”，analysis.0“宗棠条上”），后文又出现“左侯”。不熟悉古人称名习惯的读者可能以为是不同的人。",
   "evidence": [],
   "proposed": "引号外的叙述统一称“左宗棠”；「」内的原文保持不动；“左侯”只在引语中出现。"
  }
 ],
