 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头的整体问题读者能说清：朝中有人主张罢西征、专力海防，两头都要钱。但“高宗”“关陇”“出关”没有注释。不了解背景的读者不知道高宗是哪位皇帝，也不知道出关是要西进新疆。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "宗棠既平關隴，將出關，而海防議起"
    }
   ],
   "proposed": "中文：“正要出关”改为“正要出关西征新疆”，“自高宗定新疆”改为“自清高宗平定新疆”。英文相应改为 \"about to march out beyond the pass toward Xinjiang\"、\"the Qing emperor Gaozong\"。"
  },
  {
   "id": "V2",
   "path": "sections.context.0",
   "category": "style",
   "severity": "note",
   "problem": "英文 \"came originally from the Andijan\" 缺少中心名词，读起来像残句。中文“原出安集延部”是完整的。",
   "evidence": [
    {
     "id": "QSG4121-E1",
     "quote": "本安集延部之和碩伯克也"
    }
   ],
   "proposed": "改为 \"came originally from the Andijan people\"。"
  },
  {
   "id": "V3",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李鸿章在本段首次出现，只写了他“言之尤力”，没有交代身份。证据包没有给出他当时的官职，所以只能点明他在本事中的角色。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    }
   ],
   "proposed": "中文改为“传记说海防一派中李鸿章于此「言之尤力」”。英文改为 \"Li Hongzhang, the leading voice on the coastal-defense side, pressed this hardest\"。不要补写证据之外的官职。"
  },
  {
   "id": "V4",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "“锦棠/Jintang”在传记中只是名，不带姓。英文读者会以为这是全名。中文里“锦棠”与“宗棠”字形相近，又与“左宗棠”交替出现，容易混淆。",
   "evidence": [
    {
     "id": "QSG4121-E6",
     "quote": "錦棠北逾天山"
    }
   ],
   "proposed": "首次出现处补一句“（传记只称其名）”，英文补 \"(the biography gives only his given name)\"。正文叙述中统一称“左宗棠”，“宗棠”只保留在引文中。"
  }
 ],
 "overall": "逐字段核对后，事实、归属、时序、引语和解释标注都有证据支持，中英一致，没有事实类问题。开头的易读性可以通过，仅有四处 note 级的易读性和文风建议，定稿可以发布。"
}