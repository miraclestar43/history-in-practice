 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "parity",
   "severity": "fix",
   "problem": "中文说“有些开支，停下来一分也省不掉”。英文写成“some costs ... stop nothing by being stopped”，语义不通，也和中文意思不一致。",
   "evidence": [
    {
     "id": "QSG4121-E4",
     "quote": "防邊兵不可減，糜餉自若"
    }
   ],
   "proposed": "英文改为：\"some costs, he argued, are not saved by stopping.\""
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头的问题本身交代清楚了。但“关陇”“出关”“高宗”（英文 the emperor Gaozong）都没有解释，不了解背景的读者会卡住。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "自高宗定新疆"
    }
   ],
   "proposed": "给“高宗”加简短说明，例如“清高宗（乾隆）”；把“出关”说成“出关西进新疆”。不要增加史实。"
  },
  {
   "id": "V3",
   "path": "sections.context.0",
   "category": "style",
   "severity": "note",
   "problem": "英文“came originally from the Andijan”缺少中心词，读起来不完整。",
   "evidence": [
    {
     "id": "QSG4121-E1",
     "quote": "本安集延部之和碩伯克也"
    }
   ],
   "proposed": "改为“came originally from the Andijan people”或“was originally a beg of Andijan”。"
  },
  {
   "id": "V4",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李鸿章首次出现时没有说明他和本事的关系，只出现了名字。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    }
   ],
   "proposed": "写成“主张海防者中，传记点名李鸿章‘言之尤力’”，用证据内的措辞点明他的立场。不要补写他当时的官职。"
  },
  {
   "id": "V5",
   "path": "sections.story.5",
   "category": "style",
   "severity": "note",
   "problem": "中文“托克遜城”用了繁体“遜”，与 story.3 的“托克逊”写法不一致。",
   "evidence": [
    {
     "id": "QSG4121-E8",
     "quote": "翼日，收托克遜城"
    }
   ],
   "proposed": "统一为“托克逊城”。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.2",
   "category": "readability",
   "severity": "fix",
   "problem": "中文叙述中，左宗棠时而称“左宗棠”，时而称“宗棠”“左侯”；锦棠又只有名字没有姓。“诏宗棠入都备顾问，以锦棠代之”一句里，宗棠与锦棠并列，读者容易把两人混成一人或分不清谁接替谁。",
   "evidence": [
    {
     "id": "QSG4121-E18",
     "quote": "詔宗棠入都備顧問，以錦棠代之"
    }
   ],
   "proposed": "叙述文字（引文除外）统一称“左宗棠”。此句改为“七月诏左宗棠入都备顾问，由西征将领锦棠接替他”。"
  },
  {
   "id": "V7",
   "path": "sections.analysis.4",
   "category": "chronology",
   "severity": "fix",
   "problem": "稿件说传记收束教堂高楼一事后，“随即转笔：他入觐后授军机大臣兼值译署”。但授职一句（E25）在传记中位于屯田段之后、外国改观段之前，在教堂一事之前。紧接“其威望在人如此”的，只是“然值軍機、譯署，同列頗厭苦之”。稿件把原文的叙述次序写错了。",
   "evidence": [
    {
     "id": "QSG4121-E26",
     "quote": "其威望在人如此。然值軍機、譯署，同列頗厭苦之"
    },
    {
     "id": "QSG4121-E25",
     "quote": "既入覲，賜紫禁城騎馬，使內侍二人扶掖上殿，授軍機大臣，兼值譯署"
    }
   ],
   "proposed": "改为：“传记以‘其威望在人如此’收束此事，随即转笔：他在军机、译署任上（入觐后所授），‘同列頗厭苦之’……”。英文同步修改。"
  }
 ],
 "overall": "史实、引语与解释标注整体有证据支撑。需修正的是：dek 英文语义失配；analysis.4 误述了传记的叙述次序；宗棠与锦棠称呼混淆影响易读性。另有若干易读性与文风小问题。"
}