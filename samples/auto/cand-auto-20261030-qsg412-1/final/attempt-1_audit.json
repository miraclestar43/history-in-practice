 ],
 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "英文把「高宗」直接写成 the Qianlong emperor，又把关陇注为 the Gansu–Shaanxi corridor。这两处对应关系都不在证据包内，属于证据之外的具体事实。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "論者多言自高宗定新疆"
    }
   ],
   "proposed": "英文改为 'Since the emperor Gaozong took Xinjiang'，并删去 'the Gansu–Shaanxi corridor' 这一注释。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "「钱只有这么多，先停哪一头，得当场回答」/'There was only so much money… demanded an answer on the spot' 是作者的框定，证据没有记载。这一句写在 record 段里，又没有标为解释。",
   "evidence": [],
   "proposed": "删去该句，或改为「作者认为，这等于要在两头之间先做取舍」/'As the author sees it, this forced a choice between the two'。"
  },
  {
   "id": "F3",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "英文给「帕夏」加注 'a title, roughly governor'，给「和碩伯克」加注 'or clan chief'。这两项释义都不在证据中。",
   "evidence": [
    {
     "id": "QSG4121-E1",
     "quote": "本安集延部之和碩伯克也"
    }
   ],
   "proposed": "删去这两处释义，只保留音译 'Pasha' 和 'hoşbeg'。"
  },
  {
   "id": "F4",
   "path": "sections.context.1",
   "category": "facts",
   "severity": "fix",
   "problem": "原文是「且言將代取烏魯木齊」，「代取」指俄方声称代为攻取。中文改成「乌鲁木齐也在其口头计划之内」，英文写成 'would take Ürümqi too'，都抹掉了「代」字，把它写成了俄国自己的占地计划。",
   "evidence": [
    {
     "id": "QSG4121-E2",
     "quote": "且言將代取烏魯木齊"
    }
   ],
   "proposed": "中文改为「且言将代取乌鲁木齐」，删去「也在其口头计划之内」；英文改为 'and said it would take Ürümqi on China's behalf'。"
  },
  {
   "id": "F5",
   "path": "sections.context.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "「到光绪元年，伊犁已在俄国手中」/'By the first year of Guangxu' 把时间点写成了定论。原文只作「當是時」，并未系年。",
   "evidence": [
    {
     "id": "QSG4121-E2",
     "quote": "當是時，俄以回數擾其邊境，遽引兵逐回，取伊犁"
    }
   ],
   "proposed": "改为「传记记为『当是时』，未系具体年份」/'The biography dates this only as \"at that time\"'。"
  },
  {
   "id": "F6",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "「海上一旦有事将无以应对」/'if trouble came at sea' 把「不虞」限定成了海上之事，原文泛指不测。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "無以待不虞"
    }
   ],
   "proposed": "中文改为「一旦有不虞之事将无以应对」；英文改为 'nothing would be left to meet the unforeseen'。"
  },
  {
   "id": "F7",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "证据只作「鴻章」，英文补出了姓氏 Li Hongzhang，这超出了证据。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "鴻章言之尤力"
    }
   ],
   "proposed": "英文改为 'Hongzhang' 并注明原文只称其名，或删去姓氏。"
  },
  {
   "id": "F8",
   "path": "sections.story.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "「反驳不在道德，而在账」/'arithmetic, not moral' 是作者判断，没有标为解释。而且原话里本有「挫國威」这一非财务理由，与「不在道德」的说法并不完全相符。",
   "evidence": [
    {
     "id": "QSG4121-E4",
     "quote": "無益海防而挫國威，且長亂"
    }
   ],
   "proposed": "改为「作者认为，他的反驳重心在账上」/'One reading is that his answer rested chiefly on cost'。"
  },
  {
   "id": "F9",
   "path": "sections.story.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文概述漏了中文所含的「坐自遗患」和「帕夏守不住则归英入俄」两层意思。英文译文 'Instead of recovering' 也漏译了「不及時」。",
   "evidence": [
    {
     "id": "QSG4121-E4",
     "quote": "不及時規還國家舊所沒地"
    }
   ],
   "proposed": "英文概述补上 'storing up trouble, and the land would fall to England or Russia if Pasha failed'；译文改为 'Instead of recovering in good time the lands…'。"
  },
  {
   "id": "F10",
   "path": "sections.story.2",
   "category": "chronology",
   "severity": "fix",
   "problem": "英文 'The dispute ended quickly' 是时长判断，证据未记，中文「结局很短」也没有这层意思。另外 'rather than disband' 误译了「不罷兵」，原意是不停兵。",
   "evidence": [
    {
     "id": "QSG4121-E5",
     "quote": "遂決策出塞，不罷兵"
    }
   ],
   "proposed": "改为 'The record of how it ended is brief'，并把 'rather than disband' 改为 'rather than halt the campaign'。"
  },
  {
   "id": "F11",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "英文 'The minister at Khüree, in Urga' 加了地名对应注释，证据只作「庫倫大臣」。",
   "evidence": [
    {
     "id": "QSG4121-E9",
     "quote": "適庫倫大臣上言西事宜畫定疆界"
    }
   ],
   "proposed": "改为 'The minister at Kulun (Khüree)'，删去 'in Urga'。"
  },
  {
   "id": "F12",
   "path": "sections.story.7",
   "category": "chronology",
   "severity": "fix",
   "problem": "原文顺序是：何步云降，伯克胡里纳白彦虎后攻汉城，大军至后遁走俄，然后西四城相继下。稿中把遁走俄移到西四城下之后，并略去了伯克胡里攻汉城一事。原文遁走俄的主语是伯克胡里，稿中明写白彦虎同逃，属于推断。",
   "evidence": [
    {
     "id": "QSG4121-E11",
     "quote": "伯克胡里既納白彥虎，乃效力攻漢城。大軍至，复遁走俄。西四城相繼下"
    }
   ],
   "proposed": "按原序改为「何步云以喀什汉城降；伯克胡里既纳白彦虎，攻汉城，大军至，遁走俄；西四城相继下」，英文同步调整。"
  },
  {
   "id": "F13",
   "path": "sections.story.8",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "英文首句 'Set side by side, the two lines show one test' 直接写成断言。中文对应句以「作者推断」开头，英文缺少这一标注。",
   "evidence": [],
   "proposed": "英文改为 'The author's inference is that, set side by side, the two lines show one test…'。"
  },
  {
   "id": "F14",
   "path": "sections.analysis.0",
   "category": "facts",
   "severity": "fix",
   "problem": "英文把「全權大臣」译为 'An Imperial Commissioner'。该词稿中已用来对应左宗棠的「欽差大臣」，这样会混淆两种官职。",
   "evidence": [
    {
     "id": "QSG4121-E13",
     "quote": "詔遣全權大臣崇厚使俄"
    }
   ],
   "proposed": "改为 'A plenipotentiary, Chonghou, was sent to Russia'。"
  },
  {
   "id": "F15",
   "path": "sections.analysis.2",
   "category": "inner_life",
   "severity": "fix",
   "problem": "英文 'meaning to die on campaign' 替左宗棠补写了动机，证据只记「輿櫬」。这也与 limits.0 所称「没有补写心理动机」相矛盾。",
   "evidence": [
    {
     "id": "QSG4121-E17",
     "quote": "宗棠輿櫬發肅州"
    }
   ],
   "proposed": "删去 'meaning to die on campaign'。"
  },
  {
   "id": "F16",
   "path": "sections.analysis.3",
   "category": "facts",
   "severity": "fix",
   "problem": "英文把「願弱」译为 'the willing and the weak'。「願」在此当谨厚、朴弱讲，并非「愿意」。",
   "evidence": [
    {
     "id": "QSG4121-E21",
     "quote": "散願弱使屯墾"
    }
   ],
   "proposed": "改为 'settling the meek and the weak on the land'。"
  },
  {
   "id": "F17",
   "path": "sections.analysis.4",
   "category": "chronology",
   "severity": "fix",
   "problem": "「他后来初入京师」中的「后来」是证据未记的时间定位，英文也没有对应的词。",
   "evidence": [
    {
     "id": "QSG4121-E23",
     "quote": "其初入京師"
    }
   ],
   "proposed": "删去「后来」，作「他初入京师时」。"
  },
  {
   "id": "F18",
   "path": "sections.analysis.4",
   "category": "attribution",
   "severity": "fix",
   "problem": "原文「為示諭曉」未写明是谁出的示谕，稿中写成「他示谕晓之」/'he posted a proclamation'。民间传言原文是「樓即毀矣」，英文 'would have it torn down' 加进了左宗棠的主动意图。",
   "evidence": [
    {
     "id": "QSG4121-E23",
     "quote": "民間讙言左侯至，樓即毀矣，為示諭曉，乃止"
    }
   ],
   "proposed": "中文改为「民间讙言左侯至楼即毁，后出示谕晓，乃止（原文未明言示谕者）」；英文改为 'the tower would come down once Marquis Zuo arrived; a notice was posted to explain'。"
  },
  {
   "id": "F19",
   "path": "sections.analysis.5",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "中文第二层判断以「一种解释是」标注，英文 'Zuo's objection held not because…' 没有对应标注，两版不一致。",
   "evidence": [],
   "proposed": "英文改为 'One reading is that Zuo's objection held…'。"
  },
  {
   "id": "F20",
   "path": "sections.limits.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文正文各处引号里的内容都是从文言译出的，如 hook.0、context.0、story.0/1/4/6/7、analysis.1。但全文没有一处告诉读者这些是译文，读者容易把它们当成原文。",
   "evidence": [],
   "proposed": "在英文 limits.0 加一句：'All quotations in the English text are the author's translations from the classical Chinese.'"
  },
  {
   "id": "F21",
   "path": "sections.limits.0",
