 "issues": [
  {
   "id": "V1",
   "path": "sections.story.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "本段 kind=record。段末“要害在中段：兵减不掉，饷照旧要花 / The sting is in the middle…”是作者对原话重点的评判，却以陈述句写出，没有标为解释。开头的“作者认为”只覆盖第一句。",
   "evidence": [
    {
     "id": "QSG4121-E4",
     "quote": "防邊兵不可減，糜餉自若"
    }
   ],
   "proposed": "zh 改为“作者以为，要害在中段：……”；en 改为“In the author's reading, the sting is in the middle: …”"
  },
  {
   "id": "V2",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“released every captured Muslim of the south”多出“of the south”。原文只说释放所擒缠回，没有限定为南路之人；中文版也没有这一限定。",
   "evidence": [
    {
     "id": "QSG4121-E8",
     "quote": "悉釋所擒纏回，縱之歸"
    }
   ],
   "proposed": "en 改为“released every Turkic Muslim he had captured, sending them home”"
  },
  {
   "id": "V3",
   "path": "sections.analysis.2",
   "category": "parity",
   "severity": "fix",
   "problem": "英文在“the biography … says Russia too was cowed”中插入“written from the Qing side”，中文版没有对应内容，中英不一致。这一史源立场判断属于作者评语，应同时出现在两种语言中，或者都删去。",
   "evidence": [
    {
     "id": "QSG4121-E18",
     "quote": "而俄亦懾我兵威，恐事遂決裂"
    }
   ],
   "proposed": "删去 en 的“written from the Qing side,”；或在 zh 对应处补“（此系清方史书的说法）”"
  },
  {
   "id": "V4",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头出现“高宗”“关陇”“出关”，不熟悉背景的读者不一定知道所指。主线（西征与海防争同一笔钱）能看懂，但这几个词增加了理解门槛。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "論者多言自高宗定新疆"
    }
   ],
   "proposed": "首次出现时加极简说明，例如“自高宗（乾隆帝）定新疆”；“关陇”可作“陕甘一带（关陇）”"
  },
  {
   "id": "V5",
   "path": "sections.story.7",
   "category": "readability",
   "severity": "note",
   "problem": "中文正文在引语之外交替使用“左宗棠”和“宗棠”（如“宗棠露布以闻”“宗棠曰”，以及 analysis.0 的“宗棠条上”、story.6 的“宗棠歎曰”），称呼不统一。",
   "evidence": [
    {
     "id": "QSG4121-E11",
     "quote": "宗棠露布以聞，詔晉二等侯"
    }
   ],
   "proposed": "引语之外统一作“左宗棠”"
  },
  {
   "id": "V6",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "英文“Suzhou”（肃州）容易被读者误认作江苏苏州，后文 analysis.2 也再次出现。",
   "evidence": [
    {
     "id": "QSG4121-E6",
     "quote": "二年三月，次肅州"
    }
   ],
   "proposed": "en 首次出现时写作“Suzhou (in Gansu)”"
  },
  {
   "id": "V7",
   "path": "sections.analysis.4",
   "category": "readability",
   "severity": "note",
   "problem": "“此职系入觐后所授，传记记于前文”所指的授职，正文从未交代，读者无从对照。",
   "evidence": [
    {
     "id": "QSG4121-E25",
     "quote": "既入覲，賜紫禁城騎馬，使內侍二人扶掖上殿，授軍機大臣，兼值譯署"
    }
   ],
   "proposed": "把括注改为“（入觐后，左宗棠被授军机大臣，兼值译署）”，en 同步修改"
  },
  {
   "id": "V8",
   "path": "reflection.example.alternative",
   "category": "readability",
   "severity": "note",
   "problem": "中文“既不停全款、也不全停”字面上自相矛盾，和英文“neither full funding nor a full stop”也对不上。",
   "evidence": [],
   "proposed": "zh 改为“既不全额投入、也不全部停下”"
  }
 ],
 "overall": "定稿引语逐字可核，因果与推断大体已标注；需修正 story.1 未标注的评判、story.5 英文多出的“of the south”和 analysis.2 的中英不一致，另有几处易读性小问题，但开头可读，不影响理解。"
}