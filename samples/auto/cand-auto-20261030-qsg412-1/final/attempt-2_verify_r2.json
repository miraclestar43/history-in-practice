 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头出现“高宗”（英文作 the emperor Gaozong）和“关陇”，均未说明。不了解背景的读者不知道“高宗”指哪位皇帝，也不知道关陇在哪里。这不妨碍理解核心冲突，但多了一道门槛。",
   "evidence": [
    {
     "id": "QSG4121-E3",
     "quote": "自高宗定新疆，歲糜數百萬"
    }
   ],
   "proposed": "在“高宗”后补一句简注，如“清高宗（乾隆）”；“关陇”可简注为“陕甘一带”。英文同步处理。"
  },
  {
   "id": "V2",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "“锦棠”只以名相称，与“宗棠”同带“棠”字。读者容易误以为两人有亲属关系，或把两人混淆。正文叙述中又“左宗棠”“宗棠”交替使用，加重了混淆。",
   "evidence": [
    {
     "id": "QSG4121-E6",
     "quote": "錦棠北逾天山，會金順軍先攻烏魯木齊"
    }
   ],
   "proposed": "叙述中统一用“左宗棠”称左（“宗棠”只保留在引文里）。锦棠首次出现时注明“传记只记其名”，此后一律称“锦棠”。"
  },
  {
   "id": "V3",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "英文把肃州译作 Suzhou，读者很容易当成江南的苏州。analysis.2 也有同样问题。",
   "evidence": [
    {
     "id": "QSG4121-E6",
     "quote": "二年三月，次肅州"
    }
   ],
   "proposed": "首次出现时写作“Suzhou (Jiuquan, in Gansu)”，或加“the Gansu town of”，后文保持一致。"
  },
  {
   "id": "V4",
   "path": "sections.story.5",
   "category": "parity",
   "severity": "fix",
   "problem": "中文正文没有写“南路恟惧”，句末却说“放回俘虏与南疆恟惧，传记写在一处”，指向了一件文中未曾交代的事。英文则写了 Panic spread through the south。中英不一致，中文还缺了一个记录事实。",
   "evidence": [
    {
     "id": "QSG4121-E8",
     "quote": "悉釋所擒纏回，縱之歸。南路恟懼，翼日，收托克遜城"
    }
   ],
   "proposed": "中文改为“……悉释所擒缠回，纵之归。南路恟惧；次日收托克逊城……”，不添因果。"
  },
  {
   "id": "V5",
   "path": "sections.story.5",
   "category": "style",
   "severity": "note",
   "problem": "简体正文中夹有繁体字“遜”（托克遜城）。",
   "evidence": [
    {
     "id": "QSG4121-E8",
     "quote": "收托克遜城"
    }
   ],
   "proposed": "改为“托克逊城”。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文 the biography says Russia too was cowed by our military prestige 中的“our”沿用了传记的清廷口吻，却没有加引号。读起来像作者本人站在清方立场作判断。",
   "evidence": [
    {
     "id": "QSG4121-E18",
     "quote": "而俄亦懾我兵威，恐事遂決裂"
    }
   ],
   "proposed": "改为 the biography says Russia too was \"cowed by our military might\"（加引号表明是原文口吻），或写作 cowed by the Qing army's might。"
  },
  {
   "id": "V7",
   "path": "sections.analysis.4",
   "category": "parity",
   "severity": "fix",
   "problem": "中文删去了“爭言富強”。英文则译作 talking of wealth and strength among themselves，把“爭言富強”和“私議”混在一起，“among themselves”无原文依据。中英两版都与原文有出入。",
   "evidence": [
    {
     "id": "QSG4121-E22",
     "quote": "海外諸國爭言富強，雖中國屢平大難，彼猶私議以為脆弱也"
    }
   ],
   "proposed": "中文补“海外诸国争言富强，虽见中国屡平大难，仍私议以为脆弱”。英文改为 the overseas powers, all vying to speak of wealth and power, still privately judged China frail……"
  }
 ],
 "overall": "定稿史实、引文与解释标注总体可靠。需修正三处：story.5 中文漏写“南路恟惧”造成中英不一致，analysis.2 英文未加引号的“our”口吻，analysis.4 对“爭言富強”的中英处理不一致；其余为易读性与文风小注。"
}