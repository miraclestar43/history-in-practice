  "issues": [
   {
    "id": "F1",
    "path": "sections.story.1",
    "category": "facts",
    "severity": "fix",
    "problem": "原文中“with her own writing in it”在语法上修饰圣经，没有说明亲笔字迹就在被撕下的扉页上。中文“那一页上有她亲笔写的字”和英文“the page with her own writing on it”把一种推断写成了事实。",
    "evidence": [
     {
      "id": "S-E5",
      "quote": "I tore the fly-leaf out of the Bible that Queen Alexandra had given to the ship, with her own writing in it,"
     }
    ],
    "proposed": "zh：他还从王后赠给船、内有她亲笔字迹的那本圣经上撕下扉页。en：He tore the fly-leaf out of the Bible the Queen had given to the ship, with her own writing in it."
   },
   {
    "id": "F2",
    "path": "sections.story.8",
    "category": "parity",
    "severity": "fix",
    "problem": "中文“他看清了两件事”把可能开出水道也写成了他“看清”的事。原文中他“could see”的只有雪面松软、成果太少、走不远。水道只是他“taking into account also”的一种可能。英文写成“a second possibility to weigh”，是对的，中英文不一致。",
    "evidence": [
     {
      "id": "S-E7",
      "quote": "I could see that with the present loose surface"
     },
     {
      "id": "S-E7",
      "quote": "Taking into account also the possibility of leads opening close to us"
     }
    ],
    "proposed": "zh 改为：他看清，以眼下松软的雪面，加上四天苦干换来的那点成果，走不了多远；他同时也考虑到，附近有可能开出水道，那样就能划船向西北方向去找陆地。"
   },
   {
    "id": "F3",
    "path": "sections.context.heading",
    "category": "style",
    "severity": "note",
    "problem": "小标题含“两磅的规矩”，但 context 两段都没有写两磅规定，这一规定出现在 story.0。标题与本节内容不对应。",
    "evidence": [],
    "proposed": "改为“原计划与弃船时的处境”/“The Original Plan, and Where They Stood”，或把两磅规定移入本节。"
   },
   {
    "id": "F4",
    "path": "sections.analysis.0",
    "category": "attribution",
    "severity": "fix",
    "problem": "文中说两次决定“看的是同样的东西：眼前这段路找不找得到、值不值得把船带进去冒险”。这只是不拔营那次的理由（S-E13）。海洋营决定的理由（S-E7）是雪面松软、四天成果太少、附近可能开出水道，没有提到找路或船的危险。这里把一次决定的理由套到了另一次上，“作者推断”的标签补救不了。",
    "evidence": [
     {
      "id": "S-E13",
      "quote": "A path over the shattered floes would be hard to find, and to get the boats into a position of peril might be disastrous"
     },
     {
      "id": "S-E7",
      "quote": "considering how little result we had to show for all our strenuous efforts of the past four days, it would be impossible to proceed for any great distance"
     }
    ],
    "proposed": "改为“两次决定都在衡量眼前的路还能不能走下去”/“Both decisions turned on whether the way ahead could be made”，并删去“值不值得把船带进去冒险”及对应的英文“and was it worth taking the boats into danger to use it”。"
   }
