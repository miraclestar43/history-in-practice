 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.1",
   "category": "attribution",
   "severity": "fix",
   "problem": "证据中，靠海豹和企鹅过活、保留雪橇口粮是沙克尔顿本人的决定。文中写成「他们还决定」/\"They also chose\"，把决定者泛化成了全队。story.11 已经正确写作「他还决定」，两处说法不一致。",
   "evidence": [
    {
     "id": "S-E17",
     "quote": "I decided to conserve our valuable sledging rations, which would be so necessary for the inevitable boat journey, as much as possible, and to subsist almost entirely on seals and penguins."
    }
   ],
   "proposed": "zh：「他们还决定几乎全靠海豹和企鹅过活」改为「他还决定让大家几乎全靠海豹和企鹅过活」；en：\"They also chose to live almost entirely on seals and penguins\" 改为 \"He also decided they would live almost entirely on seals and penguins\"。"
  },
  {
   "id": "V2",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "「此后获救的过程」/\"the rescue that followed\" 断言后来发生了获救。证据包只写到「目标是抵达陆地」和进驻耐心营，没有任何关于获救的内容。同一句话又声明这部分在证据范围之外，前后自相矛盾。",
   "evidence": [
    {
     "id": "S-E2",
     "quote": "The task is to reach land with all the members of the Expedition."
    },
    {
     "id": "S-E8",
     "quote": "Our new home, which we were to occupy for nearly three and a half months, we called “‘ Patience Camp"
    }
   ],
   "proposed": "zh：「本篇也不写此后获救的过程」改为「本篇也不写耐心营之后的经过」；en：\"the story of the rescue that followed\" 改为 \"what happened after Patience Camp\"。"
  },
  {
   "id": "V3",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与 V2 相同。「此后的获救过程」/\"The rescue that followed\" 断言了证据包没有记载的获救。",
   "evidence": [
    {
     "id": "S-E2",
     "quote": "The task is to reach land with all the members of the Expedition."
    }
   ],
   "proposed": "zh：「本篇不涉及此后的获救过程」改为「本篇不涉及耐心营之后的经过」；en：\"The rescue that followed is not covered here.\" 改为 \"What happened after Patience Camp is not covered here.\""
  },
  {
   "id": "V4",
   "path": "sections.context.heading",
   "category": "style",
   "severity": "note",
   "problem": "标题写了「两磅的规矩」，但 context 两段讲的是原计划和弃船时所处的位置。两磅规矩实际出现在 story.0。",
   "evidence": [],
   "proposed": "可把标题改为「原计划与所处位置」/\"The Original Plan, and Where They Stood\"，也可保持不改。"
  }
 ],
 "overall": "定稿的引语都逐字来自证据，数字、时序和解释标注基本可靠。需要修正两处：分析段把沙克尔顿本人的口粮决定写成了全队的决定；边界说明和不确定性注释中提到了证据之外的「获救」。"
}