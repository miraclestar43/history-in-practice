 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "中文写“魏公子无忌”，英文只写 Prince Wuji 和 the city of Daliang。英文读者读完开头不知道他是魏国公子，也不知道大梁是魏都，因此看不出“自己的国君叫停救兵”这层难处。中英在这一点上也不一致。",
   "evidence": [
    {
     "id": "SJ0771-E36",
     "quote": "無忌自在大梁時"
    },
    {
     "id": "SJ0771-E9",
     "quote": "請救於魏"
    }
   ],
   "proposed": "en 改为：Prince Wuji of Wei rode out of Daliang, the Wei capital, with a hundred-odd chariots and horsemen…"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文 came back to ask Hou Ying what he had missed 误读了原文。“我豈有所失哉”是问自己是否有什么过失、怠慢了侯嬴，不是问漏了什么。analysis.0 英文作 what fault he had committed，与此处前后不一致。",
   "evidence": [
    {
     "id": "SJ0771-E13",
     "quote": "我豈有所失哉？復引車還，問侯生"
    }
   ],
   "proposed": "en 改为：…he turned the chariots around and came back to ask Hou Ying whether he had failed him in some way."
  },
  {
   "id": "F3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "英文首次出现 King Anxi 时没有说明他是魏王、是无忌自己的国君；Lord Pingyuan 也没有标明是赵国人（中文写“赵国平原君”）。后文又在 King Anxi、the King of Wei、the king of Wei、the king 之间换叫法，读者难以确认是同一人，开头的难处也看不出来。",
   "evidence": [
    {
     "id": "SJ0771-E27",
     "quote": "魏王畏秦，終不聽公子"
    },
    {
     "id": "SJ0771-E9",
     "quote": "公子姊為趙惠文王弟平原君夫人"
    }
   ],
   "proposed": "en 改为：King Anxi of Wei, Wuji's own king, had already sent General Jin Pi…；末句改为 …his own sister was the wife of Lord Pingyuan of Zhao。后文统一用 the king of Wei。"
  },
  {
   "id": "F4",
   "path": "sections.story.5",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写“假传魏王令”，英文 declared that he was replacing Jin Pi by the king's order 丢掉了“矫/假传”，读来像是真有王命。这改变了读者对事件性质的判断。",
   "evidence": [
    {
     "id": "SJ0771-E29",
     "quote": "至鄴，矯魏王令代晉鄙"
    }
   ],
   "proposed": "en 改为：At Ye, Wuji claimed a forged order from the king of Wei and announced that he was replacing Jin Pi."
  },
  {
   "id": "F5",
   "path": "sections.analysis.3",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“拖下去的代价由城里的人承担”是作者推断，证据只有平原君使者说邯郸旦暮降秦。这句却写在“作者推断”标签之前，读来像史实。英文 On this reading 同样放得太靠后。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "今邯鄲旦暮降秦而魏救不至"
    }
   ],
   "proposed": "zh：……旦暮降秦。作者推断：拖下去的代价由城里的人承担；他选的……。en 把 On this reading 移到 the price of holding back 之前。"
  },
  {
   "id": "F6",
   "path": "sections.analysis.4",
   "category": "readability",
   "severity": "fix",
   "problem": "“十八年后秦国俘虏了魏王”里的魏王，并不是全文一直出现的那位魏王（安釐王）。证据记载安釐王与公子同年去世，被俘的是后来的魏王。正文不加区分，读者会以为是同一人。",
   "evidence": [
    {
     "id": "SJ0771-E35",
     "quote": "其歲，魏安釐王亦薨"
    },
    {
     "id": "SJ0771-E35",
     "quote": "十八歲而虜魏王"
    }
   ],
   "proposed": "zh 改为：此后十八年，秦国俘虏了魏国后来的国君；en 改为：eighteen years later captured a later king of Wei。"
  },
  {
   "id": "F7",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "本段说“纪年只用原文的魏安釐王二十年”，但正文任何段落都没有用这个年份，是对本文内容的不实描述。“八万之数出自本传”是凑数的局限说明，读者理解不需要。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏安釐王二十年"
    }
   ],
   "proposed": "删去整段（中英同删）。"
  },
  {
   "id": "F8",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "“纪年只用原文，不换算公元”与正文不符：正文没有任何纪年，这半句读者用不上。",
   "evidence": [],
   "proposed": "删去“纪年只用原文，不换算公元”及英文对应的 Dates follow the original… 一句。"
  },
  {
   "id": "F9",
   "path": "reflection.example.steps",
   "category": "facts",
   "severity": "fix",
   "problem": "中文“主动认下对自己这方的亏欠”与所附史例矛盾：无忌起初面有自功之色，是门客进言后才自责，并不“主动”。英文没有“主动”，中英也不一致。这一措辞来自已知污染 K7 的简报说法。",
   "evidence": [
    {
     "id": "SJ0771-E24",
     "quote": "公子聞之，意驕矜而有自功之色"
    },
    {
     "id": "SJ0771-E24",
     "quote": "於是公子立自責"
    }
   ],
   "proposed": "删去“主动”：三、事成之后认下对自己这方的亏欠，不把功劳记在自己账上（门客劝后无忌自责）。"
  },
  {
   "id": "F10",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "analysis.0 至 analysis.3 每段都以“作者推断：”开头，analysis.4 又用“作者认为”和“一种解释是”，标签反复出现，读来像审核标注。",
   "evidence": [],
   "proposed": "在 analysis 第一段标一次“作者推断”，其余各段改用“在作者看来”“这样读”等自然句式，保留解释性质。"
  },
  {
   "id": "F11",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "uncertainty_note 几乎逐句重复 limits.0 和 limits.1，属于凑数的材料说明。",
   "evidence": [],
   "proposed": "压缩为一句：本文只依据《史记·魏公子列传》，对话与情绪描写均为史家记述。"
  }
 ],
