 "issues": [
  {
   "id": "V1",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "中文在转述侯嬴的话时，“无忌”“公子”“他”来回切换。“公子待他厚，公子走而他不送，他由此知道公子会……”一句里，“他”指侯嬴，“公子”指无忌，同一人换了称呼，读者需要停下来分辨。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "然公子遇臣厚，公子往而臣不送，以是知公子恨之復返也"
    }
   ],
   "proposed": "改为“无忌待他厚，无忌走时他却不送，侯嬴由此料到无忌会心怀不满而折回”；后文“公子一开口”改为“无忌一开口”。"
  },
  {
   "id": "V2",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "“作者推断：”在 analysis.0、1、2、3 中各出现一次，analysis.4 又有“作者认为”和“一种解释是”。按第6、8条，推断只需在 analysis 开头集中标一次，反复贴标签读起来像审核痕迹。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "往恐不聽，必當殺之，是以泣耳"
    }
   ],
   "proposed": "保留 analysis.0 开头的“作者推断”。analysis.1、2、3 的标签改成自然句或删去，例如“这样看”。analysis.4 只保留一处“一种解释是”。英文同步处理。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.2",
   "category": "readability",
   "severity": "note",
   "problem": "“这笔债他没有抹掉，军队送回魏国，自己留在赵国”中，后两个分句和“没抹掉债”的关系没有交代。紧接着又说“留赵未必就是认下这笔债”，前后读来像自相矛盾。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "使將將其軍歸魏，而公子獨與客留趙"
    },
    {
     "id": "SJ0771-E32",
     "quote": "公子恐其怒之，乃誡門下"
    }
   ],
   "proposed": "改为“从这些言行看，他没有把这笔债抹掉；至于把军队送回魏国、自己留在赵国，能否算认债，要另看：他留赵十年不归……”。英文同步修改。"
  },
  {
   "id": "V4",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 已说明本文只依据本传，这一段再说兵数取自本传，没有新增会影响判断的限度，属于凑数的局限说明（第8条“宁短勿凑”）。",
   "evidence": [
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "删去 sections.limits.2 的中英文。"
  },
  {
   "id": "V5",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已交代秦围邯郸、姐姐是平原君夫人、晋鄙率十万救赵，context.0 又重复一遍，开头信息有冗余。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏王使將軍晉鄙將十萬眾救趙"
    }
   ],
   "proposed": "context.0 只保留 hook 中没有的内容：长平之后围邯郸，姐姐多次写信求救，促成魏王出兵。删去重复的身份交代。"
  }
 ],
 "overall": "逐字段核对后，事实、引文、归属与时序均有证据支持，没有需要修正的事实问题；仅有五处不影响理解的易读性建议（note），定稿可通过。"
