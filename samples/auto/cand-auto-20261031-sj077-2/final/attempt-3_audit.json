 "issues": [
  {
   "id": "F1",
   "path": "sections.analysis.2",
   "category": "parity",
   "severity": "fix",
   "problem": "中文结论是留赵“未必就是认下这笔债”（承认亏欠）；英文末句写成 need not count as settling the debt，意思变成“还清债务”。这与中文不一致，也与同段 did not write the debt off 的框架不一致。",
   "evidence": [
    {
     "id": "SJ0771-E32",
     "quote": "公子恐其怒之，乃誡門下：「有敢為魏王使通者，死。」"
    }
   ],
   "proposed": "英文末句改为：so staying there need not mean he was owning up to the debt."
  },
  {
   "id": "F2",
   "path": "sections.story.7",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把“自言罪過，以負於魏，無功於趙”写成无忌第一人称的直接引语 \"I have failed Wei and done nothing for Zhao.\"，但原文是史家的间接叙述，不是他的原话。中文只引了逐字片段，没有问题。",
   "evidence": [
    {
     "id": "SJ0771-E31",
     "quote": "自言罪過，以負於魏，無功於趙"
    }
   ],
   "proposed": "英文改为间接转述：and pronounced himself at fault, saying he had failed Wei and done nothing for Zhao."
  },
  {
   "id": "F3",
   "path": "sections.context.5",
   "category": "readability",
   "severity": "note",
   "problem": "侯嬴在集市里拜访的“一位朋友”就是屠户朱亥，但这里没有点明。到 story.3 才写“朱亥是侯嬴早先推荐的屠者”，读者前后对不上。",
   "evidence": [
    {
     "id": "SJ0771-E8",
     "quote": "臣所過屠者朱亥"
    }
   ],
   "proposed": "中文“去拜访一位朋友”改为“去拜访屠户朱亥”；英文 to call on a friend 改为 to call on his friend Zhu Hai, a butcher。"
  },
  {
   "id": "F4",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "中文直接引了「嚄唶宿將」，没有在同段用白话讲明意思（英文已经译出）。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "晉鄙嚄唶宿將"
    }
   ],
   "proposed": "在「嚄唶宿將」后补一句白话，例如“——一位叱咤军中的老将”。"
  },
  {
   "id": "F5",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "analysis 各段反复使用“作者推断：”标签（analysis.0、1、2、3 各一次，analysis.4 又有“作者认为”“一种解释是”），读起来像审核括注。",
   "evidence": [],
   "proposed": "在 analysis 开头标一次“作者推断”，其余段落改用自然句承接。不删去任何推断的限定。"
  },
  {
   "id": "F6",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "limits.2 只是重复 limits.0 的“本文只依据本传”，对读者判断没有新增信息。limits.1 与 uncertainty_note 也大段重复。",
   "evidence": [],
   "proposed": "删去 limits.2；uncertainty_note 保持现状即可，limits.1 可只保留第一句。"
  },
  {
   "id": "F7",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "context.0 至 context.3 把 hook.1 已经讲过的晋鄙十万众、止于邺、百余乘车骑等再讲一遍，开头部分重复较多。",
   "evidence": [],
   "proposed": "可酌情压缩 hook.1 或 context 中重复的兵数与驻邺细节，只保留一处完整叙述。"
  }
 ],
