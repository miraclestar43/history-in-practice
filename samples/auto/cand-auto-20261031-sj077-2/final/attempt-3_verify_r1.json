 "issues": [
  {
   "id": "V1",
   "path": "sections.context.5",
   "category": "facts",
   "severity": "fix",
   "problem": "证据写的是侯嬴故意让公子的车骑在集市里久停（「久立公子車騎市中」），被久久晾着的是无忌的车骑。中文「久久站着」主语含混，英文 standing there a long time 把久立的写成了侯嬴本人。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "故久立公子車騎市中，過客以觀公子"
    }
   ],
   "proposed": "中文改为：「侯嬴又让无忌的车骑在集市里久等，自己去拜访一位朋友，借此观察无忌」。英文改为：\"Hou Ying then kept Wuji's carriage waiting a long time in the marketplace while he called on a friend and watched Wuji\"。"
  },
  {
   "id": "V2",
   "path": "sections.context.5",
   "category": "parity",
   "severity": "fix",
   "problem": "英文比中文多出内容：once the guests were seated，以及侯嬴自陈中的 he was a mere gatekeeper, and the prince had personally come for him before a crowd。英文还把集市久候的经过重复叙述了一遍。中文没有这些。中英不一致。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "嬴乃夷門抱關者也，而公子親枉車騎，自迎嬴於眾人廣坐之中"
    }
   ],
   "proposed": "英文删去自陈部分重复的集市经过，并删去中文没有的半句，改为：\"Hou Ying later spelled out his reasoning: he had wanted to make the prince's name. The townsfolk took Hou Ying for a lout and Wuji for a true elder who can humble himself before scholars.\" 同时删去 once the guests were seated，或在中文相应补「坐定」。"
  },
  {
   "id": "V3",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "英文 King Zhao of Qin 与后文的 the king of Zhao（赵王）字面相近，英语读者容易混成同一人。另外，晋鄙率十万救赵一事在 hook.1 已经交代过，这里又完整重复一遍。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "秦昭王已破趙長平軍，又進兵圍邯鄲"
    }
   ],
   "proposed": "英文改称 \"King Zhaoxiang of Qin\" 或 \"the king of Qin\"。末句可缩为「魏王派出的，就是开头说的晋鄙那支十万大军」，避免整句重复。"
  },
  {
   "id": "V4",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "迎接无忌时写「赵王」，下一段才出现「赵孝成王」，接着又回到「赵王」。context.4 打猎一事里也有一位「赵王」，读者可能分不清这些「赵王」是否同一人。",
   "evidence": [
    {
     "id": "SJ0771-E24",
     "quote": "趙孝成王德公子之矯奪晉鄙兵而存趙"
    }
   ],
   "proposed": "story.6 首次出现时写「赵孝成王」（英文 King Xiaocheng of Zhao），此后统一沿用这一称呼。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "analysis.0 至 analysis.3 每段都以「作者推断」开头或插入，标注重复，违反「集中写、标一次」的要求。此外标题是「三件事」，analysis.1、analysis.2 分别写「第二步」「第三步」，analysis.0 却没有标「第一」。",
   "evidence": [
    {
     "id": "SJ0771-E17",
     "quote": "晉鄙聽，大善；不聽，可使擊之"
    }
   ],
   "proposed": "只在 analysis.0 开头保留一次「作者推断」，并在该段补「第一步」。删去 analysis.1、analysis.2、analysis.3 中重复的「作者推断：」，改用「这说明」「换个角度看」一类自然衔接。英文同步调整。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.3",
   "category": "parity",
   "severity": "fix",
   "problem": "中文「失信于魏王」指无忌背弃了对魏王的信义；英文 losing the trust of his king 指魏王不再信任他。两者含义不同。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "魏王怒公子之盜其兵符，矯殺晉鄙"
    }
   ],
   "proposed": "英文改为 \"at the price of killing his own general and breaking faith with his king\"。"
  },
  {
   "id": "V7",
   "path": "sections.limits.1",
   "category": "readability",
   "severity": "note",
   "problem": "limits.1 与 uncertainty_note 几乎逐句重复（叙述用语、非实录心理）。半句「本文凡涉情绪处都只是转述史家的叙述」近似审核说明，属于凑数。",
   "evidence": [
    {
     "id": "SJ0771-E13",
     "quote": "公子行數里，心不快"
    }
   ],
   "proposed": "删去「本文凡涉情绪处都只是转述史家的叙述」这半句，或整段并入 uncertainty_note，只保留一处。"
  },
  {
   "id": "V8",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "limits.2 只是声明兵数取自本传。limits.0 已说明本文只依据本传，这一段不增加读者需要的信息，属于为凑局限而写。",
   "evidence": [
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "删去 limits.2。"
  }
 ],
 "overall": "引文均逐字可查，史实与因果基本有证据支持；需修正 context.5 久立主语的误读、context.5 和 analysis.3 两处中英不一致，其余为人物称呼和局限段冗余的易读性小问题，开头可读性合格。"
}