 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "readability",
   "severity": "fix",
   "problem": "摘要和开头重复同一套情节。摘要已经写了“十万大军停在边境”“手里没有兵，只有一群门客”，hook.1 又写“无忌手里没有兵，只有百余乘车骑和一群门客”，并再讲一遍十万大军止步。摘要成了开头的预告，没有提出一个问题。",
   "evidence": [
    {
     "id": "SJ0771-E26",
     "quote": "魏王恐，使人止晉鄙，留軍壁鄴"
    },
    {
     "id": "SJ0771-E27",
     "quote": "約車騎百餘乘"
    }
   ],
   "proposed": "摘要改成问题式，例如：zh“救兵被自己的国君叫停在半路，一个手里没有兵的公子还能做什么？”en“When your own king halts the relief army halfway, what can a prince with no troops do?”hook.1 保持不动。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "《史记》中“魏安釐王二十年”交代的是秦军围邯郸、魏王派晋鄙出兵的时间（E9）。无忌出城赴死发生在此后多次请求魏王无果之后，证据没有说出城也在这一年。稿件把年份直接安在出城上。本段的证据也没有列 E9。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏安釐王二十年，秦昭王已破趙長平軍，又進兵圍邯鄲"
    }
   ],
   "proposed": "删去句首“魏安釐王二十年，”（英文同步删去“In the twentieth year of King Anxi of Wei,”）。年份已在 context.0 和 limits 中交代；如需保留，可放到 context.0，写成“魏安釐王二十年，秦昭王……围邯郸”。"
  },
  {
   "id": "V3",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "fix",
   "problem": "“我赵胜”（英文“me, Zhao Sheng”）突然出现一个新名字。读者不知道赵胜就是平原君，会以为是另一个人。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "且公子縱輕勝，棄之降秦，獨不憐公子姊邪"
    }
   ],
   "proposed": "zh 改为“哪怕你看不起我，独不怜公子姊邪”；en 删去“, Zhao Sheng”。"
  },
  {
   "id": "V4",
   "path": "sections.context.5",
   "category": "facts",
   "severity": "fix",
   "problem": "“過客以觀公子”的“過客”是拜访朋友。E8 中侯嬴说“臣所過屠者朱亥”，“过”也是拜访的意思。稿件写成“让过路人都来围观”，属于误译。英文还把这层误读放进引号，当作侯嬴原话（“while people watched”“the more I tried you”）；中文是转述，没有引号，中英不一致。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "故久立公子車騎市中，過客以觀公子，公子愈恭"
    },
    {
     "id": "SJ0771-E8",
     "quote": "臣所過屠者朱亥"
    }
   ],
   "proposed": "zh 改为“侯嬴又让车骑停在集市里，故意去拜访一位朋友，久久站着，借此观察无忌”。英文同步改：叙述部分写“kept Wuji's carriage waiting in the market while he went to call on a friend, watching Wuji”；侯嬴自陈部分去掉引号，改为转述，删去“while people watched”。"
  },
  {
   "id": "V5",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "fix",
   "problem": "关键转折缺失。hook 停在“回来问侯嬴”，story 直接跳到献计。侯嬴回来时的回答在正文里没有出现，读者看不出为什么无忌放弃赴死，转而听计。这个回答是“以肉投餒虎”，以及他料定公子会因没被送行而折返。这句话只在 analysis.0 出现。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "譬若以肉投餒虎，何功之有哉？尚安事客？然公子遇臣厚，公子往而臣不送，以是知公子恨之復返也"
    }
   ],
   "proposed": "在 story.0 句首补一句白话：zh“侯嬴说，带门客去冲秦军，就像拿肉投给饿虎，毫无用处；他故意不送，就料定公子会心有不平而折回。接着他献上一个计策。”英文同步补写。不另加对白或场面。"
  },
  {
   "id": "V6",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "中文引了「嚄唶宿將」，却没有白话解释；「是以泣耳，豈畏死哉」也没有说明它在对话中的作用（他在解释自己为何流泪）。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "晉鄙嚄唶宿將，往恐不聽，必當殺之，是以泣耳，豈畏死哉"
    }
   ],
   "proposed": "在引语后补白话：“嚄唶宿將”即“威风凛凛的老将”；“是以泣耳，豈畏死哉”即“我是为这个哭，哪里是怕死”，用来解释自己流泪的原因。"
  },
  {
   "id": "V7",
   "path": "sections.analysis.2",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "英文首句“he kept the books honestly after it worked”把推断写成定论，与中文中性的“第三步是事成之后怎么记账”不一致。这句话也和段末“need not count as settling the debt”的保留相矛盾。",
   "evidence": [
    {
     "id": "SJ0771-E32",
     "quote": "公子恐其怒之，乃誡門下：「有敢為魏王使通者，死。」"
    }
   ],
   "proposed": "en 首句改为“Third, how he kept the books after it worked.”"
  },
  {
   "id": "V8",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "analysis 的 0、1、2、3 段反复用“作者推断：”开头，第 4 段又用“作者认为”和“一种解释是”。标签重复，读起来像审核标注。",
   "evidence": [],
   "proposed": "只在 analysis.0 标一次“作者推断”，其余段改用自然的衔接句。"
  },
  {
   "id": "V9",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "“八万人之数出自本传”属于凑数的局限说明。limits.0 已写明本文只依据本传，这句信息重复。",
   "evidence": [
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "删去首句，只保留纪年说明，或将纪年说明并入 uncertainty_note。"
  },
  {
   "id": "V10",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "story.6 先写“赵王”，story.7 才出现“赵孝成王”，读者可能以为是两个人。",
   "evidence": [
    {
     "id": "SJ0771-E24",
     "quote": "趙孝成王德公子之矯奪晉鄙兵而存趙"
    }
   ],
   "proposed": "在 story.6 第一次出现时写“赵孝成王”，此后统一称“赵王”。"
  }
 ],
 "overall": "定稿大部分有证据支持。需要修改的是：侯嬴“過客”的误译和英文伪引（facts/fix）、出城年份的错位（chronology/fix）、英文推断写成定论（fix），以及摘要与开头重复、“赵胜”指代不清、正文缺少侯嬴折返时那句关键回答这三处易读性问题（fix）。改完后可以发稿。"
}