 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.2",
   "category": "parity",
   "severity": "fix",
   "problem": "中文结论是留赵「未必就是认下这笔债」（承认亏欠）。英文写成 need not count as settling the debt，意思变成“还清这笔债”，与中文不一致；也与同段 did not write the debt off 的“承认／不抹掉”框架不一致。",
   "evidence": [
    {
     "id": "SJ0771-E32",
     "quote": "公子恐其怒之，乃誡門下：「有敢為魏王使通者，死。」"
    }
   ],
   "proposed": "英文末句改为：so staying there need not mean he was owning up to the debt."
  },
  {
   "id": "V2",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "「嚄唶宿將」「是以泣耳，豈畏死哉」两处原句，中文没有在同段用白话讲清意思。读者不易明白：无忌是在说明自己流泪的原因，并否认自己怕死。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "晉鄙嚄唶宿將，往恐不聽，必當殺之，是以泣耳，豈畏死哉"
    }
   ],
   "proposed": "在引语后补白话：晋鄙是一员声威很盛的老将；无忌说，自己是为不得不杀他而哭，不是怕死。"
  },
  {
   "id": "V3",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "「此五霸之伐也」没有白话释义，读者不明白侯嬴用它来说明这个计策的分量。",
   "evidence": [
    {
     "id": "SJ0771-E15",
     "quote": "北救趙而西卻秦，此五霸之伐也"
    }
   ],
   "proposed": "句后补：这是可以比肩春秋五霸的功业。"
  },
  {
   "id": "V4",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "story.6 称「赵王」，story.7 改称「赵孝成王」，随后又回到「赵王」。context.4 里打猎的「赵王」也用同一叫法，读者可能以为是几个人，或混淆为同一人。",
   "evidence": [
    {
     "id": "SJ0771-E24",
     "quote": "趙孝成王德公子之矯奪晉鄙兵而存趙"
    }
   ],
   "proposed": "在 story.6 首次出场时写「赵孝成王」，此后统一称「赵王」；story.7 开头改为「赵王」。英文同步处理。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "analysis.0 到 analysis.3 每段都以「作者推断：」开头，analysis.4 又用「作者认为」「一种解释是」，标签反复出现，读起来像审核标注。",
   "evidence": [],
   "proposed": "只在 analysis.0 开头标一次「作者推断」，其后各段删去重复标签，用自然句式衔接；英文同步。"
  },
  {
   "id": "V6",
   "path": "sections.context.5",
   "category": "readability",
   "severity": "note",
   "problem": "英文段把集市久候、观察无忌的情节讲了两遍：先作为叙述，又在侯嬴自述里重复。英文还比中文多出“自己只是守门人、公子当众亲迎”一句。段落冗长，中英详略不一。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "故久立公子車騎市中，過客以觀公子，公子愈恭"
    }
   ],
   "proposed": "英文侯嬴自述部分压缩为：Hou Ying later explained that he had done it to make the prince's name; the townsfolk took Hou Ying for a lout and Wuji for a true elder who could humble himself before scholars."
  },
  {
   "id": "V7",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已交代秦围邯郸、晋鄙十万、驻邺观望、姐姐是平原君夫人；context.0 和 context.1 又重复其中一部分，信息有所重叠。",
   "evidence": [],
   "proposed": "context.0 删去「无忌的姐姐是平原君夫人」的重复说明，只保留「她几次写信给魏王和无忌求救」，例如写作「无忌的姐姐几次写信……」。"
  },
  {
   "id": "V8",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 已说明本文只依据本传，limits.2 只是重复兵数出处，没有提供新的限定。limits.1 与 uncertainty_note 也几乎逐句重复。属于凑出来的局限说明。",
   "evidence": [],
   "proposed": "删去 limits.2；limits.1 可并入 limits.0，或与 uncertainty_note 只保留一处。"
  }
 ],
 "overall": "事实、引文、归属与时序均有证据支持，只有 analysis.2 英文一处 parity 需修正；其余为不影响理解的易读性建议，修正 V1 后可发。"
}