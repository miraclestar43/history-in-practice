 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "中文只写“回来问侯嬴”，英文多出“whether he had failed him in some way”，中英不一致。英文这里的 he/him 也指代不清，读者难以判断是谁辜负了谁。证据只写无忌自问“我豈有所失哉”后“問侯生”。",
   "evidence": [
    {
     "id": "SJ0771-E13",
     "quote": "我豈有所失哉？復引車還，問侯生"
    }
   ],
   "proposed": "英文改为“he turned the chariots around and came back to question Hou Ying.” 如需保留问的内容，中英同步写成“回来问侯嬴，自己是否有什么过失”，英文写“whether Wuji himself had done something wrong”。"
  },
  {
   "id": "V2",
   "path": "sections.analysis.4",
   "category": "causality",
   "severity": "fix",
   "problem": "“代价也没有就此结束”把无忌留赵十年、被毁谤夺兵、病酒而死，以及魏国后来的覆亡，直接写成救赵的“代价”，以事实语气给出了因果定论。证据只显示秦国收买的是晋鄙的门客，并未说这些后果由救赵造成。这句不在“作者认为”“一种解释是”的范围内。",
   "evidence": [
    {
     "id": "SJ0771-E33",
     "quote": "乃行金萬斤於魏，求晉鄙客，令毀公子於魏王"
    },
    {
     "id": "SJ0771-E35",
     "quote": "秦聞公子死，使蒙驁攻魏，拔二十城"
    }
   ],
   "proposed": "把“代价也没有就此结束：”改为“后来的事也与这次救赵相连：”（英文 “And the costs did not stop there.” 改为 “What followed was tied to this rescue as well.”）。因果判断留给段末“一种解释是”。"
  },
  {
   "id": "V3",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已经交代了秦围邯郸、无忌的姐姐是平原君夫人、魏王派晋鄙率十万救赵。context.0 又把这几件事完整复述一遍，开头与背景在信息上重复。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏王使將軍晉鄙將十萬眾救趙"
    }
   ],
   "proposed": "context.0 只保留 hook 没有讲的部分，即长平之战后围城、姐姐几次写信求救。晋鄙、十万这两项改为承接语，如“魏王这才派出了前面说的那支救兵”。"
  },
  {
   "id": "V4",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "“兵数取自本传的记述”与 limits.0 的“本文只依据《史记·魏公子列传》”重复，不提供新的限定，属于为凑局限而写的条目。",
   "evidence": [
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "删去本段（中英同删）。"
  },
  {
   "id": "V5",
   "path": "sections.limits.1",
   "category": "readability",
   "severity": "note",
   "problem": "本段与 uncertainty_note 几乎逐句重复。“本文凡涉情绪处都只是转述史家的叙述”读起来像审核说明，不太像给读者的限定。",
   "evidence": [
    {
     "id": "SJ0771-E24",
     "quote": "公子聞之，意驕矜而有自功之色"
    }
   ],
   "proposed": "删去后半句“本文凡涉情绪处都只是转述史家的叙述”（英文同删 “wherever emotion enters…relayed”），或整段并入 uncertainty_note。"
  }
 ],
 "overall": "引文、人名、数字与证据基本吻合，需要修正两处：hook.0 英文多出的内容和指代，以及 analysis.4 中写成定论的“代价”因果；其余是可选的易读性精简。"
}