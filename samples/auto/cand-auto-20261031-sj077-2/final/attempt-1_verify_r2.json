 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "英文开头写的是 Prince Wuji 和 Daliang，但没有说明他是哪国的公子，也没有说大梁是魏国都城。英文读者读完开头分不清他属于魏国还是赵国。中文写的是“魏公子无忌”，英文缺了这一层，中英也不一致。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "為大梁夷門監者"
    }
   ],
   "proposed": "en 改为：Prince Wuji of Wei rode out of Daliang, the Wei capital, with a hundred-odd chariots and horsemen…"
  },
  {
   "id": "V2",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "英文首次出现 King Anxi 时没有说明他是魏王、是无忌自己的国君。正文后面又在 the King of Wei、King Anxi、the king 之间来回换叫法，读者难以确认是同一个人，也看不出这里的难处是“自己的国君叫停了救兵”。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏安釐王二十年"
    },
    {
     "id": "SJ0771-E26",
     "quote": "魏王恐，使人止晉鄙"
    }
   ],
   "proposed": "en 改为：King Anxi of Wei, Wuji's own king, had already sent General Jin Pi…；后文统一用 the king of Wei（或统一用 King Anxi）。"
  },
  {
   "id": "V3",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "“无忌的姐姐是平原君夫人”在 hook.1 已经交代过，这里又重复一次。英文此处用 the King of Wei，与 hook.1 的 King Anxi 称谓不统一。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "公子姊為趙惠文王弟平原君夫人，數遺魏王及公子書"
    }
   ],
   "proposed": "中文改为“她几次写信给魏王和无忌求救”，省去重复的身份交代；英文统一魏王的称谓。"
  },
  {
   "id": "V4",
   "path": "sections.context.5",
   "category": "readability",
   "severity": "note",
   "problem": "英文把集市停车、久立观察这一段写了两遍：一次作为叙事，一次在侯嬴自陈时复述，读起来冗长。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "故久立公子車騎市中，過客以觀公子，公子愈恭"
    }
   ],
   "proposed": "en 侯嬴自陈部分只保留动机：He had wanted to make the prince's name; the townsfolk took Hou Ying for a lout and Wuji for a true elder who can humble himself before scholars. 删去对停车观察的复述。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.3",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“拖下去的代价由城里的人承担”是作者的推断，证据只有平原君使者说邯郸旦暮降秦。这句却写在“作者推断”标签之前，读起来像史实陈述。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "今邯鄲旦暮降秦而魏救不至"
    }
   ],
   "proposed": "把“作者推断：”移到“但平原君……”一句之后，紧接在“拖下去的代价……”之前；英文同样把 On this reading 前移到 the price of holding back 之前。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.4",
   "category": "readability",
   "severity": "note",
   "problem": "analysis 每段都用“作者推断：”开头，本段又同时用了“作者认为”和“一种解释是”，与“标一次、不反复括注”的要求不符。",
   "evidence": [
    {
     "id": "SJ0771-E37",
     "quote": "名冠諸侯，不虛耳"
    }
   ],
   "proposed": "在 analysis.0 开头标一次“作者推断”；其余各段改用“这样看”“一种解释是”等自然句式，本段只保留其中一个标签。"
  },
  {
   "id": "V7",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件说“纪年只用原文的魏安釐王二十年”，但正文任何段落都没有使用这个年份，这是对本文内容的不实描述。“八万之数出自本传”也是凑数的局限说明，读者理解不需要。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏安釐王二十年"
    },
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "删去整段（中英同删）。"
  },
  {
   "id": "V8",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "“纪年只用原文，不换算公元”针对的是正文并未出现的年份，属于凑数说明；其余内容与 limits.0、limits.1 完全重复。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏安釐王二十年"
    }
   ],
   "proposed": "删去“纪年只用原文，不换算公元”这半句（英文同删）。"
  },
  {
   "id": "V9",
   "path": "reflection.example.steps",
   "category": "facts",
   "severity": "fix",
   "problem": "中文写“主动认下对自己这方的亏欠”，括注却是“门客劝后无忌自责”。证据显示无忌起初有自功之色，是门客进言后才自责，“主动”与记载不符。英文版没有“主动”，中英也不一致。",
   "evidence": [
    {
     "id": "SJ0771-E24",
     "quote": "公子聞之，意驕矜而有自功之色。客有說公子曰"
    },
    {
     "id": "SJ0771-E24",
     "quote": "於是公子立自責"
    }
   ],
   "proposed": "删去“主动”，改为：三、事成之后认下对自己这方的亏欠，不把功劳记在自己账上（门客劝后无忌自责）。"
  }
 ],
 "overall": "引文和史实总体与证据相符，没有关于来源未载的断言。需要修改的是：英文开头补出魏国身份与魏王称谓，analysis.3 的推断标签前移，limits.2 的不实纪年说明删去，steps 删去与记载不符的“主动”。其余为文风层面的建议。"
}