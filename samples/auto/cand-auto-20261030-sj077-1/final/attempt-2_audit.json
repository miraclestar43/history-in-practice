 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "中文写“赶到大梁”，英文写“arrived in Daliang”。证据只说使者往来于魏，没有写到大梁。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "平原君使者冠蓋相屬於魏"
    }
   ],
   "proposed": "中文改为“赶到魏国”，英文改为“arrived in Wei”。"
  },
  {
   "id": "F2",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "中文“在大梁把话说绝”、英文“in Daliang”，地点比证据具体。证据只写“於魏”。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "平原君使者冠蓋相屬於魏"
    }
   ],
   "proposed": "中文改为“在魏国把话说绝”，英文改为“in Wei”。"
  },
  {
   "id": "F3",
   "path": "sections.analysis.2",
   "category": "chronology",
   "severity": "fix",
   "problem": "末句把“赵王、平原君边界亲迎在前，门客劝谏、公子自责在后”写成确定的先后。证据没有交代这两件事的时间顺序，只是叙述上相邻。同一段括注已经承认原文未交代先后，这里又写成定序，前后矛盾。",
   "evidence": [
    {
     "id": "SJ0771-E23",
     "quote": "趙王及平原君自迎公子於界"
    },
    {
     "id": "SJ0771-E24",
     "quote": "於是公子立自責"
    }
   ],
   "proposed": "删去“赵王、平原君边界亲迎在前，门客劝谏、公子自责在后”一句；中英两版同步删除。如需保留，改为“原文叙述顺序是先记亲迎、后记劝谏”。"
  },
  {
   "id": "F4",
   "path": "sections.story.8",
   "category": "parity",
   "severity": "fix",
   "problem": "英文写“sent the generals back”（复数）。原文是派一名将领带军归魏，中文“将领”的数也不明确。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "使將將其軍歸魏"
    }
   ],
   "proposed": "英文改为“had a general lead the army back to Wei”。"
  },
  {
   "id": "F5",
   "path": "sections.today.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "现代场景“决策层因为怕更大的对手压着不动；你手里有一线证据，也有一个能干的人”几乎照搬已知污染K7。K7这一类比依赖已剔除的E10（魏王畏秦、止晋鄙）和E12（公子请王不得）。现存证据并没有写魏王因惧秦而按兵不动，这个类比暗中把被剔除的史实带回了正文。",
   "evidence": [],
   "proposed": "把前提改为不对应史实的中性说法，例如“决策层迟迟不动”，删去“因为怕更大的对手”。英文同步改为“the people with authority will not move”。"
  }
 ],
 "inherited": [
  {
   "id": "P1",
   "verdict": "valid",
   "same_as": "",
   "rationale": "原文中“能急人之困”是平原君说明自己与公子结为婚姻的理由，即平原君对公子的看重与期许，不是公子的自我标榜。中文“自命”、英文“prided himself”属于归属错误。修改建议可采纳。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "勝所以自附為婚姻者，以公子之高義，為能急人之困"
    }
   ]
  }
 ]
