 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "中文“秦王随即遣使警告魏王”中的“随即”表示紧接着发生。证据只记秦王遣使，没有任何时间衔接词。英文用的是 then，只表示先后，两版轻重不一致。",
   "evidence": [
    {
     "id": "SJ0771-E26",
     "quote": "秦王使使者告魏王曰"
    }
   ],
   "proposed": "把“随即”改为“此后”，或直接删去“随即”。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头先讲姻亲关系，再连续给出纪年、长平之战、十万众、驻邺，“难处在于”一句放在长段末尾。公子本人的处境（有三千门客而无国政）要到 hook.1 才交代。读者能大致说清问题，但抓住重点较慢。",
   "evidence": [],
   "proposed": "把“难处在于：救兵听命于魏王，而魏王畏秦，按兵不动”提到段首或紧跟姻亲句之后。长平、十万等细节可后移，不删任何事实。"
  },
  {
   "id": "F3",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已声明“侯嬴（下称侯生）”，但 context.2“侯嬴年七十”、limits.0“侯嬴献窃符之计”又改回全名，同一人的称呼来回切换。",
   "evidence": [],
   "proposed": "中文正文统一用“侯生”（原文引语中的“嬴”保留不动）。英文已统一为 Hou Ying，不需修改。"
  },
  {
   "id": "F4",
   "path": "sections.story.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "兵符在王卧内、如姬父被杀两条，侯生原话都以“嬴聞”起头，是转述的听闻。稿件写成“他说，晋鄙的兵符常在……”，英文更是直接作为事实陈述，丢失了“听说”这一限定。",
   "evidence": [
    {
     "id": "SJ0771-E15",
     "quote": "嬴聞晉鄙之兵符常在王臥內"
    },
    {
     "id": "SJ0771-E15",
     "quote": "嬴聞如姬父為人所殺"
    }
   ],
   "proposed": "中文改为“他说，他听闻晋鄙的兵符常在魏王卧内……又听闻如姬的父亲被人所杀……”。英文改为 \"Hou Ying said he had heard that Jin Bi's tally... and had heard that her father had been murdered...\"。"
  },
  {
   "id": "F5",
   "path": "sections.story.8",
   "category": "chronology",
   "severity": "fix",
   "problem": "“在原文的叙述里，下面这件事排在赵王议封五城之前”这一叙事次序，证据包无法确认。证据只显示留赵紧接在魏王之怒之后；E31 写在五城一幕之后的“公子竟留趙”反而让次序显得不明。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "公子亦自知也。已卻秦存趙，使將將其軍歸魏，而公子獨與客留趙"
    },
    {
     "id": "SJ0771-E31",
     "quote": "公子竟留趙"
    }
   ],
   "proposed": "删去“排在赵王议封五城之前”的说法，改为“原文紧接着记：退秦存赵之后……”。英文相应删去 \"comes before the king of Zhao's discussion of the five cities\"。"
  },
  {
   "id": "F6",
   "path": "sections.analysis.2",
   "category": "chronology",
   "severity": "fix",
   "problem": "“原文叙在五城之议之前”同 F5，证据包不能确认；后半句“紧接在魏王之怒与「公子亦自知也」之后”有据。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "魏王怒公子之盜其兵符，矯殺晉鄙，公子亦自知也"
    }
   ],
   "proposed": "中文删去“叙在五城之议之前”，只保留“原文把留赵紧接在魏王之怒与「公子亦自知也」之后”。英文同步删去 \"before the five-city offer\"。"
  },
  {
   "id": "F7",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "全篇讲“付代价、认亏欠”，叙事却停在魏王授上将军印，读者会以为结局圆满。证据记有后续：秦王行金收买“晉鄙客”毁谤公子，魏王改派他人代将，公子谢病长饮四年，病酒而卒。这一结局直接关系到对矫杀晋鄙代价的判断。秦国专门寻找晋鄙门客一事与此前杀晋鄙之间的关联，证据未明说，只能作为解释写出。",
   "evidence": [
    {
     "id": "SJ0771-E33",
     "quote": "乃行金萬斤於魏，求晉鄙客，令毀公子於魏王"
    },
    {
     "id": "SJ0771-E33",
     "quote": "後果使人代公子將"
    },
    {
     "id": "SJ0771-E33",
     "quote": "竟病酒而卒"
    }
   ],
   "proposed": "在授上将军印之后补一两句：秦王行金万斤，求晋鄙客毁谤公子；魏王日闻其毁，后使人代公子将；公子谢病不朝，长夜饮四年，竟病酒而卒。若要把这与矫杀晋鄙联系起来，须写成“一种解释是……”。英文同步补齐。"
  },
  {
   "id": "F8",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“原文未写他事前是否权衡”与证据不符。公子出发前那句答话本身就记录了他事先的估计：晋鄙恐不听，必当杀之。至于盗符、惹魏王怒等其他代价，原文确实没有记他事前权衡过。现写法把两者混为一谈，会误导读者。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "往恐不聽，必當殺之"
    }
   ],
   "proposed": "中文改为：“原文记他事前已料到晋鄙恐不听、必当杀之；至于盗符、惹魏王怒等其他代价，原文没有写他事前是否掂量过。”英文同步修改；也可整句删去。"
  },
  {
   "id": "F9",
   "path": "sections.limits.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“无旁证可对 / with no corroboration to set against it”断言其他记载中不存在旁证，超出证据包所能支持的范围。证据包只说明本文用的是这一篇。",
   "evidence": [],
   "proposed": "中文改为“本文只依据并核对了《史记·魏公子列传》一篇，未与其他记载对照”。英文改为 \"This piece relies on, and was checked against, this one chapter only, without comparison to other accounts.\""
  },
  {
   "id": "F10",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“只此一处，无旁证 / appears here alone, with no corroboration”断言旁证不存在，无法核实。",
   "evidence": [
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "中文改为“「得選兵八萬人」在本篇只出现一次，本文未与其他记载对照”。英文同步修改。"
  },
  {
   "id": "F11",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“侯生自刭的缘由，原文只记他自言「以送公子」，没有更多交代”沿用了已知污染 K6 的说法（K6 依据已剔除的证据）。证据包内其实另有相关话语：侯生说过“老臣不能從”，也说过公子出行而自己不送。“没有更多交代”与证据不符。",
   "evidence": [
    {
     "id": "SJ0771-E13",
     "quote": "老臣不能從"
    },
    {
     "id": "SJ0771-E14",
     "quote": "公子往而臣不送"
    },
    {
     "id": "SJ0771-E20",
     "quote": "北鄉自剄，以送公子"
    }
   ],
   "proposed": "中文改为：“侯生自刭，原文记他此前说过「老臣不能從」，又自言「北鄉自剄，以送公子」；除此之外的动机，本文不作推测。”不要写“原文没有更多交代”。英文同步修改。"
  },
  {
   "id": "F12",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“只有一个史源 / rests on a single historical source”和“仅此一处、无旁证 / with no corroboration”断言其他记载不存在，问题同 F9、F10。",
   "evidence": [
    {
     "id": "SJ0771-E22",
     "quote": "得選兵八萬人"
    }
   ],
   "proposed": "中文改为“本篇只依据并核对了《史记·魏公子列传》一篇，未与他书对照……「得選兵八萬人」在本篇只出现一次”。英文同步修改。"
  },
  {
   "id": "F13",
   "path": "sections.story.4",
   "category": "style",
   "severity": "note",
   "problem": "英文先已译述公子的答话，紧接着又用 \"By his own account, he wept over having to kill Jin Bi...\" 重复一遍。中文只说了一次。",
   "evidence": [],
   "proposed": "英文删去重复句，或把它并入前句。"
  },
  {
   "id": "F14",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "中文先写“公子必会「恨之復返」”，又写“他自己说：「以是知公子恨之復返也」”，同一意思说了两遍，前一处还写成了预言口吻。",
   "evidence": [],
   "proposed": "只保留后一句，即“他说：公子待他厚，此去而他不相送，「以是知公子恨之復返也」”。"
  },
  {
   "id": "F15",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "标题是“三处不体面的地方”，analysis.1 和 analysis.2 分别标了“第二处”“第三处”，analysis.0 却没有标“第一处”，读者难以对应。",
   "evidence": [],
   "proposed": "中文段首加“第一处是……”，英文加 \"The first...\"。"
  },
  {
   "id": "F16",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "本段几乎逐句重复 hook.1 的“数请魏王、宾客辩士劝说、自度终不能得之于王、决意赴死”。",
   "evidence": [],
   "proposed": "压缩为一句承接语，或删去与 hook.1 重复的部分。"
  }
 ],
