 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "主角在段中才以“这位魏国公子/this prince of Wei”出现。他前面已经堆了魏安釐王、秦王、晋鄙、平原君、赵惠文王等名字和年份。主角是谁、为什么平原君的使者冲着他来，要到段末“公子的姐姐正是平原君夫人”才交代。不了解背景的读者读完开头，说不清是谁遇到了问题。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "公子姊為趙惠文王弟平原君夫人，數遺魏王及公子書，請救於魏"
    }
   ],
   "proposed": "开头先立主角：“魏国公子（下称公子）的姐姐是赵国平原君夫人。”再写秦围邯郸、魏王遣晋鄙又令其停军于邺，最后写使者责让公子。不删任何事实，只调整顺序；英文同步调整。"
  },
  {
   "id": "F2",
   "path": "sections.context.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "「過客以觀公子」中的“過”是拜访之意：侯生借拜访其客，自己观察公子。稿件写成“让过客（路人）围观”，英文作 so that passers-by could watch，把观察者从侯生错成了路人。同一用法见「臣所過屠者朱亥」。市人如何看待二人是另一句，不能混为一谈。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "故久立公子車騎市中，過客以觀公子，公子愈恭"
    },
    {
     "id": "SJ0771-E8",
     "quote": "臣所過屠者朱亥"
    }
   ],
   "proposed": "中文改为：“他故意让公子的车骑久立市中，自己去拜访他的客人，借此观察公子，公子愈恭，于是……”。英文改为：“He had deliberately kept the prince's carriage standing in the marketplace while he called on an acquaintance, so as to watch the prince: the longer the prince waited, the more deferential he became — and so…”"
  },
  {
   "id": "F3",
   "path": "sections.story.4",
   "category": "attribution",
   "severity": "fix",
   "problem": "“哭的是非杀本国老将不可，不是怕死”和英文 “What he cried for was the killing… not the risk to himself” 用叙述者口吻把公子自述的哭因写成了定论。证据只有他本人的答话。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "是以泣耳，豈畏死哉"
    }
   ],
   "proposed": "改为“——照他自己的说法，哭的是非杀晋鄙不可，不是怕死”。英文改为 “By his own account, he wept over having to kill Jin Bi, not out of fear for himself.”"
  },
  {
   "id": "F4",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已声明“下称侯生”，本段又改回“侯嬴年七十”，随后引语里还有自称“嬴”，中文读者容易以为是两个人。英文一律用 Hou Ying，两种语言的称呼不对应。",
   "evidence": [],
   "proposed": "中文统一称“侯生”，首次可写“侯生（侯嬴）”。context.3 引语中的“嬴”可加注“侯生自称”。"
  },
  {
   "id": "F5",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "story.7 已写到辞让五城、赵王终未献城，本段再回头写魏王之怒与留赵，并说明此事在原文中排在五城之议之前。倒叙使读者难以理清先后。",
   "evidence": [],
   "proposed": "把本段调到 story.7 之前，或在段首明确标出“回到退秦之后”。保留“原文叙在五城之议之前”的说明。"
  }
 ],
