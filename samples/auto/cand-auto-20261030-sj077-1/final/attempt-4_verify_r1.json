 "issues": [
  {
   "id": "V1",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "fix",
   "problem": "开头唯一点名的赵国国君是 hook.0 括注里的赵惠文王。story.6 只写“赵王”，story.7 才首次出现“赵孝成王”。读者容易把 story.6 的赵王当成赵惠文王，或把赵王和赵孝成王当成两个人。",
   "evidence": [
    {
     "id": "SJ0771-E23",
     "quote": "趙王及平原君自迎公子於界"
    },
    {
     "id": "SJ0771-E24",
     "quote": "趙孝成王德公子之矯奪晉鄙兵而存趙"
    }
   ],
   "proposed": "story.6 首次出现时写“赵孝成王与平原君亲到边界迎接”（en: King Xiaocheng of Zhao and Lord Pingyuan），之后统一简称“赵王”。"
  },
  {
   "id": "V2",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "中文版只写“如姬最幸”，没有说明她是谁宠爱的人；英文版已注明 the king's favorite。中文版又先写“兵符”后写“虎符”，没有说明两者是同一物，英文版已说明。",
   "evidence": [
    {
     "id": "SJ0771-E15",
     "quote": "而如姬最幸，出入王臥內"
    }
   ],
   "proposed": "中文改为“魏王最宠爱的如姬出入卧内”。首次出现“虎符”时加“（即晋鄙的兵符）”。"
  },
  {
   "id": "V3",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已约定“侯嬴（下称侯生）”，context.2 又改用“侯嬴年七十”，随后再回到“侯生”，称呼来回切换。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "魏有隱士曰侯嬴，年七十"
    }
   ],
   "proposed": "改为“侯生年七十，家贫……”，全文中文统一用“侯生”（引文内的“嬴”保留原样）。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "小标题是“三处不体面的地方”，analysis.1 和 analysis.2 分别标了“第二处”“第三处”，但 analysis.0 没有标“第一处”，读者难以对应。",
   "evidence": [],
   "proposed": "在 analysis.0 开头点明“第一处是两条路都不干净”（en: The first undignified spot …）。"
  },
  {
   "id": "V5",
   "path": "sections.story.0",
   "category": "style",
   "severity": "note",
   "problem": "本段与 hook.0、hook.1 几乎逐句重复：使者责让、多次请王、宾客劝说、决意赴死都已写过。",
   "evidence": [
    {
     "id": "SJ0771-E27",
     "quote": "公子自度終不能得之於王"
    }
   ],
   "proposed": "压缩为一句承接，例如“劝王无果，公子决意赴秦军而死”，或与 story.1 合并。"
  },
  {
   "id": "V6",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "中文先写“公子必会「恨之復返」”，紧接着又写“他自己说：「以是知公子恨之復返也」”，同一意思说了两遍。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "以是知公子恨之復返也"
    }
   ],
   "proposed": "删去“公子必会「恨之復返」。他自己说：”，只保留“他还说，公子待他厚，此去而他不相送，「以是知公子恨之復返也」”。"
  },
  {
   "id": "V7",
   "path": "sections.story.4",
   "category": "style",
   "severity": "note",
   "problem": "英文版先写 \"that was why he wept, not because he feared death.\"，紧接着又写 \"By his own account, he wept over having to kill Jin Bi, not out of fear for himself.\"，两句意思重复。",
   "evidence": [
    {
     "id": "SJ0771-E18",
     "quote": "是以泣耳，豈畏死哉"
    }
   ],
   "proposed": "英文删去其中一句，或把后一句缩为 \"— by his own account.\"。"
  },
  {
   "id": "V8",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "留赵一事在原文里排在五城之议之前，正文却放在 story.7（辞让五城）之后，只能靠“在原文的叙述里……排在之前”这句插注来说明，读者容易弄乱先后。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "而公子獨與客留趙"
    }
   ],
   "proposed": "把 story.8 移到 story.7 之前，按原文顺序叙述，并删去这句顺序插注。"
  }
 ],
 "overall": "定稿的史实、引文、署名与解释标注均有证据支持，未发现事实性错误。需修改一处易读性问题：story.6 的赵王身份不清，应写明赵孝成王。其余均为文风与易读性方面的小建议。"
}