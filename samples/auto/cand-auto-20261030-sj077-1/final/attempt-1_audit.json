 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "unsupported",
   "severity": "block",
   "problem": "「大军未至（据简报转述）」/'the army never reached the city' 沿用已剔除的 E10（K2：魏王止晋鄙、留军观望）。证据里只有平原君使者责问时说的「魏救不至」。这是使者的说法，正文却当成叙述事实来写。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "今邯鄲旦暮降秦而魏救不至"
    }
   ],
   "proposed": "改为'平原君的使者责问魏救不至'（英文同步改为 Lord Pingyuan's envoys complained that Wei's relief had not come），删除'据简报转述'。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "unsupported",
   "severity": "block",
   "problem": "括注「留驻不进一节据简报转述」和英文 'the halt of the relief army is retold from the briefing' 都用了已剔除的 E10（K2）。英文还把'援军停驻'当成事实写出。紧接其后的 'Instead' 也以这一说法为前提。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "魏王使將軍晉鄙將十萬眾救趙"
    }
   ],
   "proposed": "中英文都删去括注；英文删去 'Instead'。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "「话一句比一句重」/'each message harsher than the last' 写的是语气逐次升级，证据只记使者冠盖相属、责让之辞，没有逐次加重的记载。（使者到大梁一节可由侯嬴为大梁夷门监者、公子过夷门推知，不算问题。）",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "平原君使者冠蓋相屬於魏，讓魏公子曰"
    }
   ],
   "proposed": "改为'使者冠盖相属，责让公子'（英文同步），删去'一句比一句重'。"
  },
  {
   "id": "F4",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "中文的「公子无忌」和英文通篇的 'Lord Xinling' 都超出证据包。证据只称「魏公子」「公子」。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "讓魏公子曰"
    }
   ],
   "proposed": "改称'魏公子'/'the Wei prince (the lord)'；或明确注明人名封号出自证据包以外。"
  },
  {
   "id": "F5",
   "path": "sections.hook.1",
   "category": "unsupported",
   "severity": "block",
   "problem": "「魏王未再发兵、使人止晋鄙（据简报转述）」出自已剔除的 E10（K2），却写进了 record 段。英文同。",
   "evidence": [],
   "proposed": "删去这一句，只保留公子有门客、未得任以国政，以及决意赴秦军而死。"
  },
  {
   "id": "F6",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "「公子无忌」的名字不在证据中。",
   "evidence": [
    {
     "id": "SJ0771-E2",
     "quote": "公子為人仁而下士"
    }
   ],
   "proposed": "改为'魏公子'。"
  },
  {
   "id": "F7",
   "path": "sections.context.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文用引号引的是译文，没有标明是译述，读来像原文。",
   "evidence": [
    {
     "id": "SJ0771-E2",
     "quote": "士無賢不肖皆謙而禮交之"
    }
   ],
   "proposed": "在引语前加 'in translation' 或 'as the passage may be rendered'。"
  },
  {
   "id": "F8",
   "path": "sections.context.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "中文有「一种解释是」，英文 'Read the episode both ways' 没有解释标签，两种语言不一致。",
   "evidence": [],
   "proposed": "改为 'One reading is that the episode cuts both ways.'"
  },
  {
   "id": "F9",
   "path": "sections.context.1",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文引号里是译文，没有标明是译述。",
   "evidence": [
    {
     "id": "SJ0771-E3",
     "quote": "是後魏王畏公子之賢能，不敢任公子以國政"
    }
   ],
   "proposed": "标明是译文。"
  },
  {
   "id": "F10",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "英文 'the eastern gate of Daliang' 中的方位'东门'证据没有。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "為大梁夷門監者"
    }
   ],
   "proposed": "改为 'a gate of Daliang'。"
  },
  {
   "id": "F11",
   "path": "sections.context.2",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文引号里是侯嬴话的译文，没有标明是译述。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "臣脩身絜行數十年"
    }
   ],
   "proposed": "标明是译文。"
  },
  {
   "id": "F12",
   "path": "sections.context.3",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "「这些看似闲棋的往来，邯郸被围那年全用上了」/'came due' 是作者推断，却写在 record 段里，没有标签。",
   "evidence": [],
   "proposed": "前面加'作者认为'/'One reading is'。"
  },
  {
   "id": "F13",
   "path": "sections.context.3",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文引号里是译文，没有标明是译述。",
   "evidence": [
    {
     "id": "SJ0771-E8",
     "quote": "此子賢者，世莫能知"
    }
   ],
   "proposed": "标明是译文。"
  },
  {
   "id": "F14",
   "path": "sections.story.0",
   "category": "unsupported",
   "severity": "block",
   "problem": "「据简报转述，他先求魏王发兵不得，遂决意赴秦军而死」用了已剔除的 E12（K3），还用「遂」/'and so' 把它写成因果。证据只记他决意赴死。",
   "evidence": [
    {
     "id": "SJ0771-E13",
     "quote": "具告所以欲死秦軍狀"
    }
   ],
   "proposed": "删去求魏王一节和'遂'，只写'他决意赴秦军而死'。"
  },
  {
   "id": "F15",
   "path": "sections.story.1",
   "category": "inner_life",
   "severity": "fix",
   "problem": "英文 'a gnawing unhappiness' 加重了原文「心不快」的心理程度，中文没有这一层。",
   "evidence": [
    {
     "id": "SJ0771-E13",
     "quote": "公子行數里，心不快"
    }
   ],
   "proposed": "改为 'felt displeased'。"
  },
  {
   "id": "F16",
   "path": "sections.story.1",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文引号里是译文，没有标明是译述。",
   "evidence": [
