 "issues": [
  {
   "id": "V1",
   "path": "sections.context.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "record 段称公子名声“一半来自养客”（en: rested half on his retainers）。这是证据中没有的量化判断，也没有标为解释。",
   "evidence": [
    {
     "id": "SJ0771-E2",
     "quote": "士以此方數千里爭往歸之，致食客三千人"
    }
   ],
   "proposed": "zh 改为“魏公子在魏国以养客知名”；en 改为“The Wei prince was known in Wei for keeping retainers.”"
  },
  {
   "id": "V2",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "称侯生自刭的动机“原文只写行为和一句话”（en: comes down to an act），等于断言自刭已经发生。证据包只有侯生请求届时北乡自刭的许诺，没有记载他实际自刭。",
   "evidence": [
    {
     "id": "SJ0771-E20",
     "quote": "請數公子行日，以至晉鄙軍之日，北鄉自剄，以送公子"
    }
   ],
   "proposed": "zh 改为“侯生许诺北乡自刭以送公子，证据只记这句许诺，是否践行、动机为何均未载”；en 相应改为“Hou Ying's pledge to cut his own throat is recorded only as a single sentence; whether he carried it out, and why, is not in the evidence.”"
  },
  {
   "id": "V3",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“晋鄙军中合符如何校验，原文没有记载”是对原文全篇的断言，证据包无法支持，因为包内只有侯生对合符的假设性预案。这一句与同段末句“证据未载”的口径也不一致。",
   "evidence": [
    {
     "id": "SJ0771-E17",
     "quote": "公子即合符，而晉鄙不授公子兵而復請之，事必危矣"
    }
   ],
   "proposed": "zh 改为“晋鄙军中实际如何合符，证据未载”；en 改为“how the tallies were actually matched in Jin Bi's camp is not recorded in the evidence”。"
  },
  {
   "id": "V4",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "与 V2 相同：“侯生自刭的动机原文只写行为与一句话”（en: given only as an act）把侯生的许诺写成了已发生的行为，证据没有记载他实际自刭。",
   "evidence": [
    {
     "id": "SJ0771-E20",
     "quote": "請數公子行日，以至晉鄙軍之日，北鄉自剄，以送公子"
    }
   ],
   "proposed": "zh 改为“侯生北乡自刭只见于其许诺之语，是否践行及动机证据未载”；en 改为“Hou Ying's throat-cutting appears only as a pledge; whether he carried it out, and why, is not in the evidence.”"
  },
  {
   "id": "V5",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与 V3 相同：“晋鄙军中合符如何校验原文未载”是对原文全篇的断言，超出证据包可核范围。",
   "evidence": [
    {
     "id": "SJ0771-E17",
     "quote": "公子即合符，而晉鄙不授公子兵而復請之，事必危矣"
    }
   ],
   "proposed": "zh 改为“晋鄙军中实际如何合符，证据未载”；en 改为“how the tallies were actually matched in Jin Bi's camp is not recorded in the evidence”。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.2",
   "category": "style",
   "severity": "note",
   "problem": "“这一转与留赵相呼应”之后，冒号所列的是边界亲迎与门客劝谏的先后，与“留赵”无关，论证不连贯。前文刚说明留赵与自责孰先孰后未载，此处容易让读者误以为在暗示一个先后顺序。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "已卻秦存趙，使將將其軍歸魏，而公子獨與客留趙"
    }
   ],
   "proposed": "删去冒号后的分句，或改写为直接说明“自责”与“留赵”在何种意义上相呼应。"
  }
 ],
 "overall": "定稿整体紧扣证据，引语逐字无误，解释均已标注。需修正以下几处：context.0 中无据的“一半”；limits.1 与 uncertainty_note 把侯生的自刭许诺写成已发生的行为，并以“原文未载”超出证据包断言。analysis.2 另有一处论证不连贯的文风提示。"
}