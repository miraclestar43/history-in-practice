 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头第一句先交代公子姐姐的婚姻关系，接着在读者还不知道问题是什么时，连续堆入魏安釐王二十年、长平、赵惠文王、十万众、邺等年份、人名和地名。核心难处直到段末才点明。中文「冠盖相属」未作解释，英文却有解释。读者仍能读懂，故列为 note。",
   "evidence": [
    {
     "id": "SJ0771-E26",
     "quote": "名為救趙，實持兩端以觀望"
    }
   ],
   "proposed": "可把末句「难处在于……按兵不动」提到段首附近，或先写「邯郸被围、魏军停在邺观望」，再补姻亲关系。「冠盖相属」可改为「使者接连不断」。不删除任何事实。"
  },
  {
   "id": "V2",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已约定「下称侯生」，本段又改回「侯嬴年七十」，随后再用「侯生」，同一人的称呼交替出现。英文全程用 Hou Ying，没有这个问题。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "魏有隱士曰侯嬴，年七十，家貧"
    }
   ],
   "proposed": "中文统一用「侯生」，例如把「侯嬴年七十」改为「侯生年七十」。"
  },
  {
   "id": "V3",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "中文先写公子必会「恨之復返」，紧接着又写「他自己说：「以是知公子恨之復返也」」，同一句原文重复引用。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "以是知公子恨之復返也"
    }
   ],
   "proposed": "删去末句「他自己说：「以是知公子恨之復返也」」，或把前句改为直接引用这一整句。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "小标题是「三处不体面的地方」，analysis.1 和 analysis.2 分别以「第二处」「第三处」开头，但本段没有标出「第一处」，读者不易对应。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "譬若以肉投餒虎"
    }
   ],
   "proposed": "在本段开头加「第一处是……」，例如「第一处是两条路都不干净：」。英文同步加 \"The first undignified spot is...\"。"
  }
 ],
 "overall": "逐字段核对后，事实、引文、时序、因果、归属和中英对应均有证据支持，推断都已标为作者解释，无须阻断或修正；仅有三处易读性和一处文风问题，列为 note。"
}