 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "causality",
   "severity": "fix",
   "problem": "导语只写魏王遣晋鄙救赵、使者责问救兵不至，读者会以为救兵只是行动迟缓。证据写明，魏王受秦恫吓后命晋鄙停军于邺，名为救赵，实则持两端观望。",
   "evidence": [
    {
     "id": "SJ0771-E26",
     "quote": "魏王恐，使人止晉鄙，留軍壁鄴，名為救趙，實持兩端以觀望"
    }
   ],
   "proposed": "在“魏王遣晋鄙救赵”之后补一句：魏王畏秦，令晋鄙停军于邺观望（英文同步）。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "开头写了魏王派晋鄙带十万众救赵，接着又说救兵至今不到，但漏掉了救兵不到的原因：秦王恫吓，魏王命晋鄙停军于邺、持两端观望。缺了这一步，读者会误以为救兵只是迟缓。",
   "evidence": [
    {
     "id": "SJ0771-E26",
     "quote": "吾攻趙旦暮且下，而諸侯敢救者，已拔趙，必移兵先擊之"
    },
    {
     "id": "SJ0771-E26",
     "quote": "魏王恐，使人止晉鄙，留軍壁鄴，名為救趙，實持兩端以觀望"
    }
   ],
   "proposed": "在“魏王派将军晋鄙带十万众救赵”后补：秦王遣使威胁，魏王恐，令晋鄙停军于邺，名为救赵，实则观望（英文同步）。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "不了解背景的读者读完开头，说不清“谁遇到了什么问题、为什么难”。魏公子首次出现时没有说明他是魏国公子、与魏王的关系；平原君没有说明是赵国人；又因为缺了魏王止军这一环，看不出公子为何调不动兵。",
   "evidence": [
    {
     "id": "SJ0771-E9",
     "quote": "公子姊為趙惠文王弟平原君夫人"
    },
    {
     "id": "SJ0771-E27",
     "quote": "魏王畏秦，終不聽公子"
    }
   ],
   "proposed": "首次出现时注明“魏国公子”“赵国的平原君（赵惠文王之弟）”，并用一句话点出难处：兵权在魏王手里，魏王畏秦按兵不动。不补证据以外的身份细节。"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "causality",
   "severity": "fix",
   "problem": "稿件把“未被任以国政”直接接到“决意赴秦军而死”，漏掉了中间一步：公子多次请求魏王，又让宾客辩士百般劝说，魏王终不听。赴死是请王失败后的选择，不是起点。另外，原文说他约车骑百余乘、带门客同赴，而稿件“手里只有三千门客”易让人以为三千人都随行。",
   "evidence": [
    {
     "id": "SJ0771-E27",
     "quote": "公子患之，數請魏王，及賓客辯士說王萬端。魏王畏秦，終不聽公子"
    },
    {
     "id": "SJ0771-E27",
     "quote": "約車騎百餘乘，欲以客往赴秦軍，與趙俱死"
    }
   ],
   "proposed": "改为：公子多次请魏王，宾客辩士也说王万端，魏王畏秦终不听；公子自度无法说动魏王，才约车骑百余乘，欲带门客赴秦军与赵俱死（英文同步）。"
  },
  {
   "id": "F5",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "守门人首次出现时称“侯生”，到 context.2 才以“侯嬴”出现，此后两种称呼交替。读者容易以为是两个人。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "魏有隱士曰侯嬴，年七十，家貧，為大梁夷門監者"
    }
   ],
   "proposed": "首次出现写“夷门守门人侯嬴（下称侯生）”，全文统一用“侯生”；英文统一用 Hou Ying。"
  },
  {
   "id": "F6",
   "path": "sections.context.1",
   "category": "causality",
   "severity": "fix",
   "problem": "作者推断“他未被任以国政，调兵无从谈起”，把公子无法出兵归因于魏王忌惮其贤能。但证据显示，邯郸告急时公子曾多次请魏王出兵，魏王拒绝的原因是畏秦。这个推断忽略了相反证据，因果偏移。",
   "evidence": [
    {
     "id": "SJ0771-E27",
     "quote": "魏王畏秦，終不聽公子"
    },
    {
     "id": "SJ0771-E26",
     "quote": "魏王恐，使人止晉鄙"
    }
   ],
   "proposed": "删去“调兵无从谈起”这一推断，或改为：公子无国政之任，只能请王出兵；而魏王因畏秦终不听（英文同步）。"
  },
  {
   "id": "F7",
   "path": "sections.context.3",
   "category": "readability",
   "severity": "fix",
   "problem": "英文对魏公子交替使用 the prince 与 the lord（context.3、story.0–2 等处），而 Lord Pingyuan 也称 Lord，读者容易把两人混淆。",
   "evidence": [],
   "proposed": "英文全文统一称魏公子为 the prince，the lord 只用于平原君或删去。"
  },
  {
   "id": "F8",
   "path": "sections.story.0",
   "category": "causality",
   "severity": "fix",
   "problem": "稿件写成使者一番责让后，公子便直接决意赴死。证据显示，中间还有多次请魏王而不得这一步；原文说他是“自度終不能得之於王”之后才决定赴死。",
   "evidence": [
    {
     "id": "SJ0771-E27",
     "quote": "公子自度終不能得之於王，計不獨生而令趙亡"
    }
   ],
   "proposed": "在“他决意赴秦军而死”前补：他多次请魏王、宾客辩士劝说无果（英文同步）。"
  },
  {
   "id": "F9",
   "path": "sections.story.3",
   "category": "facts",
   "severity": "fix",
   "problem": "窃符计写到侯生献策就停了，漏掉了计策确已执行：公子请如姬，如姬果然盗出兵符。",
   "evidence": [
    {
     "id": "SJ0771-E28",
     "quote": "公子從其計，請如姬。如姬果盜晉鄙兵符與公子"
    }
   ],
   "proposed": "段末补一句：公子从其计请如姬，如姬果然盗出晋鄙兵符交给公子（英文同步）。"
  },
  {
   "id": "F10",
   "path": "sections.story.4",
   "category": "facts",
   "severity": "fix",
   "problem": "侯生自刭只写成许诺，没有交代结局。原文记他到期果然北乡自刭。",
   "evidence": [
    {
     "id": "SJ0771-E30",
     "quote": "公子與侯生決，至軍，侯生果北鄉自剄"
    }
   ],
   "proposed": "在叙事中按时间补：公子到军中之日，侯生果然北乡自刭（英文同步）。"
  },
  {
   "id": "F11",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件从预案直接跳到椎杀，漏掉了中间经过：公子到邺矫令代晋鄙，晋鄙合符后起疑、想不听命。缺了这一步，读者看不出预案中的坏情况确实发生了，椎杀是对拒命的应对。",
   "evidence": [
    {
     "id": "SJ0771-E29",
     "quote": "至鄴，矯魏王令代晉鄙。晉鄙合符，疑之"
    },
    {
     "id": "SJ0771-E29",
     "quote": "欲無聽"
    }
   ],
   "proposed": "在椎杀前补：公子至邺矫令代晋鄙，晋鄙合符后起疑，质问单车来代之事，欲不听命（英文同步）。"
  },
  {
   "id": "F12",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "五城之议写到自责就结束了，漏掉了后续：公子在赵王面前侧行辞让，自言负魏、无功于赵，赵王因此终未献五城。",
   "evidence": [
    {
     "id": "SJ0771-E31",
     "quote": "自言罪過，以負於魏，無功於趙"
    },
    {
     "id": "SJ0771-E31",
     "quote": "趙王侍酒至暮，口不忍獻五城，以公子退讓也"
    }
   ],
   "proposed": "段末补：公子侧行辞让，自言负魏、无功于赵，赵王侍酒至暮终未献五城（英文同步）。"
  },
  {
   "id": "F13",
   "path": "sections.story.8",
   "category": "chronology",
   "severity": "fix",
   "problem": "原文先叙魏王怒、公子遣军归魏而独留赵，再叙赵孝成王议封五城。稿件把留赵放在五城与自责之后，暗示留赵发生在其后，顺序颠倒。",
   "evidence": [
    {
     "id": "SJ0771-E25",
     "quote": "已卻秦存趙，使將將其軍歸魏，而公子獨與客留趙"
    },
    {
     "id": "SJ0771-E24",
     "quote": "趙孝成王德公子之矯奪晉鄙兵而存趙"
    }
   ],
   "proposed": "把 story.8 移到 story.7 之前，或在 story.8 明示：遣军归魏、留赵在五城之议之前（英文同步）。"
  },
  {
   "id": "F14",
   "path": "sections.analysis.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“从结果看，他欠了自己这方一笔债……仍然把方案走完”是作者的评价，却以陈述语气写出，没有标为解释。",
   "evidence": [],
   "proposed": "改为“作者认为，从结果看……”（英文同步，如 In the author's view）。"
  },
  {
   "id": "F15",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“原文只记他立自责，未记辩解之辞”与证据不符。原文还记他侧行辞让、自言负魏且无功于赵，赵王因此终未献五城。",
   "evidence": [
    {
     "id": "SJ0771-E31",
     "quote": "公子側行辭讓，從東階上。自言罪過，以負於魏，無功於趙"
    },
    {
     "id": "SJ0771-E31",
     "quote": "口不忍獻五城，以公子退讓也"
    }
   ],
   "proposed": "改为：原文记他立即自责，又在赵王面前辞让，自言负魏、无功于赵，赵王因此终未献五城（英文同步）。"
