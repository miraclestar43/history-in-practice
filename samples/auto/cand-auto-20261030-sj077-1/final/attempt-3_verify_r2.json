 "issues": [
  {
   "id": "V1",
   "path": "sections.context.3",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件把「過客以觀公子」误读为“让过客（路人）围观”，英文也写成 so that passers-by could watch。这里的“過”是拜访的意思：侯生是去拜访他的客人（即屠者朱亥），借此观察公子。E8「臣所過屠者朱亥」中的“過”是同一用法。看的人是侯生，不是路人；市人的看法是另一回事。",
   "evidence": [
    {
     "id": "SJ0771-E7",
     "quote": "故久立公子車騎市中，過客以觀公子，公子愈恭"
    },
    {
     "id": "SJ0771-E8",
     "quote": "臣所過屠者朱亥"
    }
   ],
   "proposed": "中文改为：“他故意让公子的车骑久立市中，自己去拜访朋友，借此观察公子，公子愈恭，于是……”。英文改为：“He had deliberately kept the prince's carriage standing in the marketplace while he called on a friend, in order to watch the prince: the longer the prince waited, the more deferential he became — and so…”"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "主人公在本段后半才出现，第一次露面就用“这位魏国公子”，好像前文已经介绍过他。在他出场之前，段落先铺了长平、十万众、邺、秦王恫吓等背景。开头整体还能读懂，读者能说出“谁遇到什么难题、为何难”，但人物出场偏晚。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "讓魏公子曰"
    }
   ],
   "proposed": "把“这位魏国公子”改为“魏国的公子（本文主人公）”，或者在段首用一句话先点出他；事实内容不删。"
  },
  {
   "id": "V3",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "「恨之復返」先被改写成预测（“公子必会”），紧接着又整句引用一遍，重复，而且两处说法不完全一致。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "以是知公子恨之復返也"
    }
   ],
   "proposed": "删去“公子必会「恨之復返」”，保留：“他还说，公子待他厚，此去而他不相送，‘以是知公子恨之復返也’。”"
  },
  {
   "id": "V4",
   "path": "sections.analysis.0",
   "category": "style",
   "severity": "note",
   "problem": "小标题是“三处不体面的地方”，后文用了“第二处”“第三处”，但本段没有标出“第一处”，读者对不上号。",
   "evidence": [],
   "proposed": "在段首加“第一处是没有干净的选项。”英文相应加 \"The first undignified spot is that no option was clean.\""
  }
 ],
 "overall": "定稿整体有证据支撑，推断都已标注，中英文一致。唯一需要修正的事实问题是 context.3 把「過客」误读成路人围观；另有三处纯文风或易读性的小建议，不影响通过。"
}