 "issues": [
  {
   "id": "V1",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 已说明“侯嬴（下称侯生）”，但中文 context.2 又回到“侯嬴年七十”，随后再改称“侯生”；context.3 的引文里还出现自称“嬴”。同一人三种称呼交替出现，读者容易分神。英文统一用 Hou Ying，没有这个问题。",
   "evidence": [
    {
     "id": "SJ0771-E4",
     "quote": "魏有隱士曰侯嬴，年七十"
    }
   ],
   "proposed": "中文正文统一用“侯生”，把“侯嬴年七十”改为“侯生年七十”；引文中的“嬴”保持原样即可。"
  },
  {
   "id": "V2",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "中文先写“公子必会「恨之復返」”，紧接着又写“他自己说：「以是知公子恨之復返也」”，同一层意思重复了一次。英文只说了一次。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "以是知公子恨之復返也"
    }
   ],
   "proposed": "删去“公子必会「恨之復返」。”一句，保留后面的完整引文，使中英一致。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.2",
   "category": "readability",
   "severity": "note",
   "problem": "毛公、薛公首次出现，没有交代身份，也没有说明他们与公子的关系，读者不知道这两人是谁。",
   "evidence": [
    {
     "id": "SJ0771-E32",
     "quote": "毛公、薛公兩人往見公子曰"
    }
   ],
   "proposed": "在两人名字前补上证据范围内的说明，例如“直到毛公、薛公两人前去见他”。证据没有提供更多身份信息，不要补造。"
  }
 ],
 "overall": "逐字段核对后，事实、引语、归属、时间顺序与解释标注均有证据支持，中英一致，开头能让读者说清公子遇到的难题及其原因。仅有三处易读性或文风层面的小问题，可以签发。"
}