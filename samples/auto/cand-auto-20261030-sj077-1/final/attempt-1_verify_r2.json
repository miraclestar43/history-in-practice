 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "“公子不是自命能急人之困吗”/“the man who prided himself on rushing to others in distress”把“能急人之困”写成了公子的自我标榜。原文的说法不同：平原君称，自己正是看重公子高义、能急人之困，才与公子结为婚姻。这句话说的是平原君对公子的期许，并非公子的自我宣称。",
   "evidence": [
    {
     "id": "SJ0771-E11",
     "quote": "勝所以自附為婚姻者，以公子之高義，為能急人之困"
    },
    {
     "id": "SJ0771-E11",
     "quote": "安在公子能急人之困也"
    }
   ],
   "proposed": "中文改为“当初正是看重公子高义、能急人之困才结为婚姻，如今公子的急人之困在哪里？”；英文改为“had he not married into the prince's family precisely because the prince was known to rush to others in distress — so where was that now?”"
  },
  {
   "id": "V2",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "中文先写“公子必会「恨之復返」”，紧接着又写“他自己说：「以是知公子恨之復返也」”，同一句话引了两遍，读来重复。英文只表述一次，两版详略不一。",
   "evidence": [
    {
     "id": "SJ0771-E14",
     "quote": "以是知公子恨之復返也"
    }
   ],
   "proposed": "删去“公子必会「恨之復返」”这一半句，中文改为“他还说，公子待他厚，此去而他不相送，「以是知公子恨之復返也」。”"
  }
 ],
 "overall": "定稿整体有证据支撑，引文逐字可核，解释和推断都已标注。只需修正 hook.0 中“自命能急人之困”的归属偏差；story.2 的重复引语属于可选的文风修订。"
}