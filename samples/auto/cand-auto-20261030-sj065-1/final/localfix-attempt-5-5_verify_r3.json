 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "hook.0 把公主当面轻慢公叔写成已经发生的事；hook.1 说这场脾气和这门婚事“都是公叔按计策安排的”，也就是计策真的执行了。标注的证据 E17–E19 只是仆人的设想（“即令公主怒而輕君”“則必辭”）。证明计策确已执行、吴起确实看到这一幕的是 E20，但两段的 ev 都没有列入 E20。正文内容本身有证据支持，问题在于证据标注不全。",
   "evidence": [
    {
     "id": "SJ0651-E19",
     "quote": "君因召吳起而與歸，即令公主怒而輕君"
    },
    {
     "id": "SJ0651-E20",
     "quote": "於是吳起見公主之賤魏相，果辭魏武侯"
    }
   ],
   "proposed": "在 sections.hook.0 和 sections.hook.1 的 ev 中补入 SJ0651-E20，正文不改。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头同时出现两位公主：先写“魏国的一位公主”（公叔的妻子），紧接着写“要把一位公主许配给吴起”。读者可能一时分不清这是不是同一人。英文 a princess of Wei / a princess 也有同样问题。",
   "evidence": [
    {
     "id": "SJ0651-E18",
     "quote": "試延以公主"
    },
    {
     "id": "SJ0651-E17",
     "quote": "公叔為相，尚魏公主"
    }
   ],
   "proposed": "末句改为“国君魏武侯要把另一位公主许配给吴起。”英文改为 \"wanted to give Wu Qi another princess in marriage.\""
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1 的“一门婚事就能让吴起在魏国待不下去”和摘要“一门婚事，却让他在魏国待不下去”几乎同句，摘要与开头重复了同一个落点。",
   "evidence": [],
   "proposed": "hook.1 末句改为聚焦机制的问法，例如“公叔的仆人凭什么断定，吴起一定会推辞这门婚事，而推辞又一定会被看成要走？”英文相应调整。"
  },
  {
   "id": "V4",
   "path": "sections.story.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "稿件把三件事的顺序写成“统领三军→镇守西河→治理百官”，并在“治理百官”之后写“三件比完”。证据包里 E13（守西河）与 E14（“此三者”）编号相连。据《史记》原文，三问的顺序是：将三军、治百官（亲万民、实府库）、守西河，守西河这一问紧接“此三者”。稿件把后两问的次序颠倒了。",
   "evidence": [
    {
     "id": "SJ0651-E13",
     "quote": "守西河而秦兵不敢東鄉，韓趙賓從，子孰與起？"
    },
    {
     "id": "SJ0651-E14",
     "quote": "此三者，子皆出吾下，而位加吾上，何也？"
    },
    {
     "id": "SJ0651-E28",
     "quote": "治百官，親萬民，實府庫，子孰與起？"
    }
   ],
   "proposed": "把“治理百官、亲近百姓、充实国库……田文还是说不如你”移到第二问，“镇守西河……田文仍说不如你”放在第三问，紧接“三件比完”。英文同步调序。"
  },
  {
   "id": "V5",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李克评语里的“司马穰苴”对一般读者是陌生人名，读者不知道这个比较有多重的分量。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "可在白话释义处加四五个字的身份说明，例如“连以善于用兵著称的司马穰苴也超不过他”。英文相应补 \"the celebrated general Sima Rangju\"。不另加生平。"
  },
  {
   "id": "V6",
   "path": "sections.story.4",
   "category": "style",
   "severity": "note",
   "problem": "“拿把公主许配给吴起来试探他”中“拿把”连用，句子不通顺。",
   "evidence": [],
   "proposed": "改为“用把公主许配给吴起这件事来试探他”。"
  },
  {
   "id": "V7",
   "path": "sections.analysis.1",
   "category": "style",
   "severity": "note",
   "problem": "段首已写“司马迁在传末评论说”，段末又补一句“这是司马迁的评语”，重复标注，读起来像审核说明。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀"
    }
   ],
   "proposed": "删去末句“这是司马迁的评语。”及英文 \"That is Sima Qian's own verdict.\""
  },
  {
   "id": "V8",
   "path": "uncertainty_note",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文把三条评语统称为“当事人的评价”。李克是文侯问询的对象，不是事件当事人，这个称呼不准确；英文作 the speakers' own judgments，中英也不一致。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "文侯問李克曰：「吳起何如人哉？」"
    }
   ],
   "proposed": "把“这些是当事人的评价”改为“这些是说话人各自的评价”，与英文一致。"
  },
  {
   "id": "V9",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 内容几乎逐句重复（单一史源、对话未必逐字、三条评语出处、作者推断），不符合“宁短勿凑”。",
   "evidence": [],
   "proposed": "二者保留其一的完整表述，另一处压缩为一句，例如 limits.0 只留“本篇只依据《史記·孫子吳起列傳》；文中对话是史书的叙述，未必逐字。”英文同步。"
  },
  {
   "id": "V10",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "第二条“试探已经执行，且不止一次的可能”语法残缺。",
   "evidence": [],
   "proposed": "改为“试探已经执行过，而且可能不止一次”。"
  },
  {
   "id": "V11",
   "path": "reflection.example.alternative",
   "category": "readability",
   "severity": "note",
   "problem": "英文 \"whether he means to stay\" 中的 he 没有明确指代。此节其余部分用第二人称 you，中文作“对方把‘留不留心’的判断”，英文此处读者会不知道 he 是谁。",
   "evidence": [],
   "proposed": "改为 \"force the question of whether you mean to stay into an open negotiation\"。"
  }
 ],
 "overall": "引语逐字无误，因果与评价归属基本清楚，开头也能让读者明白处境；但三问次序颠倒（V4）、开头两段证据标注缺 E20（V1）、不确定性说明误称“当事人”（V8）三处需修改后方可定稿，其余为文风与易读性建议。"
}