 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "readability",
   "severity": "fix",
   "problem": "摘要说“当时的宰相”承认功劳不如吴起，紧接着开头介绍的宰相是公叔。读者容易以为认输的是公叔，实际上认输的是前一任宰相田文。前后两任宰相在开头分不清。",
   "evidence": [
    {
     "id": "SJ0651-E12",
     "quote": "文曰：「不如子。」"
    },
    {
     "id": "SJ0651-E17",
     "quote": "田文既死，公叔為相"
    }
   ],
   "proposed": "中文改为“功劳连魏国前一任宰相都承认不如他”；英文改为“even Wei's previous chief minister admitted that his record was the greater”。"
  },
  {
   "id": "V2",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "fix",
   "problem": "上一句的主语是楚悼王，下一句“他严明法令”和“He made the laws clear and strict”的“他／He”既可指悼王，也可指吴起。读者分不清是谁在推行改革。",
   "evidence": [
    {
     "id": "SJ0651-E21",
     "quote": "至則相楚。明法審令"
    }
   ],
   "proposed": "中文改为“吴起严明法令”；英文改为“Wu Qi made the laws clear and strict”。"
  },
  {
   "id": "V3",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "进言者翻出的旧事列得很全：家产败光、杀三十多人、啮臂发誓、母死不归、曾子绝交。这些对理解吴起在魏国的遭遇用处不大，让开头偏重。",
   "evidence": [
    {
     "id": "SJ0651-E3",
     "quote": "吳起殺其謗己者三十餘人"
    }
   ],
   "proposed": "可以压缩旧事清单，只保留“猜忍”的评价和替鲁君算的那笔账。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "句首已经写明“司马迁在传末评论说”，末句“这是司马迁的评语／That is Sima Qian's own verdict”重复了出处，读起来像审核说明。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀。悲夫！"
    }
   ],
   "proposed": "中英文都删去末句。"
  },
  {
   "id": "V5",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 的内容几乎逐句重复：单一史源、对话未必逐字、三条评语的出处、作者推断。不符合“宁短勿凑”。",
   "evidence": [],
   "proposed": "保留其中一处的完整说明，另一处压缩为一句。"
  },
  {
   "id": "V6",
   "path": "reflection.example.alternative",
   "category": "readability",
   "severity": "note",
   "problem": "英文前半句用 you，后半句“whether he means to stay”改用 he，人称前后不一致。",
   "evidence": [],
   "proposed": "英文改为“whether you mean to stay”。"
  },
  {
   "id": "V7",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "“司马穰苴／Sima Rangju”没有交代身份，不了解背景的读者看不出这个比较的分量。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "中文加“齐国名将”，英文加“the famed Qi general”。"
  }
 ],
 "overall": "事实、引文和归属都有证据支持，推断也已标明；需要修改两处易读性问题：摘要里两任宰相容易混淆，楚国一段中“他”的指代不清。其余为文风和易读性建议。"
}