 "issues": [
  {
   "id": "V1",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李克第一次出现时，稿件没有交代他是谁。司马穰苴也没有说明，读者不知道这个比较的分量。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "文侯問李克曰：「吳起何如人哉？」"
    }
   ],
   "proposed": "证据没有给出李克的职务，不要补造官职。可以把穰苴一句改为“论带兵，连以善于用兵著称的司马穰苴也超不过他”。英文相应改为“not even Sima Rangju, famed for his generalship, could surpass him”。"
  },
  {
   "id": "V2",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "note",
   "problem": "英文“slight him in front of Wu Qi”中的 him 指代不清，可能被读成轻慢吴起。中文写的是“轻慢公叔”，指代明确。",
   "evidence": [
    {
     "id": "SJ0651-E19",
     "quote": "即令公主怒而輕君"
    }
   ],
   "proposed": "改为“flare up and slight her husband in front of Wu Qi”。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "“吴起曾劝武侯，地形的险要比不上君主的德行”这段劝谏，正文从未叙述过（E27 已在证据包中），读者读到这里会突然。",
   "evidence": [
    {
     "id": "SJ0651-E27",
     "quote": "起對曰：「在德不在險。」"
    }
   ],
   "proposed": "可在 story.1 开头用一句白话补叙：武侯乘船顺西河而下，称赞山河险固，吴起回答“在德不在險”，意思是国家安危在德行而不在地形险要。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.1",
   "category": "style",
   "severity": "note",
   "problem": "句首已写明“司马迁在传末评论说”，句末“这是司马迁的评语”重复了出处说明。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀"
    }
   ],
   "proposed": "删去末句“这是司马迁的评语。”及英文“That is Sima Qian's own verdict.”"
  },
  {
   "id": "V5",
   "path": "sections.limits.0",
   "category": "style",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 的内容基本重复：单一史源、对话未必逐字、三条评语的出处都写了两遍。",
   "evidence": [],
   "proposed": "保留其中一处的完整表述，另一处压缩为一句说明。"
  },
  {
   "id": "V6",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "中文“试探已经执行，且不止一次的可能”语句不通，与英文“may well be run again”的意思也没有完全对齐。",
   "evidence": [],
   "proposed": "改为“试探已经执行过，而且很可能还会再来”。"
  }
 ],
 "overall": "定稿的事实、引文、归属和因果表述都有证据支持，中英文基本一致，可以发布；只有几处易读性和文风上的小问题，建议顺手修改。"
}