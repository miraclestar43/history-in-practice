 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "readability",
   "severity": "note",
   "problem": "“魏国的前一任宰相”是相对后文公叔而言的称谓。读摘要时，读者还不知道有两任宰相，容易误以为这是一位已经卸任的人。田文承认“不如子”时正担任宰相。",
   "evidence": [
    {
     "id": "SJ0651-E11",
     "quote": "魏置相，相田文"
    },
    {
     "id": "SJ0651-E12",
     "quote": "文曰：「不如子。」"
    }
   ],
   "proposed": "改为“功劳连当朝宰相都承认不如他”；英文相应改为 \"even Wei's chief minister at the time\"。"
  },
  {
   "id": "V2",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头的问句“一门婚事就能让吴起在魏国待不下去”与摘要末句“一门婚事，却让他在魏国待不下去”几乎同句重复。",
   "evidence": [],
   "proposed": "把问句改为聚焦仆人的判断依据，例如“公叔的仆人凭什么断定，吴起一定会推辞这门婚事？”，以免与摘要重复。"
  },
  {
   "id": "V3",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李克拿“司马穰苴”作比，但普通读者不知道此人是谁，读不出这句评价的分量。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "可在名字前加一个简短身份，例如“连以善于用兵闻名的司马穰苴也超不过他”。只做定位，不补生平。"
  },
  {
   "id": "V4",
   "path": "sections.story.4",
   "category": "style",
   "severity": "note",
   "problem": "“拿把公主许配给吴起来试探他”中“拿把”是笔误，句子不通。",
   "evidence": [
    {
     "id": "SJ0651-E18",
     "quote": "試延以公主"
    }
   ],
   "proposed": "改为“拿许配公主这件事来试探他”。"
  },
  {
   "id": "V5",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "note",
   "problem": "同一段里，“公主”先指武侯要许配给吴起的那位公主，段末“公主这样轻贱自己的丈夫”又指公叔的妻子。前后都用“公主”，读者可能要停下来分辨。",
   "evidence": [
    {
     "id": "SJ0651-E19",
     "quote": "即令公主怒而輕君"
    }
   ],
   "proposed": "段末改为“吴起看到公叔的妻子这样轻贱自己的丈夫”，与 story.5 的叫法保持一致。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "“吴起曾劝武侯，地形的险要比不上君主的德行”指的是正文没有讲过的西河对话，读者缺少上下文。另外，末句“这是司马迁的评语”与开头的“司马迁在传末评论说”重复。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "吳起說武侯以形勢不如德"
    }
   ],
   "proposed": "删去末句“这是司马迁的评语。”（英文同删 \"That is Sima Qian's own verdict.\"）。可把前半句改为“吴起曾在西河的船上劝武侯……”，让读者知道是哪次劝谏，不展开对话内容。"
  },
  {
   "id": "V7",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 的内容几乎逐句重复，都在讲单一史源、对话未必逐字、三条评语的出处和作者推断。这不符合“集中放在文末，宁短勿凑”的要求。",
   "evidence": [],
   "proposed": "保留一处完整说明，另一处压缩为一句，例如 limits.0 只写“本篇只依据《史記·孫子吳起列傳》；人物评语各出其说话人”。"
  }
 ],
 "overall": "定稿的事实、引文、归属和中英对应都有证据支持，没有需要修正的错误。开头能让读者明白吴起面临的处境；只余几处称谓、重复和笔误方面的易读性或文风建议（均为 note）。"
}