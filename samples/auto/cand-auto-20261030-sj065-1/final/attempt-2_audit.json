 "issues": [
  {
   "id": "F1",
   "path": "sections.context.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文写“a courtier described him to the ruler of Lu”，把进言者明确为朝臣。证据没有说明进言者的身份，中文“鲁国有人”更准确，中英因此不一致。",
   "evidence": [],
   "proposed": "改为“someone in Lu described him to the ruler of Lu”。"
  },
  {
   "path": "sections.context.0",
   "id": "F2",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“the philosopher Zengzi”给曾子加了“philosopher”的身份，这一点证据中没有，中文也没有。",
   "evidence": [
    {
     "id": "SJ0651-E1",
     "quote": "嘗學於曾子"
    }
   ],
   "proposed": "删去“the philosopher”，改为“He had studied under Zengzi”。"
  },
  {
   "id": "F3",
   "path": "sections.story.1",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“sucked the poison from it”添加了“poison”。原文只写“吮之”，中文也只说“吮吸患处”。",
   "evidence": [
    {
     "id": "SJ0651-E6",
     "quote": "卒有病疽者，起為吮之"
    }
   ],
   "proposed": "改为“Wu Qi sucked the abscess himself”。"
  },
  {
   "id": "F4",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "英文同一处地名一会儿写“Xihe”，一会儿写“West River”，读者可能看不出两者是同一个“西河”。",
   "evidence": [
    {
     "id": "SJ0651-E8",
     "quote": "武侯浮西河而下"
    }
   ],
   "proposed": "统一写法，例如“drifting down the Xi He (West River)”。"
  },
  {
   "id": "F5",
   "path": "sections.story.5",
   "category": "style",
   "severity": "note",
   "problem": "“说了一句很轻的话 / something very light”是作者的评价，但写在 record 段里。",
   "evidence": [
    {
     "id": "SJ0651-E17",
     "quote": "起易去也"
    }
   ],
   "proposed": "改为“公叔的仆人说：「起易去也。」”，删去“很轻”。"
  },
  {
   "id": "F6",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“wanted him dead”把“害”强化成了“要他死”。原文只写“欲害”，中文“想害他”是准确的，中英不一致。",
   "evidence": [
    {
     "id": "SJ0651-E23",
     "quote": "故楚之貴戚盡欲害吳起"
    }
   ],
   "proposed": "改为“Every nobleman of royal blood wanted to do him harm”。"
  },
  {
   "id": "F7",
   "path": "sections.limits.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "本段称“本文不替吴起补写心理活动 / does not invent Wu Qi's inner life”，但 analysis.1 推测了他的心理（“可能判断解释已经无用”）。虽然那里标了推断，这里的绝对说法与正文不符。",
   "evidence": [],
   "proposed": "改为“除明确标为作者推断之处外，本文不替吴起补写心理活动”，英文同步修改。"
  },
  {
   "id": "F8",
   "path": "sections.limits.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“the clearing of laws and orders”容易被读成“废除法令”，与原文“明法審令”的意思相反，也与中文及 story.7 英文的“clear laws and careful orders”不一致。",
   "evidence": [
    {
     "id": "SJ0651-E21",
     "quote": "明法審令"
    }
   ],
   "proposed": "改为“the clarifying of laws and the careful framing of orders”。"
  }
 ],
