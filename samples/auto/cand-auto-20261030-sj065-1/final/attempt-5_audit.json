 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "readability",
   "severity": "fix",
   "problem": "摘要一次罗列吴起、田文、公叔三人，又预先讲完整套计策和结局（辞婚、国君起疑、不再信他）。这违反摘要只提出处境、不交代结局、不罗列人物的要求，也与 hook.0 重复同一套情节。",
   "evidence": [
    {
     "id": "SJ0651-E20",
     "quote": "果辭魏武侯。武侯疑之而弗信也"
    }
   ],
   "proposed": "删去结局句。例如改为：「吴起替魏国守住西河，功劳连宰相都承认不如他。可一门婚事，却让他在魏国待不下去。」英文同步，删去 'Wu Qi declined the marriage, and the ruler grew suspicious and stopped trusting him.' 并删去田文、公叔的点名。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头先概述了全部经过和结局（辞婚、武侯起疑、吴起怕获罪去楚），再在 story 中倒回去讲，并与 dek 重复。读者在开头就知道了结果，关键转折失去悬念。",
   "evidence": [
    {
     "id": "SJ0651-E20",
     "quote": "吳起懼得罪，遂去，即之楚"
    }
   ],
   "proposed": "hook.0 停在处境上：保留公叔妻子当面轻慢公叔、武侯要把一位公主许配给吴起这两点，删去「吴起见了公叔家这一幕，推辞了这门婚事。武侯从此怀疑他，不再信任他。吴起怕获罪，离开魏国，去了楚国。」英文同步删去对应句。这些内容 story.5 已有。"
  },
  {
   "id": "F3",
   "path": "sections.story.5",
   "category": "readability",
   "severity": "fix",
   "problem": "本文有两位公主：武侯要许配给吴起的那位，和公叔的妻子。此处只写「公主」「魏相」，英文写 'the princess' 'the chief minister of Wei'，读者在关键转折处难以分清是哪位公主、谁被轻贱。",
   "evidence": [
    {
     "id": "SJ0651-E20",
     "quote": "於是吳起見公主之賤魏相，果辭魏武侯"
    }
   ],
   "proposed": "中文改为「吴起见公叔的妻子轻贱公叔，果然推辞了武侯许配公主的婚事」。英文改为 'Seeing Gongshu's wife scorn Gongshu, Wu Qi declined Marquis Wu's offer of a princess.'"
  },
  {
   "id": "F4",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "fix",
   "problem": "英文 'have the princess he had married flare up and slight him in front of Wu Qi' 中的 him 有两个可能对象（公叔或吴起），而这正是计策的关键一步。",
   "evidence": [
    {
     "id": "SJ0651-E19",
     "quote": "即令公主怒而輕君"
    }
   ],
   "proposed": "改为 'have his own wife, the princess, flare up and slight Gongshu in front of Wu Qi.'"
  },
  {
   "id": "F5",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "英文用 Wey（卫）和 Wei（魏）两个拼写相近的国名，英语读者容易混淆。",
   "evidence": [],
   "proposed": "首次出现时写 'the small state of Wey (distinct from Wei, where he later served)'，此后沿用。"
  },
  {
   "id": "F6",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "uncertainty_note 与 limits.0 几乎逐句重复（单一史源、未必逐字、三条评语的出处、作者推断），不符合“宁短勿凑”。",
   "evidence": [],
   "proposed": "uncertainty_note 只保留一句：「本篇仅依据《史記·孫子吳起列傳》（维基文库本）；思考题场景为虚构。」其余内容由 limits.0 承担。"
  },
