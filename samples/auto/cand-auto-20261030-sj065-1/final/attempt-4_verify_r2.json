 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "中文首次提到“西河”时没有说明它是什么。英文已写 western frontier，中文读者到 story.0 才知道它的作用是抵御秦、韩。",
   "evidence": [
    {
     "id": "SJ0651-E7",
     "quote": "乃以為西河守，以拒秦、韓"
    }
   ],
   "proposed": "改为“一位替魏国守住西河（魏国抵御秦、韩的边地）……的将军”。"
  },
  {
   "path": "sections.story.0",
   "id": "V2",
   "category": "readability",
   "severity": "note",
   "problem": "司马穰苴首次出现时没有说明身份，读者不知道这句比较的分量。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "改为“可论带兵，连以用兵著称的司马穰苴也超不过他”。只依据原句的比较关系，不补其他生平。"
  },
  {
   "id": "V3",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "story.0 的国君还是魏文侯，story.2 却出现“国君年纪还轻”，story.4 又出现“当时的魏国国君武侯”。正文没有交代国君已经换成武侯，读者可能分不清田文所说的“主少”指谁。",
   "evidence": [
    {
     "id": "SJ0651-E8",
     "quote": "武侯浮西河而下"
    },
    {
     "id": "SJ0651-E15",
     "quote": "主少國疑"
    }
   ],
   "proposed": "在 story.1 开头改为“到了魏武侯在位时，魏国任命宰相，用了田文”。不添加证据以外的亲属关系或年份。"
  },
  {
   "id": "V4",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "“其中两件是”近似“此处录其二”式的选材说明，会让读者追问第三件是什么。",
   "evidence": [
    {
     "id": "SJ0651-E14",
     "quote": "此三者，子皆出吾下"
    }
   ],
   "proposed": "改为“他一连比了三件事，比如：……”，不再写“其中两件是”。英文同步改为 \"He compared them on three counts, for example:\"。"
  },
  {
   "id": "V5",
   "path": "sections.story.6",
   "category": "parity",
   "severity": "fix",
   "problem": "英文 \"removed royal kinsmen of distant blood from their privileges\" 补出了“特权”这一具体内容。中文“罢免与王室血缘疏远的公族”和原文“廢公族疏遠者”都没有这一层，中英不一致，也超出了证据。",
   "evidence": [
    {
     "id": "SJ0651-E21",
     "quote": "廢公族疏遠者"
    }
   ],
   "proposed": "英文改为 \"dismissed royal kinsmen of distant blood\"。"
  }
 ],
 "overall": "史实、引语、归属与解释标注均有证据支持；需修正 story.6 英文多出的“特权”一处，另有四处易读性小问题建议顺手改善，整体可放行。"
}