 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "readability",
   "severity": "note",
   "problem": "摘要里的“魏国的前一任宰相”没有参照对象。读者此时还不知道有后一任宰相公叔，无法理解“前一任”指谁、前于谁。",
   "evidence": [
    {
     "id": "SJ0651-E12",
     "quote": "文曰：「不如子。」"
    }
   ],
   "proposed": "改为“功劳连魏国宰相都承认不如他”（英文同步改为 even Wei's chief minister）。"
  },
  {
   "id": "V2",
   "path": "dek",
   "category": "readability",
   "severity": "note",
   "problem": "摘要“一门婚事，却让他在魏国待不下去”和开头 hook.1“一门婚事就能让吴起在魏国待不下去”措辞几乎相同，两处重复同一个结果。",
   "evidence": [
    {
     "id": "SJ0651-E20",
     "quote": "吳起懼得罪，遂去，即之楚"
    }
   ],
   "proposed": "摘要保留处境，改为提问式，如“可一门婚事，却成了他在魏国的一道难题”；hook.1 维持原样。"
  },
  {
   "id": "V3",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "三次发问是不加引号、不点明说话人的直接引语。英文尤其明显：“In command of the armies..., how do you compare with me?”紧跟在叙述句后面，读者需要倒推才知道是吴起在问田文。",
   "evidence": [
    {
     "id": "SJ0651-E12",
     "quote": "起曰：「將三軍，使士卒樂死，敵國不敢謀，子孰與起？」"
    }
   ],
   "proposed": "第一问前加“吴起问田文：”，英文加 Wu Qi asked Tian Wen: ，其余不动。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "句首已经写明“司马迁在传末评论说”，句末“这是司马迁的评语”重复了出处，读起来像审核说明。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀。悲夫！"
    }
   ],
   "proposed": "删去末句“这是司马迁的评语。”和英文 That is Sima Qian's own verdict."
  },
  {
   "id": "V5",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 几乎逐句重复：单一史源、对话未必逐字、三条评语的出处。",
   "evidence": [],
   "proposed": "保留 uncertainty_note 的完整表述，把 limits.0 缩为一句“本篇只依据《史记·孙子吴起列传》，评语出处与推断范围见文末说明”，或二者择一。"
  },
  {
   "id": "V6",
   "path": "reflection.example.assumptions",
   "category": "readability",
   "severity": "note",
   "problem": "中文第二条“试探已经执行，且不止一次的可能”语法残缺，与英文 may well be run again 的意思不完全对应。",
   "evidence": [],
   "proposed": "改为“试探已经执行，而且可能还会再来”。"
  }
 ],
 "overall": "事实、引文、归属、时序和中英对应均有证据支持，没有需要修正的史实问题；只有几处不影响理解开头的易读性小问题，可以通过终审。"
}