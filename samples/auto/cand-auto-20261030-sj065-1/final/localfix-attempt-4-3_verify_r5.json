 "issues": [
  {
   "id": "V1",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李克、司马穰苴第一次出现时没有说明身份，也没有说明他们和本事的关系。读者不知道李克为何被问，也不知道拿司马穰苴作比意味着什么。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "文侯問李克曰：「吳起何如人哉？」"
    },
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "改为“魏文侯向李克打听吴起的为人”。司马穰苴处只依据评语本身点明作比的用意，例如“连李克拿来作比的用兵名家司马穰苴也超不过他”。不补造证据之外的身份细节。"
  },
  {
   "id": "V2",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "英文“Han and Zhao come as guests”是对「賓從」的字面直译，读者不易明白。中文作“归附”，两种语言的意思也略有出入。",
   "evidence": [
    {
     "id": "SJ0651-E13",
     "quote": "韓趙賓從"
    }
   ],
   "proposed": "英文改为“Han and Zhao defer to Wei”或“submit to Wei”，与中文“归附”一致。"
  },
  {
   "id": "V3",
   "path": "sections.story.4",
   "category": "style",
   "severity": "note",
   "problem": "英文“flare up and slight him in front of Wu Qi”中的 him 可以指公叔，也可以指吴起，指代不清。",
   "evidence": [
    {
     "id": "SJ0651-E19",
     "quote": "即令公主怒而輕君"
    }
   ],
   "proposed": "把“slight him”改为“slight Gongshu”。"
  },
  {
   "id": "V4",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "本段只写攻击者“又射又刺吴起”，没有明说吴起因此丧命。读者要到 analysis.1 才知道结局，读到“灭族七十多家”时可能不清楚吴起是否已死。",
   "evidence": [
    {
     "id": "SJ0651-E23",
     "quote": "擊起之徒因射刺吳起，并中悼王"
    },
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀"
    }
   ],
   "proposed": "在“也击中了悼王的遗体”后补一句“吴起就这样死了”，并把 SJ0651-E25 加入本段证据；英文同步补一句。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "司马迁在正文中第一次出现，没有说明他是《史记》的作者，读者不一定知道他和本篇史源的关系。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "吳起說武侯以形勢不如德"
    }
   ],
   "proposed": "改为“《史记》作者司马迁在传末评论说”；英文改为“Sima Qian, author of the Records of the Grand Historian, remarked at the end of the biography”。"
  },
  {
   "id": "V6",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "中文第二条“试探已经执行，且不止一次的可能”语法残缺。",
   "evidence": [],
   "proposed": "改为“试探已经执行，而且可能不止一次”。"
  }
 ],
 "overall": "事实、引文、归属、因果和中英一致性均有证据支持，未发现需修正的事实问题；仅有几处人物身份说明和措辞的易读性与文风小问题，建议顺手修改，定稿可以通过。"
}