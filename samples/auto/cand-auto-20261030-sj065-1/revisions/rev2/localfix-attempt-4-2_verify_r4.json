 "issues": [
  {
   "id": "V1",
   "path": "sections.story.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“后来，魏国的国君换成了武侯”所依据的证据不在本段的 ev（E11–E14）里，这几条都没有提到武侯。证据包中能支持武侯在位、吴起为他效力的是 E8，“主少”见 E15。",
   "evidence": [
    {
     "id": "SJ0651-E8",
     "quote": "武侯浮西河而下，中流，顧而謂吳起曰"
    },
    {
     "id": "SJ0651-E15",
     "quote": "主少國疑"
    }
   ],
   "proposed": "在本段 ev 中补上 SJ0651-E8（以及 SJ0651-E15）。措辞可改为“到了魏武侯在位时”，避免暗示证据未载的更替细节。"
  },
  {
   "id": "V2",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "“他一连比了三件事，其中两件是”读起来像在交代取材范围，接近“此处录其二”一类过程说明，会让读者追问第三件是什么。",
   "evidence": [
    {
     "id": "SJ0651-E14",
     "quote": "此三者，子皆出吾下"
    }
   ],
   "proposed": "改为“他一连比了三件事，比如：……”，或直接叙述两问，再接“三件比完”。英文同步改为 He compared them on three counts, for instance: …"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "中文开头（dek、hook.1）只写“守住西河”，不了解背景的读者不知道西河是魏国西边抵御秦国的边地；英文写了 western frontier，中英信息略有差异。",
   "evidence": [
    {
     "id": "SJ0651-E7",
     "quote": "乃以為西河守，以拒秦、韓"
    },
    {
     "id": "SJ0651-E13",
     "quote": "守西河而秦兵不敢東鄉"
    }
   ],
   "proposed": "中文改为“替魏国守住西边抵御秦国的西河”（dek 同步），与英文 western frontier 对齐。"
  },
  {
   "id": "V4",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "司马穰苴第一次出现时没有说明身份，读者不明白拿他作比较的意义。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "写成“连以善于用兵著称的司马穰苴也超不过他”，只依据李克这句话本身的比较义，不补其他生平。英文同步：not even Sima Rangju, a byword for generalship, …"
  },
  {
   "id": "V5",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "中文“试探已经执行，且不止一次的可能”语句不通，英文 may well be run again 意思更明确。",
   "evidence": [],
   "proposed": "改为“试探已经执行，而且可能不止一次”。"
  }
 ],
 "overall": "定稿史实、引文、归属与因果表述都有证据支持，推断已标注，中英基本一致；需修正 story.1 的证据对应（补 E8），其余是开头地名说明等易读性小改，修后可发。"
