 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“守边多年”/“for years”的时间跨度在证据中没有依据。证据只记载他被任命为西河守。",
   "evidence": [
    {
     "id": "SJ0651-E7",
     "quote": "乃以為西河守，以拒秦、韓"
    }
   ],
   "proposed": "改为“在魏国任西河守、功劳明确的吴起”/“He had held Wei's western frontier at Xihe”"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“位置稳固”/“his footing looked secure”无证据支持。证据中他与田文争位且不悦，并不能说明稳固。",
   "evidence": [],
   "proposed": "删去“位置稳固”/“and his footing looked secure”"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "英文“gone south to the state of Chu”中的方位“south”证据没有记载，中文也没有对应内容。",
   "evidence": [
    {
     "id": "SJ0651-E20",
     "quote": "即之楚"
    }
   ],
   "proposed": "改为“had gone to the state of Chu”"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文用「」标出的「留不留心」「拒绝」都不是证据中的逐字片段。",
   "evidence": [],
   "proposed": "改用引号“”或不加引号；如要引原文，可用「起有留心則必受之」"
  },
  {
   "id": "F5",
   "path": "sections.hook.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文多出中文没有的“a matter that takes an hour to justify”；中文末尾有（作者解释）标注，英文前两句没有解释标签。",
   "evidence": [],
   "proposed": "英文改为“cannot easily turn his refusal into a large matter to be explained”，并在段首加“One reading is that…”或注明为作者解释"
  },
  {
   "id": "F6",
   "path": "sections.context.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文把“衛”译作“Wei”，与下文的魏国（Wei）同名，读者会把吴起的母国误读为魏国，事实因此混淆。",
   "evidence": [
    {
     "id": "SJ0651-E1",
     "quote": "吳起者，衛人也"
    }
   ],
   "proposed": "衛统一译作“Wey”（或加注“Wei 衛, not the later Wei 魏”）"
  },
  {
   "id": "F7",
   "path": "sections.context.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“Wei's capital”“Lu and Wei are brother states”同样把衛与魏混用；“to slight Wei”把“棄衛”（抛弃卫国）弱化了，与中文“抛弃卫国”不一致。",
   "evidence": [
    {
     "id": "SJ0651-E3",
     "quote": "君用起，則是棄衛"
    }
   ],
   "proposed": "衛改译“Wey”；“slight Wei”改为“abandon Wey”"
  },
  {
   "id": "F8",
   "path": "sections.context.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“摔门离开卫国”没有依据。原文只说从卫国郭门向东出走，没有摔门这一动作。英文“walked out through the eastern gate”基本相符，中英也因此不一致。",
   "evidence": [
    {
     "id": "SJ0651-E3",
     "quote": "東出衛郭門"
    }
   ],
   "proposed": "改为“从卫国郭门向东出走”"
  },
  {
   "id": "F9",
   "path": "sections.context.1",
   "category": "unsupported",
   "severity": "block",
   "problem": "“鲁君起疑，辞退了吴起”/“grew suspicious and dismissed him”在证据中无记载。证据只有进言内容，没有鲁君的反应或罢免。context.2“这套说法之所以有效”也建立在这一虚构结果上。",
   "evidence": [],
