 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "开头连续出现两位“宰相”。hook.0 称公叔为“魏国宰相”，hook.1 又称“宰相田文”，没有说明两人先后任职。不了解背景的读者会分不清谁是现任宰相、田文与公叔是什么关系。dek 已写明“当时的宰相田文”“后来的魏相公叔”，hook 中却丢了这一层。",
   "evidence": [
    {
     "id": "SJ0651-E17",
     "quote": "田文既死，公叔為相"
    }
   ],
   "proposed": "中文改为“连前任宰相田文都承认功劳不如他”；英文改为“whose record even Tian Wen, the chief minister before Gongshu, admitted was greater than his own”。"
  },
  {
   "id": "V2",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "中文开头直接写“守住西河”，没有交代西河是什么。英文已译为 western frontier，中英信息量不一致，中文读者在开头无从理解这项功劳。",
   "evidence": [
    {
     "id": "SJ0651-E7",
     "quote": "乃以為西河守，以拒秦、韓"
    }
   ],
   "proposed": "改为“替魏国镇守西河、抵御秦韩的将军”。"
  },
  {
   "id": "V3",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李克、司马穰苴首次出现，都没有说明身份。读者不知道为何拿司马穰苴作比较。证据包没有提供两人的身份，不宜补写具体职务。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "白话部分改为“可论带兵，连以善于用兵著称的司马穰苴也超不过他”。李克处可写“文侯向李克打听”，不补职务。"
  },
  {
   "id": "V4",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "“其中两件是”带有“此处录其二”式的取材说明口吻。",
   "evidence": [
    {
     "id": "SJ0651-E14",
     "quote": "此三者，子皆出吾下"
    }
   ],
   "proposed": "改为“他一连比了三件事，比如……；又如……”，英文相应改为“He compared them on three counts, for example…”。"
  },
  {
   "id": "V5",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "story.0 的国君是魏文侯，story.2 的田文却说“主少国疑”，story.4 又出现“当时的魏国国君武侯”。正文没有交代国君已由文侯换成武侯，读者难以理解“主少”指谁。证据包没有直接记载君位更替，只显示吴起后来侍奉武侯。",
   "evidence": [
    {
     "id": "SJ0651-E8",
     "quote": "武侯浮西河而下，中流，顧而謂吳起曰"
    }
   ],
   "proposed": "在 story.2 的白话解释中写明“国君（此时已是年轻的武侯）年纪还轻”，或在 story.1 写“后来，吴起侍奉魏武侯期间”。不补写文侯去世的细节。"
  },
  {
   "id": "V6",
   "path": "sections.story.4",
   "category": "style",
   "severity": "note",
   "problem": "“拿把公主许配给吴起来试探他”语句别扭。",
   "evidence": [
    {
     "id": "SJ0651-E18",
     "quote": "試延以公主"
    }
   ],
   "proposed": "改为“用许配公主这件事来试探他”。"
  },
  {
   "id": "V7",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "只写攻击者“又射又刺吴起”，没有明说吴起因此而死，读者要到 analysis.1 才知道他的结局。",
   "evidence": [
    {
     "id": "SJ0651-E23",
     "quote": "擊起之徒因射刺吳起，并中悼王"
    },
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀"
    }
   ],
   "proposed": "中文改为“攻击他的人又射又刺，杀死了吴起，也击中了悼王的遗体”，英文相应补“and killed him”。"
  },
  {
   "id": "V8",
   "path": "sections.analysis.1",
   "category": "causality",
   "severity": "fix",
   "problem": "司马迁原文用“以”字写明因果：因刻暴少恩而亡其躯。中文写成“施政「刻暴少恩」……最后丢了性命”，弱化成先后并置，与英文的“it cost him his life”也不一致。另外“这是史家对他一生的评价”扩大了评语范围，原文针对的是他在楚国施政致死这一点。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "然行之於楚，以刻暴少恩亡其軀。悲夫！"
    }
   ],
   "proposed": "中文改为“可他自己在楚国施政「刻暴少恩」，严苛暴烈、少有恩惠，因此丢了性命。这是司马迁的评语。”英文末句改为“That is Sima Qian's own verdict.”"
  },
  {
   "id": "V9",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "中文“试探已经执行，且不止一次的可能”语句残缺，与英文“may well be run again”不完全对应。",
   "evidence": [],
   "proposed": "改为“试探已经执行过，而且可能还会再来”。"
  }
 ],
 "overall": "定稿史实、引语与归属基本都有证据支持；需修正结尾太史公评语被弱化的因果和开头两位宰相易混的问题，其余为易读性与文风小改。"
}