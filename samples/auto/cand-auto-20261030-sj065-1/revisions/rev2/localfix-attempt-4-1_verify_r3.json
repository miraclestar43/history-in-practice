 "issues": [
  {
   "id": "V1",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "fix",
   "problem": "context.1 和 story.0 里的国君都是魏文侯。从 story.1 起，文中却不加交代地出现了“国君年纪还轻”（story.2）和“当时的魏国国君武侯”（story.4）。读者分不清文侯和武侯是不是同一人，也就看不懂田文“主少国疑”这句话为什么成立。",
   "evidence": [
    {
     "id": "SJ0651-E8",
     "quote": "武侯浮西河而下，中流，顧而謂吳起曰"
    },
    {
     "id": "SJ0651-E15",
     "quote": "主少國疑，大臣未附"
    }
   ],
   "proposed": "在 story.1 开头交代国君已经换人，例如改为“后来，魏国的国君已是年轻的武侯。魏国任命宰相，用了田文……”，英文同步改为“Later, with the young Marquis Wu now on the throne, Wei appointed a chief minister…”。"
  },
  {
   "id": "V2",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "fix",
   "problem": "“让自己的妻子，也就是那位公主”紧跟在“拿把公主许配给吴起”之后。读者容易以为许给吴起的公主和公叔的妻子是同一个人，人物关系因此混淆。",
   "evidence": [
    {
     "id": "SJ0651-E17",
     "quote": "公叔為相，尚魏公主"
    },
    {
     "id": "SJ0651-E19",
     "quote": "即令公主怒而輕君"
    }
   ],
   "proposed": "改为“让自己娶的那位公主当着吴起的面发怒、轻慢公叔”。英文改为“have the princess he had married flare up and slight him in front of Wu Qi”。"
  },
  {
   "id": "V3",
   "path": "sections.story.4",
   "category": "parity",
   "severity": "fix",
   "problem": "英文全段用 would 写成仆人的计划。中文“公叔先去对……武侯说”“第二步，公叔请吴起到家里，让自己的妻子……发怒”却读起来像已经发生的事，只在中间插了一句“照仆人的设计”。中英对这段性质（计策还是实事）的表述不一致。计策是否付诸实施，要到 story.5（E20“果辭”）才交代。",
   "evidence": [
    {
     "id": "SJ0651-E18",
     "quote": "君因先與武侯言曰"
    },
    {
     "id": "SJ0651-E19",
     "quote": "君因召吳起而與歸"
    }
   ],
   "proposed": "中文段首改为“仆人的计策是：第一步，公叔先对当时的魏国国君武侯说……”。第二步改为“第二步，公叔再请吴起到家里……”，使全段明确是计策内容，与英文一致。"
  },
  {
   "id": "V4",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "李克评语里的“司马穰苴”第一次出现，没有任何身份说明。不了解背景的读者看不出这个比较为什么是高评价。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "然用兵司馬穰苴不能過也"
    }
   ],
   "proposed": "在不补造史实的前提下，把白话改为“可论带兵，连（李克拿来作比的）善于用兵的司马穰苴也超不过他”，或在英文后加一句同义说明。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.1",
   "category": "style",
   "severity": "note",
   "problem": "句首已写“司马迁在传末评论说”，句末“这是司马迁的评语”再重复归属，近于审核说明式的赘语。",
   "evidence": [
    {
     "id": "SJ0651-E25",
     "quote": "以刻暴少恩亡其軀。悲夫！"
    }
   ],
   "proposed": "删去末句“这是司马迁的评语。”及英文“That is Sima Qian's own verdict.”"
  }
 ],
 "overall": "引文和事实均有证据支持，没有发现来源未载类断言。需要修改的是：交代文侯到武侯的更替，消除两位公主的指代混淆，并让 story.4 中英文都明确这是计策内容；修改后可以发布。"
}