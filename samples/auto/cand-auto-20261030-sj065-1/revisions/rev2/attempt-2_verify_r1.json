 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件把「在德不在險」一番话的场景写成“西河边”（en: beside the West River）。证据记载这番对话发生在武侯浮西河而下的船上、河中流处，吴起也说“舟中之人”，并不在河边。",
   "evidence": [
    {
     "id": "SJ0651-E8",
     "quote": "武侯浮西河而下，中流，顧而謂吳起曰"
    },
    {
     "id": "SJ0651-E10",
     "quote": "舟中之人盡為敵國也"
    }
   ],
   "proposed": "zh 改为“浮西河时舟中那番「在德不在險」”；en 改为 \"the words he spoke on the boat in midstream of the West River\"。"
  },
  {
   "id": "V2",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "zh 第二条“试探已经执行，且不止一次的可能”语句不通顺，读起来像残句；en 的 \"may well be run again\" 意思清楚。",
   "evidence": [],
   "proposed": "改为“试探已经执行，且可能不止一次”。"
  }
 ],
 "overall": "定稿的事实、引语、归属和解释标注基本都有证据支持。只有一处场景地点表述（舟中误作西河边）需要小修，另有一处中文文风可以顺一下。"
