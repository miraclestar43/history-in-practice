 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "“功劳无人能比 / no one in Wei could match his record”超出证据。证据中只有田文一人在比功时承认不如吴起，没有说魏国无人能比。",
   "evidence": [
    {
     "id": "SJ0651-E13",
     "quote": "守西河而秦兵不敢東鄉，韓趙賓從，子孰與起？」文曰：「不如子。」"
    }
   ],
   "proposed": "中文改为“吴起替魏国守住西河，战功卓著”；英文改为“Wu Qi held Wei's western frontier at Xihe and had a formidable record”。"
  },
  {
   "id": "F2",
   "path": "dek",
   "category": "inner_life",
   "severity": "fix",
   "problem": "中文“想除掉他”比证据的“害吳起”“起易去也”更重，容易读成要取他性命。证据只支持公叔忌恨吴起、想把他赶走。",
   "evidence": [
    {
     "id": "SJ0651-E17",
     "quote": "而害吳起。公叔之僕曰：「起易去也。」"
    }
   ],
   "proposed": "改为“魏相公叔忌恨他，想把他赶走”。"
  },
  {
   "id": "F3",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“the ruler never trusted him again”把证据中的“疑之而弗信”写成永久不再信任，语气过重；中文“从此不再信他”尚可。",
   "evidence": [
    {
     "id": "SJ0651-E20",
     "quote": "武侯疑之而弗信也"
    }
   ],
   "proposed": "英文改为“and the ruler grew suspicious and stopped trusting him”。"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“功劳谁也比不上 / whose record no one in Wei could match”无证据支持。证据只有田文本人承认“不如子”。",
   "evidence": [
    {
     "id": "SJ0651-E12",
     "quote": "子孰與起？」文曰：「不如子。」"
    }
   ],
   "proposed": "中文改为“一位替魏国守住西河、连宰相田文都承认功劳不如他的将军”；英文同步修改。"
  },
  {
   "id": "F5",
   "path": "sections.context.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“第一句就是 / The first charge was”断言了完整进言的开头结构。证据摘录起于话语中段，无法确认这是第一句。",
   "evidence": [
    {
     "id": "SJ0651-E3",
     "quote": "起之為人，猜忍人也。"
    }
   ],
   "proposed": "改为“他说吴起「猜忍」，意思是为人多疑狠厉”；英文改为“He charged that Wu Qi was suspicious and ruthless.”"
  },
  {
   "id": "F6",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "fix",
   "problem": "中文首次出现“魏文侯”时没有说明身份，英文则写了“a worthy ruler”，两版不一致。后文还会出现魏武侯，读者容易分不清两位国君。",
   "evidence": [
    {
     "id": "SJ0651-E26",
     "quote": "吳起於是聞魏文侯賢，欲事之。"
    }
   ],
   "proposed": "改为“吴起听说魏国国君魏文侯贤明，便去投奔魏国”。"
  },
  {
   "id": "F7",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“大臣李克 / his minister Li Ke”：证据没有写明李克的职务。",
   "evidence": [
    {
     "id": "SJ0651-E4",
     "quote": "文侯問李克曰：「吳起何如人哉？」"
    }
   ],
   "proposed": "中文删去“大臣”，写作“魏文侯先问李克”；英文改为“Marquis Wen first asked Li Ke”。"
  },
  {
   "id": "F8",
   "path": "sections.story.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“魏国设立宰相 / Wei created the office of chief minister”把“置相”（任命宰相）误读成新设官职。",
   "evidence": [
    {
     "id": "SJ0651-E11",
     "quote": "魏置相，相田文。"
    }
   ],
   "proposed": "中文改为“后来魏国任命宰相，用了田文”；英文改为“Later, when Wei appointed a chief minister, it chose Tian Wen”。"
  },
  {
   "id": "F9",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "fix",
   "problem": "正文只写了两项比较，却接着说“三件比完 / When the three were done”，读者无从知道第三件是什么，转折处读不通。",
   "evidence": [
    {
     "id": "SJ0651-E14",
     "quote": "此三者，子皆出吾下，而位加吾上，何也？"
    }
   ],
   "proposed": "开头改为“吴起一连比了三件事，其中两件是：……”，再接现有两问；英文同步改为“He compared them on three counts; two of them were…”。"
  },
  {
   "id": "F10",
   "path": "sections.story.3",
   "category": "inner_life",
   "severity": "fix",
   "problem": "中文“想把他除掉”超出“害吳起”“起易去也”，暗示要取他性命。证据只支持排挤、赶走。",
   "evidence": [
    {
     "id": "SJ0651-E17",
     "quote": "公叔為相，尚魏公主，而害吳起。"
    }
   ],
   "proposed": "改为“他忌恨吴起，想把他赶走”。"
  },
  {
   "id": "F11",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "fix",
   "problem": "正文先写文侯任用吴起，后面突然改由武侯出场，story.2里还有“国君年纪还轻”。读者分不清文侯和武侯是不是同一人，也不知道此时在位的是谁。",
   "evidence": [
    {
     "id": "SJ0651-E18",
     "quote": "君因先與武侯言曰"
    }
   ],
   "proposed": "在正文首次提到武侯处写明“当时的魏国国君武侯”（英文“Marquis Wu, then ruler of Wei”）；不要补写二人的亲属关系或继位时间。"
  },
  {
   "id": "F12",
   "path": "sections.story.6",
   "category": "causality",
   "severity": "fix",
   "problem": "史书用“故”把贵戚想害吴起写成他变法的结果，正文却改成转折“却 / But”，削弱了史书原有的因果。",
   "evidence": [
    {
     "id": "SJ0651-E23",
     "quote": "故楚之貴戚盡欲害吳起。"
    }
   ],
   "proposed": "中文改为“史书写道，因此楚国的贵戚都想害他”；英文改为“For this reason, the history says, Chu's nobles all wanted him dead.”"
  },
  {
   "id": "F13",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "有三处细节与证据或英文版不符：一，中文“跑到悼王的遗体旁伏下”与“伏之”不符，英文已写作“threw himself on it”，两版不一致；二，“围攻”添加了包围的细节，原文只是“攻”；三，原文“射刺”（又射又刺），正文只写了射。",
   "evidence": [
    {
     "id": "SJ0651-E23",
     "quote": "吳起走之王尸而伏之。擊起之徒因射刺吳起，并中悼王。"
    }
   ],
   "proposed": "中文改为“王族大臣作乱，攻击吴起；吴起跑到悼王遗体处，伏在遗体上，攻击他的人射杀、刺杀吴起，也射中了悼王的遗体”；英文改为“shot and stabbed him”。"
  },
  {
   "id": "F14",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "英文用“Wey”（卫）和“Wei”（魏）区分两国，但没有说明，读者容易混淆。",
   "evidence": [],
   "proposed": "在“Wey”首次出现处加短注，例如“Wey (a different state from Wei, where he later served)”。"
  },
  {
   "id": "F15",
   "path": "sections.limits.0",
   "category": "style",
   "severity": "note",
   "problem": "本段与uncertainty_note内容几乎重复。",
   "evidence": [],
   "proposed": "二者保留其一，或把limits.0压缩为一句。"
  },
  {
   "id": "F16",
   "path": "reflection.scenario",
   "category": "quotes",
   "severity": "fix",
   "problem": "现代虚构场景用引号引了证据原词“无留心”，等于在现代场景中引用证据；英文版没有这个引用，两版也不一致。",
   "evidence": [
    {
     "id": "SJ0651-E18",
     "quote": "無留心則必辭矣"
    }
   ],
   "proposed": "改为“管理层反而认定他本来就没打算留下”，去掉引号和原词。"
  },
  {
   "id": "F17",
   "path": "reflection.example.assumptions",
   "category": "style",
   "severity": "note",
   "problem": "中文“试探已经执行，且不止一次的可能”语句残缺，与英文“may well be run again”不完全对应。",
   "evidence": [],
   "proposed": "改为“试探已经执行过，而且很可能还会再来”。"
  }
 ],
