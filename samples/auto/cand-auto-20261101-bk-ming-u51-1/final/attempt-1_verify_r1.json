 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.3",
   "category": "readability",
   "severity": "fix",
   "problem": "正文出现审核过程式说明：「本文依据的讲述只写到……」「朱祁钰那三个'好'是什么意思，本文不作揣测」（英文 \"the account this piece relies on goes only as far as…\" \"this piece will not guess\"），违反第 10 条。",
   "evidence": [
    {
     "id": "BK-MING-U511-E20",
     "quote": "包括守门人在内的所有人都被这一声怒吼震惊了，东华门就此敞开"
    }
   ],
   "proposed": "改为：「这场赌局也不宜当成励志故事来读。书里写，守门人是被这一声怒吼震住才开了门；而赌赢之后紧接着的，是封赏，以及对于谦的逮捕。」英文同步：\"Nor is this gamble best read as an inspirational tale. In the book, the gatekeepers opened because the shout stunned them; and what came straight after the winning throw was rewards, and the arrest of Yu Qian.\""
  },
  {
   "id": "V2",
   "path": "sections.story.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "「没有朱祁镇点头，这件事就没有名分」紧跟在「书里的解释很直白」之后，读者会以为是书中原话，实为本文引申。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "毕竟你们就算杀了朱祁钰，也不可能自己做皇帝吧"
    }
   ],
   "proposed": "可删去这句，或改成「换句话说，没有朱祁镇点头，这件事就没有名分」。不改也可。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.0",
   "category": "causality",
   "severity": "note",
   "problem": "称外部压力是「可以核对的时间压力」，但「奏折一递上密谋就失去意义」本身是当年明月的判断（「很有可能会同意」），只有奏折和朝会日程属于书中所述的事件。",
   "evidence": [
    {
     "id": "BK-MING-U511-E11",
     "quote": "朱祁钰在无子且奄奄一息的情况下，很有可能会同意这一建议"
    }
   ],
   "proposed": "可改为「前者是书中写到的日程和局势，后者是作者对性格的解释」。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "note",
   "problem": "「临场补上的办法」与书中「徐有贞却胸有成竹」的写法略有出入。",
   "evidence": [
    {
     "id": "BK-MING-U511-E18",
     "quote": "但徐有贞却胸有成竹，用一句话解决了难题"
    }
   ],
   "proposed": "可改为「这是徐有贞在门前一句话定下的办法」。"
  },
  {
   "id": "V5",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "朱祁镇、朱祁钰两个名字只差一字，正文后面多处只写名字、不带身份，不了解背景的读者容易混淆。",
   "evidence": [
    {
     "id": "BK-MING-U511-E22",
     "quote": "是那位被他关押的囚犯，他的哥哥在召集群臣"
    }
   ],
   "proposed": "在关键转折处（如 story.0、story.8）首次再现时附上身份，如「太上皇朱祁镇」「病中的皇帝朱祁钰」。"
  },
  {
   "id": "V6",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "「未换算年份；此后各人的结局未写」（英文 \"not converted to a year… is not covered\"）是为凑局限而写的说明，读者理解用不上。",
   "evidence": [],
   "proposed": "可删去最后一句。"
  }
 ],
 "overall": "引文、归属与中英对应基本可靠；须修改 analysis.3 中审核过程式的说明，其余只是可选的措辞改进。"
