 "issues": [
  {
   "id": "V1",
   "path": "sections.story.8",
   "category": "parity",
   "severity": "note",
   "problem": "中文“登基第二天”对应书中“登基后的第二天”，意思是复位次日。英文 \"On the second day after his restoration\" 可能被读成复位两天后，与中文略有出入。",
   "evidence": [
    {
     "id": "BK-MING-U511-E25",
     "quote": "在登基后的第二天，他就给了“还乡团”的成员们优厚的回报"
    }
   ],
   "proposed": "英文改为 \"The day after his restoration, ...\""
  },
  {
   "id": "V2",
   "path": "sections.analysis.1",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "“钥匙一没，城门就再打不开，这一千人也退不出去，收手这条路就断了”是本文对扔钥匙作用的推断，书中只写了扔钥匙和“有进无退”。这句用陈述语气写出，后文的“一种理解是”只覆盖下一句。该段属于分析段，误导程度有限。",
   "evidence": [
    {
     "id": "BK-MING-U511-E16",
     "quote": "他把钥匙扔进了阴沟里"
    },
    {
     "id": "BK-MING-U511-E16",
     "quote": "有进无退，有生无死"
    }
   ],
   "proposed": "可把“一种理解是”提前到“钥匙一没”之前，或改为“在本文看来，钥匙一没……”，后句相应删去重复的标记。"
  },
  {
   "id": "V3",
   "path": "sections.story.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "“没有朱祁镇点头，这件事就没有名分”紧跟在“书里的解释很直白”之后，容易被读成书中原有的说法。书里只写了“也不可能自己做皇帝”，这一句是本文的补充概括。意思与原书一致，不构成曲解。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "毕竟你们就算杀了朱祁钰，也不可能自己做皇帝吧。"
    }
   ],
   "proposed": "可保留，或改为“换句话说，没有朱祁镇点头，这件事就没有名分”，以示这是转述后的概括。"
  },
  {
   "id": "V4",
   "path": "sections.context.2",
   "category": "parity",
   "severity": "note",
   "problem": "英文给张軏加了 \"a man of weighty family\"，中文没有对应内容。这一说法有证据支持（书中称“张軏的来头更大”），只是中英不完全对等。",
   "evidence": [
    {
     "id": "BK-MING-U511-E1",
     "quote": "而张軏的来头更大，他是张玉的儿子，张辅的弟弟"
    }
   ],
   "proposed": "二选一：中文补“来头不小的”，或英文删去该短语。"
  },
  {
   "id": "V5",
   "path": "dek",
   "category": "readability",
   "severity": "note",
   "problem": "摘要和开头都在讲“计划有洞”和“天亮窗口关闭”，有部分重复。开头补上了谁、在哪里、为什么难，读者仍能看懂处境，不影响理解。",
   "evidence": [
    {
     "id": "BK-MING-U511-E12",
     "quote": "留给他们的时间已经不多了。干，还是不干？"
    }
   ],
   "proposed": "可不改。若要调整，摘要可以更侧重“等还是赌”的两难，少写“洞”的具体内容。"
  }
 ],
 "overall": "定稿的事实、引文和归属均与证据一致，人物称谓清楚，开头易读，未发现必须修改的问题，仅有几处可选的措辞、标记和中英对等小注。"
}