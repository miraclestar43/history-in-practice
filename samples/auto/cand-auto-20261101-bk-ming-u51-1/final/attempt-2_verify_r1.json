 "issues": [
  {
   "id": "V1",
   "path": "sections.story.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "“没有朱祁镇点头，这件事就没有名分”紧跟在“书里的解释很直白：”之后，读者会以为这也是书里的话。书中只说“你们就算杀了朱祁钰，也不可能自己做皇帝”，“名分”是本文的引申。整体意思没有偏离原书，不影响判断。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "毕竟你们就算杀了朱祁钰，也不可能自己做皇帝吧"
    }
   ],
   "proposed": "可不改。如需区分，改为“换句话说，没有朱祁镇点头，这件事就没有名分”，英文同步。"
  },
  {
   "id": "V2",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "“前者是可以核对的时间压力”容易让人以为经过了独立核验。实际上，奏折一递上密谋就失去意义、朱祁钰很可能同意，这些同样出自当年明月的判断，本文也只依据这一本书。",
   "evidence": [
    {
     "id": "BK-MING-U511-E11",
     "quote": "如果这份文件提交出去，徐有贞的阴谋将再无用武之地，因为朱祁钰在无子且奄奄一息的情况下，很有可能会同意这一建议"
    }
   ],
   "proposed": "改为“前者是书中日程摆出来的时间压力，后者是作者对性格的解释”。英文相应改为 \"a time pressure set out in the book's own timeline\"。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.1",
   "category": "causality",
   "severity": "note",
   "problem": "“钥匙一没，城门就再打不开，这一千人也退不出去，收手这条路就断了”是本文的推论，却写成了定论，“一种理解是”只管住了下一句。书中只写了扔钥匙这个动作和“有进无退，有生无死”这句话。",
   "evidence": [
    {
     "id": "BK-MING-U511-E16",
     "quote": "他把钥匙扔进了阴沟里"
    },
    {
     "id": "BK-MING-U511-E16",
     "quote": "有进无退，有生无死"
    }
   ],
   "proposed": "把归属提前，例如“按这个逻辑，钥匙一没……”，或把“一种理解是”移到这句之前。英文同步。"
  }
 ],
 "overall": "定稿的事实、引文、归属和中英对应都与证据包一致，开头能让读者看清处境与难点，人物称谓稳定，没有需要修改的问题，仅有三处可选的归属措辞 note，可以发布。"
}