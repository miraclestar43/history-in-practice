 "issues": [
  {
   "id": "V1",
   "path": "sections.story.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "“没有朱祁镇点头，这件事就没有名分”紧跟在“书里的解释很直白”之后，读起来像书中原有的说法。书里只说“就算杀了朱祁钰，也不可能自己做皇帝”，“名分”是本文的引申。这个引申合理，也不改变判断。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "毕竟你们就算杀了朱祁钰，也不可能自己做皇帝吧"
    }
   ],
   "proposed": "可不改；如要改，把这句改为“换句话说，没有朱祁镇点头，这件事就没有名分”，英文相应改为 \"In other words, ...\"。"
  },
  {
   "id": "V2",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "note",
   "problem": "书里写的是“阴谋集团确定，计划正式实施”，稿件写作“计划正式确定”，措辞略有出入，不影响主线。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "这一天是正月十三日，阴谋集团确定，计划正式实施"
    }
   ],
   "proposed": "可不改；如要改，中文改为“密谋的班底定了下来，计划正式启动”，英文改为 \"the group was settled and the plan set in motion\"。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "“前者是可以核对的时间压力”说得偏强。奏折一递上密谋就失去意义，这本身也是当年明月的判断（故事部分已写作“当年明月认为”），本文只依据这一本书，谈不上另行核对。",
   "evidence": [
    {
     "id": "BK-MING-U511-E11",
     "quote": "如果这份文件提交出去，徐有贞的阴谋将再无用武之地"
    }
   ],
   "proposed": "中文改为“前者是书中按时间顺序讲出来的外部压力，后者是作者对人物性格的解释”，英文改为 \"The first is an outside pressure the book lays out in its sequence of events; the second is the author's interpretation of his character.\""
  },
  {
   "id": "V4",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "城门此时已经关上并锁好，“收手关门这条路”的说法容易让读者困惑。没有钥匙后，断掉的其实是重新开门、把军队撤出去的退路。",
   "evidence": [
    {
     "id": "BK-MING-U511-E16",
     "quote": "他将张軏统领的一千军队放进了内城，然后关上了城门"
    }
   ],
   "proposed": "中文把“收手关门这条路就断了”改为“再开城门、把军队撤出去这条退路就断了”，英文把 \"the option of calling it off and locking the gate\" 改为 \"the option of reopening the gate and pulling the troops back out\"。"
  },
  {
   "id": "V5",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "英文里 Zhu Qizhen 和 Zhu Qiyu 字形几乎相同。正文后面多处只用人名，没有附上 the retired emperor 或 the reigning emperor，英语读者容易混淆两人。",
   "evidence": [
    {
     "id": "BK-MING-U511-E23",
     "quote": "却又被自己弟弟关押起来"
    }
   ],
   "proposed": "可不改；如要改，在英文 story 部分两人首次重新出现处各加一次身份，例如 \"the retired emperor, Zhu Qizhen\" 和 \"the ailing emperor, Zhu Qiyu\"。"
  }
 ],
 "overall": "定稿的事实、引文、归属和时间顺序均与证据包一致，没有编造或冒充原文，开头可读，人物也分得清；只有几处措辞和归属的细节可酌情微调，可以通过终审。"
}