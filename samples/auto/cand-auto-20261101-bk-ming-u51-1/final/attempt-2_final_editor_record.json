 "contamination": [
  {
   "id": "K1",
   "brief_line": "- 石亨找来宦官曹吉祥和张軏（张辅的弟弟）合谋（BK-MING-U511-E1）；三人不知从何下手，石亨向太常寺卿许彬请教，许彬推荐了徐有贞（BK-MING-U511-E2）。",
   "dropped_ids": [
    "U511-E1",
    "U511-E2"
   ]
  },
  {
   "id": "K2",
   "brief_line": "- 据本书的讲述，徐有贞因当年说错一句话受人唾弃，一直想讨回公道（BK-MING-U511-E3）。",
   "dropped_ids": [
    "U511-E3"
   ]
  },
  {
   "id": "K3",
   "brief_line": "- 徐有贞提出先与南宫里的朱祁镇取得联系，正月十三日计划确定实施（BK-MING-U511-E4）。",
   "dropped_ids": [
    "U511-E4"
   ]
  },
  {
   "id": "K4",
   "brief_line": "- 正月十四日朝会，病重的朱祁钰面对大臣争论是否复立朱见深，下令十七日复议，并说“所请不允”（BK-MING-U511-E5）（BK-MING-U511-E6）。",
   "dropped_ids": [
    "U511-E5",
    "U511-E6"
   ]
  },
  {
   "id": "K5",
   "brief_line": "- 当夜徐有贞提出三步计划：借边报调张軏的一千军队入城、用石亨掌管的钥匙开内城门、去南宫接出朱祁镇入宫复位（BK-MING-U511-E7）；但他们没有南宫和大内宫城的钥匙，夜间宫门不会开（BK-MING-U511-E8）。作者推测徐有贞明知风险仍要赌一把（BK-MING-U511-E9）。朱祁镇知道风险，仍然同意（BK-MING-U511-E10）。",
   "dropped_ids": [
    "U511-E10",
    "U511-E7",
    "U511-E8",
    "U511-E9"
   ]
  },
  {
   "id": "K6",
   "brief_line": "- 正月十六日，于谦、胡濙、王直商定推举朱见深复立为太子，由商辂起草奏折，准备次日朝会提出；作者认为此奏一上，阴谋将再无用处（BK-MING-U511-E11）。",
   "dropped_ids": [
    "U511-E11"
   ]
  },
  {
   "id": "K7",
   "brief_line": "- 当夜众人慌乱，都看向徐有贞（BK-MING-U511-E12）；他说要去看天象（BK-MING-U511-E13），在房顶作出决定：“成大事就在今晚，机不可失，动手！”（BK-MING-U511-E14），出门时留下“若回来，就做人，不能回来，便是鬼”（BK-MING-U511-E15）。",
   "dropped_ids": [
    "U511-E12",
    "U511-E13",
    "U511-E14",
    "U511-E15"
   ]
  },
  {
   "id": "K8",
   "brief_line": "- 在长安门，石亨放一千军队入城后心慌，徐有贞要过钥匙扔进阴沟，说“有进无退，有生无死”（BK-MING-U511-E16）；天色突然变暗，张軏问“事济否”，徐有贞答“必济”（BK-MING-U511-E17）。",
   "dropped_ids": [
    "U511-E16",
    "U511-E17"
   ]
  },
  {
   "id": "K9",
   "brief_line": "- 南宫门不开，徐有贞让军士撞墙而入，接出朱祁镇（BK-MING-U511-E18）；到东华门，守卫不开门，徐有贞也无计可施，天将亮（BK-MING-U511-E19）；朱祁镇大喊“我太上皇也”，东华门打开（BK-MING-U511-E20）。",
   "dropped_ids": [
    "U511-E18",
    "U511-E19",
    "U511-E20"
   ]
  },
  {
   "id": "K10",
   "brief_line": "- 朱祁镇到奉天殿敲响钟鼓，徐有贞挡在殿前告诉内阁重臣“太上皇已经复位了”（BK-MING-U511-E21）；据本书的讲述，病中的朱祁钰听说后笑着说了“好，好，好”（BK-MING-U511-E22）；朱祁镇重新坐上皇位（BK-MING-U511-E23）。",
   "dropped_ids": [
    "U511-E21",
    "U511-E22",
    "U511-E23"
   ]
  },
  {
   "id": "K11",
   "brief_line": "材料性质与必要说明：本书是通俗历史读物，叙述高度小说化，书中大量人物心理和部分场面（如徐有贞房顶上的心思、朱祁钰的内心独白、天色突暗时众人的感受）是作者的演绎，正文开头自然说明一次“据《明朝那些事儿》的讲述”，心理和评价写成“当年明月认为/书里写道”，不要当作已证实的史实。括号里的文言短句（所请不允、事济否、必济、毁墙入、我太上皇也）是书中引用的原话，可据本书引用点睛并译成白话。作者对徐有贞冒险动机的解释是推断（BK-MING-U511-E9）。本段没有写此后各人的结局，文章不要补写。不要换算公元年份，只用书中的“正月某日”。称谓上要分清“朱祁镇（太上皇，被关在南宫）”“他的弟弟朱祁钰（在位皇帝）”和“朱祁镇的儿子朱见深”，全文固定叫法。",
   "dropped_ids": [
    "U511-E9"
   ]
  }
 ],
