 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“他们的计划有个大家都知道的洞”（英文 Every one of them knew the flaw）把对漏洞的知晓写到全体密谋者身上。书中说他们到了东华门才发现最大漏洞。书里认为应该看出这个洞的只有徐有贞，而且这是当年明月的推测。",
   "evidence": [
    {
     "id": "BK-MING-U511-E19",
     "quote": "才发现了这个计划中的最大漏洞"
    },
    {
     "id": "BK-MING-U511-E9",
     "quote": "我相信以徐有贞的聪明，应该了解这一点"
    }
   ],
   "proposed": "中文改为“他们的计划有个洞”；英文改为“Their plan had a flaw.”，后文不变。"
  },
  {
   "id": "F2",
   "path": "sections.story.0",
   "category": "attribution",
   "severity": "note",
   "problem": "“没有朱祁镇点头，这件事就没有名分”紧接在“书里的解释”之后，读来像书中原话。证据里只有“也不可能自己做皇帝”，没有“名分”这一层。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "毕竟你们就算杀了朱祁钰，也不可能自己做皇帝吧"
    }
   ],
   "proposed": "删去这一句；或改成本文的说法，例如“换句话说，没有朱祁镇点头，这件事就没有名分”。英文同步修改。"
  },
  {
   "id": "F3",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "末句“假如东华门始终不开……材料没有写，但那时已无退路”（英文 the material does not say...）有两处问题。一是断言完整来源没写什么，读者理解并不需要这半句。二是“已无退路”把徐有贞的口号“有进无退”写成了客观结论，证据没有交代失败时的局面。",
   "evidence": [
    {
     "id": "BK-MING-U511-E16",
     "quote": "有进无退，有生无死"
    }
   ],
   "proposed": "删去中英文的整个末句，段落止于“但它也把一次可能的收手机会一并扔掉了”。"
  },
  {
   "id": "F4",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "note",
   "problem": "文中称“前者是可以核对的时间压力，后者是作者的解释”。可是“奏折一上，密谋就失去意义”同样是当年明月的判断，他的理由是朱祁钰“很有可能会同意”，并不能独立核对。把两股力量并列也是本文的归纳，不是书里的讲法。",
   "evidence": [
    {
     "id": "BK-MING-U511-E11",
     "quote": "如果这份文件提交出去，徐有贞的阴谋将再无用武之地"
    }
   ],
   "proposed": "将“前者是可以核对的时间压力”改为“前者是书中按事件先后给出的时间压力”；英文同步，例如“The first is the time pressure the book sets out in its sequence of events.”。"
  },
  {
   "id": "F5",
   "path": "sections.analysis.3",
   "category": "facts",
   "severity": "fix",
   "problem": "“书里只说众人被这声怒吼震住了”“书里也没有解释”（英文 the book says only... / it does not explain at all）都是关于完整来源写了什么、没写什么的断言，本文只依据证据包，无法确认。",
   "evidence": [
    {
     "id": "BK-MING-U511-E20",
     "quote": "包括守门人在内的所有人都被这一声怒吼震惊了"
    }
   ],
   "proposed": "改为“守门人为什么开门，本文依据的讲述只写到众人被这声怒吼震住；朱祁钰那三个‘好’是什么意思，本文不作揣测。”英文同步改写，并删去 at all。"
  },
  {
   "id": "F6",
   "path": "sections.analysis.2",
   "category": "causality",
   "severity": "note",
   "problem": "“恰恰是徐有贞一加入就坚持的第一步……他把一个能叫开门的人带到了门前”容易让读者以为联络朱祁镇是为了叫开宫门。书中给出的理由是“不可能自己做皇帝”；到了东华门，徐有贞也无计可施。",
   "evidence": [
    {
     "id": "BK-MING-U511-E4",
     "quote": "也不可能自己做皇帝吧"
    },
    {
     "id": "BK-MING-U511-E19",
     "quote": "这次徐有贞同样保持了沉默"
    }
   ],
   "proposed": "在末句前加半句“这未必是他事先算到的”，其余不改；英文同步。"
  },
  {
   "id": "F7",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "note",
   "problem": "胡濙、王直、商辂第一次出场，也是唯一一次出场，没有交代身份。读者分不清他们是谁，但这不影响主线。",
   "evidence": [
    {
     "id": "BK-MING-U511-E11",
     "quote": "于谦、胡濙、王直经过仔细商议"
    }
   ],
   "proposed": "可简化为“于谦与胡濙、王直几人商定……请商辂起草奏折”，不补写证据之外的官职。"
  },
  {
   "id": "F8",
   "path": "uncertainty_note",
   "category": "parity",
   "severity": "note",
   "problem": "“此后各人的结局未写”（英文 What later became of each person is not covered）与正文 story.8 已写的封赏和逮捕容易让读者觉得前后矛盾。",
   "evidence": [
    {
     "id": "BK-MING-U511-E25",
     "quote": "就在同一天，徐有贞便下令逮捕了于谦和王文等人"
    }
   ],
   "proposed": "改为“本文只写到复位后的封赏与逮捕，此后各人的结局不在本文范围”；英文同步。"
  },
  {
   "id": "F9",
   "path": "sections.context.2",
   "category": "unsupported",
   "severity": "note",
   "problem": "已知污染 K1–K11 所列的 dropped_ids（U511-E1 至 E25 中的各条）在本证据包中仍完整存在，编号为 BK-MING-U511-E*。正文对应的说法，包括同谋、许彬推荐、正月十三联络、十四日朝会、三步计划、扔钥匙、撞墙、东华门、复位等，都能在包内逐字核对，所以不判为无据。这里只作记录，请流程核对这些编号是否被误标为已剔除。",
   "evidence": [
    {
     "id": "BK-MING-U511-E1",
     "quote": "石亨为他的阴谋找到了两个同谋者"
    },
    {
     "id": "BK-MING-U511-E2",
     "quote": "他推荐的人就是徐有贞"
    }
   ],
   "proposed": "正文不改。"
  }
 ],
