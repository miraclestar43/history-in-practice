 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头段一次给出五个星期、三个月、三只海豹、两张半兽皮、每天一顿热食等多组数字。其中燃料存量（三只海豹、两张半带脂肪的兽皮）读者在开头还用不上，会冲淡“困岛、无人搜救、粮食有限”这条主线。这不影响事实。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E2",
     "quote": "Our stocks included three seals and two and a half skins (with blubber attached)"
    }
   ],
   "proposed": "保留“足额五个星期、减量可撑三个月”。燃料存量这一句可以压缩成“燃料主要靠海兽脂肪，存量有限”，具体只数放到后文，或者保留但移到段尾。不删除任何限定。"
  },
  {
   "id": "V2",
   "path": "reflection.example.steps",
   "category": "style",
   "severity": "note",
   "problem": "现代示例里的类比不严密：外出谈事的人通常仍领工资，还会产生差旅开销，所以“反而少一份开销／removes one salary's worth of cost”与假设条件对不上。象岛场景中“少一张嘴”的逻辑被生硬套用到了这里。这不涉及史实。",
   "evidence": [],
   "proposed": "改为“先算最坏情形：出去的人不会让留守者的开支增加，外出成本有明确上限”。删去“反而少一份开销”。"
  }
 ],
