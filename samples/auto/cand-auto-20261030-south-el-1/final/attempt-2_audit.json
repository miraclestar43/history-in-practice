 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“一条脆弱的小船/one fragile boat”和“胜算很小的路/a long-odds voyage”在证据中都没有依据。证据只说航程危险极大，没有给出胜算，也没有说船“脆弱”（只有覆罩被称为 flimsy decking）。这两个说法与已知污染 K1（“胜算很小的选项”）和 K5（“一条脆弱的小船”）的措辞一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E6",
     "quote": "all hands knew that the perils of the proposed journey were extreme"
    }
   ],
   "proposed": "中文改为“一条小船……走一条危险极大的路”；英文改为“one small boat … a voyage whose perils were extreme”。"
  },
  {
   "id": "F2",
   "path": "dek",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文通篇称叙述者为“the captain”，但证据没有给出这一职衔。证据中他只以第一人称出现，是作出决定、交出指挥权的人（Wild 随后 remaining in full command）。用一个证据外的具体官职，容易让读者误认人物。此问题适用于全文所有英文“the captain”。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E17",
     "quote": "who was remaining in full command"
    }
   ],
   "proposed": "英文全文把“the captain”改为“the leader”（与中文“队长”对应），或改为“the narrator”。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "causality",
   "severity": "fix",
   "problem": "“于是全队定为每天只吃一顿热食/So the whole party went onto…”把决定写成燃料状况的直接后果，并改成了无主语的被动句。原文的写法是：作者先初步估量了形势，然后由他本人作出决定。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E2",
     "quote": "after making a preliminary survey of the situation, I decided that the party must be limited to one hot meal a day"
    }
   ],
   "proposed": "中文改为“初步估量形势后，队长决定全队每天只吃一顿热食”；英文改为“After a preliminary survey of the situation, he decided the party must be limited to one hot meal a day.”"
  },
  {
   "id": "F4",
   "path": "sections.hook.2",
   "category": "style",
   "severity": "note",
   "problem": "英文引语后紧接“The conclusion was forced on him.”，与引语内容重复。",
   "evidence": [],
   "proposed": "删去英文末句，或改为“in his words”引出原句。"
  },
  {
   "id": "F5",
   "path": "sections.context.0",
   "category": "parity",
   "severity": "fix",
   "problem": "“一支船队”在中文里指多条船组成的船队，与原文 a boat party（乘一条船的一队人）和英文译法不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E4",
     "quote": "A boat party might make the voyage"
    }
   ],
   "proposed": "改为“一队人乘船”。"
  },
  {
   "id": "F6",
   "path": "sections.context.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“冬天还少了六张嘴/six fewer mouths”在证据中没有依据，原文只说 fewer mouths。“六张嘴”来自已知污染 K6。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E5",
     "quote": "There would be fewer mouths to feed during the winter"
    }
   ],
   "proposed": "中文改为“冬天要吃饭的嘴也少了”；英文改为“fewer mouths to feed through the winter”。"
  },
  {
   "id": "F7",
   "path": "sections.context.2",
   "category": "causality",
   "severity": "fix",
   "problem": "“正因为如此/So”把必须详细论证说成上一段最坏情形计算的结果。原文给出的原因是全队都知道航程危险极端。英文还删去了“since”这层因果连接。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E6",
     "quote": "The case required to be argued in some detail, since all hands knew that the perils of the proposed journey were extreme"
    }
   ],
   "proposed": "删去“正因为如此/So”；英文改为“The case had to be argued in some detail, since everyone knew the journey's perils were extreme.”"
  },
  {
   "id": "F8",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "“船横倒进涌里”容易被读成船翻覆。原文只说船突然横落进浪谷。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E21",
     "quote": "the boat suddenly fell off into the trough of the sea"
    }
   ],
   "proposed": "改为“船突然横落进浪谷”。"
  },
  {
   "id": "F9",
   "path": "sections.story.8",
   "category": "causality",
   "severity": "fix",
   "problem": "原文不增加配水的理由只有一条，即逆风可能拖长航程。“缺水是最严酷的匮乏”在原文里是描述口渴的一般感慨，稿件却用“而/and”把它并列进冒号后的拒绝理由。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E25",
     "quote": "I dared not permit the 175 SOUTH allowance of water to be increased since an unfavourable wind might drive us away from the island and lengthen our voyage by many days"
    },
    {
     "id": "SOUTH-EL1-E25",
     "quote": "Lack of water is always the most severe privation that men can be condemned to endure"
    }
   ],
   "proposed": "把这句感慨从理由句中拆出单独成句。中文：“……航程拖长许多天。原文感叹，缺水是人所能承受的最严酷的匮乏。”英文：“…lengthen the voyage by many days. Lack of water, the account adds, is the severest privation men can be condemned to endure.”"
  },
  {
   "id": "F10",
   "path": "sections.analysis.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“留下的人在冬天少六张嘴/six fewer mouths”在证据中没有依据（原文只说 fewer mouths），沿用了已知污染 K6。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E5",
     "quote": "There would be fewer mouths to feed during the winter"
    }
   ],
   "proposed": "中文改为“少了几张要吃饭的嘴”；英文改为“fewer mouths to feed”。"
  },
  {
   "id": "F11",
   "path": "sections.analysis.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“风险的下限/The floor of the risk”方向说反了。原文算的是最坏情形（at worst），即对留守者损害的上界，不是下限。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E5",
     "quote": "at worst the venture would add nothing to the risks of the men left on the island"
    }
   ],
   "proposed": "中文改为“最坏情形被算成：也不会给留下的人增加风险”；英文改为“The worst case was calculated as adding nothing…”"
  },
  {
   "id": "F12",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "本段声明“数字都照原文：八百英里/eight hundred miles”，但原文写的是 over 800 miles，稿件丢了“多/over”。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E4",
     "quote": "South Georgia was over 800 miles away"
    }
   ],
   "proposed": "改为“八百多英里/over eight hundred miles”。"
  },
  {
   "id": "F13",
   "path": "sections.context.2",
   "category": "parity",
   "severity": "fix",
   "problem": "中文漏掉了天气不稳定一项，英文有“unsettled weather”，中英不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E6",
     "quote": "The weather then is unsettled"
    }
   ],
   "proposed": "中文改为“天气不稳，天色阴沉，大风几乎不停”。"
  }
 ],
 "inherited": [
  {
   "id": "P1",
   "verdict": "duplicate",
   "same_as": "F9",
   "rationale": "问题成立。原文不增加配水的唯一理由是逆风拖长航程，“缺水最严酷”是对口渴的一般感慨，稿件把它写成了拒绝依据。与 F9 相同。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E25",
     "quote": "since an unfavourable wind might drive us away from the island and lengthen our voyage by many days"
    }
   ]
  }
 ]
}