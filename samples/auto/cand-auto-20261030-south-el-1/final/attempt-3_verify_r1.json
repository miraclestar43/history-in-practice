 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "sea-elephants 指象海豹（elephant seal），中文译成“海象”（walrus）是误译，物种不对。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E2",
     "quote": "probably would be supplemented by seals and sea-elephants to some extent"
    }
   ],
   "proposed": "中文“或许还能靠海豹和海象补一些”改为“或许还能靠海豹和象海豹补一些”；英文不变。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头一段同时堆了五个星期、三个月、三只海豹、两张半兽皮、每天一顿热食等数字，读者此时还用不上存量细节，冲淡了“困在岛上、粮少、无人来救”这个核心问题。",
   "evidence": [],
   "proposed": "开头保留“足额五个星期、减量三个月、每天只吃一顿热食”。“三只海豹和两张半带脂肪的兽皮”可后移或改为概括（燃料主要靠所剩不多的海兽脂肪），但不得删去“不敢把信心全押在补给上”的限定。"
  },
  {
   "id": "V3",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "fix",
   "problem": "名单列出六人后，又出现一个未点名的“木匠”，并写他问自己是否随行、得到肯定答复。读者容易以为木匠是第七人，或分不清他是名单中的谁。证据只能说明木匠随行，没有写明他是名单中哪一位。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E14",
     "quote": "He first inquired if he was to go with me, and seemed quite pleased when I said “ Yes.”"
    }
   ],
   "proposed": "在“木匠”首次出现处加一句“（他也在这六人之中）”，英文加“(he was one of the six)”。不要擅自指认是哪一位。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头已把沙克尔顿介绍为“《南方》作者”，这里的“作者推断”读者会误以为是沙克尔顿本人的推断，混淆了史源作者与本文作者。英文“The author infers”同样有歧义。",
   "evidence": [],
   "proposed": "“作者推断”改为“本文推断”或“笔者推断”；英文改为“This piece infers”。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "fix",
   "problem": "“作者推断”与开头的“《南方》作者”同词，读者分不清推断出自谁。英文同。",
   "evidence": [],
   "proposed": "改为“本文推断”；英文改为“This piece infers”。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.2",
   "category": "readability",
   "severity": "fix",
   "problem": "“作者提出的一种替代做法”易被读成沙克尔顿本人提出的替代做法。",
   "evidence": [],
   "proposed": "改为“本文提出的一种替代做法”；英文“One alternative would have been”可保留。"
  },
  {
   "id": "V7",
   "path": "reflection.example.alternative",
   "category": "readability",
   "severity": "fix",
   "problem": "“作者提出”和“the author raises”与前文“《南方》作者”同称，指代不清。",
   "evidence": [],
   "proposed": "改为“本文提出的一种替代”；英文改为“One alternative this piece raises”。"
  },
  {
   "id": "V8",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "一段之内连续跳过巨浪、文森特垮掉、限水、望见陆地、进湾五件事，缺少过渡，时间线索不清。",
   "evidence": [],
   "proposed": "可拆成两段：巨浪、文森特、限水为一段；5月8日望见南乔治亚与5月10日进湾为另一段。不增删事实。"
  }
 ],
 "overall": "定稿整体有证据支撑，引文逐字、解释已标注、中英一致；需改正“海象”误译，并修正木匠身份不清和“作者推断”指代歧义两处易读性问题。"
}