 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头只写“象岛上”“全队”“队长”。不了解背景的读者说不清这是谁、为何困在象岛、为什么难。hook.0 一上来就堆了五个星期、三个月、三只海豹、两张半兽皮等数字，读者此时还用不上。hook 与 context 前两段读完后，“谁遇到了什么问题”仍不清楚。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E1",
     "quote": "Privation and exposure had left their mark on the party"
    },
    {
     "id": "SOUTH-EL1-E5",
     "quote": "there was no chance at all of any search being made for us on Elephant Island"
    }
   ],
   "proposed": "开头先用一句话交代：记述者沙克尔顿（《南方》作者、本队队长）一行经乘船航程后困在象岛，粮食有限，有人冻伤，也不会有人来搜寻。之后统一称“沙克尔顿”或“队长”。存量细数（三只海豹、两张半兽皮）后移，开头只保留“足额口粮够五个星期”这一个比较。"
  },
  {
   "id": "F2",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "fix",
   "problem": "中文正文直接用 Worsley、Wild、Deception Island 等英文，没有给常用中文译名。Worsley 和 Wild 首次出现时也没说明身份，读者分不清两人谁是谁。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E7",
     "quote": "Worsley and Wild realized that the attempt must be made"
    },
    {
     "id": "SOUTH-EL1-E8",
     "quote": "accuracy and quickness as a navigator"
    }
   ],
   "proposed": "中文改用常用译名并全文统一：沃斯利（Worsley）、怀尔德（Wild）、克林（Crean）、欺骗岛（Deception Island）等。首次出现时说明身份，只写证据所及的内容，例如“领航的沃斯利”“将留守指挥的怀尔德”。"
  },
  {
   "id": "F3",
   "path": "sections.story.1",
   "category": "parity",
   "severity": "fix",
   "problem": "证据只写他“决定”征求志愿者。英文写成 “He called for volunteers”，把决定说成了已经做的事，与中文“决定征求”也不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E9",
     "quote": "I decided to call for volunteers"
    }
   ],
   "proposed": "英文改为 “He decided to call for volunteers”。"
  },
  {
   "id": "F4",
   "path": "sections.story.3",
   "category": "chronology",
   "severity": "fix",
   "problem": "正文先写“名单最后定为六人”，再写“队长把木匠叫来”，暗示叫木匠在定名单之后。但木匠被叫来时还在问自己是否随行，证据没有给出这两件事的先后。木匠与名单中哪个人对应，证据也没写，读者会困惑。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E14",
     "quote": "He first inquired if he was to go with me"
    }
   ],
   "proposed": "去掉暗示先后的衔接，例如把木匠一段写成“另一件事是……”，不要排在“名单最后定为”之后。"
  },
  {
   "id": "F5",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "fix",
   "problem": "“拼凑出来的东西很简陋”没有交代指的是什么，读者不知道是什么被拼凑出来。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E15",
     "quote": "It was a patched-up affair, but it provided a base for a canvas covering"
    }
   ],
   "proposed": "改为“木匠拼凑出的骨架很简陋”。不要补写证据以外的材料（不写桅杆、箱盖、雪橇板）。"
  },
  {
   "id": "F6",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "“决定做出后”没有说明决定了什么，读者无从理解。证据写明的是：察看冰情后决定，除非条件不允许，次日早晨乘 James Caird 出发。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E30",
     "quote": "I decided that, unless the conditions forbade it, we would make a start in the James Caird on the following morning."
    },
    {
     "id": "SOUTH-EL1-E16",
     "quote": "This decision made"
    }
   ],
   "proposed": "在“决定做出后”前补一句：队长与沃斯利、怀尔德登上临海岩顶察看冰情，决定除非条件不允许，次日早晨乘 James Caird 出发。中英文同步修改。"
  },
  {
   "id": "F7",
   "path": "sections.story.8",
   "category": "facts",
   "severity": "fix",
   "problem": "叙事停在缺水限水，没有交代结果，读者不知道航程是否成功。证据包已有结果：离开象岛整十四天后望见南乔治亚，随后驶入 King Haakon Bay 一处小湾。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E26",
     "quote": "McCarthy caught a glimpse of the black cliffs of South Georgia, just fourteen days after oy; departure from Elephant Island"
    },
    {
     "id": "SOUTH-EL1-E28",
     "quote": "I thought must be King Haakon Bay, and I decided that we must land there"
    }
   ],
   "proposed": "末尾补一段：5月8日中午12点半前后，McCarthy 从云隙中望见南乔治亚的黑色悬崖，距离开象岛整十四天；5月10日，他们驶向被认为是 King Haakon Bay 的海湾，几次抢风后进入湾口，转向南岸一处小湾。中英文同步补入。"
  },
  {
   "id": "F8",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "“船可能被吹离海岛”容易被读成吹离象岛。证据中的 island 指航行目标，即南乔治亚。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E25",
     "quote": "an unfavourable wind might drive us away from the island"
    }
   ],
   "proposed": "改为“船可能被吹离目标海岛”。"
  },
  {
   "id": "F9",
   "path": "sections.analysis.2",
   "category": "chronology",
   "severity": "fix",
   "problem": "“记录里的顺序——先说清危险和理由，再征求意见，最后落名单”被写成记录事实。证据只说这个案子“需要”详细论证，以及他“决定”征求志愿者，并没有记下当众论证与征求志愿的实际先后，也没有写明确实征求过。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E6",
     "quote": "The case required to be argued in some detail"
    },
    {
     "id": "SOUTH-EL1-E9",
     "quote": "I decided to call for volunteers"
    }
   ],
   "proposed": "改为“若按记述的叙述顺序读——……”，并注明原文未写明实际先后，也未写明是否确已征求。"
  },
  {
   "id": "F10",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "补入结局（F7）后，“正文的天数只保留出海第六天”“月份照原文”与正文不再相符：原文还明确写了离开象岛十四天，以及5月8日、5月10日。uncertainty_note 中的同一说法也要一并改。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E26",
     "quote": "The morning of May 8 broke thick and stormy"
    },
    {
     "id": "SOUTH-EL1-E28",
     "quote": "the morning of May 10"
    }
   ],
   "proposed": "改为：天数只用原文明确写出的出海第六天、离开象岛第十四天；日期照原文写5月8日、5月10日；所引片段未给公元年份，不做换算。中英文与 uncertainty_note 同步修改。"
  },
  {
   "id": "F11",
   "path": "reflection.example.steps",
   "category": "quotes",
   "severity": "fix",
   "problem": "现代虚构场景用引号引用了史料中的说法（“风险只由急迫需要来辩护”，即 E6 的译述），违反现代场景不得引用证据的规则。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E6",
     "quote": "The risk was justified solely by our urgent need of assistance"
    }
   ],
   "proposed": "去掉引号，用场景内的话改写，例如“说清楚：之所以冒这个险，只因为确实急需外援”。英文同步修改。"
  }
 ],
