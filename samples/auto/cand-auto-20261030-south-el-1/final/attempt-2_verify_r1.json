 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "facts",
   "severity": "fix",
   "problem": "原文说两位医生担心手术“将是必要的”，中英文都弱化成“可能需要/might be necessary”，削弱了原文的判断。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E1",
     "quote": "the two doctors feared that an operation would be necessary"
    }
   ],
   "proposed": "中文改为“两位医生担心必须动手术”；英文改为“the two doctors feared an operation would be necessary”。"
  },
  {
   "id": "V2",
   "path": "sections.story.5",
   "category": "parity",
   "severity": "fix",
   "problem": "英文保留了原文的“pathetic little group”，中文只写“站成一小群”，漏掉“可怜”这一层，中英不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E18",
     "quote": "made a pathetic little group on the beach"
    }
   ],
   "proposed": "中文改为“在海边站成可怜的一小群”。"
  },
  {
   "id": "V3",
   "path": "reflection.example.steps",
   "category": "style",
   "severity": "note",
   "problem": "现代类比的内部逻辑不自洽：出去谈事的人仍然领工资，还要带一个月开销，并不能像“少一张嘴”那样“少一份开销”。这句话与假设中的现金约束相矛盾。",
   "evidence": [],
   "proposed": "改为“出去的人不额外增加留守者的开支，只带够一个月开销”，删去“反而少一份开销/removes one salary's worth of cost”。"
  }
 ],
 "overall": "定稿整体忠实于证据：引文逐字、解释均有标注、现代段未冒充记录。仅需修正一处对医生判断的弱化、一处中英措辞不对等；另有一处现代类比的逻辑小瑕疵，可按需调整。"
}