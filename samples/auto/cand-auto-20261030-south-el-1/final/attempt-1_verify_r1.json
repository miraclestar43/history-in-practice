 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "“口粮只够五个星期 / Rations for five weeks”只取了足额配给的数字。原文同时写明减量可撑三个月，“只够”夸大了紧迫程度，也与 hook.0 不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E2",
     "quote": "we had full rations for the whole party for a period of five weeks. The rations could be spread over three months on a reduced allowance"
    }
   ],
   "proposed": "zh 改为“足额口粮只够五个星期”；en 改为“Full rations for five weeks”。"
  },
  {
   "id": "V2",
   "path": "sections.hook.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文末句“The decision was made for him.”暗示决定由他人作出，偏离原文“conclusion was forced upon me”（形势逼出结论），也与中文“这个结论是被逼出来的”不对应。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E3",
     "quote": "That conclusion was forced upon me"
    }
   ],
   "proposed": "en 末句改为“The conclusion was forced on him by circumstance.”"
  },
  {
   "id": "V3",
   "path": "sections.story.2",
   "category": "parity",
   "severity": "fix",
   "problem": "英文多出两处中文没有的内容：一是点名 Blackborrow，中文只写“病号”；二是在 kind=record 段落中加入评判性的“not a moral position”，该判断属于 analysis.1 的解释，不应写进记录段，且中文缺失。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E12",
     "quote": "They suggested that I should take Blackborrow in order that he might have shelter and warmth as quickly ag possible, but I had to veto this idea"
    }
   ],
   "proposed": "en 删去“, not a moral position”；中英统一是否点名，例如中文改为“把双脚冻伤的 Blackborrow 带上船”。"
  },
  {
   "id": "V4",
   "path": "sections.story.4",
   "category": "unsupported",
   "severity": "fix",
   "problem": "中文“骨架凑合而成”中的“骨架”是证据之外的具体细节。中英“改船的活全是拼凑出来的 / The refit was a patched-up affair”把原文只指覆罩底座的“It”扩大为整个改船工程。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E15",
     "quote": "It was a patched-up affair, but it provided a base for a canvas covering"
    }
   ],
   "proposed": "zh 改为“这套底架是拼凑出来的，但足以支撑一层帆布覆罩”，去掉“全是”和无据的“骨架凑合而成”；en 改为“The base was a patched-up affair, but it provided a base for a canvas covering.”"
  },
  {
   "id": "V5",
   "path": "sections.story.7",
   "category": "chronology",
   "severity": "fix",
   "problem": "“后来一次测算 / A later reckoning”断定 380 英里测算发生在海锚丢失之后。所给证据未写明两件事的先后，也未给日期。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E21",
     "quote": "About 11 a.m. the boat suddenly fell off into the trough of the sea"
    },
    {
     "id": "SOUTH-EL1-E22",
     "quote": "We had done over 380 miles and were getting on for half-way to South Georgia"
    }
   ],
   "proposed": "去掉“后来 / later”，改为“航程中一次测算显示 / One reckoning showed”。"
  },
  {
   "id": "V6",
   "path": "sections.story.8",
   "category": "causality",
   "severity": "fix",
   "problem": "中文“风向不利，航程可能拖长许多天”易读成当时风向已经不利。原文是假设：一旦风向不利，就可能把船吹离海岛、拖长航程。中文还漏掉了“吹离海岛”。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E25",
     "quote": "an unfavourable wind might drive us away from the island and lengthen our voyage by many days"
    }
   ],
   "proposed": "zh 改为“万一风向不利，船可能被吹离海岛，航程拖长许多天”。"
  }
 ],
 "overall": "定稿整体有据，引文逐字核对无误，解释段均已标注；需修正 6 处事实或对应问题：dek 口粮表述、hook.2 英文归因、story.2 中英不对称与记录段混入评判、story.4 无据细节、story.7 无据时序、story.8 假设被写成事实。"
}