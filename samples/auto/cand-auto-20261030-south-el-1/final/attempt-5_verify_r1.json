 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "中文写“重病躺舱底的人”。原文只说 sick man，“重病”是对病情程度的加码，证据没有支持。英文写作 a sick man，中英因此不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E12",
     "quote": "I did not see how a sick man, lying helpless in the bottom of the boat, could possibly survive"
    }
   ],
   "proposed": "把“重病躺舱底的人”改为“躺在舱底、动弹不得的病人”。"
  },
  {
   "id": "V2",
   "path": "sections.context.1",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写“格外看重”，强化了原文 had weight with me 的程度。英文 weighed with him 没有这层强化，中英不一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E5",
     "quote": "A consideration that had weight with me was that there was no chance at all of any search being made for us on Elephant Island"
    }
   ],
   "proposed": "把“一条让他格外看重的考虑”改为“一条在他看来分量很重的考虑”，或改为“他看重的一条考虑”。"
  },
  {
   "id": "V3",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头段在读者还不清楚处境时，就连续给出五个星期、三个月、三只海豹、两张半兽皮等存量数字。燃料存量的细数对理解“谁遇到什么难题”帮助不大，读者也暂时用不上。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E2",
     "quote": "Our stocks included three seals and two and a half skins (with blubber attached)"
    }
   ],
   "proposed": "开头只保留“足额口粮够五周、减量可撑三个月、每天一顿热食”。海豹与兽皮的具体存量可以后置，或并入后文；不要删掉“不敢完全指望海兽补给”这一限定。"
  },
  {
   "id": "V4",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "本段把巨浪、文森特垮掉、限水、望见陆地、飓风、销钉、进湾登陆、登陆后的限定全部塞进一段，时间线不易追踪。事实与证据一致。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E26",
     "quote": "at 12.30 p.m, through a rift in the clouds, McCarthy caught a glimpse of the black cliffs of South Georgia"
    }
   ],
   "proposed": "不改动内容，在“5月8日中午”处和“5月10日”处分段，拆成三段。"
  }
 ],
 "overall": "定稿事实、引文与解释标注总体有证据支持。需修正两处措辞加码（analysis.1 的“重病”、context.1 的“格外”）；开头易读性可以通过，另有两处可选的易读性改进。"
}