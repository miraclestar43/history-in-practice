 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头段塞入了三只海豹、两张半带脂肪的兽皮、燃料靠脂肪等存量细节。读者在这里还用不上这些细节，它们反而冲淡了“口粮足额只够五周、无人来救”这条主线。这些事实本身有证据支持。",
   "evidence": [
    {
     "id": "SOUTH-EL1-E2",
     "quote": "Our stocks included three seals and two and a half skins (with blubber attached)"
    }
   ],
   "proposed": "保留五周、三个月和每天一顿热食这几项。海豹与兽皮的存量、燃料来源可后移，或压缩成一句，不必删除。"
  },
  {
   "id": "V2",
   "path": "reflection.example.steps",
   "category": "style",
   "severity": "note",
   "problem": "现代类比中写“出去的人……反而少一份开销”。这与情境设定不合：出去谈事的人仍领工资，还会产生差旅费用。原文“少一张嘴吃饭”的逻辑不能直接照搬，读者会觉得这一步算不通。",
   "evidence": [],
   "proposed": "改为“出去的人不应额外增加留守者的负担，并为外出开销设定上限”。"
  }
 ],
 "overall": "定稿的事实、引文、归属、时间顺序和中英对应都与证据一致，推断均已标为解释；只有两处非阻断的易读性和文风小问题，可以发布。"
}