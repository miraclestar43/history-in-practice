 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头只写“站在一边的是胡适”，没有说明他站在哪一边（主张白话也能作诗），也没有交代他的身份（同在美国、在康乃尔读书的中国留学生）。不了解背景的读者读完 hook.0 说不清争论双方各持什么立场。英文“On one side stood Hu Shi”有同样的问题。",
   "evidence": [
    {
     "id": "HS-E5",
     "quote": "我在一九一〇年同时进康乃尔的赵元任"
    },
    {
     "id": "HS-E21",
     "quote": "白话也可以作诗"
    }
   ],
   "proposed": "改为“站在一边、主张白话也能作诗的，是在康乃尔读书的留学生胡适”；英文相应改为“On one side, arguing that poetry could be written in the vernacular, stood Hu Shi, a Chinese student at Cornell”。"
  },
  {
   "id": "F2",
   "path": "sections.story.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "文中只写“他在日记里写下九条主张”，读来像是胡适独自拟成。按胡适的说法，这九条是他在绮色佳与任鸿隽、唐钺、杨铨讨论后，记下的讨论中的几个项目，同时也总结了他自己的主张。漏写这层来历，会改变读者对九条归属的理解。中英文都有此问题。",
   "evidence": [
    {
     "id": "HS-E39",
     "quote": "我在日记里记着我们讨论中的几个项目。这几项也很准确地总结出我自己对这些问题的主张"
    },
    {
     "id": "HS-E39",
     "quote": "和在那里度暑假的老朋友任叔永（鸿隽）、唐钺（擘黄）和后来中央研究院发起人之一的杨杏佛（铨）重叙旧交"
    }
   ],
   "proposed": "改为“1916年夏，他途经绮色佳，与任鸿隽、唐钺、杨铨等人讨论文学问题；7月6日他在日记里记下讨论中的九个项目，他说这些也准确总结了他自己的主张……”，英文同步修改。"
  },
  {
   "id": "F3",
   "path": "title",
   "category": "readability",
   "severity": "note",
   "problem": "英文标题把《尝试集》译作“Book of Experiments”，正文（story.7、analysis.1）却作“Experiments”。同一书名用了两种译法，读者可能以为是两本书。",
   "evidence": [],
   "proposed": "全文统一为一种译名，例如标题和正文都用“Experiments”，或都用“Book of Experiments”。"
  },
  {
   "id": "F4",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "“以这一论调讲演”中的“这一论调”在本段和上一段都找不到所指（limits.1 谈的是“改良”与唐德刚对半死语言和白话诗的评论），读者不知道格里德嗤之以鼻的是什么说法。英文“this account”同样缺少所指。",
   "evidence": [
    {
     "id": "HS-E28",
     "quote": "适之先生一辈子都坚持着这个论调。反对他的人就觉得他居功太多。"
    }
   ],
   "proposed": "点明所指，如“胡适一生坚持他对白话文运动起源的这种说法（见唐德刚注）；反对他的人觉得他居功太多……”，英文同步修改。"
  }
 ],
