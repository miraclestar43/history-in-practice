 "issues": [
  {
   "id": "F1",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "末句“并非本文所据材料的记载 / not something recorded in the material this piece relies on”是在断言完整来源没写什么。本文只依据证据包，无法替全书作此断言。而且证据确实记载了陈独秀本人表述的分工：胡适首举义旗，陈高张大旗声援。这样写会误导读者，以为来源对此毫无记载。真正属于推断的只是“刻意配合”这一层，应标为本文的推断。",
   "evidence": [
    {
     "id": "HS-E25",
     "quote": "他自己则高张大旗为他的朋友作声援"
    }
   ],
   "proposed": "中文改为“……的配合，是作者从先后次序读出的一种可能，属本文的推断。”英文改为“…is a possibility the author reads in the sequence — this article's inference.”"
  },
  {
   "id": "F2",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "末半句“都不是本文所据材料的记述 / neither is drawn from the material this piece relies on”属于来源未载类断言。前文已分别标明这些段落是作者推断、虚构场景，这半句对读者理解没有必要。",
   "evidence": [],
   "proposed": "删去中文“，都不是本文所据材料的记述”和英文“; neither is drawn from the material this piece relies on”，保留“是作者推断”“是为今日读者虚构的场景”。"
  },
  {
   "id": "F3",
   "path": "sections.analysis.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“accidents matter more than any monistic cause”漏掉了限定词“往往”，把胡适“往往更重要”的说法写成了绝对判断。中文保留了“往往”，中英不一致。",
   "evidence": [
    {
     "id": "HS-E9",
     "quote": "意外事件往往比"
    }
   ],
   "proposed": "英文改为“accidents often matter more than any monistic cause”。"
  },
  {
   "id": "F4",
   "path": "sections.context.1",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文用引号标出“the question of China's writing”和“how to make our classical written language easier to teach”，但两者都是中文题目的译文。读者会误以为是英文原文。全文其他处都注明了“in our translation”，此处没有标明。",
   "evidence": [
    {
     "id": "HS-E6",
     "quote": "如何可使吾国文言易于教授"
    }
   ],
   "proposed": "在英文中注明为译述，如“Hu on, in our translation, how to make our classical written language easier to teach”，或去掉引号改为转述。"
  },
  {
   "id": "F5",
   "path": "sections.context.2",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文“half-dead language”加了引号，却没有说明这是译文，读者会以为是英文原话。",
   "evidence": [
    {
     "id": "HS-E7",
     "quote": "半死的语言"
    }
   ],
   "proposed": "改为“called the classical written language — in our translation — a half-dead language”，或注明“translated from the Chinese”。"
  },
  {
   "id": "F6",
   "path": "sections.story.9",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文“not vernacular enough”加了引号，却没有标明是译述，像是在冒充赵元任的英文原话。",
   "evidence": [
    {
     "id": "HS-E26",
     "quote": "不够白"
    }
   ],
   "proposed": "改为“Zhao Yuanren often said, in our translation, that Hu's vernacular poems and essays were not vernacular enough …”，或去掉引号。"
  },
  {
   "id": "F7",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "“标为 interpretation／modern 的段落”用的是编辑内部的段落类型标签，读者在正文中未必看得到这些标签，难以对应到具体段落。",
   "evidence": [],
   "proposed": "改为“文中注明为作者推断的段落”“设想的今日场景”，不使用内部标签名。"
  },
  {
   "id": "F8",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "中文首次出现任鸿隽时只写“在康乃尔的任鸿隽”，没有交代他是胡适的朋友，与本事的关系不清。英文写了“Another Cornell friend”。",
   "evidence": [
    {
     "id": "HS-E10",
     "quote": "当时在康乃尔的另一位中国朋友任鸿隽"
    }
   ],
   "proposed": "中文改为“当时在康乃尔的另一位中国朋友任鸿隽”。"
  }
 ],
