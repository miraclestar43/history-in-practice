 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件写朋友们“为‘诗能不能用白话写’吵了一年多”。按胡适的说法，一年多的讨论起初是关于文学改革，后来才“逐渐约束到”诗能不能用白话这个中心议题。收缩到诗是在1916年7月湖上事件和百句打油诗之后，不是争论一开始的题目。现在的写法把结果说成了起点。",
   "evidence": [
    {
     "id": "HS-E20",
     "quote": "我们一年多的讨论已逐渐约束到一个中心议题里来。这个中心议题便是：白话文用在文学其他任何部门都很适合，就是不能“用之于诗”"
    },
    {
     "id": "HS-E11",
     "quote": "愈辩则牵涉愈多，内容也愈复杂愈精湛"
    }
   ],
   "proposed": "中文改为“一群在美国读书的中国朋友，为中国文学该怎样改争了一年多，最后争到一个问题上：诗能不能用白话写。”英文改为“argued for more than a year over how Chinese literature should change, until the quarrel narrowed to one question: could poetry be written in baihua...”。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "“站在一边的是胡适”没有说明他站在哪一边，紧接着又说他自认保守。读者读到下一段“反对他的”之前，分不清他的立场。",
   "evidence": [
    {
     "id": "HS-E20",
     "quote": "我只有以身作则，来认真尝试用白话作诗"
    }
   ],
   "proposed": "中文改为“站在‘白话也能作诗’这一边的是胡适”；英文改为“On the side arguing that poetry could be written in baihua stood Hu Shi”。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "attribution",
   "severity": "fix",
   "problem": "稿件说把胡适推向“后来那个决定”（只用白话作诗）的是送别诗引起的偶然事件，这把来源的两处说法混在一起了。胡适说送别诗引起的是“这许多严肃性的讨论”和历史研析；让他“下定决心不写旧诗”的，他归于湖上那件“偶然发生的小事”。",
   "evidence": [
    {
     "id": "HS-E15",
     "quote": "这许多严肃性的讨论，和我后来所做的历史性的研析，实在只是由于我写了一首向去哈佛升学朋友的送别诗所引起的小小偶然事件"
    },
    {
     "id": "HS-E38",
     "quote": "那时还有一桩值得一提的偶然发生的小事，也引起了连锁性的反应。其结果竟使我下定决心不写旧诗，要写就用活的语言来写"
    }
   ],
   "proposed": "中文改为“按他自己的说法，这许多严肃的讨论都只源于一首送别诗引起的小小偶然事件；让他下定决心不写旧诗的，则是又一件小意外——湖上那场险事。”英文对应改为“In his own telling, all the serious discussion grew out of a small accident set off by a farewell poem, and it was another small accident, the incident on the lake, that made him resolve to stop writing old-style verse.”"
  },
  {
   "id": "V4",
   "path": "sections.limits.2",
   "category": "readability",
   "severity": "note",
   "problem": "“以这一论调讲演”中的“这一论调”找不到前文所指。上一段讲的是唐德刚对“半死的文字”和白话诗的评论，读者不知道格里德嗤之以鼻的是哪种说法。",
   "evidence": [
    {
     "id": "HS-E28",
     "quote": "适之先生一辈子都坚持着这个论调。反对他的人就觉得他居功太多"
    },
    {
     "id": "HS-E27",
     "quote": "因而没有“胡适”，恐怕也就没有“白话文运动”"
    }
   ],
   "proposed": "中文改为“胡适一辈子坚持‘一连串意外加上他本人的试验促成了白话文运动’这一说法，唐德刚记下，反对他的人觉得他居功太多……”；英文相应写明“this account”指什么。"
  }
 ],
 "overall": "定稿大体有据，引语逐字、推断已标注，但开头两段需修：一处把争论的终点写成起点，一处把下定决心的诱因从湖上事件误归于送别诗；另有两处易读性小问题。"
}