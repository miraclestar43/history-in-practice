 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文写“还说这一路是被「逼上梁山」的”，明确是胡适自己的说法。英文却写成“He had been pushed here — bi shang Liangshan”，把他的自述写成了叙述者的断言，中英归属不一致。",
   "evidence": [
    {
     "id": "HS-E2",
     "quote": "我说我是被“逼上梁山”的。"
    }
   ],
   "proposed": "英文改为：\"He said he had been pushed here — bi shang Liangshan, 'driven to Liangshan,' ...\""
  },
  {
   "id": "V2",
   "path": "sections.story.2",
   "category": "facts",
   "problem": "中文写“说白话是民众不知不觉中完成的文学革命的高潮”。原文说的是用语体文写的活文学（最明显的如元曲）是这一革命的最高潮，不是“白话”本身。",
   "severity": "fix",
   "evidence": [
    {
     "id": "HS-E13",
     "quote": "这种用语体文写的活文学——最明显的如元曲——便是人民大众在不知不觉中完成的文学革命的最高潮"
    }
   ],
   "proposed": "改为：“说用白话写的活文学——最明显的如元曲——是民众不知不觉中完成的文学革命的最高潮。”"
  },
  {
   "id": "V3",
   "path": "sections.story.2",
   "category": "parity",
   "severity": "fix",
   "problem": "中英内容不对等。英文另有三处中文没有的内容：“活文学代替死文学”与“文学革命”的定义；唐代和尚、宋代哲学家、百姓歌曲戏剧小说的递进；“中国文学之复苏得力于白话戏曲小说”。另外，中文“在剑桥的梅光迪”容易被读成英国剑桥，英文则写明是麻州。",
   "evidence": [
    {
     "id": "HS-E12",
     "quote": "一部中国文学史也就是一部活文学逐渐代替死文学的历史"
    },
    {
     "id": "HS-E13",
     "quote": "我写了一封长信给麻州剑桥的梅君"
    }
   ],
   "proposed": "二选一：在中文补入对应的简述，并把“剑桥”改为“麻州剑桥（哈佛所在）”；或删减英文，使两版一致。"
  },
  {
   "id": "V4",
   "path": "sections.story.4",
   "category": "parity",
   "severity": "fix",
   "problem": "英文有以下内容，中文没有：陈衡哲是沃莎女子学院学生；“言”字出自《诗经》；对这批留学生算是险事；梅光迪“反对到底”“大加挞伐”。英文还把梅的主张写成两句，中文只有一句。",
   "evidence": [
    {
     "id": "HS-E16",
     "quote": "莎菲陈（衡哲）——她是沃莎女子学院的学生"
    },
    {
     "id": "HS-E17",
     "quote": "所以我的一切激进他都反对到底"
    }
   ],
   "proposed": "中文补入以上几点，例如“沃莎女子学院的陈衡哲”“《诗经》里‘言’一类的老字”“梅对他的一切激进主张都反对到底，并据此对他的观念大加挞伐”；或删减英文，使两版一致。"
  },
  {
   "id": "V5",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件写两人共同的让步是“唯独不能用在诗里”（英文为 everything except poetry）。但证据中梅光迪说的是高级散文里也用不得，“只剩诗”是胡适本人的归纳。现在的写法删去了改变判断的限定。",
   "evidence": [
    {
     "id": "HS-E19",
     "quote": "但是在高级散文里——肯定的是在诗里面——白话千万用不得"
    },
    {
     "id": "HS-E20",
     "quote": "则我的朋友们除了“诗”这个堡垒之外，其他方面已经全部向我让步了"
    }
   ],
   "proposed": "补一句，并标明归纳者：“梅光迪还说高级散文里也用不得；按胡适的归纳，双方最后只争诗这一处。”英文同步修改。"
  },
  {
   "id": "V6",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "中文“第二，也是更要紧的一条”改变了原意。原文是说这一条是朋友们“更能言之成理的”理由，指对方的论证更有力，不是作者判断它更重要。英文 more telling 也略偏。另外，中文漏了第一条与朋友立论的关联（白话诗数量太少使他们振振有词），英文却有。",
   "evidence": [
    {
     "id": "HS-E20",
     "quote": "第二，也是他们更能言之成理的，则是从来没有中国作家认真着实用白话来作诗作文。"
    },
    {
     "id": "HS-E20",
     "quote": "所以使他们振振有词的原因，是白话诗的数量太少"
    }
   ],
   "proposed": "中文改为“第二，也是朋友们更能言之成理的一条”，并在第一条后补“这使朋友们振振有词”；英文改为 \"Second, and the more persuasive for his friends\"。"
  },
  {
   "id": "V7",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "本段证据列了 HS-E28，正文却没有用。这一条记录了反对者认为胡适居功太多，格里德对这一论调嗤之以鼻。全文主线依赖胡适自述的首倡角色，这一异议会改变读者的判断，应在“边界”中说明。",
   "evidence": [
    {
     "id": "HS-E28",
     "quote": "反对他的人就觉得他居功太多。"
    }
   ],
   "proposed": "在反事实一句后补：“唐德刚也记下，反对胡适的人觉得他居功太多，后来为他作传的格里德曾对这一论调嗤之以鼻。”英文同步。"
  },
  {
   "id": "V8",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "“均非书中记载／neither is recorded in the book”是在断言完整来源里没有什么。这里不需要这样写，只要说明这些段落的性质即可。",
   "evidence": [
    {
     "id": "HS-E35",
     "quote": "所以笔者还是把它翻译回来了"
    }
   ],
   "proposed": "改为“凡标为 interpretation 的段落是作者推断，标为 modern 的段落是为今日读者虚构的场景，都不是本文所据材料的记述”。英文改为 \"...neither is drawn from the material this piece relies on.\""
  },
  {
   "id": "V9",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "中文首次出现任鸿隽时只写“在康乃尔的任鸿隽”，没有说明他是胡适的朋友。白璧德首次出现时也没有交代身份，直到 story.4 才称“保守派批评家”。英文两处都有说明。",
   "evidence": [
    {
     "id": "HS-E10",
     "quote": "当时在康乃尔的另一位中国朋友任鸿隽（叔永）"
    },
    {
     "id": "HS-E8",
     "quote": "当时有名的文学批评家白壁德（IrvingBabbitt）"
    }
   ],
   "proposed": "改为“同在康乃尔的另一位中国朋友任鸿隽”“跟著名文学批评家白璧德深造”。"
  },
  {
   "id": "V10",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "note",
   "problem": "中文一口气列出陈衡哲、杨铨、唐钺，三人此前都没有出现，后文也不再提及，读者不知道他们是谁。",
   "evidence": [
    {
     "id": "HS-E16",
     "quote": "这件事对这批中国留学生来说，也可算是件险事"
    }
   ],
   "proposed": "改为“任鸿隽、梅光迪和陈衡哲、杨铨、唐钺等几位中国留学生”。"
  }
 ],
 "overall": "引语逐字核对无误，推断和现代场景的标注也到位；但仍有几处必须修改：英文归属、白话“高潮”的说法、梅光迪“高级散文”这一限定、第二条理由的原意、两段中英不对等、遗漏的“居功太多”异议，以及一处关于完整来源的否定断言。"
}