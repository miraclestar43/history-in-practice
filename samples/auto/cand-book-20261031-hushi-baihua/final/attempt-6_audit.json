 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "“胡适没有再争下去／Hu Shi stopped arguing”与证据不符。他决定自己试验之后，仍在7月26日写信向任鸿隽申说理由，并没有停止争论。证据只说他认定以身作则是唯一办法。",
   "evidence": [
    {
     "id": "HS-E20",
     "quote": "那我只有以身作则，来认真尝试用白话作诗。除此之外，再没有其他的办法了。"
    },
    {
     "id": "HS-E21",
     "quote": "因此在七月二十六日我就写了一封信给吾友任君"
    }
   ],
   "proposed": "改为“胡适认定只有以身作则，决定自己去试。”英文同步改为 Hu Shi concluded that the only way was to try it himself."
  },
  {
   "id": "F2",
   "path": "sections.hook.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“胡适接下来做的事，比他的任何一句辩论都更有说服力”是作者的评价，没有标注为解释。证据也没有记载他的试验说服了任何人。",
   "evidence": [],
   "proposed": "删去这句，或改为“胡适接下来没有只靠辩论，而是决定自己动手去试。”英文同步修改。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头一口气列出五个人名，胡适本人却没有交代身份（在美国的中国留学生）。陈衡哲、杨铨、唐钺此后都不再出现，读者分不清谁是本事的关键人物。",
   "evidence": [
    {
     "id": "HS-E16",
     "quote": "我的朋友任鸿隽、莎菲陈（衡哲）——她是沃莎女子学院的学生——梅光迪、杨铨、唐钺等人在〔绮色佳〕凯约嘉湖上划船"
    }
   ],
   "proposed": "首句写明“在美国留学的胡适”。船上的人改为“任鸿隽、梅光迪等几位中国朋友”，其余姓名可移到正文后部，或保留但不占开头的焦点。英文同步修改。"
  },
  {
   "id": "F4",
   "path": "sections.context.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "“当时正去哈佛／then on his way to Harvard”放在1916年夏的语境里。证据中梅光迪准备去哈佛是在胡适离开康乃尔、写送别诗的时候；到湖上事件时，他已被称为“哈佛朋友”。",
   "evidence": [
    {
     "id": "HS-E8",
     "quote": "当我正准备离开康乃尔之时，我的朋友梅光迪那时在绮色佳度假，正准备去哈佛升学"
    },
    {
     "id": "HS-E16",
     "quote": "而是另一位哈佛朋友梅君"
    }
   ],
   "proposed": "改为“梅光迪，此时在哈佛随一位保守派文学批评家深造”。英文同步改为 then studying at Harvard under..."
  },
  {
   "id": "F5",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“爱用打油诗取笑胡适／liked to tease Hu in comic verse”把一次行为写成了习惯。证据只记任鸿隽作过一首打油诗嘲笑胡适。",
   "evidence": [
    {
     "id": "HS-E10",
     "quote": "也作了一首打油诗来嘲笑我"
    }
   ],
   "proposed": "改为“曾作打油诗取笑胡适”。英文同步改为 who once teased Hu in comic verse。"
  },
  {
   "id": "F6",
   "path": "sections.story.2",
   "category": "chronology",
   "severity": "fix",
   "problem": "正文把“记下九条（7月6日）时收到湖上来信”写成确定的事实。证据中湖上事件发生在7月8日，晚于7月6日，“同时”只是胡适自己的说法，时间上对不上。",
   "evidence": [
    {
     "id": "HS-E38",
     "quote": "就在我记录上述九条的同时，我又收到一封从绮色佳的来信"
    },
    {
     "id": "HS-E16",
     "quote": "原来那年七月八日我的朋友任鸿隽"
    },
    {
     "id": "HS-E15",
     "quote": "以上九条是记载在我一九一六年七月六日的日记之中"
    }
   ],
   "proposed": "改为“据胡适回忆，大约在记下这九条的同时，他收到了开头那封信（湖上事件按他的说法发生在7月8日）。”英文同步修改。"
  },
  {
   "id": "F7",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“当众接下了举证的责任／publicly took on”所依据的前提没有证据支持。证据只说他在写出几首白话诗之前就决定了诗集名，没有说他公开宣布过。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "在我还没有写出几首白话诗之前，我已决定把我下一个诗集定名为《尝试集》了"
    }
   ],
   "proposed": "删去“当众／publicly”，改为“等于先替自己定下了要举证的任务”。"
  },
  {
   "id": "F8",
   "path": "sections.analysis.1",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“两人是否事先商量过”这一猜测在证据中毫无依据。证据中胡适对放低调子另有说明（顾虑老一辈保守派），陈独秀是在文章刊出之后才响应。提出这一猜测等于暗示一种未经记录的共谋。",
   "evidence": [
    {
     "id": "HS-E23",
     "quote": "为考虑到那无可怀疑的老一辈保守分子的反对，我觉得我要把这一文题写得温和而谦虚"
    },
    {
     "id": "HS-E25",
     "quote": "他在《新青年》的后一期也写了一篇《文学革命论》来作为响应"
    }
   ],
   "proposed": "删去“两人是否事先商量过……一种可能”一句，只保留“发表时他把调子放低，陈独秀随后把旗子举高”。英文同步修改。"
  },
  {
   "id": "F9",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“只用了四年左右／it took about four”把范围扩大到了整场斗争。胡适说的是：四年时间里，在学校内以白话代替文言“几乎已完全成功”。",
   "evidence": [
    {
     "id": "HS-E30",
     "quote": "我们只用了短短的四年时间，要在学校内以白话代替文言，几乎已完全成功了"
    }
   ],
   "proposed": "改为“结果只用了四年左右，在学校里以白话代替文言就几乎完全成功了”。英文同步修改。"
  },
  {
   "id": "F10",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "正文引用了五四以后学生刊物大增，却漏掉胡适本人紧接着的限定：他认为五四学生运动是对文艺复兴运动的一种“干扰”，把文化运动转成了政治运动。缺了这一句，读者会以为他对五四只有肯定。",
   "evidence": [
    {
     "id": "HS-E30",
     "quote": "是对中国文艺复兴运动的一种干扰——它把一个文化运动转变成为一项政治运动——但是对传播白话文来说，五四运动倒是功不可没的"
    }
   ],
   "proposed": "在学生刊物一句后补上：“他同时说，五四学生运动对文化运动是一种‘干扰’，把它变成了政治运动，但对传播白话文功不可没。”英文同步补上。"
  },
