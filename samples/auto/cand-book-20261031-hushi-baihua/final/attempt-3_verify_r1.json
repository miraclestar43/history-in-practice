 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.3",
   "category": "facts",
   "severity": "fix",
   "problem": "胡适原话是“至少获得了部分的胜利”，这是一个保底式的肯定。稿件中文用“但他称之为‘部分的胜利’”构成转折，英文写成“Yet he called it only a partial victory”，把“至少”改成了“只”，方向与原文相反，削弱了胡适自己的评价。",
   "evidence": [
    {
     "id": "HS-E30",
     "quote": "因此在我们的斗争中，至少获得了部分的胜利。其中重要的部分就是以白话文为教育的工具。"
    }
   ],
   "proposed": "中文改为：他说这场斗争“至少获得了部分的胜利”，其中重要的部分是以白话为教育工具。英文改为：He said the struggle had won at least a partial victory, the important part being the vernacular as the instrument of education. 同时删去“Yet”“only”及中文的“但”。"
  },
  {
   "id": "V2",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "“绮色佳”首次出现时没有说明它与康乃尔的关系。不熟悉背景的读者不知道它就是康乃尔所在的小城，后文的“凯约嘉湖”也因此难以定位。",
   "evidence": [
    {
     "id": "HS-E10",
     "quote": "所以我在从绮色佳去纽约的火车上"
    },
    {
     "id": "HS-E16",
     "quote": "〔绮色佳〕凯约嘉湖上划船"
    }
   ],
   "proposed": "首次出现处改为“绮色佳（康乃尔所在的小城）”。英文 Ithaca 可同样加注 home of Cornell。"
  },
  {
   "id": "V3",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "稿件写“文章誊了三份”，后面只列出两份的去向，读者会追问第三份去了哪里。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "我一共复写了三份。一份给由我自己做主编的《中国留美学生季报》发表。……另一份则寄给当时一份新杂志《新青年》。"
    }
   ],
   "proposed": "改为“文章复写了三份，其中一份交给……，另一份寄给……”。英文改为 Of the three copies, one went to…, another to…。不补写第三份的去向。"
  },
  {
   "id": "V4",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "“标为 interpretation 的段落”“标为 modern 的段落”用的是编辑系统内部的标签，读者在正文里看不到这些标记，无法据此辨认哪些段落是推断、哪些是虚构场景。",
   "evidence": [],
   "proposed": "改为：文中写明“作者推断”“一种解释”的段落是作者的推断；“今天怎么用”和“思考”部分是为今日读者虚构的场景。英文作相应修改。"
  }
 ],
 "overall": "定稿的事实、引语与归属基本都有证据支持，需修正 analysis.3 中把“至少获得部分的胜利”写成“只是部分胜利”的偏差，另有三处易读性小注，修改后可发。"
}