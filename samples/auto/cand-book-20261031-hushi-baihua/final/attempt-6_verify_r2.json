 "issues": [
  {
   "id": "V1",
   "path": "sections.story.4",
   "category": "chronology",
   "severity": "fix",
   "problem": "中文稿写“最后顺着他的话反将一军”。证据只说开头写老梅发脾气、接着讨论死活文字，并“特别提出”锻炼一点，没有说这段放在诗的最后。英文稿也没有“最后”，中英不一致。",
   "evidence": [
    {
     "id": "HS-E18",
     "quote": "开头我描写老梅大发脾气，接着我又讨论了一些死文字和活文字不同之点。"
    },
    {
     "id": "HS-E18",
     "quote": "我特别提出了他所说的文字必须经过诗人、美术家长期锻炼那一点来驳他"
    }
   ],
   "proposed": "把“最后顺着他的话反将一军”改为“还特别顺着他的话反将一军”。"
  },
  {
   "id": "V2",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "稿件写“北大另一位……教授”，但前文只说陈独秀主编《新青年》，从未交代他是北京大学文科学长。读者看不出“另一位”是相对谁说的。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "陈氏于一九一六年受聘为国立北京大学文科学长。"
    }
   ],
   "proposed": "在 story.7 或 story.8 首次提到陈独秀时补一句“时任北京大学文科学长”，英文同步补 then dean of letters at Peking University。"
  }
 ],
 "overall": "定稿事实、引语与归属基本都有证据支持；需把 story.4 中证据未载的“最后”改掉，另建议补出陈独秀的北大身份以便理解，修改后可发。"
}