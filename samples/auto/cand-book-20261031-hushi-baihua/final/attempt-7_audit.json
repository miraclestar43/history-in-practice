 "issues": [
  {
   "id": "F1",
   "path": "sections.context.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文把“逼上梁山”释为“being forced by circumstances into a rebel's course”。胡适自己的释义是：为环境所迫，不得已做出违反本意的非常行为。英文的释义偏离了这一点，而且中文版没有这句释义。",
   "evidence": [
    {
     "id": "HS-E2",
     "quote": "不得已而做出违反他本意的非常行为"
    }
   ],
   "proposed": "英文改为：the Chinese idiom for being forced by circumstances into drastic action against one's own will。或者删去释义，与中文保持一致。"
  },
  {
   "id": "F2",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“privately looking down on the spoken language”意味着有意识地私下轻视。证据说的是“下意识的鄙弃”。",
   "evidence": [
    {
     "id": "HS-E20",
     "quote": "他们都对白话有一种下意识的鄙弃"
    }
   ],
   "proposed": "英文改为“while unconsciously looking down on the spoken language”。中文“骨子里”可保留，也可改为“下意识里”。"
  },
  {
   "id": "F3",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "“找不到同伴”和“with no companions”把话说绝了。原信是“不能多得同志”，即同伴难得，并非完全没有。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "可惜须单身匹马而往，不能多得同志，结伴同行"
    }
   ],
   "proposed": "中文改为“可惜要单身匹马前往，难得同伴”。英文改为“He would have to ride out alone, with few companions”。"
  },
  {
   "id": "F4",
   "path": "sections.story.6",
   "category": "inner_life",
   "severity": "fix",
   "problem": "本段是记录段（kind=record），却把信中的假设说法写成他的考虑：“给自己留了后路”。证据只记他说可能终归文言诗国，同时还写了“然我去志已决”。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "然我去志已决"
    },
    {
     "id": "HS-E22",
     "quote": "则我或终归老于"
    }
   ],
   "proposed": "中文改为“他也说：如果这块新地全是不毛之地，他也许终究还要回到‘文言诗国’”。英文改为“He also wrote that if the new land turned out to be barren...”。“留后路”的说法只留在已标明“作者推断”的分析段。"
  },
  {
   "id": "F5",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "“北大另一位……教授”预设读者知道陈独秀在北大任职，但正文从未交代。读者会不明白“另一位”是相对谁而言。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "陈氏于一九一六年受聘为国立北京大学文科学长"
    },
    {
     "id": "HS-E25",
     "quote": "北京大学一校之内便有两位教授对之极为重视"
    }
   ],
   "proposed": "在 story.7 或 story.8 首次提到陈独秀时补一句“时任北京大学文科学长”，英文同步。"
  },
  {
   "id": "F6",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "“这是当事人多年后的回忆，不是当时的独立记录”这句话一概而论，没有区分两类文本。本章确实是晚年口述，但其中引述了1916年7月6日日记和7月26日致任鸿隽信等当时文字。读者会误以为这些引文也只是回忆。",
   "evidence": [
    {
     "id": "HS-E15",
     "quote": "以上九条是记载在我一九一六年七月六日的日记之中"
    },
    {
     "id": "HS-E21",
     "quote": "因此在七月二十六日我就写了一封信给吾友任君"
    },
    {
     "id": "HS-E35",
     "quote": "多少也有点出入"
    }
   ],
   "proposed": "改为：这一章整体是胡适晚年的口述回忆，其中引述了他1916年7月6日的日记和7月26日致任鸿隽的信等当时文字；本文依据的只是经胡适转引、再经英译与回译的文本，没有查阅原件。英文同步修改。"
  },
  {
   "id": "F7",
   "path": "uncertainty_note",
   "category": "attribution",
   "severity": "fix",
   "problem": "关于白话诗试验的结果，文中只给了唐德刚“白话诗则未必”的评语，没有给出胡适本人在同一章的自评“新诗大有成就”。读者会以为来源对这项试验只有否定判断。",
   "evidence": [
    {
     "id": "HS-E29",
     "quote": "则未必——至少是还未脱离"
    },
    {
     "id": "HS-E40",
     "quote": "四十年来的新诗更是大有成就"
    }
   ],
   "proposed": "在唐德刚评语旁并列一句：“胡适本人在同一章则说「四十年来的新诗更是大有成就」，同时承认新文学各部门发展并不平均。”两种看法分别标明是谁的观点。英文同步。"
  }
 ],
