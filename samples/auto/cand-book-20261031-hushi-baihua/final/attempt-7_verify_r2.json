 "issues": [
  {
   "id": "V1",
   "path": "sections.story.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "稿件用叙述者口吻直接写出两点：梅光迪受老师影响，以及因此对胡适的一切激进主张反对到底。这既是对梅光迪动机的判断，也是一条因果。证据中这是胡适的说法，稿件没有标明出处。英文 under the influence of his conservative teacher, he opposed everything radical 同样如此。",
   "evidence": [
    {
     "id": "HS-E17",
     "quote": "这时的梅觐庄正受了他那位保守派文学批评老师白壁德教授的影响。所以我的一切激进他都反对到底。"
    }
   ],
   "proposed": "中文改为“在胡适看来，梅光迪那时正受他那位保守派老师的影响，所以对胡适的一切激进主张都反对到底。”英文相应改为 \"As Hu saw it, Mei was then under the influence of his conservative teacher and so opposed everything radical Hu proposed.\""
  },
  {
   "id": "V2",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "story.8 写“北大另一位研究古典音韵学的教授”，“另一位”预设读者已知陈独秀在北大任职。但稿件此前只写到陈独秀主编《新青年》，没有交代他与北大的关系，读者会不明白“另一位”从何说起。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "陈氏于一九一六年受聘为国立北京大学文科学长。"
    },
    {
     "id": "HS-E25",
     "quote": "北京大学一校之内便有两位教授对之极为重视。其一则为陈独秀本人。"
    }
   ],
   "proposed": "在 story.7 首次提到陈独秀处补半句“陈独秀1916年已受聘为北京大学文科学长”，英文同步补上。"
  },
  {
   "id": "V3",
   "path": "title",
   "category": "readability",
   "severity": "note",
   "problem": "英文中《尝试集》的译名前后不一：标题作 Book of Experiments，story.6 作 Experiments。读者可能以为是两样东西。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "我已决定把我下一个诗集定名为《尝试集》了"
    }
   ],
   "proposed": "统一一个英文译名，例如两处都用 Experiments，或都用 Book of Experiments。"
  }
 ],
 "overall": "定稿事实、引文、日期和中英对应基本都有证据支持，来源说明也写成了本文依据的范围；只需在 story.3 补上“在胡适看来”的归属，另有两处易读性小问题可以顺手调整。"
}