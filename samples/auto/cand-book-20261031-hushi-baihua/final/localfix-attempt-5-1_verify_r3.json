 "issues": [
  {
   "id": "V1",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "合写论文的“一位同学”在此处没有名字。直到 story.9 才以“当年与他分写论文的赵元任”出现，读者要回头才能对上是同一个人。",
   "evidence": [
    {
     "id": "HS-E5",
     "quote": "因而我就和我在一九一〇年同时进康乃尔的赵元任谈起这些问题"
    }
   ],
   "proposed": "zh 改为“于是他和1910年同时进康乃尔的同学赵元任商定”；en 相应改为“he agreed with Zhao Yuanren, who had entered Cornell with him in 1910”。"
  },
  {
   "id": "V2",
   "path": "sections.story.4",
   "category": "readability",
   "severity": "note",
   "problem": "凯约嘉湖（story.4）和绮色佳（story.3）都没有交代彼此的关系，读者不知道湖在哪里，也不知道它与朋友们夏天聚会的地方有什么联系。",
   "evidence": [
    {
     "id": "HS-E16",
     "quote": "在〔绮色佳〕凯约嘉湖上划船"
    }
   ],
   "proposed": "把“在凯约嘉湖上划船”改为“在绮色佳的凯约嘉湖上划船”；en 改为“rowing on Cayuga Lake at Ithaca”。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "style",
   "severity": "note",
   "problem": "hook.1 中“把反对理由排个队”的两条，几乎逐句重复了 story.6；“送别诗引起的小小偶然事件”一句也在 story.3 重复出现，读来累赘。",
   "evidence": [
    {
     "id": "HS-E20",
     "quote": "我开始用的战术是把他们反对我的原因排个队"
    }
   ],
   "proposed": "hook.1 只保留一句概括：“胡适的办法是先把朋友们的反对理由排个队，再以身作则。”两条理由的细节留给 story.6。"
  },
  {
   "id": "V4",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "正文写“文章誊了三份”，却只交代了两份的去向，读者会追问第三份去了哪里。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "我一共复写了三份。一份给由我自己做主编的《中国留美学生季报》发表。"
    }
   ],
   "proposed": "zh 改为“文章复写了三份，其中一份交给……，另一份寄给……”；en 改为“He made three copies; one went to…, another to…”。"
  },
  {
   "id": "V5",
   "path": "title",
   "category": "readability",
   "severity": "note",
   "problem": "《尝试集》的英文译名前后不一：标题作 Book of Experiments，story.7 和 analysis.1 作 Experiments，英文读者可能以为是两本书。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "我已决定把我下一个诗集定名为《尝试集》了"
    }
   ],
   "proposed": "统一译名，例如全文都用 Experiments (Changshi ji)，或都用 Book of Experiments。"
  }
 ],
 "overall": "定稿的事实、引文、时序和归属都与证据一致；推断已标为本文解释，唐德刚的评论也已标明是译注者的意见。开头的易读性过关，只需按上列注意项做小幅改动。"
}