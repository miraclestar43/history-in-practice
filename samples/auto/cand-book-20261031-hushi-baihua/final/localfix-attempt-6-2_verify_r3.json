 "issues": [
  {
   "id": "V1",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "稿件写“北大另一位研究古典音韵学的教授”（英文 Another Peking University professor）。但前文只介绍陈独秀是《新青年》主编，从未交代他在北大任职，读者看不出“另一位”是相对谁说的。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "陈氏于一九一六年受聘为国立北京大学文科学长"
    },
    {
     "id": "HS-E25",
     "quote": "北京大学一校之内便有两位教授对之极为重视。其一则为陈独秀本人。"
    }
   ],
   "proposed": "首次提到陈独秀时补上身份：中文写“时任北京大学文科学长的陈独秀”，英文写“Chen Duxiu, dean of letters at Peking University”。也可以把后句改为“北大另一位教授、研究古典音韵学的学者”。"
  },
  {
   "id": "V2",
   "path": "title",
   "category": "readability",
   "severity": "note",
   "problem": "英文版对《尝试集》的译名不统一：标题用 Book of Experiments，story.6 和 analysis.1 用 Experiments。读者可能以为是两样东西。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "我已决定把我下一个诗集定名为《尝试集》了"
    }
   ],
   "proposed": "英文统一用一个译名。例如标题保留 Book of Experiments，story.6 和 analysis.1 也改为 Book of Experiments。或者三处都用 Experiments。"
  }
 ],
 "overall": "事实、引语、归属与时序均与证据相符，推断已标明，中英对应完整，开头能读懂。只有两处易读性小问题（陈独秀的北大身份未交代，英文诗集译名不统一），建议顺手修正，可以发稿。"
}