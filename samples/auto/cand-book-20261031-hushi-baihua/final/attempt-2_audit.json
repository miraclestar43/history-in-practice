 "issues": [
  {
   "id": "F1",
   "path": "sections.analysis.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "本段把“传单、送别诗、湖上险些翻船都是意外”写成胡适本人的史观。证据中胡适明确称作意外的是送别诗，并泛称“一连串的小意外事件”。写湖上划船一段时他说“虽然没有发生什么意外”，没有把这件事称作他所说的意外。把湖上险事（以及未被明确点名的传单）归入这一串，是本文自己的归并。英文同样有此问题。",
   "evidence": [
    {
     "id": "HS-E10",
     "quote": "意外的小事"
    },
    {
     "id": "HS-E15",
     "quote": "送别诗所引起的小小偶然事件"
    },
    {
     "id": "HS-E9",
     "quote": "一连串的小意外事件，逐渐地强迫我采取了这个立场"
    },
    {
     "id": "HS-E16",
     "quote": "虽然没有发生什么意外"
    }
   ],
   "proposed": "中文改为：“他明确把送别诗称作‘意外的小事’，并说是‘一连串的小意外事件’逐渐把他推到这个立场；本文把传单和湖上险些翻船引出的争论也放进这一串，这是本文的归并。”英文改为：\"He explicitly called the farewell poem an accident and spoke of a chain of small accidents; placing the leaflet and the near-capsize on the lake in that chain is this article's own grouping.\""
  },
  {
   "id": "F2",
   "path": "sections.story.4",
   "category": "parity",
   "severity": "fix",
   "problem": "英文开头写 \"Two days later, another accident.\"，把湖上险事称作 accident。证据只称其为“险事”，并说“虽然没有发生什么意外”。中文作“险事”，中英不一致，英文还暗中把此事归入胡适所说的“意外”。",
   "evidence": [
    {
     "id": "HS-E16",
     "quote": "虽然没有发生什么意外"
    },
    {
     "id": "HS-E16",
     "quote": "也可算是件险事"
    }
   ],
   "proposed": "英文改为：\"Two days later came a close call on Cayuga Lake.\""
  },
  {
   "id": "F3",
   "path": "sections.story.9",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文写陈独秀说自己 \"was only hoisting a flag in support\"，多出了 only。证据是陈独秀“高张大旗”为朋友声援，没有自谦为“只是”。中文“自己高张大旗作声援”无此问题。",
   "evidence": [
    {
     "id": "HS-E25",
     "quote": "他自己则高张大旗为他的朋友作声援"
    }
   ],
   "proposed": "英文改为：\"he himself was raising the banner high in his friend's support.\""
  },
  {
   "id": "F4",
   "path": "sections.analysis.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "“按陈独秀的说法……他只是作声援”/“merely coming up in support”有两处问题。一是证据中没有“只是”，原文是“高张大旗”。二是这一说法经胡适转述，应写明是胡适所记。",
   "evidence": [
    {
     "id": "HS-E25",
     "quote": "他坦白地说，那首举义旗号召文学革命的是他的朋友胡适。他自己则高张大旗为他的朋友作声援"
    }
   ],
   "proposed": "中文改为：“据胡适转述，陈独秀坦白说首举义旗的是胡适，他自己高张大旗作声援。”英文删去 merely，改为 \"by Hu's report, Chen said frankly that the banner was Hu's and that he himself was raising it high in support.\""
  },
  {
   "id": "F5",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "推断里把“提前定名《尝试集》”写成“当众揽下举证责任”/“publicly took on the burden of proof”。证据只说他在写出几首白话诗之前已决定诗集名，没有记载他把这个决定公开宣布。“当众”是推断之外另加的事实前提。",
   "evidence": [
    {
     "id": "HS-E22",
     "quote": "在我还没有写出几首白话诗之前，我已决定把我下一个诗集定名为《尝试集》了"
    }
   ],
   "proposed": "中文删去“当众”，改为“等于先给自己揽下举证责任”。英文删去 publicly，改为 \"he took on the burden of proof in advance\"。"
  },
  {
   "id": "F6",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "文中写“文章誊了三份”，随后只列出两份去向。读者会以为漏写了一份，或以为前后数字不符。",
   "evidence": [
    {
     "id": "HS-E24",
     "quote": "我一共复写了三份"
    }
   ],
   "proposed": "中文改为“文章誊了三份，其中一份……另一份……”。英文相应改为 \"Of three copies, one went to… another to…\"。"
  },
  {
   "id": "F7",
   "path": "sections.story.5",
   "category": "readability",
   "severity": "note",
   "problem": "“梅光迪说的范围更宽”/“drew the line more widely”含义含混，读者可能误以为梅允许白话用的范围更宽。证据的意思正相反：梅连高级散文也排除在外。",
   "evidence": [
    {
     "id": "HS-E19",
     "quote": "但是在高级散文里——肯定的是在诗里面——白话千万用不得"
    }
   ],
   "proposed": "中文改为“梅光迪划出的禁区更大”。英文改为 \"Mei ruled out more\"。"
  },
  {
   "id": "F8",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件写英文稿从《逼上梁山》“一节”/“section”节译，唐德刚的原话是“那一章”。",
   "evidence": [
    {
     "id": "HS-E35",
     "quote": "自他《四十自述》的《逼上梁山》那一章里节译出来的"
    }
   ],
   "proposed": "中文“一节”改为“一章”，英文 section 改为 chapter。"
  }
 ],
