 "issues": [
  {
   "id": "V1",
   "path": "sections.limits.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文写成“it is the author's question, not Snow's”，比中文“这是作者提出的疑问”多出一层断言：斯诺从未提出过这个问题。证据只显示斯诺断言两组“没有任何差别”，并不能证明全书中他没有讨论过这个问题。中英因此不一致，英文多出的这层断言也缺少证据支持。",
   "evidence": [
    {
     "id": "W-E4",
     "quote": "As there is no difference whatever, either in the houses or the people receiving the supply of the two Water Companies"
    }
   ],
   "proposed": "英文删去“, not Snow's”，改为“and it is the author's question”，与中文一致。"
  }
 ],
 "overall": "定稿的事实、数字、引语和解释标注整体都有证据支持，中英基本一致；只有limits.1的英文多出“not Snow's”这一无据断言，删去后即可发布。"
}