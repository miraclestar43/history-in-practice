 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头只说斯诺“为一种学说辩护已经五年”，没有交代这一学说与供水、霍乱的关系，也没有说明斯诺在本事中的身份。不了解背景的读者读完开头，说不清他要检验什么。",
   "evidence": [
    {
     "id": "W-E5",
     "quote": "ascertain the exact effect of the water supply on the progress of the epidemic"
    },
    {
     "id": "W-E4",
     "quote": "test the effect of water supply on the progress of cholera"
    }
   ],
   "proposed": "首次提到学说时，用证据范围内的说法点明它关涉的问题，例如“他倡导了五年的学说关涉供水对霍乱的影响”。不要补写证据之外的学说内容或人物履历。"
  },
  {
   "id": "F2",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "开头两段说了“对照已经摆在眼前”，却没有交代难在哪里。真正的难点是很多住户说不清自家用哪家公司的水，这一点要到 story.4 才出现，读者读完开头说不清“为什么难”。",
   "evidence": [
    {
     "id": "W-E6",
     "quote": "they can seldom remember the name of the Water Company till they have looked for the receipt"
    },
    {
     "id": "W-E9",
     "quote": "all that was required was to learn the supply of water to each individual house where a fatal attack of cholera might occur"
    }
   ],
   "proposed": "在 hook.1 末尾加一句（中英同步），说明难点在于要逐户查清用哪家的水，而住户往往自己也不知道。story.4 的细节保留不动。"
  },
  {
   "id": "F3",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "context 第一段堆了1832—1849年的合并史，包括南华克公司、南伦敦公司和伦敦桥水厂。读者此时还用不上这些，却没先告诉读者关键的差别：一家公司的水含伦敦污水，另一家的不含。",
   "evidence": [
    {
     "id": "W-E10",
     "quote": "the united company derived their supply from the Thames at Battersea Fields"
    },
    {
     "id": "W-E4",
     "quote": "one group being supplied with water containing the sewage of London"
    }
   ],
   "proposed": "先用一句话说明两家公司取水口的差别及其意义，合并沿革可以压缩或后置。取水地点等影响判断的事实不要删去。"
  },
  {
   "id": "F4",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "“巴利医生 / Dr Baly”首次出现时没有说明他是谁、与本事有何关系，读者只知道他在某张表里弄错了年份。",
   "evidence": [
    {
     "id": "W-E1",
     "quote": "In the table at page 200, Dr. Baly has fallen into the mistake of supposing"
    }
   ],
   "proposed": "按证据说明他在一张表中把兰贝斯迁址的年份写成了1849年，不补造其他身份信息。也可以把这条考订移到 limits.2。"
  },
  {
   "id": "F5",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "“兰贝斯”“南华克”在文中既是公司名，也是地区名（如“兰贝斯的两个分区”“兰贝斯、南华克和纽因顿其他混供的分区”），读者容易把地区和公司混为一谈。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "two sub-districts of Lambeth, called Kennington, first part, and Kennington, second part"
    },
    {
     "id": "W-E12",
     "quote": "the various other sub-districts of Lambeth, Southwark, and Newington"
    }
   ],
   "proposed": "指地区时写成“兰贝斯区”“南华克区”，指公司时始终带“公司”二字。英文同步使用 district / Company 加以区分。"
  },
  {
   "id": "F6",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "怀廷在这里第一次出现，只写作“怀廷医生 / Mr Whiting”，没有说明他受托替斯诺调查只由南华克和沃克斯霍尔公司供水的地区。他的全名和分工要到 limits.0 才交代。",
   "evidence": [
    {
     "id": "W-E13",
     "quote": "I was fortunate enough to obtain the assistance of a medical man, Mr. John Joseph Whiting, L.A.C."
    }
   ],
   "proposed": "首次出现时补上“协助斯诺调查部分只由南华克和沃克斯霍尔公司供水地区的约翰·约瑟夫·怀廷”，后文统一简称“怀廷”。"
  }
 ],
 "inherited": [
  {
   "id": "P1",
   "verdict": "valid",
   "same_as": "",
   "rationale": "证据只记下斯诺断言两组“没有任何差别”，并没有显示斯诺是否讨论过分组与房租、房龄、地段的关系。英文的“not Snow's”多出一层没有证据支持的断言，中文也没有这层意思，中英不一致。英文应删去“, not Snow's”。",
   "evidence": [
    {
     "id": "W-E4",
     "quote": "As there is no difference whatever, either in the houses or the people receiving the supply of the two Water Companies"
    }
   ]
  }
 ]
