 "issues": [
  {
   "id": "V1",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件引用第二个七周南华克和沃克斯霍尔公司的“每万户537”。OCR原文写的是2,353例死亡对40,046户，按此复算约为每万户588，不是537。说明2,353与537中至少有一个识别有误。兰贝斯一侧可以复算（302÷26,107≈每万户115.7）。稿件对“伦敦其余地区”一行做了同类说明，这一处却把537当作可靠数字引用。",
   "evidence": [
    {
     "id": "W-E17",
     "quote": "Now 2,353 deaths in 40,046 houses, the number supplied by the Southwark and Vauxhall Company, are 537 deaths to each 10,000 houses"
    },
    {
     "id": "W-E17",
     "quote": "continued to suffer nearly five times the mortality"
    }
   ],
   "proposed": "保留斯诺原话“接近五倍”（nearly five times），删去537对115的具体数值。或者保留数值，同时加注：OCR中的死亡数2,353与户数40,046复算不出537，可能有识别错误。"
  },
  {
   "id": "V2",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "本段声称只采用“清楚可辨、能够复算”的数字，但story.6引用的第二个七周每万户537无法由OCR中的2,353÷40,046复算（结果约588）。这个限定与稿件的实际做法不符。",
   "evidence": [
    {
     "id": "W-E17",
     "quote": "Now 2,353 deaths in 40,046 houses, the number supplied by the Southwark and Vauxhall Company, are 537 deaths to each 10,000 houses"
    }
   ],
   "proposed": "在不可复算的例子里补上这一处：第二个七周南华克和沃克斯霍尔公司“2,353例/40,046户”复算不出537，本篇只引用斯诺“接近五倍”的说法。uncertainty_note可同步补一句。"
  },
  {
   "id": "V3",
   "path": "sections.story.2",
   "category": "readability",
   "severity": "note",
   "problem": "法尔医生第一次出现时，稿件没有说明他是谁、为何能让各区登记员填报。后文又出现“登记总长”（Registrar General）提出要求（limits.0），读者可能分不清法尔与登记总长是不是同一人。证据只写明在法尔的建议下发出了要求，由登记总长提出。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "I communicated them to Dr. Farr, who was much struck with the result, and at his suggestion the Registrars of all the south districts of London were requested"
    },
    {
     "id": "W-E16",
     "quote": "the Registrar General requested the District Registrars to make a return of the water supply"
    }
   ],
   "proposed": "不补造头衔，只按证据交代关系：可写作“（他的建议促成了登记总长向各区登记员发出要求）”，让读者分清这两个角色。"
  }
 ],
 "overall": "引语、归属、解释标注和中英一致性基本过关，开头可读。需修正第二个七周“每万户537”这一无法复算的OCR数字，并让limits.2的声明与此一致。另建议交代法尔与登记总长的关系。"
}