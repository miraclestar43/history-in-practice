 "issues": [
  {
   "id": "F1",
   "path": "sections.context.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文写成新公司“撤掉伦敦桥的水厂”，把撤除的主体定为南华克和沃克斯霍尔公司。证据用的是被动语态，没有说明由谁撤除。英文版保留了被动语态，中英不一致。",
   "evidence": [
    {
     "id": "W-E10",
     "quote": "The water works at London Bridge were abolished, and the united company derived their supply from the Thames at Battersea Fields"
    }
   ],
   "proposed": "改为“伦敦桥的水厂被撤除，合并后的公司改从……取水”。"
  },
  {
   "id": "F2",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "证据原文是“可能”来自霍乱病人的东西（might have come）。中文“霍乱病人排出的任何东西”和英文“whatever had come from cholera patients”都去掉了这层保留，把可能性写成了已然。",
   "evidence": [
    {
     "id": "W-E4",
     "quote": "whatever might have come from the cholera patients"
    }
   ],
   "proposed": "中文改为“以及可能来自霍乱病人的任何东西”；英文改为“whatever might have come from cholera patients”。"
  },
  {
   "id": "F3",
   "path": "sections.story.1",
   "category": "facts",
   "severity": "fix",
   "problem": "证据只说获准抄录“其他一些”住址（others），没有说获准抄录其余全部。中文“其余的”和英文“the rest”都说过头了。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "I was kindly permitted to take a copy of others"
    }
   ],
   "proposed": "中文改为“另一些获准抄录”；英文改为“he was allowed to copy others”。"
  },
  {
   "id": "F4",
   "path": "sections.story.2",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写的是登记“发病所在房屋”的供水，英文只写“the house in every fatal case”，丢掉了“发病所在”这一限定。另外英文没有写明只针对霍乱死亡。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "make a return of the water supply of the house in which the attack took place, in all cases of death from cholera"
    }
   ],
   "proposed": "英文改为“to return the water supply of the house in which the attack took place, in every death from cholera”。"
  },
  {
   "id": "F5",
   "path": "sections.story.2",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "本段是 record 段，末句“变成了官方登记里的一栏”/“became a column in the official returns”是作者的概括，未加标注。证据只说登记员“被要求”填报，而且这项规定是“将于”8月26日后执行，并没有记录它实际成了官方报表中的一栏。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "the Registrars of all the south districts of London were requested to make a return of the water supply"
    },
    {
     "id": "W-E11",
     "quote": "This order was to take place after the 26th August"
    }
   ],
   "proposed": "删去末句，或改为标明的解读：“作者认为，一个人在街上查出的苗头由此进入了官方登记的要求之中。”"
  },
  {
   "id": "F6",
   "path": "sections.story.7",
   "category": "causality",
   "severity": "fix",
   "problem": "作者把肯宁顿的“38户对4户”与表九的死亡率并列，称“方向一致”。但肯宁顿数字只是死亡户的计数，证据没有给出两家公司在肯宁顿各自的供水户数，不能当作率来比较。这层推断需要说明缺少分母。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "thirty-eight of the houses in which these deaths occurred were supplied with"
    }
   ],
   "proposed": "在中英文加一句：“肯宁顿的数字只是死亡户数，证据未给出两家在当地各有多少供水户，不能直接当作死亡率比较。”"
  },
  {
   "id": "F7",
   "path": "sections.analysis.1",
   "category": "inner_life",
   "severity": "fix",
   "problem": "“斯诺选了更费事的路”/“Snow took the more laborious road”暗示他权衡过、并放弃了按区平均或贫富对比的方案。证据只记录了他实际怎么做以及他的决心，没有写他考虑过替代方案。",
   "evidence": [
    {
     "id": "W-E5",
     "quote": "I resolved to spare no exertion"
    }
   ],
   "proposed": "中文改为“斯诺实际走的是更费事的路”，英文改为“What Snow actually did was more laborious”，避免暗示他曾比较、放弃其他方案。"
  },
  {
   "id": "F8",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“此后每一例死亡都要记下供水”/“every death came with its water supply recorded”有两处过度概括：一是证据只涉及伦敦南部各区的霍乱死亡，不是所有死亡；二是证据只说登记员“被要求”填报、规定“将于”8月26日后执行，没有记录实际执行情况。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "the Registrars of all the south districts of London were requested to make a return of the water supply of the house in which the attack took place, in all cases of death from cholera."
    }
   ],
   "proposed": "中文改为“伦敦南部各区的登记员随后被要求为每一例霍乱死亡填报发病房屋的供水”；英文相应改为“registrars in the south districts were asked to return the water supply for every cholera death”。"
  },
  {
   "id": "F9",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“提出学说、做调查、编统计的是同一个人”与证据不完全相符。死者住址来自登记总署（部分刊于每周公报），8月26日后的供水信息由各区登记员填报，并非全部由斯诺一人收集。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "to be supplied with the addresses of persons dying of cholera"
    },
    {
     "id": "W-E11",
     "quote": "Some of these addresses were published in the Weekly Returns"
    }
   ],
   "proposed": "补一句：“死者住址来自登记总署，8月26日后的供水信息由登记员填报；但本篇读到的统计和论证都经斯诺之手整理。”"
  },
  {
   "id": "F10",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "证据说按周交租的工人家庭的水费“一律由房东或其代理人缴纳”，住户对“这件事”（用哪家公司）一无所知；并没有说他们不知道水费由谁交。紧接着的“‘选择’往往不在喝水的人手里”是作者的推断，未加标注。",
   "evidence": [
    {
     "id": "W-E6",
     "quote": "the rates are invariably paid by the landlord or his agent, who often lives at a distance, and the residents know nothing about the matter"
    }
   ],
   "proposed": "中文改为“按周交租的工人家庭水费由房东缴纳，住户对用哪家公司的水一无所知”，并把末句标为“作者认为”。英文相应改为“did not even know which company supplied them”，末句前加“One reading is that”。"
  }
 ],
 "inherited": [
  {
   "id": "M1",
   "verdict": "duplicate",
   "same_as": "F7",
   "rationale": "与 F7 相同。“选了更费事的路”暗示斯诺权衡并放弃过其他方案。证据只记录他的决心和实际做法，没有写他考虑过替代方案。",
   "evidence": [
    {
     "id": "W-E5",
     "quote": "I was desirous of making the investigation myself"
    }
   ]
  }
 ]
