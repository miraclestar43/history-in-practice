 "issues": [
  {
   "id": "F1",
   "path": "reflection.example.steps",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文把“同一条街”加引号归给斯诺，看起来像引用斯诺原话，但证据中没有这个说法。英文写作 Snow's single street，也不准确：斯诺的调查覆盖多个混供分区，并不是单独一条街。",
   "evidence": [
    {
     "id": "W-E4",
     "quote": "In many cases a single house has a supply different from that on either side."
    },
    {
     "id": "W-E12",
     "quote": "I pursued my inquiry over the various other sub-districts of Lambeth, Southwark, and Newington"
    }
   ],
   "proposed": "中文改为“相当于斯诺在同一批混供街道里所做的比较”（去掉引号）；英文改为“the equivalent of Snow's comparison within the same intermixed streets”。"
  },
  {
   "id": "F2",
   "path": "sections.story.3",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“而不是死在哪里 / not the place where they died”是证据之外的补充。证据只说病人发病后被送往济贫院或别处，斯诺查的是发病时所住房屋的供水，并没有说这些人死在被送去的地方。",
   "evidence": [
    {
     "id": "W-E12",
     "quote": "I inquired the water supply of the house where the individuals were living when the attack took place."
    }
   ],
   "proposed": "中文改为“而不是他们后来被送去的地方”；英文改为“not the place they had been moved to”。"
  }
 ],
