 "issues": [
  {
   "id": "V1",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "“伦敦其余地区”这一行的数字彼此对不上。1,422 ÷ 256,423 × 10,000 ≈ 55，不是59。同表另两行可以复算：1,263/40,046→315，98/26,107→37。可见这一行的户数或死亡数在OCR中可能已经错乱，稿件却把三个数并列，当作可靠数字呈现。",
   "evidence": [
    {
     "id": "W-E8",
     "quote": "Rest of London .... 256,423 1,422 59"
    }
   ],
   "proposed": "删去“死亡1,422人／1,422 deaths”，只保留斯诺给出的每万户59。或者加一句限定：“OCR文本中该行的户数与死亡数无法复算出59，可能有识别错误”（英文同步）。"
  },
  {
   "id": "V2",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件称表九的户数、死亡数和每万户死亡数都是“清楚可辨”、可以放心采用的数字。但表九“伦敦其余地区”一行在内部无法复算（1,422/256,423≈55，而非59），说明“字迹清楚”并不等于“未被OCR改错”。",
   "evidence": [
    {
     "id": "W-E8",
     "quote": "Rest of London .... 256,423 1,422 59"
    }
   ],
   "proposed": "把例子改为“表九中两家公司的户数、死亡数与每万户死亡数”，并补一句：“‘伦敦其余地区’一行无法复算，本篇只引用其每万户数”（英文同步）。"
  },
  {
   "id": "V3",
   "path": "sections.context.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头第二段一次给出1832–1849年的合并史（南华克公司、南伦敦公司），以及伦敦桥、巴特西原野、沃克斯霍尔桥、亨格福德市场四处地名。读者此时还用不上这么多层级，也没有被告知取水口位置的意义：巴特西原野的水含伦敦污水。这一点要到context.2才说明。",
   "evidence": [
    {
     "id": "W-E4",
     "quote": "the houses supplied with the water from Battersea Fields"
    }
   ],
   "proposed": "压缩合并史，只保留“南华克和沃克斯霍尔公司在巴特西原野取水，兰贝斯公司在亨格福德市场对面取水”。另在下一段或本段点明，前者的取水处在伦敦污水所及范围内，这一点有W-E4的依据。"
  },
  {
   "id": "V4",
   "path": "sections.story.2",
   "category": "readability",
   "severity": "note",
   "problem": "法尔第一次出现时只称“法尔医生（Dr. Farr）”，没有交代他与登记系统的关系。读者不明白为何他一建议，各区登记员就被要求填报。同段及后文还交替出现“登记总署”和“登记总长”，读者容易混淆两者。",
   "evidence": [
    {
     "id": "W-E11",
     "quote": "at his suggestion the Registrars of all the south districts of London were requested"
    }
   ],
   "proposed": "在不补造身份的前提下，用一句话说明角色，例如“斯诺把结果交给法尔医生；正是在法尔的建议下，各区登记员被要求……”。同时在首次出现时注明“登记总长（登记总署的负责人）”，此后统一用这一称呼。"
  },
  {
   "id": "V5",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "note",
   "problem": "怀廷在中文稿里第一次出现时只称“怀廷医生”，没有交代他是协助斯诺调查部分地区的人。全名与分工要到limits.0才出现。",
   "evidence": [
    {
     "id": "W-E13",
     "quote": "I was fortunate enough to obtain the assistance of a medical man, Mr. John Joseph Whiting"
    }
   ],
   "proposed": "首次出现时写作“协助斯诺调查部分地区的医生约翰·约瑟夫·怀廷”，此后统一简称“怀廷”。英文同步改为“John Joseph Whiting, a medical man assisting Snow”。"
  }
 ],
 "overall": "引文、年代、归属与解释标注都经得起证据检验，中英文也基本一致。需要修正的是表九“伦敦其余地区”一行数字无法复算，稿件却把它当作可靠数字引用并在limits里背书；另有三处人物与开头地名的易读性小问题。"
}