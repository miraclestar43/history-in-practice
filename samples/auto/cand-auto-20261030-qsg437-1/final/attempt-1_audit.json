 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "导语把张之洞议奏写成在为京通铁路辩护，并说他把「南北两段」分给督抚。证据只记台谏请停京通铁路。议奏所说的是河北路和自河以南的路，由直隶总督、湖广总督分管，河南巡抚为副，这显然是另一条南北干线。证据没有写这份议奏的对象就是京通铁路。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "會海軍衙門奏請修京通鐵路"
    },
    {
     "id": "QSG4371-E7",
     "quote": "河北路成"
    },
    {
     "id": "QSG4371-E13",
     "quote": "北路責之直隸總督，南路責之湖廣總督，副以河南巡撫"
    }
   ],
   "proposed": "改为「台谏请停修京通铁路；张之洞的议奏则排出修路之利的次序，并把一条南北线路的北段、南段分给督抚」。不要说南北两段就是京通铁路。"
  },
  {
   "id": "F2",
   "path": "dek",
   "category": "unsupported",
   "severity": "fix",
   "problem": "有两处说法证据没有支持。一是「不先辩害/did not begin by answering their harms」，证据摘录不能显示议奏的开篇顺序。二是「传文只留下这一部记载/preserves this one memorial」。",
   "evidence": [],
   "proposed": "删去「不先辩害」和「只留下这一部记载」，改为「议奏中排出修路之利的次序、列成条目」。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "「朝堂上僵住了/had the court at a standstill」无证据。证据只记海军衙门奏请修路，台谏争陈其害、请停办。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "臺諫爭陳鐵路之害，請停辦"
    }
   ],
   "proposed": "改为「要不要修京通铁路，朝中有了争执」/'The proposed Beijing-Tongzhou railway drew opposition at court'。"
  },
  {
   "id": "F4",
   "path": "sections.hook.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把文言原文的英译直接放进引号，读者看不出这是译述。全文英文引语都有这个问题（hook.1、context.0、story.1–8 等）。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "會海軍衙門奏請修京通鐵路，臺諫爭陳鐵路之害，請停辦"
    }
   ],
   "proposed": "在首次引用处注明 'quotations from the Chinese are our translations'，或在各处写 'in our translation'。"
  },
  {
   "id": "F5",
   "path": "sections.hook.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "「他做的第一件事是排序」「没有先去驳那些害」把排序写成议奏的开篇，但证据摘录不显示议奏各部分的先后。「最见功夫」是作者评价，未标为解释。",
   "evidence": [
    {
     "id": "QSG4371-E5",
     "quote": "修路之利，以通土貨、厚民生為最大，徵兵、轉餉次之"
    }
   ],
   "proposed": "改为「议奏中明确排出了目标次序：……」。「最见功夫」前加「作者认为」/'in the author's view'。"
  },
  {
   "id": "F6",
   "path": "sections.context.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "「不是后人替他想的/not one supplied by later hands」不成立。《清史稿》是赵尔巽等后人所修，「恥言和」正是修史者给出的动机，不能当作张之洞本人的自述或同时代记录。",
   "evidence": [
    {
     "id": "QSG4371-E1",
     "quote": "之洞恥言和，則陰自圖強"
    }
   ],
   "proposed": "改为「「耻言和」是《清史稿》修撰者写下的动机，并非本文推测」/'is the motive the compilers of the Draft History assigned'。"
  },
  {
   "id": "F7",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "证据只写到广东的学堂、一个枪炮厂、一个矿务局。正文的「两广/Guangdong and Guangxi」证据原文未出现。英文 'schools… mining bureaus' 用了复数，与证据及本段后文 'a mining bureau' 不一致。",
   "evidence": [
    {
     "id": "QSG4371-E1",
     "quote": "設廣東水陸師學堂，創槍砲廠，開礦務局"
    }
   ],
   "proposed": "改为「在广东设学堂、创枪炮厂、开矿务局」/'in Guangdong he had set up an academy, an arsenal and a mining bureau'。"
  },
  {
   "id": "F8",
   "path": "sections.context.2",
   "category": "causality",
   "severity": "fix",
   "problem": "本段虽标为解释，但「若论兵事，争执只会更烈/the fight only grows hotter」用断言口吻写反事实结果，证据无任何支持。",
   "evidence": [],
   "proposed": "改为「若先论兵事，争执或许更烈（作者推测，传文未载）」/'might have grown hotter (the author's conjecture)'，或删去该半句。"
  },
  {
   "id": "F9",
   "path": "sections.story.0",
   "category": "unsupported",
   "severity": "block",
   "problem": "「编辑简报称七利，第七条未见于本传摘录」引用了证据包外的简报说法，可能来自已剔除的 QSG4371-E12（属已知污染 K1）。证据包只有利一至利六。",
   "evidence": [
    {
     "id": "QSG4371-E11",
     "quote": "太原旺煤鐵，運行便則開採必多，利六"
    }
   ],
   "proposed": "删去「编辑简报称七利，第七条未见于本传摘录」及对应英文，只保留「本文所据摘录列到利六，本文不替其余补写」。"
  },
  {
   "id": "F10",
   "path": "sections.story.1",
   "category": "causality",
   "severity": "fix",
   "problem": "「第一条答的是安全顾虑」「第二条答的是迁坟拆屋的顾虑」把利一、利二写成对台谏具体之害的回应。传文未录台谏所指何害，与 limits.0 自相矛盾。「值得记住的正是……最具体的落点」是作者判断，未标为解释。",
   "evidence": [
    {
     "id": "QSG4371-E9",
     "quote": "內處腹地，無慮引敵，利一；原野廣漠，墳廬易避，利二"
    }
   ],
   "proposed": "改为「利一讲腹地不易引敌，利二讲坟庐易避；一种解释是它们针对安全与迁拆的顾虑，但传文未记台谏所指何害」。后半句加「作者认为」。"
  },
  {
   "id": "F11",
   "path": "sections.story.2",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "「这与……目标顺序是配套的/It matches the goal order」是作者判断，未标为解释。利四落在「足裕餉源」，饷源更接近被列为「次之」的转饷，不能直接视为「通土货、厚民生」的配套。",
   "evidence": [
    {
     "id": "QSG4371-E10",
     "quote": "人貨輻輳，足裕餉源，利四"
    },
    {
     "id": "QSG4371-E5",
     "quote": "徵兵、轉餉次之"
    }
   ],
   "proposed": "改为「作者认为，利三与「厚民生」相呼应；利四则落在饷源上」。"
  },
  {
   "id": "F12",
   "path": "sections.story.3",
   "category": "causality",
   "severity": "fix",
   "problem": "「第五、六条才轮到军事」「与开头的排序一致」不成立。利一「無慮引敵」已涉安全，利四「足裕餉源」已涉饷。传文的编号也没说是按轻重排列，开头只把征兵、转饷列为「次之」。",
   "evidence": [
    {
     "id": "QSG4371-E9",
     "quote": "無慮引敵，利一"
    },
    {
     "id": "QSG4371-E5",
     "quote": "徵兵、轉餉次之"
    }
   ],
   "proposed": "改为「第五条讲集兵，第六条讲煤铁开采」。删去「才轮到」和「与开头的排序一致」及对应英文。"
  },
  {
   "id": "F13",
   "path": "sections.story.3",
   "category": "facts",
   "severity": "fix",
   "problem": "中文转述把「近畿有事」写成「京城有事」，范围不准，与英文 'near the capital' 也不一致。",
   "evidence": [
    {
     "id": "QSG4371-E11",
     "quote": "近畿有事，淮、楚精兵崇朝可集"
    }
   ],
   "proposed": "改为「京畿一带有事」。"
  },
  {
   "id": "F14",
   "path": "sections.story.4",
   "category": "facts",
   "severity": "fix",
   "problem": "英文把「井陘」两次拼作 'Jixing'，应为 Jingxing。",
   "evidence": [
    {
     "id": "QSG4371-E7",
     "quote": "則三晉之轍接於井陘"
    }
   ],
   "proposed": "'Jixing' 改为 'Jingxing'，'Jixing Pass' 改为 'Jingxing'。"
  },
  {
   "id": "F15",
   "path": "sections.story.4",
   "category": "facts",
   "severity": "fix",
   "problem": "「把这条路画成南北两截」暗示议奏的线路就是前文的京通铁路，证据没有支持（见 F1）。",
   "evidence": [
    {
     "id": "QSG4371-E8",
     "quote": "自河以南，則東引淮、吳，南通湘、蜀"
    }
   ],
   "proposed": "改为「他把议奏中的线路画成以河为界的南北两段」/'the line in his memorial'。"
  },
  {
   "id": "F16",
   "path": "sections.story.5",
   "category": "quotes",
   "severity": "fix",
   "problem": "「大家一起管」用了「」引号，但不是证据中的逐字片段，违反引语规则。",
   "evidence": [],
   "proposed": "去掉引号，改为「没有留下各段无人专责的余地」。英文同步去掉引号。"
  },
  {
   "id": "F17",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "「这条铁路的工期、用款……/this railway」所指不清，容易让读者以为获准的就是京通铁路。证据没写获准的线路就是京通铁路。",
   "evidence": [
    {
     "id": "QSG4371-E14",
     "quote": "得旨報可，遂有移楚之命"
    }
   ],
   "proposed": "改为「传文没有记议奏所提线路的工期、用款……」/'the line he proposed'。"
  },
  {
   "id": "F18",
   "path": "sections.story.8",
   "category": "chronology",
   "severity": "fix",
   "problem": "「传文最后给了他一句评语/closes on a verdict」断定这句评语位于传末，证据没有显示其位置。",
   "evidence": [
    {
     "id": "QSG4371-E17",
     "quote": "蒞官所至，必有興作。務宏大，不問費多寡"
    }
   ],
   "proposed": "改为「传文对他有一句评语」/'The biography passes a verdict'。"
  },
  {
   "id": "F19",
   "path": "sections.analysis.0",
