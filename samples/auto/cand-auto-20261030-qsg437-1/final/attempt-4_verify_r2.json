 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写明出处为《清史稿·张之洞传》。英文只写“The Draft History of the Qing records”，紧接着又说“The biography then records”。英文读者不知道这是谁的传，出处层级比中文少了一层。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "會海軍衙門奏請修京通鐵路，臺諫爭陳鐵路之害，請停辦"
    }
   ],
   "proposed": "英文改为“Zhang Zhidong's biography in the Draft History of the Qing records it this way …”"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头出现的海军衙门、翁同龢、徐会沣都没有说明身份。“京通”也未说明是北京至通州。读者能看出各方立场，但分不清他们是谁。证据未给出翁、徐的官职，不宜补写。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵；徐會灃請改修德州濟寧路，利漕運"
    }
   ],
   "proposed": "写“京通（北京至通州）铁路”。翁、徐可称“另有朝臣翁同龢等”“徐会沣”，不补造官职。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "开头只讲京通铁路的修停之争，没有交代张之洞议奏的线路与京通线不同：他提出的是一条以河为界、分南北两段的线路。读者读到后文“南北线路”“北路、南路”时，容易以为这就是京通线，无法说清他究竟提出了什么、为何难以定夺。",
   "evidence": [
    {
     "id": "QSG4371-E7",
     "quote": "河北路成，則三晉之轍接於井陘，關隴之驂交於洛口"
    },
    {
     "id": "QSG4371-E8",
     "quote": "自河以南，則東引淮、吳，南通湘、蜀"
    },
    {
     "id": "QSG4371-E13",
     "quote": "北路責之直隸總督，南路責之湖廣總督，副以河南巡撫"
    }
   ],
   "proposed": "在 hook.1 补一句：“他没有就京通线本身辩护，而是另拟一条以河为界、分南北两段的线路。”英文同步增补。"
  },
  {
   "id": "V4",
   "path": "sections.story.1",
   "category": "readability",
   "severity": "note",
   "problem": "此段引用「務宏大」，英文作“the verdict calls”，但这句评语要到 story.8 才出现。读者此时不知道评语出自何处。",
   "evidence": [
    {
     "id": "QSG4371-E17",
     "quote": "蒞官所至，必有興作。務宏大，不問費多寡"
    }
   ],
   "proposed": "改为“在一个被传文评为「務宏大」的人笔下”。英文改为“a man the biography later describes as aiming at the grand”。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件称“先试修一小段”属传文未载的替代选择，但传文记有翁同龢等「請試修邊地」，“试修”主张本身有记载，只是目的在用兵、地点在边地。另外，“这在议奏中也未见”只能针对传文摘录的议奏而言，不能推及议奏全文。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵"
    },
    {
     "id": "QSG4371-E19",
     "quote": "有此七利，分段分年成之"
    }
   ],
   "proposed": "限定为“传文所录议奏中未见”。并注明：传文记翁同龢等曾请试修边地，但那是为便用兵，不是以运量和扰民程度决定其余各段。英文同步修改。"
  }
 ],
 "overall": "事实、引文与解释标注总体有证据支撑。仍需修订：analysis.2 关于“试修”未载的表述需加限定；hook.0 英文出处须与中文对齐；开头应交代张之洞所拟线路与京通线不同，否则不能通过易读性要求。"
}