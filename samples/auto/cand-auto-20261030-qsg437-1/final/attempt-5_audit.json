 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写明出处是《清史稿·张之洞传》。英文只写 \"The Draft History of the Qing records\"，后文却说 \"The biography then records\"。英文读者不知道是谁的传，出处比中文少了一层。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "臺諫爭陳鐵路之害，請停辦"
    }
   ],
   "proposed": "英文改为 \"Zhang Zhidong's biography in the Draft History of the Qing records it this way ...\"。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "张之洞第一次出现（「其后录有张之洞的议奏」）时没有说明身份，也没有说明他与这场争执的关系。他的身份要到 hook.1 才以“本文传主”交代。不了解背景的读者读到这里，不知道他是谁、为何要上奏。",
   "evidence": [
    {
     "id": "QSG4371-E1",
     "quote": "設廣東水陸師學堂"
    }
   ],
   "proposed": "把“本文传主”的说明挪到第一次出现处，如“其后录有本文传主张之洞的议奏”（英文同步为 \"the memorial of Zhang Zhidong, the subject of this biography\"）。不要补入证据以外的官职。"
  },
  {
   "id": "F3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "开头只讲京通铁路修还是停的争执，没有交代张之洞议奏所论的线路是什么：一条以河为界、分南北两段的线路。读者读到 dek 和后文的“北路、南路”时，容易以为这就是京通线，说不清他究竟提出了什么。",
   "evidence": [
    {
     "id": "QSG4371-E7",
     "quote": "河北路成"
    },
    {
     "id": "QSG4371-E8",
     "quote": "自河以南"
    },
    {
     "id": "QSG4371-E3",
     "quote": "修京通鐵路"
    }
   ],
   "proposed": "在 hook.1 补一句：“他的议奏所论是一条以河为界、分南北两段的线路；传文所录未说明它与京通线的关系。”英文同步增补。不得写入证据以外的起讫地点。"
  },
  {
   "id": "F4",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "翁同龢、徐会沣第一次出现时没有任何身份说明，读者难以判断他们在争执中的位置。证据包没有记他们的官职。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵；徐會灃請改修德州濟寧路，利漕運"
    }
   ],
   "proposed": "可写“另有翁同龢等、徐会沣两种奏请（传文此处未载其职）”。不得补造官职。"
  },
  {
   "id": "F5",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件称替代选择“传文没有记载，属反事实”。但传文记有翁同龢等「請試修邊地」，“试修”这一主张本身有记载，只是目的在用兵、地点在边地，并非以运量与扰民程度决定其余各段。另外，“议奏中也未见”只能指传文所录的议奏文字，不能推及议奏全文。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵"
    },
    {
     "id": "QSG4371-E19",
     "quote": "分段分年成之"
    }
   ],
   "proposed": "改为“传文所录议奏中未见”，并注明：传文记翁同龢等曾请试修边地，但那是为便用兵，不是先修一段、以运量和扰民程度决定其余各段。英文同步修改。"
  },
  {
   "id": "F6",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "稿件称议奏“包含四个部分”，漏掉了 story.4 所述的南北两段接续图景。传文所录议奏实有这一部分，此说与前文不一致，容易让读者以为议奏只有这四项。",
   "evidence": [
    {
     "id": "QSG4371-E7",
     "quote": "河北路成，則三晉之轍接於井陘"
    },
    {
     "id": "QSG4371-E8",
     "quote": "萬里聲息，刻期可通"
    }
   ],
   "proposed": "改为“至少包含以下四个部分（另有南北接续的图景）”。英文同步改为 \"includes at least four components (besides the picture of connections)\"。"
  },
  {
   "id": "F7",
   "path": "sections.story.5",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“没有留下各段无人专责的余地”是作者对分工效果的判断，却写成了事实。传文只记了各段交给谁。",
   "evidence": [
    {
     "id": "QSG4371-E13",
     "quote": "北路責之直隸總督，南路責之湖廣總督，副以河南巡撫"
    }
   ],
   "proposed": "前加“作者认为，”。英文前加 \"In the author's view,\"。"
  }
 ],
