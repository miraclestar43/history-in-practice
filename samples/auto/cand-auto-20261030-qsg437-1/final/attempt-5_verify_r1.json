 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "中文开头只写「京通铁路」，没有展开，不了解背景的读者未必知道这是北京至通州的线路。英文已写作 Beijing-Tongzhou，中英在可读性上不对等。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "會海軍衙門奏請修京通鐵路"
    }
   ],
   "proposed": "首次出现时写作「京通铁路（北京至通州）」，后文沿用「京通铁路」这一简称。"
  },
  {
   "id": "V2",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "「以河为界」没有说明是哪条河。读者在开头难以想象议奏线路的大致走向，而证据本身也没有点名这条河。",
   "evidence": [
    {
     "id": "QSG4371-E7",
     "quote": "河北路成"
    },
    {
     "id": "QSG4371-E8",
     "quote": "自河以南"
    }
   ],
   "proposed": "不补写河名，只加一句限定，例如「以一条河为界（传文只称“河”）」，避免读者自行代入。"
  }
 ],
 "overall": "定稿各字段的事实、引文、归属与解释标注均有证据支持，中英一致，可以发布；开头的易读性只有两处可选的小改进。"
}