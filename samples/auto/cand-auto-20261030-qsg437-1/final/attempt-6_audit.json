 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.1",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都称“传文所录未说明它与京通线的关系”，但议奏明确给出了所拟干路的起讫：自京外卢沟桥起，经河南，到汉口镇。这是另拟的干路，不是京通线。现写法与证据相反，也让读者无从知道议奏所论是哪条线。证据只说“河北”“自河以南”，没有写出“黄河”二字，改写时不应补入。",
   "evidence": [
    {
     "id": "QSG4371-E22",
     "quote": "今宜自京外盧溝橋起，經河南以達湖北漢口鎮。此幹路樞紐，中國大利所萃也"
    },
    {
     "id": "QSG4371-E7",
     "quote": "河北路成"
    },
    {
     "id": "QSG4371-E8",
     "quote": "自河以南"
    }
   ],
   "proposed": "中文改为：他的议奏另拟一条干路，「自京外盧溝橋起，經河南以達湖北漢口鎮」，以河为界分南北两段，并非京通线。英文同步改为：The memorial proposes a separate trunk line, running from Lugou Bridge outside the capital through Henan to Hankou, divided by the river into northern and southern sections; it is not the Beijing-Tongzhou line."
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "开头一口气列出海军衙门、台谏、翁同龢、徐会沣四方主张。张之洞直到段末才以“本文传主”身份出现，读者读完不清楚他与这场争执的关系。翁同龢、徐会沣也只有名字，没有说明各自主张的立场。再加上 hook.1 原先没交代线路起讫，不了解背景的读者说不清“谁遇到了什么问题、为什么难”。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "會海軍衙門奏請修京通鐵路，臺諫爭陳鐵路之害，請停辦"
    },
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵；徐會灃請改修德州濟寧路，利漕運"
    }
   ],
   "proposed": "首句先点明：朝中就修不修铁路、修在哪里分成几派（修京通线、停办、改修边地、改修德济线），张之洞随后上议奏回应。再按“修京通—请停办—修边地以便用兵—修德济以利漕运”的顺序简列各方，各方只保留主张与理由，不补造身份。英文同步调整。"
  },
  {
   "id": "F3",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都说张之洞本传在准奏之后“只”记他奏开炼铁厂「資路用」（\"it goes on only to record his petition for an ironworks\"）。但本传后文还记有他「三十四年，督辦粵漢鐵路」。“只”字与证据不符。粤汉铁路与议奏所拟的卢沟桥至汉口干路名称不同，不应混为一谈。",
   "evidence": [
    {
     "id": "QSG4371-E23",
     "quote": "三十四年，督辦粵漢鐵路"
    },
    {
     "id": "QSG4371-E22",
     "quote": "今宜自京外盧溝橋起，經河南以達湖北漢口鎮"
    }
   ],
   "proposed": "删去“只”。补一句：本传后文另记「三十四年，督辦粵漢鐵路」，那是粤汉铁路，并非议奏所拟自卢沟桥经河南至汉口的干路。英文同步修改。"
  },
  {
   "id": "F4",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "与 F3 相同：限制段说本传“只在其后记他奏开炼铁厂「資路用」”（\"goes on only to record\"），漏掉了本传另记的督办粤汉铁路一事。",
   "evidence": [
    {
     "id": "QSG4371-E23",
     "quote": "三十四年，督辦粵漢鐵路"
    }
   ],
   "proposed": "删去“只”。补充：本传另记「三十四年，督辦粵漢鐵路」，与议奏所拟线路不是同一条。英文同步修改。"
  },
  {
   "id": "F5",
   "path": "sections.story.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“不是独立核算过的数字”（\"not figures from any independent accounting\"）是证据之外的否定性断言。证据里七利是逐条的定性理由，并不是数字，传文也没有记任何测算。这样写会暗示这些“利”原本是数字，只是缺少第三方核查。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "有此七利，分段分年成之"
    }
   ],
   "proposed": "中文改为：这组「利」是议奏自列的定性理由，传文未录任何测算。英文改为：These are qualitative reasons the memorial itself lists; the recorded text gives no quantities."
  },
  {
   "id": "F6",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与 F5 相同：“不是独立核算过的数字”（\"not independently audited figures\"）是证据之外的否定性断言，而且暗示七利原本是数字。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "有此七利"
    }
   ],
   "proposed": "中文改为：那组「利」是他自列的定性理由，传文未录任何测算，不能当作成本收益分析来读。英文同步修改。"
  },
  {
   "id": "F7",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与 F5 相同：“非独立核算”（\"not independent figures\"）是证据之外的否定性断言。另外，本说明说张之洞本传未记工期等，却没有提到本传另记督办粤汉铁路，与 F3、F4 修改后的正文不一致。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "有此七利"
    },
    {
     "id": "QSG4371-E23",
     "quote": "三十四年，督辦粵漢鐵路"
    }
   ],
   "proposed": "改为「「利」为定性理由，传文未录测算」。补一句：本传另记督办粤汉铁路，与议奏所拟线路不同。英文同步修改。"
  },
  {
   "id": "F8",
   "path": "sections.story.8",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“按「家不增一畝」这一限定，‘不问花费’不宜读作为私谋利”是作者从两处传文并列推出的结论，传文并没有这样说。中文接在“一种解释是”之后、隔了分号，标示不清。英文另起一句（\"should not be taken as spending for private gain\"），完全没有解释标签。",
   "evidence": [
    {
     "id": "QSG4371-E17",
     "quote": "務宏大，不問費多寡"
    },
    {
     "id": "QSG4371-E21",
     "quote": "任疆寄數十年，及卒，家不增一畝雲"
    }
   ],
   "proposed": "中文改为：作者认为，结合「家不增一畝」，“不问花费”不宜读作为私谋利。英文改为：In the author's view, read with the qualifier about his family's land, ... should not be taken as spending for private gain."
  },
  {
   "id": "F10",
   "path": "dek",
   "category": "readability",
   "severity": "note",
   "problem": "导语只说“一条南北线路”，读者不知道线路起讫，后文与《王文韶传》京汉铁路的对照也就难以理解。证据给出了起讫。",
   "evidence": [
    {
     "id": "QSG4371-E22",
     "quote": "今宜自京外盧溝橋起，經河南以達湖北漢口鎮"
    }
   ],
   "proposed": "把“一条南北线路”改为“一条自卢沟桥经河南至汉口的干路”。英文同步修改。"
  }
 ],
