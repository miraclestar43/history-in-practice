 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都称事情在传文里“停在「得旨報可」四个字上”。但传文紧接着记了调任湖广，又记他奏开炼铁厂「資路用」，并非就此结束。",
   "evidence": [
    {
     "id": "QSG4371-E14",
     "quote": "得旨報可，遂有移楚之命"
    },
    {
     "id": "QSG4371-E14",
     "quote": "資路用"
    }
   ],
   "proposed": "中文改为：传文在「得旨報可」之后，接着记他调任湖广，并奏开炼铁厂「資路用」；本传没有记这条线路的修筑经过。英文同步修改。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件称传文记这场争执“只用了一句话”，写成只有修、停两方，并说“主张修的一方又答了什么”传文没有抄录、只留下「請停辦」的收口。实际上，传文紧接着记了翁同龢、徐会沣两种替代主张，随后录有张之洞的议奏。英文同样有误。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵；徐會灃請改修德州濟寧路，利漕運"
    }
   ],
   "proposed": "改为：传文记了台谏请停办、翁同龢等请试修边地以便用兵、徐会沣请改修德州济宁路以利漕运三种意见，其后录张之洞议奏；台谏所说的具体害处和海军衙门的理由，传文没有记。英文同步修改。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "fix",
   "problem": "中文开头的「台谏」没有解释，不了解背景的读者不知道这是什么人、为何能请停办。英文把同一群体先译作 remonstrating officials，又写成 censors and remonstrating officials，再加注 the Qing court's remonstrance officials；dek 里又用 censors。称呼交替，读者容易以为是几群人。",
   "evidence": [
    {
     "id": "QSG4371-E3",
     "quote": "臺諫爭陳鐵路之害"
    }
   ],
   "proposed": "中文首次出现时加简短说明，如“台谏（负责进言、弹劾的言官）”。英文全篇统一用一个译名（如 the censors），首次出现时说明一次即可。"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "张之洞在开头第一次出现时，既没说明他是谁，也没说明他与这场争执的关系（他是传主，他的议奏是对上述各种主张的回应）。读完 hook 难以说清“谁遇到了什么问题”。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵；徐會灃請改修德州濟寧路，利漕運"
    }
   ],
   "proposed": "首次出现处改为“本文传主张之洞针对这几种主张上了一份议奏，其中明确排出了目标次序……”。不补造证据以外的官职。英文同步修改。"
  },
  {
   "id": "F5",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "推测“若先论兵事，争执或许更烈”时，把争执写成只有台谏一方。证据显示当时已有人以用兵为理由主张试修边地。这一对照没有交代，推测因此缺了实际背景，读者也会误以为没人从兵事立论。",
   "evidence": [
    {
     "id": "QSG4371-E18",
     "quote": "翁同龢等請試修邊地，便用兵"
    }
   ],
   "proposed": "在推测前补一句：当时翁同龢等已以“便用兵”为由请试修边地。保留“作者推测，传文未载”的标注。英文同步修改。"
  },
  {
   "id": "F6",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件写“利一到利六”，又说“本文所据摘录列到「利六」，本文不替其余补写”。证据显示议奏列的是七利，第七条为「漕運無梗」，并紧接「分段分年成之」。英文同样写成 benefit six。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "海上用兵，漕運無梗，利七。有此七利，分段分年成之"
    }
   ],
   "proposed": "改为“利一到利七”，删去“摘录列到利六、不替其余补写”一句，补写利七（「海上用兵，漕運無梗，利七」），并注明议奏提出「分段分年成之」。英文同步修改。"
  },
  {
   "id": "F7",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "“传文没有记……争议后续”说得过满。张之洞本传接着记了开炼铁厂「資路用」，同卷《王文韶传》还记有京汉铁路兴筑。两条线路是否同一，证据不能确定，但至少应把范围限定为张之洞本传。英文同。",
   "evidence": [
    {
     "id": "QSG4371-E14",
     "quote": "資路用"
    },
    {
     "id": "QSG4371-E20",
     "quote": "而京漢鐵路亦興築於是時矣"
    }
   ],
   "proposed": "改为“张之洞本传没有记这条线路的工期、用款、拆迁；同卷《王文韶传》记有京汉铁路兴筑，是否即此线，本文不作断定”。英文同步修改。"
  },
  {
   "id": "F8",
   "path": "sections.story.8",
   "category": "facts",
   "severity": "fix",
   "problem": "引「不問費多寡」时，略去了传文紧随其后的限定「家不增一畝」。读者会把“不问花费”理解成可能为私。这个限定会改变判断，应当保留。",
   "evidence": [
    {
     "id": "QSG4371-E17",
     "quote": "務宏大，不問費多寡"
    },
    {
     "id": "QSG4371-E21",
     "quote": "及卒，家不增一畝雲"
    }
   ],
   "proposed": "在评语后补：传文同时记他任疆寄数十年，「及卒，家不增一畝」。英文同步补译述。"
  },
  {
   "id": "F9",
   "path": "sections.analysis.0",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件把议奏归纳为“三个部分”，漏掉了议奏明文提出的「分段分年成之」。这一点直接关系到分工与实施方式的论述。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "有此七利，分段分年成之"
    }
   ],
   "proposed": "在归纳中补入“提出分段、分年修成”，或把“三个部分”改为“几个部分”并列出此项。英文同步修改。"
  },
  {
   "id": "F10",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件称“先修一小段……再定其余各段”这类做法在议奏里没有出现。但议奏已主张「分段分年成之」，分段推进并非作者独创的替代项。议奏里没有的，只是“先试一段、以运量与扰民程度检验后再定”的设计。英文同。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "分段分年成之"
    }
   ],
   "proposed": "改为：议奏已主张分段分年修成，但没有先试一段、凭运量与扰民程度再决定其余各段的设计；第二种做法（给每条利配可核对口径）议奏中未见。英文同步修改。"
  },
  {
   "id": "F11",
   "path": "sections.today.0",
   "category": "facts",
   "severity": "fix",
   "problem": "现代应用段借用史实细节时写成“那六条编号的‘利’”，与议奏的七利不符。英文 those six numbered benefits 同样有误。",
   "evidence": [
    {
     "id": "QSG4371-E19",
     "quote": "有此七利"
    }
   ],
   "proposed": "改为“那七条编号的‘利’”，英文改为 those seven numbered benefits。"
  },
  {
   "id": "F12",
   "path": "sections.limits.2",
   "category": "facts",
   "severity": "fix",
   "problem": "与 sections.story.6 相同：“传文没有记……争议后续”需要限定为张之洞本传。同卷《王文韶传》记有京汉铁路兴筑，本传也记了铁厂「資路用」。英文同。",
   "evidence": [
    {
     "id": "QSG4371-E20",
     "quote": "而京漢鐵路亦興築於是時矣"
    },
    {
     "id": "QSG4371-E14",
     "quote": "資路用"
    }
   ],
   "proposed": "改为“张之洞本传没有记议奏所提线路的工期、用款、拆迁；同卷他传有京汉铁路兴筑的记载，是否同一线路无法确定”。英文同步修改。"
  },
  {
   "id": "F13",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "“传文未记工期、用款、拆迁与争议后续”没有限定为本传，与同卷《王文韶传》所记京汉铁路兴筑的线索冲突。英文 the biography records no ... aftermath 同。",
   "evidence": [
    {
     "id": "QSG4371-E20",
     "quote": "而京漢鐵路亦興築於是時矣"
    }
   ],
   "proposed": "改为“张之洞本传未记工期、用款、拆迁；同卷他传所记京汉铁路兴筑是否即此线，未作断定”。英文同步修改。"
  }
 ],
