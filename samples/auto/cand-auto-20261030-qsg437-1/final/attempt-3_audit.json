 "issues": [
  {
   "id": "F1",
   "path": "sections.analysis.1",
   "category": "facts",
   "severity": "fix",
   "problem": "利一原文是「無慮引敵」，意思是不必担心铁路把敌人引进来，不是“避敌”。中文“避敌”和英文 \"avoiding the enemy\" 都改变了原意，也与 story.1 的转述（“不至于引敌”/\"will not draw in an enemy\"）不一致。",
   "evidence": [
    {
     "id": "QSG4371-E9",
     "quote": "內處腹地，無慮引敵，利一"
    }
   ],
   "proposed": "中文“避敌、避坟庐这两条”改为“不至引敌、坟庐易避这两条”；英文 \"avoiding the enemy and sparing graves and houses\" 改为 \"not drawing in the enemy and easily avoiding graves and houses\"。"
  },
  {
   "id": "F2",
   "path": "sections.today.0",
   "category": "style",
   "severity": "note",
   "problem": "today.0 与 reflection.question 措辞重复，两处都有「把目标的优先级公开排出来」「写成可以逐条检验的清单」，读来像同一段话写了两遍。",
   "evidence": [],
   "proposed": "改写 today.0 或 reflection.question 中的一处措辞，避免逐字重复。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "style",
   "severity": "note",
   "problem": "英文 \"the censors and remonstrating officials - the Qing court's remonstrance officials\" 同义反复，括注没有增加信息。",
   "evidence": [],
   "proposed": "简化为 \"the censors (the court's remonstrance officials)\"。"
  }
 ],
