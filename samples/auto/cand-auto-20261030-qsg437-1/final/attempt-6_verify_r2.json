 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头先交代张之洞在广东办学堂、枪炮厂、矿务局。读者此时还用不上这一信息，而且 context.0 又把它完整重复了一遍。结果是延后了读者对核心问题的把握：朝中就修不修铁路、修在哪里争执不下。读者仍能说清问题所在，因此不构成 fix。",
   "evidence": [
    {
     "id": "QSG4371-E1",
     "quote": "設廣東水陸師學堂，創槍砲廠，開礦務局"
    },
    {
     "id": "QSG4371-E3",
     "quote": "臺諫爭陳鐵路之害，請停辦"
    }
   ],
   "proposed": "hook.0 中英文都删去“在这份议奏之前，他已在广东办过学堂、枪炮厂和矿务局”一句，这一信息留在 context.0 交代。身份只保留“久任地方大员，「任疆寄數十年」”。"
  }
 ],
 "overall": "定稿各字段的事实、引文、归属、时序与中英对应均有证据支持，推断和反事实均已标明为作者解释，可以发布。仅有一条易读性 note，建议精简 hook 开头的背景铺陈。"
}