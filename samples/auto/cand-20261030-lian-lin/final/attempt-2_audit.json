 "issues": [
  {
   "id": "F1",
   "path": "sections.story.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文写“《史记》记有这样的权衡”，英文写“The Shiji records this weighing of options”。这样写像是史家或朝议的判断，但这段话是赵王召见相如时相如本人的回答。段落还漏掉了相如主动请缨、许诺“完璧归赵”这一环节。",
   "evidence": [
    {
     "id": "L-E20",
     "quote": "王召見，問藺相如曰"
    },
    {
     "id": "L-E20",
     "quote": "相如曰：「秦以城求璧而趙不許，曲在趙。"
    },
    {
     "id": "L-E20",
     "quote": "臣請完璧歸趙"
    }
   ],
   "proposed": "改为：赵王召见相如问可否予璧，相如答：……「均之二策，甯許以負秦曲」。他又自请奉璧出使，许诺城不入则完璧归赵。中英文同改。"
  },
  {
   "id": "F2",
   "path": "sections.analysis.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "沿用“《史记》所记的那段权衡”（英文“The weighing of options recorded in the Shiji”），没有交代这是相如对赵王的答话，会让读者误判谋略出自谁。",
   "evidence": [
    {
     "id": "L-E20",
     "quote": "相如曰：「秦以城求璧而趙不許，曲在趙。"
    }
   ],
   "proposed": "改为“相如答赵王时的那段权衡”（英文：the weighing Lin Xiangru offered the king）。"
  },
  {
   "id": "F3",
   "path": "sections.story.1",
   "category": "facts",
   "severity": "fix",
   "problem": "完璧一事写到秦王送相如回国就结束了。证据所载的结局没有写进去：相如因此拜为上大夫，秦赵最终没有交换城与璧。缺了这一步，读者看不出相如由上大夫到上卿的升迁过程。",
   "evidence": [
    {
     "id": "L-E19",
     "quote": "拜相如爲上大夫"
    },
    {
     "id": "L-E19",
     "quote": "秦亦不以城予趙，趙亦終不予秦璧"
    }
   ],
   "proposed": "段末补一句：相如归国后，赵王以为贤，拜为上大夫；秦终不以城予赵，赵亦终不予秦璧。中英文同补。"
  },
  {
   "id": "F4",
   "path": "sections.story.2",
   "category": "facts",
   "severity": "fix",
   "problem": "段落从廉颇送王至境直接跳到“终不能加胜于赵”，省掉了渑池会的核心冲突：秦王令赵王鼓瑟，相如以死相逼使秦王击缻，又张目叱退秦王左右，并以咸阳回敬十五城。会前的背景也被省掉：秦伐赵，赵王畏秦不欲行，廉、蔺力主赴会。这样一来，story.3 的“功大”没有了内容。",
   "evidence": [
    {
     "id": "L-E18",
     "quote": "趙王畏秦，欲毋行"
    },
    {
     "id": "L-E18",
     "quote": "王不行，示趙弱且怯也"
    },
    {
     "id": "L-E18",
     "quote": "相如張目叱之，左右皆靡"
    },
    {
     "id": "L-E18",
     "quote": "秦王爲趙王撃鮓"
    },
    {
     "id": "L-E18",
     "quote": "請以秦之咸陽爲趙王壽"
    }
   ],
   "proposed": "依 L-E18 补写会前背景，以及鼓瑟、击缻、叱退左右、咸阳回敬几处情节，放在“秦王竟酒”之前。中英文同补。"
  },
  {
   "id": "F5",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "“当廷呵斥他、羞辱他的群臣”指的是渑池会上的事。稿件既没写渑池会的冲突，读者会误以为说的是秦廷献璧那一次。",
   "evidence": [
    {
     "id": "L-E8",
     "quote": "相如廷叱之，辱其群臣"
    },
    {
     "id": "L-E18",
     "quote": "相如張目叱之，左右皆靡"
    }
   ],
   "proposed": "补出 F4 的内容，或在此处注明“（指渑池会上之事）”。中英文同改。"
  },
  {
   "id": "F6",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "有两处作者推断没有标注：“两种功劳形态不同，本不好用同一把尺子量”，以及“说明他不服的不只是排序，还有出身”。后一句是在推断廉颇的心理，原文只记了他自己说的话。",
   "evidence": [
    {
     "id": "L-E5",
     "quote": "且相如素賤人，吾羞，不忍爲之下"
    }
   ],
   "proposed": "在这两句前加“作者认为”或“一种解释是”。英文对应处加 the author's view / one reading。"
  },
  {
   "id": "F7",
   "path": "sections.limits.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "“凡原文未写的人物心理，均以‘一种解释是’‘作者认为’标明”是全称断言，但 analysis.0 中仍有未标注的心理推断（见 F6），这句话不成立。它还与 uncertainty_note 重复。",
   "evidence": [],
   "proposed": "先补齐 F6 的标注，再保留此句；或删去此句，以 uncertainty_note 为准。"
  },
  {
   "id": "F8",
   "path": "sections.today.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“区别只在道具：没有战车”暗示原来的场景里有战车，但证据只记相如“引車避匿”，那是出行的车，不是战车。这是用证据之外的细节冒充史实。",
   "evidence": [
    {
     "id": "L-E6",
     "quote": "相如引車避匿"
    }
   ],
   "proposed": "改为“没有马车”（英文 no carriages），或删去这个具体道具。"
  }
 ],
