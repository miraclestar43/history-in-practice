 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "readability",
   "severity": "fix",
   "problem": "中文句子“后来为本书写引言的梅洛尼去探访时，她的实验室仍设备不足”里，离“她”最近的人是梅洛尼，读者会把实验室理解为梅洛尼的。英文明确写的是 Marie Curie's laboratory，中英两版因此不一致。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "Madame Curie's laboratory, although practically a new building, was without sufficient equipment"
    }
   ],
   "proposed": "把“她的实验室”改为“居里夫人的实验室”。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头的“局”没有交代是什么机构，读者不知道镭放在哪里、由谁保管。证据中也只称作 the Bureau。",
   "evidence": [
    {
     "id": "CUR-E28",
     "quote": "The tubes of radium presented to me were at the Bureau, whose officials had kindly offered to make the measurements"
    }
   ],
   "proposed": "改为“装镭的管子还在一个书中只称作‘局’的机构里”，不补充证据之外的机构名称。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "开头连续出现“本书”“书里”，但读者此时还不知道指的是哪本书，要到结尾的 limits 一节才交代。“射气”是术语，hook 又省去了证据中的“治疗癌症”，读者不容易看出这些镭为什么不能用于研究。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "the radium held there was used at that time only for extracting emanations for hospital use in cancer treatment"
    }
   ],
   "proposed": "第一次提到时写明“1923年出版的《皮埃尔·居里》一书”；把“只用于为医院提取射气”改为“只用于为医院提取射气、治疗癌症”。英文同步补上 in cancer treatment。"
  },
  {
   "id": "V4",
   "path": "sections.story.2",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文把「took no copyright」接在“拒绝从发现中获取任何物质利益”后面，并说“英译此处作”，读起来像是英译用这句话来表达“拒绝获利”。原文中 We took no copyright 是另起的一句，指没有申请版权保护。中文正文也没有说出这层意思。第二处「took out no patent」的“此处”同样指代不清。",
   "evidence": [
    {
     "id": "CUR-E7",
     "quote": "With my agreement he refused to draw any material profit from our discovery. We took no copyright, and published without reserve"
    },
    {
     "id": "CUR-E11",
     "quote": "We took out no patent and we did not reserve any advantage in any industrial exploitation."
    }
   ],
   "proposed": "改为“……皮埃尔·居里拒绝从发现中获取任何物质利益；他们没有申请版权（英译作「took no copyright」），把研究结果……”。第二处改为“没有申请专利（英译作「took out no patent」），也不在工业开发中保留任何好处”。"
  }
 ],
 "overall": "定稿的史实、日期、数字和英文引语都能在证据中逐一找到出处，解释性段落也已标明；需要修正的是导语中指代不清的“她”和 story.2 中英文引语的挂靠位置，另有两处开头易读性的小问题建议处理。"
}