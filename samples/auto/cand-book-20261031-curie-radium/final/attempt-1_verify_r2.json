 ],
 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "开头第一次出现“梅洛尼”时没有交代她是谁、和这件事是什么关系。她的身份要到 story.6 才说明。“皮埃尔·居里”与她的夫妻关系在 hook 里也没有点明。不了解背景的读者读开头时说不清是谁在募捐。",
   "evidence": [
    {
     "id": "CUR-E18",
     "quote": "It was my hope when I arrived in New York, a few weeks afterwards, to find ten women to subscribe ten thousand dollars each for the purchase of a gramme of radium"
    }
   ],
   "proposed": "zh 改为“是她和丈夫皮埃尔·居里多年前……；后来为本书写引言的梅洛尼在美国发起募捐，希望借此让她把研究继续下去”。en 对应改为“by Marie Curie and her husband Pierre Curie … and Meloney, who later wrote the book's introduction, set out to raise a subscription…”。"
  },
  {
   "id": "V2",
   "path": "dek",
   "category": "readability",
   "severity": "fix",
   "problem": "导语里直接写“梅洛尼探访时”，没有说明梅洛尼是谁，读者无从理解这个人物在事件中的角色。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "I also learned that Madame Curie's laboratory, although practically a new building, was without sufficient equipment"
    }
   ],
   "proposed": "zh 改为“1921年赠镭之前，后来为本书写引言的梅洛尼去探访时，她的实验室仍设备不足”。en 改为“When Meloney, who later wrote the book's introduction, visited…”。"
  },
  {
   "id": "V3",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "“局”/“the Bureau”在开头出现时没有任何说明。证据里也没有写明这是哪个机构，读者不知道它在这件事里起什么作用。",
   "evidence": [
    {
     "id": "CUR-E28",
     "quote": "The tubes of radium presented to me were at the Bureau, whose officials had kindly offered to make the measurements"
    }
   ],
   "proposed": "zh 改为“装镭的管子还存放在负责测量的一个官方机构（书中只称‘局’）”。en 改为“at an official bureau (the book calls it only 'the Bureau')”。"
  },
  {
   "id": "V4",
   "path": "sections.context.0",
   "category": "parity",
   "severity": "fix",
   "problem": "en 写了“some help from outside sources”，zh 只写“后来才得到少量补助”，漏掉了外部帮助这一项事实。",
   "evidence": [
    {
     "id": "CUR-E1",
     "quote": "later we were given a few subventions and some help from outside sources"
    }
   ],
   "proposed": "zh 改为“后来才得到少量补助和一些外部帮助”。"
  },
  {
   "id": "V5",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "“学校”/“the School”没有说明是哪所学校、和居里夫妇是什么关系，读者分不清它与索邦的区别。",
   "evidence": [
    {
     "id": "CUR-E23",
     "quote": "Already in 1898, one of the laboratory chiefs of the School, G. Bemont, had given us temporary aid."
    }
   ],
   "proposed": "zh 改为“皮埃尔任职的那所学校（书中称‘学校’）的实验室主任之一贝蒙”。en 作相应补充。"
  },
  {
   "id": "V6",
   "path": "sections.story.0",
   "category": "parity",
   "severity": "fix",
   "problem": "en 写了庞加莱“anxious to free him from the necessity of quitting France”，zh 删去了这一点。这句话正是日内瓦邀请与索邦获聘之间的联系，删去后中英内容不一致。",
   "evidence": [
    {
     "id": "CUR-E21",
     "quote": "due to the influence of Henri Poincaré, who was anxious to free him from the necessity of quitting France"
    }
   ],
   "proposed": "zh 改为“他申请后，在一心想让他不必离开法国的庞加莱的影响下获聘”。"
  },
  {
   "id": "V7",
   "path": "sections.story.1",
   "category": "chronology",
   "severity": "fix",
   "problem": "原文用的是“As early as 1899”，表明工业试验早于前文所述的处境。稿件用“同时/Meanwhile……1899年”，暗示试验发生在索邦新职之后或与之同时，时间顺序被改写了。",
   "evidence": [
    {
     "id": "CUR-E6",
     "quote": "As early as 1899 Pierre Curie succeeded in organizing a first industrial experiment"
    }
   ],
   "proposed": "zh 改为“除了这些困难，没有工业手段处理原料，研究也推不动。早在1899年，皮埃尔就……”。en 改为“Besides these difficulties… As early as 1899 Pierre Curie organized…”。"
  },
  {
   "id": "V8",
   "path": "sections.story.1",
   "category": "parity",
   "severity": "fix",
   "problem": "zh 漏掉了 en 中的两项事实：公司与皮埃尔因制造天平而有往来；试验取得了良好结果。",
   "evidence": [
    {
     "id": "CUR-E6",
     "quote": "with which he had had relations in connection with the construction of his balances"
    },
    {
     "id": "CUR-E6",
     "quote": "the operations brought good results"
    }
   ],
   "proposed": "zh 补为“借中央化学产品公司（他因制造天平与之有往来）的一处现成设施……技术细节由德比埃尔纳安排得很成功，试验效果良好”。"
  },
  {
   "id": "V9",
   "path": "sections.story.3",
   "category": "parity",
   "severity": "fix",
   "problem": "en 保留了两点，zh 都删去了：办厂之举“在当时看来很大胆”；医生的兴趣是由各种研究的发表引起的。",
   "evidence": [
    {
     "id": "CUR-E8",
     "quote": "had the idea, which seemed daring at that epoch, of founding a veritable radium factory"
    },
    {
     "id": "CUR-E8",
     "quote": "had been aroused by the publication of various investigations"
    }
   ],
   "proposed": "zh 改为“办起一座在当时看来很大胆的真正镭工厂……医生们因各种研究的发表，已对镭的生物效应和可能的疗法产生兴趣”。"
  },
  {
   "id": "V10",
   "path": "sections.story.7",
   "category": "parity",
   "severity": "fix",
   "problem": "en 引用了“I might die tomorrow. Too much is at stake.”，zh 只写“因为第二天就要接收镭”，漏掉了她给出的另一层理由。",
   "evidence": [
    {
     "id": "CUR-E26",
     "quote": "\"To-morrow I receive the radium, and I might die tomorrow. Too much is at stake.\""
    }
   ],
   "proposed": "zh 改为“她要求当晚就把文件办好：第二天就要接收镭，而她可能明天就死，事关重大（据梅洛尼转述）”。"
  },
  {
   "id": "V11",
   "path": "sections.story.7",
   "category": "readability",
   "severity": "note",
   "problem": "Eve Curie 的常用中文译名是“艾芙”，稿件写作“伊夫”，读者不易对应到这个人。",
   "evidence": [
    {
     "id": "CUR-E26",
     "quote": "My daughter Eve is not of legal age"
    }
   ],
   "proposed": "zh 改为“女儿艾芙尚未成年”。"
  },
  {
   "id": "V12",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件说“本篇内容全部出自同一本书”/“Everything in this piece comes from one book”，说得过满。today 两段是现代场景，analysis 与 reflection 中有作者的解释，这些都不出自该书。uncertainty_note 用的是“本篇事实”，两处说法也不一致。",
   "evidence": [
    {
     "id": "CUR-E1",
     "quote": "we were extremely handicapped by inadequate conditions"
    }
   ],
   "proposed": "zh 改为“本篇的史实全部出自同一本书”。en 改为“Every historical fact in this piece comes from one book”。"
  }
 ],
 "overall": "引文均逐字可查，解释与推断已标注，没有阻断性问题。但需要修正以下几处后才能放行：story.1 的“早在1899年”时间顺序；几处中英文缺失；limits.0 的过度概括；开头梅洛尼身份未交代的易读性问题。"
}