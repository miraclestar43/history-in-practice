 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.1",
   "category": "attribution",
   "severity": "fix",
   "problem": "段末说“这笔账，她在书里一项一项算过”（EN: In her book she worked through that account line by line）。但本段的市价十万美元、实验室镭的用途和募捐，都出自梅洛尼的引言，不是居里夫人自己算的。她本人在自传笔记里写的，只是放弃的财富与朋友们的反对，谈不上“一项一项”。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "That week I learned that the market price of a gramme of radium was one hundred thousand dollars."
    },
    {
     "id": "CUR-E13",
     "quote": "So it is a fortune which we have sacrificed in renouncing the exploitation of our discovery"
    }
   ],
   "proposed": "zh改为：“这笔账书里两边都有记载：梅洛尼在引言里记下了市价和募捐，她自己在自传笔记里算过放弃的那笔财富。”EN改为：\"The book records both sides of that account: Meloney's introduction notes the price and the subscription, and in her autobiographical notes Marie Curie reckons up the fortune she gave up.\""
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头出现的“局”（the Bureau）没有交代是什么机构、和镭有什么关系。证据只写作 the Bureau，不宜补写全名。",
   "evidence": [
    {
     "id": "CUR-E28",
     "quote": "The tubes of radium presented to me were at the Bureau"
    }
   ],
   "proposed": "zh可写作“还在负责测量的那个‘局’（书中只称the Bureau）里”，不补写机构全名。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "“射气”（emanations）是术语，开头读者不一定懂。另外本段在一句里叠了价格、公开方法、实验室用途、募捐四件事，信息偏密。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "the radium held there was used at that time only for extracting emanations for hospital use in cancer treatment"
    }
   ],
   "proposed": "zh改为“只用于为医院提取射气（镭放出的放射性气体）供癌症治疗”。可把募捐一事拆成单独一句。"
  },
  {
   "id": "V4",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "“学校的实验室主任之一贝蒙”（the School）中的“学校”此前没有出现过，读者不知道指哪所学校、与居里夫妇是什么关系。",
   "evidence": [
    {
     "id": "CUR-E23",
     "quote": "one of the laboratory chiefs of the School, G. Bemont, had given us temporary aid"
    }
   ],
   "proposed": "zh改为“皮埃尔任教的那所学校（书中称the School）的实验室主任之一贝蒙”，或在首次提到工作间时交代这所学校。"
  },
  {
   "id": "V5",
   "path": "sections.story.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "“这时日内瓦方面来请皮埃尔”（EN: Then Geneva came calling）把日内瓦邀请定在木棚两年和分工之后。证据没有给这次邀请任何日期，也没有交代它与木棚工作的先后。",
   "evidence": [
    {
     "id": "CUR-E4",
     "quote": "This was a grave decision for us to make."
    },
    {
     "id": "CUR-E21",
     "quote": "At this moment the Chair of Physics in the physics, chemistry and natural history course at the Sorbonne"
    }
   ],
   "proposed": "zh改为“后来有一次（书中未写年份），日内瓦方面来请皮埃尔”。EN改为\"At one point (the book gives no year), Geneva came calling for Pierre\"。"
  },
  {
   "id": "V6",
   "path": "sections.story.4",
   "category": "chronology",
   "severity": "fix",
   "problem": "“今天公认226”（EN: the number accepted now is 226）里的“今天”是原书写作时（1923年）的“now”，现在直接写成“今天”，等于把1923年的说法当成了当下的判断。",
   "evidence": [
    {
     "id": "CUR-E22",
     "quote": "one accepts now the number 226"
    }
   ],
   "proposed": "zh改为“——她写书时公认的数值是226”。EN改为\"the number accepted when she wrote was 226\"。"
  }
 ],
 "overall": "定稿的事实、引语和中英对照总体有证据支撑，推断段落也已标注；需修正三处：hook.1 的归属、日内瓦邀请的时间定位、“今天公认226”的时态。另有三处易读性小注（“局”“射气”“学校”），不影响开头理解，开头可读性通过。"
}