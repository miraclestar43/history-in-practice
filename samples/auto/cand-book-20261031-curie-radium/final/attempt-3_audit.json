 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "parity",
   "severity": "fix",
   "problem": "中文“后来为本书写引言的梅洛尼去探访时，她的实验室仍设备不足”中，离“她”最近的人是梅洛尼，读者容易把实验室理解为梅洛尼的。英文明确写作 Marie Curie's laboratory，中英不一致，也影响读者理解。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "Madame Curie's laboratory, although practically a new building, was without sufficient equipment"
    }
   ],
   "proposed": "把“她的实验室”改为“居里夫人的实验室”。"
  },
  {
   "id": "F2",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "英文 finally put a gram in Marie Curie's hands 暗示她亲手接过了镭。证据说镭本身没有带到仪式上，她拿到的只是象征性的金钥匙。这与正文 hook 所强调的事实矛盾。中文“得到一克镭”没有这个问题。",
   "evidence": [
    {
     "id": "CUR-E27",
     "quote": "The radium itself was not brought to the ceremony."
    }
   ],
   "proposed": "改为 and a subscription raised by American women finally secured her a gram of radium。"
  },
  {
   "id": "F3",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "fix",
   "problem": "开头（dek、hook.1）一再说“本书”“本书的引言”，但读者此时不知道是哪本书，要到 limits 才交代。梅洛尼第一次出现时，身份也只是“为本书写引言的人”，读者说不清她与此事的关系。",
   "evidence": [
    {
     "id": "CUR-E18",
     "quote": "to find ten women to subscribe ten thousand dollars each for the purchase of a gramme of radium"
    }
   ],
   "proposed": "第一次提到时点明书名：“居里夫人1923年出版的《皮埃尔·居里》一书（梅洛尼为其写了引言）”。梅洛尼的身份写成“发起这次募捐、后来为该书写引言的梅洛尼”。不补加证据以外的身份信息。"
  },
  {
   "id": "F4",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "“局”/the Bureau 没有说明是哪个机构，读者会困惑。证据本身也只写作 the Bureau。",
   "evidence": [
    {
     "id": "CUR-E28",
     "quote": "The tubes of radium presented to me were at the Bureau"
    }
   ],
   "proposed": "写作“还在书中只称为‘局’（the Bureau）的机构里”，不补出机构全名。"
  },
  {
   "id": "F5",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "中文“为医科学生而设”与证据不符：证据说的是这门课对医科学生是必修。中文还漏掉了P.C.N.即物理、化学和博物课程这层说明，与英文不对等。",
   "evidence": [
    {
     "id": "CUR-E21",
     "quote": "the physics, chemistry and natural history course at the Sorbonne, obligatory for students of medicine"
    }
   ],
   "proposed": "改为“索邦P.C.N.（医科学生必修的物理、化学和博物课程）的物理教席正好空缺”。"
  },
  {
   "id": "F6",
   "path": "sections.story.2",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文把「took no copyright」接在“拒绝获取物质利益”之后，并说“英译此处作”，读起来像是英译用这句话表达“拒绝获利”。原文中这是另起的一句，意思是没有申请版权保护，中文正文没有说出这层意思。第二处「took out no patent」前的“此处”同样指代不清。",
   "evidence": [
    {
     "id": "CUR-E7",
     "quote": "With my agreement he refused to draw any material profit from our discovery. We took no copyright"
    },
    {
     "id": "CUR-E11",
     "quote": "We took out no patent and we did not reserve any advantage in any industrial exploitation."
    }
   ],
   "proposed": "改为“……皮埃尔·居里拒绝从发现中获取任何物质利益；他们没有申请版权（英译作「took no copyright」），把研究结果……”。第二处改为“没有申请专利（英译作「took out no patent」），也不在工业开发中保留任何好处”。"
  },
  {
   "id": "F7",
   "path": "sections.story.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "证据 E9 只用“he”“his factory”指称，摘录中没有点名阿尔梅·德·利尔。正文直接写成德·利尔，并把 disinterested 译作“出于好意”，后者带有动机色彩。",
   "evidence": [
    {
     "id": "CUR-E9",
     "quote": "In an entirely disinterested manner he placed at our disposition a little working place in his factory"
    }
   ],
   "proposed": "写作“书中接着写道，这位实业家不图回报地在他的工厂里给他们一小块工作地方……”。“出于好意”改为“不图回报”。"
  },
  {
   "id": "F8",
   "path": "sections.story.5",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文直接用引号引出 \"Yet, I still believe that we have done right.\"，没有标明这是本书英译本的措辞。story.2 标明了，这里没有，读者会以为是她的原话。",
   "evidence": [
    {
     "id": "CUR-E13",
     "quote": "Yet, I still believe that we have done right."
    }
   ],
   "proposed": "改为 ...all the same; in the English translation: \"Yet, I still believe that we have done right.\"。"
  },
  {
   "id": "F9",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "中文“1902年科学院给的20,000法郎”中的“科学院”，容易与 context.0 的“维也纳科学院”混同。证据只写 the Academy of Sciences。",
   "evidence": [
    {
     "id": "CUR-E9",
     "quote": "accorded in 1902 by the Academy of Sciences, amounted to 20,000 francs"
    }
   ],
   "proposed": "写作“（书中只称）科学院”，或注明“不是前文的维也纳科学院”时须有依据；否则保持原称并避免让人误连前文。"
  },
  {
   "id": "F10",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "“学校的实验室主任之一贝蒙”中的“学校”（the School）此前没有交代，读者不知道是哪所学校。",
   "evidence": [
    {
     "id": "CUR-E23",
     "quote": "one of the laboratory chiefs of the School, G. Bemont"
    }
   ],
   "proposed": "写作“（书中称为‘学校’的）他们工作所在学校的一位实验室主任贝蒙”，不补出校名。"
  }
 ],
