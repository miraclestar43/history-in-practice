 ],
 "issues": [
  {
   "id": "V1",
   "path": "dek",
   "category": "chronology",
   "severity": "fix",
   "problem": "“到1921年，她的实验室仍设备不足”（en: In 1921）把实验室设备不足定在1921年。证据只说这是梅洛尼来访那一周得知的情况。那次来访在赠镭之前，基金是在之后“不到一年”内募成的，书中没有写来访年份。",
   "evidence": [
    {
     "id": "CUR-E17",
     "quote": "That week I learned that the market price of a gramme of radium was one hundred thousand dollars. I also learned that Madame Curie's laboratory, although practically a new building, was without sufficient equipment"
    },
    {
     "id": "CUR-E24",
     "quote": "In less than a year the fund had been raised."
    }
   ],
   "proposed": "zh 改为“1921年赠镭之前，梅洛尼探访时她的实验室仍设备不足”；en 改为“Before the 1921 gift, her laboratory still lacked sufficient equipment”。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头出现的“局”（the Bureau）没有交代是什么机构、在这件事里起什么作用，读者不知道镭为什么在那里。",
   "evidence": [
    {
     "id": "CUR-E28",
     "quote": "The tubes of radium presented to me were at the Bureau, whose officials had kindly offered to make the measurements"
    }
   ],
   "proposed": "改为“装镭的管子还在一个负责测量的机构（书中只称‘the Bureau’）”，不补证据以外的机构全名。"
  },
  {
   "id": "V3",
   "path": "sections.hook.1",
   "category": "causality",
   "severity": "fix",
   "problem": "“要靠募捐才能把研究继续下去”（en: it took a subscription to enable her to go on with her work）把梅洛尼发起募捐时的设想写成了居里夫人的客观处境。证据中这是梅洛尼的希望；居里夫人自己的说法是赠礼让工作“更容易”。",
   "evidence": [
    {
     "id": "CUR-E18",
     "quote": "It was my hope when I arrived in New York, a few weeks afterwards, to find ten women to subscribe ten thousand dollars each for the purchase of a gramme of radium, and in this way to enable Madame Curie to go on with her work"
    },
    {
     "id": "CUR-E10",
     "quote": "I came back to my work, made easier by the precious gift"
    }
   ],
   "proposed": "zh 改为“梅洛尼发起募捐，希望借此让她把研究继续下去”；en 改为“and Meloney set out to raise a subscription to enable her to go on with her work”。"
  },
  {
   "id": "V4",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "皮埃尔·居里在开头首次出现时没有说明是她的丈夫、研究搭档。“射气/emanations”是术语，读者在开头用不上，也看不懂。",
   "evidence": [
    {
     "id": "CUR-E11",
     "quote": "My husband, as well as myself, always refused to draw from our discovery any material profit."
    }
   ],
   "proposed": "写作“她和丈夫皮埃尔·居里”；“为医院提取射气”可改为“只用于为医院的癌症治疗提取放射性气体（射气）”。"
  },
  {
   "id": "V5",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“没有地方干活”（en: nowhere to work）说过头了。原文是缺少“合适的”工作场所，下文也写到他们确有木棚和工作间。",
   "evidence": [
    {
     "id": "CUR-E1",
     "quote": "by the lack of a proper place to work in, by the lack of money and of personnel"
    }
   ],
   "proposed": "zh 改为“缺合适的工作场所、缺人手，也缺钱”；en 改为“they lacked a proper place to work in, personnel and money”。"
  },
  {
   "id": "V6",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“双重教学让皮埃尔非常疲惫”（en: Pierre's double teaching load fatigued him greatly）改动了原文的归因。原文说让他非常疲惫的是学生众多的 P.C.N. 教学，不是双重教学本身。",
   "evidence": [
    {
     "id": "CUR-E21",
     "quote": "Pierre Curie was doing double teaching; and that in the P.C.N., with its very large number of students, fatigued him greatly."
    }
   ],
   "proposed": "zh 改为“皮埃尔要兼两处课，其中学生众多的P.C.N.教学让他非常疲惫”；en 改为“Pierre was teaching in two places, and the P.C.N., with its very large number of students, fatigued him greatly”。"
  },
  {
   "id": "V7",
   "path": "sections.story.0",
   "category": "readability",
   "severity": "note",
   "problem": "庞加莱首次出现时没有说明身份，也没有说明他为什么要帮忙（原文写了他希望皮埃尔不必离开法国），读者只看到一个名字。",
   "evidence": [
    {
     "id": "CUR-E21",
     "quote": "due to the influence of Henri Poincaré, who was anxious to free him from the necessity of quitting France"
    }
   ],
   "proposed": "zh 补为“在亨利·庞加莱的影响下获聘——庞加莱希望他不必离开法国”。"
  },
  {
   "id": "V8",
   "path": "sections.story.6",
   "category": "chronology",
   "severity": "fix",
   "problem": "“梅洛尼为本书写了引言，后来在纽约发起募捐”（en: wrote the introduction … and later launched）把先后顺序弄反了。募捐在1921年赠镭之前完成，引言收在1923年出版的书里，写作时间晚于募捐。",
   "evidence": [
    {
     "id": "CUR-E19",
     "quote": "Mme. Curie and President Harding at the White House, May 20, 1921, when a gram of radium was presented to its discoverer by the women of America."
    },
    {
     "id": "CUR-E18",
     "quote": "It was my hope when I arrived in New York, a few weeks afterwards, to find ten women"
    }
   ],
   "proposed": "zh 改为“梅洛尼（本书引言作者）曾在纽约发起这次募捐”；en 改为“Meloney, who later wrote the book's introduction, had launched the subscription in New York”。"
  },
  {
   "id": "V9",
   "path": "sections.story.6",
   "category": "readability",
   "severity": "fix",
   "problem": "英文稿对居里夫人的称呼来回换：Mme. Curie、Marie Curie、Marie、Curie。本段和 story.7 只用 “Curie”，而文中还有 Pierre Curie，读者分不清指谁。中文稿统一用“居里夫人”，没有这个问题。",
   "evidence": [
    {
     "id": "CUR-E15",
     "quote": "\"I? Oh, I have none,\" she corrected. \"It belongs to my laboratory.\""
    }
   ],
   "proposed": "英文统一为首次出现用“Marie Curie”，之后一律称“Marie Curie”或“Mme. Curie”（二选一，全篇一致）；Pierre 一律称“Pierre”。"
  }
 ],
 "overall": "定稿的引语都逐字对得上，解释段也都标明是作者推断，但还有五处事实、时序或因果问题（dek 的年份、募捐必要性的归属、“无处干活”、皮埃尔疲劳的原因、梅洛尼写引言的先后）和一处英文人名称呼混乱需要修改，改完后可以发布。"
}