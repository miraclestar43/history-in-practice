 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "中文“有意含糊”、英文“deliberately ambiguous”把含糊说成是有意为之。麦迪逊只写了这个格式含糊，以及起草目的是争取异议者，没有说含糊本身是刻意设计的。",
   "evidence": [
    {
     "id": "F-E7",
     "quote": "This ambiguous form had been drawn up by Mr. Gouverneur Morris, in order to gain the dissenting members"
    }
   ],
   "proposed": "中文改为“一个含糊的签署格式”，英文改为“an ambiguous signing formula”。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "此句位于富兰克林讲话之前，说会上已有几位成员“公开表示过异议”。证据包里当天的公开异议（伦道夫、格里等）都出现在讲话之后。F-E18 还记载富兰克林写讲稿时并不知道会有成员拒签。讲话时只能说仍可能有人持异议。",
   "evidence": [
    {
     "id": "F-E6",
     "quote": "who may still have objections to it"
    },
    {
     "id": "F-E18",
     "quote": "he did not know that any particular member would refuse to sign his name to the instrument"
    }
   ],
   "proposed": "中文改为“会要散了，会上仍可能有成员对这份文件持有异议。”英文改为“Some members might still have objections to the document on the table.”，并在本段 ev 中补上 F-E6。"
  },
  {
   "id": "F3",
   "path": "sections.story.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文把“有意含糊”放在“麦迪逊记下一笔内情”之下，等于说这是麦迪逊的原话。原文只写“This ambiguous form”，英文版也只写 ambiguous，因此中英不对等。",
   "evidence": [
    {
     "id": "F-E7",
     "quote": "This ambiguous form had been drawn up by Mr. Gouverneur Morris"
    }
   ],
   "proposed": "中文改为“这个含糊的格式由古弗尼尔·莫里斯起草，为的是争取异议者……”"
  },
  {
   "id": "F4",
   "path": "sections.analysis.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "“莫里斯和布朗特只认‘出席各州一致’这个事实”会让读者以为莫里斯本人只愿证明事实、不作承诺。证据中，莫里斯只是指出该格式仅关乎各州一致这一事实；他本人表示愿连同缺点接受方案，并服从多数决定。只有布朗特明确表示签名而不承诺自己。",
   "evidence": [
    {
     "id": "F-E15",
     "quote": "he should take it with all its faults"
    },
    {
     "id": "F-E15",
     "quote": "He remarked that the signing, in the form proposed, related only to the fact that the states present were unanimous."
    },
    {
     "id": "F-E17",
     "quote": "would, without committing himself, attest the fact"
    }
   ],
   "proposed": "中文改为“莫里斯把这个格式解读为只关乎‘出席各州一致’的事实，布朗特据此只作证明、不作承诺”。英文相应改为“Morris read the form as relating only to the fact that the states present were unanimous, and Blount signed on that basis without committing himself”。"
  },
  {
   "id": "F5",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "中文的“代价是……”仍在“作者推断”的句子之内。英文“The price was that the meaning of that row would need explaining ever after.”另起一句，脱离了 The author's inference 的标注，读起来像事实陈述，与中文不对等。",
   "evidence": [],
   "proposed": "英文改为“The price, on this inference, was that…”，或并入前一句的推断之内。"
  },
  {
   "id": "F6",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "中文“官方日志”、英文“official Journals”，以及“它们和本篇所依据的麦迪逊笔记是两份不同的材料”这一判断，在证据包里都没有出处。证据只出现“Journals of the Convention”。",
   "evidence": [
    {
     "id": "F-E23",
     "quote": "the Journals of the Convention should be either destroyed, or deposited in the custody of the president"
    }
   ],
   "proposed": "删去“官方/official”以及“两份不同的材料”一句，只写“会议日志（Journals）及其他文件的去向也值得留意”。"
  },
  {
   "id": "F7",
   "path": "reflection.example.alternative",
   "category": "parity",
   "severity": "fix",
   "problem": "中文再次写“那个有意含糊的格式”，英文写“the ambiguous form of 1787”，中英不一致。而且“有意”没有证据支持（见 F1）。",
   "evidence": [
    {
     "id": "F-E7",
     "quote": "This ambiguous form"
    }
   ],
   "proposed": "中文改为“1787年那个含糊的格式”。"
  },
  {
   "id": "F8",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都说英文引语“均为麦迪逊笔记中的逐字片段”。但 sections.limits.0 所引书名出自1793年《富兰克林文集》，不是麦迪逊笔记。limits.0 自己已限定为“正文的英文引语”。",
   "evidence": [
    {
     "id": "F-E11",
     "quote": "Final Speech of Dr. Franklin in the late Federal Convention"
    }
   ],
   "proposed": "中文改为“正文英文引语均为麦迪逊笔记中的逐字片段”，英文改为“All English quotations in the body are verbatim fragments of Madison's notes”。"
  }
 ],
