 "issues": [
  {
   "id": "F1",
   "path": "sections.story.4",
   "category": "facts",
   "severity": "fix",
   "problem": "伦道夫第一次起身时说明了拒签理由：他认为交给民众的选择方式会使会议目标落空，九个州将不批准，混乱必然随之而来。本段中英文都只写了他的致歉和保留行动自由，没有写这条理由。读者会以为他拒签只出于个人立场，story.6 中他关于无政府与内乱的说法也失去前因。",
   "evidence": [
    {
     "id": "F-E29",
     "quote": "He refused to sign, because he thought the object of the Convention would be frustrated by the alternative which it presented to the people. Nine states will fail to ratify the plan, and confusion must ensue."
    }
   ],
   "proposed": "在致歉之后补一句。中文：他说拒签是因为他认为方案交给民众的选择方式会使会议目标落空，九个州将不会批准，混乱必然随之而来。英文：He refused, he said, because he thought the alternative presented to the people would frustrate the Convention's object; nine states would fail to ratify, and confusion must ensue."
  },
  {
   "id": "F2",
   "path": "sections.story.5",
   "category": "facts",
   "severity": "fix",
   "problem": "本段列举了几位成员对签名的说法，但漏掉了威廉森提出的另一种签法：只在随宪法呈交国会的信上签名，以照顾一些不喜欢宪法的成员。麦迪逊注明其中就包括布朗特。缺了这一条，dek 和 analysis 所说的“几种对签名的不同理解”不完整，布朗特如释重负的背景也不清楚。",
   "evidence": [
    {
     "id": "F-E30",
     "quote": "Mr. WILLIAMSON suggested that the signing should be confined to the letter accompanying the Constitution to Congress"
    },
    {
     "id": "F-E30",
     "quote": "For himself, he did not think a better plan was to be expected, and had no scruples against putting his name to it."
    },
    {
     "id": "F-E31",
     "quote": "He alluded to Mr. Blount for one."
    }
   ],
   "proposed": "中英文各补一句。中文：威廉森建议签名只限于随宪法呈交国会的信，或许能让一些不喜欢宪法的成员（麦迪逊注明其中包括布朗特）满意；他自己并不指望有更好的方案，愿意签。英文作对应补充。"
  }
 ],
