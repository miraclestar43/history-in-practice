 "issues": [
  {
   "id": "F1",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "本节标题是“三份材料的来路”，story.1 直接从“第二份材料”写起，但 story.0 没有交代第一份材料是什么。证据写明，第一份材料是该手稿的摘录，宣读的也只是选段，并非整份手稿。正文只写“那份旧手稿”，读者可能以为宣读的是整部手稿。中英文都有此缺口。",
   "evidence": [
    {
     "id": "V-E3",
     "quote": "1. Extracts from a MS. work on Species"
    },
    {
     "id": "V-E23",
     "quote": "from which we propose to read to the Society the extracts referred to"
    }
   ],
   "proposed": "在句首补一句：中文“第一份材料是这份手稿的摘录。”英文“The first item was extracts from this manuscript.”"
  },
  {
   "id": "F2",
   "path": "sections.story.4",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文用引号括起“强烈倾向”，看上去像原文引语，但它其实是英文证据的译述，证据中没有这几个中文字。英文版引的是原文，没有问题。",
   "evidence": [
    {
     "id": "V-E6",
     "quote": "as he was strongly inclined to do (in favour of Mr. Wallace)"
    }
   ],
   "proposed": "去掉中文引号，改为：……不能像信中所说他（为照顾华莱士）强烈倾向于做的那样……"
  },
  {
   "id": "F3",
   "path": "sections.analysis.1",
   "category": "attribution",
   "severity": "fix",
   "problem": "正文说第二种替代做法“与信中所记达尔文的倾向相对应”，并且只把其余两种标为作者构造。但第二种做法中“把达尔文的优先权留给他日后自述”这半句，信里没有记载。信里只记了两件事：达尔文提议征得华莱士同意后尽快发表其论文；他强烈倾向于扣下自己的手稿。此外，正文也漏掉了“征得华莱士同意”这一前提。",
   "evidence": [
    {
     "id": "V-E6",
     "quote": "to obtain Mr. Wallace's consent to allow the Essay to be published as soon as possible"
    },
    {
     "id": "V-E6",
     "quote": "as he was strongly inclined to do (in favour of Mr. Wallace)"
    }
   ],
   "proposed": "改为：第二种的前半（只发华莱士）与信中所记达尔文的倾向相对应：他提议征得华莱士同意后尽快发表其论文，并强烈倾向于不公开自己的手稿；“日后自述优先权”一节与其余两种一样，是作者提出的对照，不是材料里的记载。英文同步修改。"
  }
 ],
