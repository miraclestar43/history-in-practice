 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "正文称莱尔与胡克为“两位皇家学会会员”，英文作“both Fellows of the Royal Society”。证据只给出 Lyell 的头衔为 F.R.S.，胡克的头衔为 V.P.R.S.，两人共同的头衔是 F.L.S.。“都是皇家学会会员（F.R.S.）”属于推断。",
   "evidence": [
    {
     "id": "V-E1",
     "quote": "Sir Charles Lyell , F.R.S., F.L.S., and J. D. Hooker , Esq., M.D., V.P.R.S., F.L.S."
    }
   ],
   "proposed": "改为按信头所列头衔表述，例如“两位林奈学会会员莱尔与胡克”/“Charles Lyell and J. D. Hooker, both Fellows of the Linnean Society”；或分别写明 F.R.S. 与 V.P.R.S.。"
  },
  {
   "id": "F2",
   "path": "sections.context.0",
   "category": "facts",
   "severity": "fix",
   "problem": "证据说华莱士考察的是马来群岛“大部分岛屿”。英文“exploring the islands of the Malay Archipelago”和中文“这些岛屿”都没有体现“大部分”这一限定，略有夸大。",
   "evidence": [
    {
     "id": "V-E9",
     "quote": "explored the greater part of the islands constituting the Malay Archipelago"
    }
   ],
   "proposed": "英文改为“exploring the greater part of the islands of the Malay Archipelago”；中文补“考察了马来群岛的大部分岛屿”。"
  },
  {
   "id": "F3",
   "path": "sections.story.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "首句“达尔文的那份旧手稿从未打算发表”/“was never intended for publication”由叙述者以事实口吻直接断言。证据中这只是达尔文本人1858年脚注里的说法，应归于他本人。",
   "evidence": [
    {
     "id": "V-E12",
     "quote": "This MS. work was never intended for publication"
    }
   ],
   "proposed": "首句改为“据达尔文本人所说，那份旧手稿从未打算发表”/“By Darwin's own account, his old manuscript was never intended for publication.”，或删去首句，只保留脚注引述。"
  },
  {
   "id": "F4",
   "path": "sections.story.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文写“作者表示：如果达尔文认为……就请转给莱尔”，有两处问题。其一，本文其他段落用“作者”指本文作者，这里容易误读。其二，证据中这一意愿是莱尔和胡克信中转述的，不是华莱士原文。英文用 with the express wish 加引语，来源同样未标明。",
   "evidence": [
    {
     "id": "V-E5",
     "quote": "sent to him with the expressed wish that it should be forwarded to Sir Charles Lyell"
    }
   ],
   "proposed": "中文改为“据莱尔和胡克的信，华莱士寄出时表示：如果达尔文认为……”；英文补“according to Lyell and Hooker's letter”。"
  },
  {
   "id": "F5",
   "path": "sections.story.7",
   "category": "parity",
   "severity": "fix",
   "problem": "英文作“its royal medal”，中文作“获皇家学会奖章”，丢失了“royal medal”这一具体奖项名，中英不完全对应。",
   "evidence": [
    {
     "id": "V-E22",
     "quote": "he received the royal medal from the Royal Society"
    }
   ],
   "proposed": "中文改为“1868年获皇家学会颁发的皇家奖章（royal medal）”。"
  },
  {
   "id": "F6",
   "path": "sections.analysis.1",
   "category": "parity",
   "severity": "fix",
   "problem": "末句中英不一致。英文是“a party's willingness to give way”（让步的意愿），中文“当事人的让步”读作已经发生的让步。证据中，达尔文让出发表机会的倾向被莱尔和胡克的条件拦下；他实际做的是授权二人处置手稿。",
   "evidence": [
    {
     "id": "V-E6",
     "quote": "as he was strongly inclined to do (in favour of Mr. Wallace)"
    },
    {
     "id": "V-E7",
     "quote": "he gave us permission to make what use we thought proper of his memoir"
    }
   ],
   "proposed": "中文改为“当事人让步的意愿只是其中一步”，与英文保持一致。"
  },
  {
   "id": "F7",
   "path": "sections.limits.1",
   "category": "style",
   "severity": "note",
   "problem": "中文正文出现“证据包”这一编辑流程用语，英文作“the evidence”。面向读者的文本里显得生硬。",
   "evidence": [],
   "proposed": "改为“现有材料没有说明……”。"
  },
  {
   "id": "F8",
   "path": "sections.story.2",
   "category": "style",
   "severity": "note",
   "problem": "中文“证据里没有更多材料”、英文“nothing further in the evidence”同样使用了编辑流程用语。",
   "evidence": [],
   "proposed": "改为“现有材料中没有更多记载可以判断”/“nothing further in the surviving record decides between them”。"
  }
 ],
