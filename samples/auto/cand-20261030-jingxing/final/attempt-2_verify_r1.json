 "issues": [
  {
   "id": "V1",
   "path": "reflection.scenario",
   "category": "facts",
   "severity": "fix",
   "problem": "类比把“暂缓扩张、先加固后方”等同于李左车计中的“断其辎重”。原计的“断辎重”是派奇兵去截断汉军（对方）的补给，不是加固己方后方；只有“坚壁不战”与“暂缓扩张、加固后方”大致对应。按现写法，读者会误解原计内容。",
   "evidence": [
    {
     "id": "J-E2",
     "quote": "願足下假臣奇兵三萬人，從閒道絕其輜重；足下深溝髙壘，堅營勿與戰"
    }
   ],
   "proposed": "删去括注中的“断其辎重”，改为“（相当于“深沟高垒、坚壁不战”）”；英文同步改为 the equivalent of \"dig in behind high walls and refuse battle\"。"
  },
  {
   "id": "V2",
   "path": "sections.context.2",
   "category": "style",
   "severity": "note",
   "problem": "英文对李左车的称呼不统一：context.0 用 \"the Lord of Guangwu\"，此处和 story.4 用音译 \"the Guangwu Jun\"。",
   "evidence": [],
   "proposed": "全文统一为 \"the Lord of Guangwu\"。"
  }
 ],
 "overall": "定稿史实、引文与解释标注总体可靠，所有「」引语均逐字见于证据；仅反思场景的类比误述了李左车计策的内容，需小修，另有一处英文称呼不统一的文风问题。"
}