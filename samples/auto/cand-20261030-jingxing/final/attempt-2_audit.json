 "issues": [
  {
   "id": "F1",
   "path": "sections.context.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把译文 \"its edge cannot be withstood\" 放在引号里，读者看不出这是译述，容易误当原文。",
   "evidence": [
    {
     "id": "J-E2",
     "quote": "其鋒不可當"
    }
   ],
   "proposed": "改为 \"its edge, in his words, could not be withstood\"，或在引号后注明 (our translation)。"
  },
  {
   "id": "F2",
   "path": "sections.context.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文把「奇兵」译成 \"picked troops\"（精选部队），与原文“出奇之兵”的意思不符，也与中文“奇兵”和 analysis.0 英文的 \"surprise-force plan\" 不一致。",
   "evidence": [
    {
     "id": "J-E2",
     "quote": "願足下假臣奇兵三萬人"
    }
   ],
   "proposed": "把 \"thirty thousand picked troops\" 改为 \"a surprise force of thirty thousand\"。"
  },
  {
   "id": "F3",
   "path": "sections.context.2",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“史书对他的定性只有一句”/\"gets one line of characterization from the historian\" 是关于全部史料的“仅此一句”断言，超出证据包（只有摘录）所能核实的范围。",
   "evidence": [
    {
     "id": "J-E3",
     "quote": "成安君，儒者也，常稱義兵不用詐謀奇計"
    }
   ],
   "proposed": "中文改为“本传在记他拒计时对他有这样一句定性”，英文作相应修改，删去“只有一句/one line”。"
  },
  {
   "id": "F4",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "稿件说陈馀拒绝的理由“是两层”（算术与名声），漏掉了原文记下的另一条理由：今后若有更强的敌人来，又将如何应对。",
   "evidence": [
    {
     "id": "J-E3",
     "quote": "今如此避而不擊，後有大者，何以加之！"
    }
   ],
   "proposed": "补上这一条（如“若这样还避而不击，以后来了更强的敌人又怎么应付”），不再写“两层”，或改成“至少两层”并列出三条。"
  },
  {
   "id": "F5",
   "path": "sections.context.2",
   "category": "parity",
   "severity": "fix",
   "problem": "英文 \"to avoid battle at such odds\" 中的 \"at such odds\" 是原文和中文都没有的限定语。",
   "evidence": [
    {
     "id": "J-E3",
     "quote": "今如此避而不擊"
    }
   ],
   "proposed": "改为 \"to avoid battle like this\"。"
  },
  {
   "id": "F6",
   "path": "sections.story.3",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把译文 \"the walls were all hung with Han's red banners, and they were greatly alarmed\" 放进引号，冒充原文直引。",
   "evidence": [
    {
     "id": "J-E6",
     "quote": "壁皆漢赤幟，而大驚"
    }
   ],
   "proposed": "去掉引号改为转述，或注明是译文。"
  },
  {
   "id": "F7",
   "path": "sections.story.5",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把兵法句和「驅市人而戰之」的译文放在引号里，没有标明是译述。",
   "evidence": [
    {
     "id": "J-E8",
     "quote": "陷之死地而後生，置之亡地而後存"
    },
    {
     "id": "J-E8",
     "quote": "驅市人而戰之"
    }
   ],
   "proposed": "在引号后注明 (in translation)，或改为不加引号的转述。"
  },
  {
   "id": "F8",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "叙事停在李左车的谦辞上。证据显示，这句话是他献计前的铺垫，随后他献上“按甲休兵、先声后实”之计，韩信称善并采用，燕国随即归附。稿件把中途写成了结局，主题“赢家怎样对待提建议的人”因此缺了“实际采纳”这一环。此外，“任何人都可能出错”的解读没有交代，原文紧接着以成安君“一旦而失之”为例，讲的正是智者之失。",
   "evidence": [
    {
     "id": "J-E11",
     "quote": "顧恐臣計未必足用，願效愚忠"
    },
    {
     "id": "J-E11",
     "quote": "夫成安君有百戰百勝之計，一旦而失之"
    },
    {
     "id": "J-E11",
     "quote": "韓信曰：『善。』從其策，發使使燕，燕從風而靡"
    }
   ],
   "proposed": "在此段后补一句：李左车随即献计（按甲休兵、先遣辩士致书于燕），韩信称“善”，“從其策”，燕国随之归附。并在解读中说明谦辞之后紧接的是对成安君失策的评论和他自己的献计。"
  },
  {
   "id": "F9",
   "path": "sections.analysis.0",
   "category": "facts",
   "severity": "fix",
   "problem": "对陈馀拒绝理由的拆分只列了敌情判断和形象判断两类，漏掉了原文记载的“後有大者，何以加之”。这一条既不完全是对眼前汉军的判断，也不完全是形象问题，现有的二分法因此不完整。",
   "evidence": [
    {
     "id": "J-E3",
     "quote": "後有大者，何以加之"
    }
   ],
   "proposed": "把这一条列入拆分，并调整“不是一类东西”的归类说法，使其覆盖原文全部理由。"
  },
  {
   "id": "F10",
   "path": "sections.analysis.1",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把「使人閒視，知其不用」的译文 \"sending men to look in on them and learning the plan had not been used\" 放在引号里，没有标明是译述。",
   "evidence": [
    {
     "id": "J-E4",
     "quote": "韓信使人閒視，知其不用"
    }
   ],
   "proposed": "去掉引号改为转述，或注明是译文。"
  },
  {
   "id": "F11",
   "path": "sections.analysis.2",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“原文没有记下有人问‘那条计当初为什么没被采纳’”是对全篇的缺失断言，证据包只有摘录，无法核实。",
   "evidence": [],
   "proposed": "限定范围，改为“在诸将战后问答这一段里，问的是背水之术，没有问那条计为何被否”，英文作相应修改。"
  },
  {
   "id": "F12",
   "path": "sections.analysis.3",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把译文 \"whether advice is used or not used, heeded or not heeded\" 放在引号里，冒充原文直引；而且原文是就百里奚“用與不用”而言，译文加上 \"advice\" 改变了原句的主语。",
   "evidence": [
    {
     "id": "J-E9",
     "quote": "用與不用，聽與不聽也"
    }
   ],
   "proposed": "改为不加引号的转述，或注明是译文，并写成 \"whether a man is used or not, heeded or not\"。"
  },
  {
   "id": "F13",
   "path": "sections.limits.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“没有第二个独立史源可作交叉验证”是关于史源存在与否的断言，超出证据包范围。",
   "evidence": [],
   "proposed": "改为“本文没有使用第二个史源作交叉验证”，英文作相应修改。"
  },
  {
   "id": "F14",
   "path": "reflection.example.alternative",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把「使人閒視」的译文 \"sent men to look in on them\" 放进引号，没有标明是译述。",
   "evidence": [
    {
     "id": "J-E4",
     "quote": "韓信使人閒視"
    }
   ],
   "proposed": "去掉引号，改为 as Han Xin sent men to spy on the Zhao camp。"
  },
  {
   "id": "F15",
   "path": "sections.context.2",
   "category": "style",
   "severity": "note",
   "problem": "英文前文用 \"the Lord of Guangwu\"，此处改用 \"the Guangwu Jun\"，称谓不统一。",
   "evidence": [
    {
     "id": "J-E2",
     "quote": "廣武君李左車說成安君曰"
    }
   ],
   "proposed": "统一为 \"the Lord of Guangwu\"。"
  }
 ],
