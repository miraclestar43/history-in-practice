 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“兵力对比一目了然”/“The disparity was obvious”把兵力悬殊写成确定事实。证据中赵军二十万只是“號稱”。陈馀还认为韩信号称数万、实际不过数千。双方真实兵力在原文里并不确定。",
   "evidence": [
    {
     "id": "J-E1",
     "quote": "號稱二十萬"
    },
    {
     "id": "J-E3",
     "quote": "今韓信兵號數萬，其實不過數千"
    }
   ],
   "proposed": "改为“账面上兵力悬殊（赵军二十万是号称之数）”/“On paper the gap was wide (Zhao's two hundred thousand was a claimed figure).”"
  },
  {
   "id": "F2",
   "path": "sections.story.1",
   "category": "facts",
   "severity": "fix",
   "problem": "叙事漏掉了J-E4与J-E5之间的记载。韩信先令裨将传飧，宣布“今日破趙會食”，诸将都不信，只假装应诺。他还向军吏说明：赵军未见大将旗鼓，不肯攻击前军。这一段解释了一万人为何敢先出、背水列阵。没有它，story.5诸将所说的“曰破趙會食”在正文中缺了出处，也缺了韩信对这次部署的自述理由。",
   "evidence": [
    {
     "id": "J-E12",
     "quote": "令其裨將傳飱，曰：『今日破趙會食！』諸將皆莫信，詳應曰：『諾。』"
    },
    {
     "id": "J-E12",
     "quote": "且彼未見吾大將旗鼓，未肯擊前行，恐吾至阻險而還"
    }
   ],
   "proposed": "在“韩信派一万人先行”之前补一句（中英同步）：韩信令裨将传飧，说今日破赵会食，诸将都不信，只假意应诺；他对军吏说，赵军已先占据便利之地筑营，没见到大将旗鼓之前不会攻击前军。"
  },
  {
   "id": "F3",
   "path": "sections.story.3",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“Beaten in front”意为在前方被打败。中文“在前面不能取胜”与原文“已不勝”都只是未能取胜，英文说重了。",
   "evidence": [
    {
     "id": "J-E6",
     "quote": "趙軍已不勝，不能得信等"
    }
   ],
   "proposed": "英文改为“Unable to win in front and unable to catch Han Xin”。"
  }
 ],
