 "issues": [
  {
   "id": "F1",
   "path": "sections.context.1",
   "category": "attribution",
   "severity": "fix",
   "problem": "中文“埃勒里则应本人要求把反对改成了赞成”和英文“at his own request”都把改票的请求者写成埃勒里本人。证据只写“at the request of the Member”，没有写明这位议员是谁。",
   "evidence": [
    {
     "id": "U-E12",
     "quote": "Ellery, no changed into ay at the request of the Member"
    }
   ],
   "proposed": "中文改为“埃勒里的反对票记为‘应该议员请求’改成了赞成”；英文改为“Ellery's no was recorded as 'changed into ay at the request of the Member'”。"
  },
  {
   "id": "F2",
   "path": "sections.context.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“23日接见当天上午”和“on the morning of the audience”中的“上午”没有证据支持。证据只记23日的议决，没有给出时段。",
   "evidence": [
    {
     "id": "U-E4",
     "quote": "TUESDAY, DECEMBER 23, 1783"
    }
   ],
   "proposed": "删去“上午”和“on the morning of”，改为“23日接见当天”和“on the day of the audience itself, the 23rd”。"
  },
  {
   "id": "F3",
   "path": "sections.context.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“有议员动议先问一个问题”和“a motion asked a prior question”写了一项动议及其提出者。证据只有这个问题本身和部分表决名单，没有记载动议，也没有说明是谁提出的。",
   "evidence": [
    {
     "id": "U-E11",
     "quote": "Is it the sense of Congress that seven states in Congress Assembled are competent to receive the resignation of a Commander in Chief?"
    }
   ],
   "proposed": "中文改为“同一天，日志记下一个付诸表决的问题”；英文改为“The same day, the journal records a question put to the vote”。"
  },
  {
   "id": "F4",
   "path": "sections.context.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“议定的接见次序一共三条”和“ran to three clauses”与证据不符。议定稿共六条（1–3条加4–6条），本段说三条，下一段又说“后三条”，前后矛盾。",
   "evidence": [
    {
     "id": "U-E2",
     "quote": "1. The President and members are to be seated and covered"
    },
    {
     "id": "U-E14",
     "quote": "6. The President having finished"
    }
   ],
   "proposed": "中文改为“议定的接见次序共六条，前三条管入场与就座”；英文改为“The agreed order ran to six clauses; the first three covered entry and seating”。"
  },
  {
   "id": "F5",
   "path": "sections.context.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文“announced to the secretary by a messenger, who would then introduce the General”中，“who”在语法上指向 messenger。证据写明引入将军的是秘书。中文写法正确，英文与之不一致。",
   "evidence": [
    {
     "id": "U-E2",
     "quote": "announced by the messenger to the secretary, who is thereupon to introduce the General"
    }
   ],
   "proposed": "英文改为“…announced by a messenger to the secretary, and the secretary would then introduce the General…”。"
  },
  {
   "id": "F6",
   "path": "sections.story.1",
   "category": "inner_life",
   "severity": "fix",
   "problem": "英文多出一句“The President did not rush to fill the silence”。这是对议长态度的推测，证据只记“after a pause”，中文也没有这句话，同时构成中英不一致。",
   "evidence": [
    {
     "id": "U-E5",
     "quote": "the President, after a pause, informed him"
    }
   ],
   "proposed": "删去英文“The President did not rush to fill the silence; the silence itself was entered into the official account alongside the words.”这一句。"
  },
  {
   "id": "F7",
   "path": "sections.story.6",
   "category": "unsupported",
   "severity": "fix",
   "problem": "本段 kind=record，但“副本是这番说法的留档”和“kept on file”写成了事实。证据只记副本与委任状一并交给议长，没有记载副本是否归档。",
   "evidence": [
    {
     "id": "U-E9",
     "quote": "delivered to the President his commission, with a copy of his address"
    }
   ],
   "proposed": "中文改为“副本是这番说法的书面文本”；英文删去“kept on file”，或明确标为作者推断。"
  },
  {
   "id": "F8",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "“次日照章执行”和“executed to the letter”与证据有出入。议定稿第6条写由秘书从将军手中接收委任状，日志却记将军把委任状交给了议长。这一处推断所依据的事实前提不成立。",
   "evidence": [
    {
     "id": "U-E14",
     "quote": "receive the commiBoion from the General"
    },
    {
     "id": "U-E9",
     "quote": "He then advanced and delivered to the President his commission"
    }
   ],
   "proposed": "中文改为“次日按议定次序进行（日志称“According to order”）”；英文删去“to the letter”。如需要，可注明委任状的接收人与第6条字面不同。"
  },
  {
   "id": "F9",
   "path": "sections.analysis.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "本段 kind=interpretation，但正文没有解释标记。“高低位差被明确保留”和“kept deliberately visible”带有意图判断，被写成了事实。另外，“现场没有临时调整的记录”忽略了第6条（秘书接收委任状）与实际交给议长之间的差异，见 F8。",
   "evidence": [
    {
     "id": "U-E3",
     "quote": "which they are to return by uncovering without bowing"
    },
    {
     "id": "U-E14",
     "quote": "receive the commiBoion from the General"
    }
   ],
   "proposed": "段首加“作者认为”和“As the author reads it”；删去“明确”和“deliberately”；删去“现场没有临时调整的记录”和“with no record of last-minute adjustment”。"
  },
  {
   "id": "F10",
   "path": "sections.analysis.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“接见当天上午”和“on the very morning of the audience”中的“上午”没有证据支持，证据未给出时段。",
   "evidence": [
    {
     "id": "U-E4",
     "quote": "TUESDAY, DECEMBER 23, 1783"
    }
   ],
   "proposed": "删去“上午”，英文改为“on the very day of the audience”。"
  },
  {
   "id": "F11",
   "path": "sections.context.3",
   "category": "style",
   "severity": "note",
   "problem": "英文“are bracketed insertions The editors note”中，insertions 后缺少句号。",
   "evidence": [],
   "proposed": "在 insertions 后补句号。"
  },
  {
   "id": "F12",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "中英文都写“全部事实来自”12月22日和23日的记录，但正文也用到了12月20日的来信、议决和七州表决。limits.0 写的是“12月20日至23日”，两处不一致。",
   "evidence": [
    {
     "id": "U-E10",
     "quote": "Resolved, That his Excellency the Commander in Chief be admitted to a public audience, on Tuesday next, at twelve o'clock."
    }
   ],
   "proposed": "在括号内补上12月20日的来信、议决与七州表决（英文同步补“the letter, resolution and vote of December 20”）。"
  },
  {
   "id": "F13",
   "path": "sections.context.3",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写“由秘书宣布肃静”，英文“silence was to be ordered if necessary”省去了执行者秘书，中英不一致。",
   "evidence": [
    {
     "id": "U-E14",
     "quote": "silence is to be ordered by the secretary, if necessary"
    }
   ],
   "proposed": "英文改为“silence was to be ordered by the secretary if necessary”。"
  }
 ],
