 "issues": [
  {
   "id": "F1",
   "path": "title",
   "category": "chronology",
   "severity": "fix",
   "problem": "标题“鞠躬的人与脱帽的人”/“The Man Who Bowed and the Men Who Took Their Hats Off”把12月22日议定的规则写成了已经发生的动作。23日的记录没有记载将军实际鞠躬，也没有记载国会实际脱帽回礼。这与P1指出的问题同源。",
   "evidence": [
    {
     "id": "U-E3",
     "quote": "he is to bow to Congress, which they are to return by uncovering without bowing"
    },
    {
     "id": "U-E9",
     "quote": "He then advanced and delivered to the President his commission, with a copy of his address"
    }
   ],
   "proposed": "改为规定语气：zh“该鞠躬的人与该脱帽的人：1783年的一次权力交还”；en“The Man Who Was to Bow and the Men Who Were to Uncover: Handing Back Power, 1783”。"
  },
  {
   "id": "F2",
   "path": "sections.analysis.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "中文“将军起身致辞和退场时鞠躬，国会以脱帽回礼，站着的鞠躬、坐着的回礼”是直陈句，英文“the standing man bowed, the seated body answered”也是直陈句，都把22日的规则写成了23日已发生的动作。末句“有记录的权力交还/documented transfer”又暗示姿态已被记录在案。日志只记有规定，没有记载执行情况。",
   "evidence": [
    {
     "id": "U-E3",
     "quote": "When the General rises to make his address, and also when he retires, he is to bow to Congress"
    },
    {
     "id": "U-E5",
     "quote": "he arose and addressed Congi'ess as follows"
    }
   ],
   "proposed": "zh改为“按规定，将军起身致辞和退场时鞠躬，国会以脱帽回礼——站着的鞠躬、坐着的回礼”，末句改为“仪式、按规定的姿态、凭证三者叠加”。en改为“the standing man was to bow, the seated body to answer”，末句改为“Ceremony, prescribed posture, and token together”。"
  },
  {
   "id": "F3",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "“取自影印本的OCR识别”/“OCR of a facsimile”中的“影印本/facsimile”在证据中没有依据。证据只说明来源是1922年国会图书馆版第25卷的archive.org OCR。",
   "evidence": [
    {
     "id": "U-E1",
     "quote": "MONDAY, DECEMBER 22, 1783"
    }
   ],
   "proposed": "zh改为“这份材料取自1922年印本在archive.org上的OCR识别”；en改为“the material comes from archive.org OCR of the 1922 printed volume”。"
  },
  {
   "id": "F4",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "英文“captured by OCR from a facsimile”的“facsimile”在证据中没有依据，与F3相同。中文只说“材料经OCR识别”，没有这一说法，中英因此不一致。",
   "evidence": [],
   "proposed": "en改为“the material was captured by OCR (archive.org) from the 1922 printed volume”，删去“from a facsimile”。"
  }
 ],
 "inherited": [
  {
   "id": "P1",
   "verdict": "valid",
   "same_as": "F2",
   "rationale": "成立。U-E3只是22日议定的规则，用的是“is to bow”“are to return”。23日的记录（U-E5、U-E9）只记了起身致辞和交出委任状，没有记载实际的鞠躬或脱帽。analysis.0的中文直陈句、英文“the standing man bowed, the seated body answered”以及末句“documented transfer”都把规则写成了已记录的事实。已在F2中处理。",
   "evidence": [
    {
     "id": "U-E3",
     "quote": "which they are to return by uncovering without bowing"
    },
    {
     "id": "U-E9",
     "quote": "He then advanced and delivered to the President his commission"
    }
   ]
  }
 ]
