 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "正文写出全名“乔治·华盛顿/George Washington”。证据只称“General Washington”和“Commander in Chief”，名字“George”不在证据包内。",
   "evidence": [
    {
     "id": "U-E2",
     "quote": "the order for the public audience of General Washington"
    }
   ],
   "proposed": "改为“华盛顿将军/General Washington”，或用“总司令/its commander-in-chief, General Washington”。"
  },
  {
   "id": "F2",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "叙事停在交出委任状这一步，没有交代国会随后的答词。证据包现已收入答词（U-E19、U-E20），议定次序也规定由议长宣读答词、将军站着听。读者因此会以为仪式在交接处就结束了。此外，答词对华盛顿“关照亲信军官”的请求有直接回应，正文也未提及。",
   "evidence": [
    {
     "id": "U-E14",
     "quote": "the Pi'esident is to deliver the answer of Congi'ess, which the General is to receive standing"
    },
    {
     "id": "U-E19",
     "quote": "The United States in Congress assembled receive with emotions, too affecting for utterance"
    },
    {
     "id": "U-E20",
     "quote": "will particularly charge ourselves with the interests of those confidential officers"
    }
   ],
   "proposed": "在 story.6 之后补一两句：随后国会致答词，开头称合众国国会「receive with emotions, too affecting for utterance」（英文注明中文为译述），并承诺关照那些亲信军官。只引用证据中的清晰片段。"
  },
  {
   "id": "F3",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "括注称日志（委任状交给议长）与议定稿第6条（由秘书接收）不一致。但议定稿第4条中，博迪诺的方括号增字已写明把委任状与讲稿副本交给议长；第6条的相关字样在OCR中是乱码，无法确认是否仍然有效。只拿第6条与日志对比，忽略了第4条的修改，会误导读者。",
   "evidence": [
    {
     "id": "U-E14",
     "quote": "he is to deliver [his Commission and a] copy of his address to hia aid to be pre acntod to the Scorotaiy [to the President]"
    },
    {
     "id": "U-E9",
     "quote": "delivered to the President his commission"
    }
   ],
   "proposed": "改为：议定稿经方括号增字后，第4条已写明交给议长，与日志所记一致；第6条仍有由秘书接收委任状的字样，但OCR文本无法判断这些字是否已被删去。"
  },
  {
   "id": "F4",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“日志……不记心情”“在场者的反应一律付之阙如/simply absent”说得过头。日志收录的国会答词明确表述了国会的情感，华盛顿讲话本身也表达了心情（Happy、pleased）。",
   "evidence": [
    {
     "id": "U-E19",
     "quote": "receive with emotions, too affecting for utterance"
    },
    {
     "id": "U-E7",
     "quote": "Happy in the confirmation of our independence and sovereignty"
    }
   ],
   "proposed": "改为：日志不描写个人的神情与现场反应；国会正式答词自称以「emotions, too affecting for utterance」接受辞呈，那是机构的书面表态，不是现场描写。"
  },
  {
   "id": "F5",
   "path": "sections.limits.1",
   "category": "facts",
   "severity": "fix",
   "problem": "第一条保留意见称议长答词“没有收进本篇证据包”。证据包现已收入答词（U-E19、U-E20），这句话已不成立。",
   "evidence": [
    {
     "id": "U-E19",
     "quote": "the following answer: SiE, The United States in Congress assembled receive"
    }
   ],
   "proposed": "删去这一条，或改为：答词见于日志，本篇只引用其中OCR清晰的片段。"
  },
  {
   "id": "F6",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "与 F4、F5 相同：中英文都写着“议长答词未收入本篇证据包”，并称心情与反应“不可知”。答词现已在证据包中，且表述了国会的情感。",
   "evidence": [
    {
     "id": "U-E19",
     "quote": "The United States in Congress assembled receive with emotions, too affecting for utterance"
    }
   ],
   "proposed": "中英文同步修改：删除“答词未收入证据包、不引用”；改为“个人神情与现场反应不可知；国会正式答词见于日志，并按清晰片段引用”。"
  }
 ],
