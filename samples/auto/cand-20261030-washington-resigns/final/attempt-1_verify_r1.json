 "issues": [
  {
   "id": "V1",
   "path": "sections.context.1",
   "category": "facts",
   "severity": "fix",
   "problem": "证据只收录了点名表决的一部分（U-E12 标为 part of the yeas and nays），也没有给出表决结果。正文写“名单上列出的议员几乎都投赞成”/“Nearly every member listed voted ay”，读者会理解为整份名单的投票情况，超出了证据范围。",
   "evidence": [
    {
     "id": "U-E12",
     "quote": "Partridge, no Ellery, no changed into ay at the request of the Member Howell, ay Mifflin, ay"
    }
   ],
   "proposed": "改为“在本篇所见的部分名单中，除帕特里奇投反对外均为赞成……”/“In the portion of the roll call cited here, every member voted ay except Partridge…”。"
  },
  {
   "id": "V2",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“According to order”的意思是“依照（20日的）议决”，不是“按议定次序”。证据本身也显示实际经过与议定稿不完全一致：议定稿第6条规定由秘书接收委任状，日志记载的是交给议长。因此“接见按议定次序进行”/“the audience proceeded in the agreed order”属于过度断言，日志转述也被误译成“按既定次序”。",
   "evidence": [
    {
     "id": "U-E5",
     "quote": "According to order, his Excellency the Commander in Chief was admitted to a public audience"
    },
    {
     "id": "U-E9",
     "quote": "He then advanced and delivered to the President his commission"
    },
    {
     "id": "U-E14",
     "quote": "receive the commiBoion from the General"
    }
   ],
   "proposed": "改为“第二天，12月23日，星期二，接见如期举行。日志写道：依照议决（according to order），总司令获准公开接见。”英文相应删去 “in the agreed order”。"
  },
  {
   "id": "V3",
   "path": "sections.story.6",
   "category": "unsupported",
   "severity": "fix",
   "problem": "英文“The journal closes the entry in one line”断言这一句是当日条目的结尾。证据片段 U-E9 并未显示条目在此结束，该句话本身也没有句号收尾。这句在中文版中也没有对应。",
   "evidence": [
    {
     "id": "U-E9",
     "quote": "He then advanced and delivered to the President his commission, with a copy of his address"
    }
   ],
   "proposed": "改为“The journal records it in one line:”，或删去该句，与中文保持一致。"
  },
  {
   "id": "V4",
   "path": "sections.limits.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“日志印本用方括号和删改标出议定稿的修改”中，关于印本用删改符号标注修改的说法，在证据中找不到依据。证据只说明这是带方括号改动的草稿，方括号内为博迪诺笔迹。",
   "evidence": [
    {
     "id": "U-E14",
     "quote": "draft with bracketed changes; OCR garbled in places"
    },
    {
     "id": "U-E15",
     "quote": "the words in brackets being in the writing of Elias Boudinot"
    }
   ],
   "proposed": "改为“日志印本以方括号标出议定稿中博迪诺笔迹的字样；OCR 文本无法判断原稿另有哪些删改，本篇只转述方括号中的字样。”英文同步修改。"
  },
  {
   "id": "V5",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "与 V4 相同：“议定稿的删改在OCR文本中只能看到方括号内的字样”/“not what was struck out”暗示印本有明确的删除标记，证据未提供这一点。",
   "evidence": [
    {
     "id": "U-E14",
     "quote": "draft with bracketed changes; OCR garbled in places"
    }
   ],
   "proposed": "改为“议定稿的改动在本篇所据的OCR文本中只能确认方括号内的字样（据编者注为博迪诺笔迹），其他删改无法判断。”英文同步修改。"
  }
 ],
 "overall": "定稿整体证据扎实，引语逐字无误，解释段均已标注。需修正五处：部分点名名单的概括、“according to order”的误读、英文中无据的“条目结尾”说法，以及关于印本删改标记的无据表述。"
}