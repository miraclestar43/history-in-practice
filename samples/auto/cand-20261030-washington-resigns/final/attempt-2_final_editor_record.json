 "edits": [
  {
   "path": "dek.zh",
   "before": "总司令到国会交还委任状。国会在前一天把谁坐着、谁鞠躬、谁脱帽逐条写进日志——交接的形式本身，就是交接内容的一部分。",
   "after": "总司令到国会交还委任状。国会在前一天把谁坐着、谁鞠躬、谁脱帽逐条写进日志。作者认为，交接的形式本身，就是交接内容的一部分。",
   "issues": [
    "F1"
   ]
  },
  {
   "path": "dek.en",
   "before": "The commander in chief came before Congress to hand back his commission. The day before, Congress wrote into its journal exactly who would sit, who would bow, and who would lift a hat. The form of the handover was part of what was being handed over.",
   "after": "The commander in chief came before Congress to hand back his commission. The day before, Congress wrote into its journal exactly who would sit, who would bow, and who would lift a hat. On the author's reading, the form of the handover was part of what was being handed over.",
   "issues": [
    "F1"
   ]
  },
