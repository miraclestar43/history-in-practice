 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "style",
   "severity": "fix",
   "problem": "易读性（readability）：开头第一段直接写“格兰特”“李”“波托马克军”。没有说明格兰特是追击一方（联邦/北军）的将领，李是被追击的南军北弗吉尼亚军团的统帅，也没有点明这是内战末期的追击。不了解背景的读者说不清谁在追谁，也不知道为什么这封信要紧。",
   "evidence": [
    {
     "id": "GRANT671-E1",
     "quote": "followed the Army of the Potomac in rear of Lee"
    },
    {
     "id": "GRANT671-E28",
     "quote": "General Lee surrendered the Army of Northern Virginia"
    },
    {
     "id": "GRANT671-E18",
     "quote": "every man of the Confederate army"
    }
   ],
   "proposed": "在格兰特、李第一次出现时各加半句身份说明：格兰特是率联邦军（波托马克军）追击的一方，李是南军北弗吉尼亚军团的统帅。“波托马克军”可只保留一次，并说明是格兰特一方的军队。不增加证据外的事实。"
  },
  {
   "id": "F2",
   "path": "sections.hook.1",
   "category": "style",
   "severity": "fix",
   "problem": "易读性（readability）：hook.0 结尾是格兰特拒绝会面，hook.1 却直接进入受降条文的起草，中间没有交代后来变成了受降会面，读者不知道问题是怎么变成‘起草受降条件’的。英文 \"In the writer's view, the difficulty was that the actual terms of surrender were his to draft\" 中的 his 紧跟 writer，容易误读成作者本人；中文“得由他自己”也指代不清。",
   "evidence": [
    {
     "id": "GRANT671-E11",
     "quote": "he had asked for this interview for the purpose of getting from me the terms I proposed to give his army"
    }
   ],
   "proposed": "在段首加一句过渡：后来李约见是为了听取格兰特给他军队的条件。把 his/“他”改为 Grant's/“格兰特”。不改动其余事实与限定。"
  },
  {
   "id": "F3",
   "path": "sections.context.0",
   "category": "style",
   "severity": "fix",
   "problem": "易读性（readability）：米德、谢里登第一次出现，没有说明身份（格兰特一方的指挥官）。“北弗吉尼亚军团”第一次出现，没有说明就是李的军队。段首又重复了 hook.0 已讲过的回信内容，占去了开头篇幅。",
   "evidence": [
    {
     "id": "GRANT671-E3",
     "quote": "both of these commanders hesitated very considerably"
    },
    {
     "id": "GRANT671-E28",
     "quote": "General Lee surrendered the Army of Northern Virginia"
    }
   ],
   "proposed": "删去或压缩段首对回信的重复。注明米德、谢里登是格兰特一方的两位指挥官，北弗吉尼亚军团即李的军队。"
  },
  {
   "id": "F4",
   "path": "sections.context.1",
   "category": "style",
   "severity": "fix",
   "problem": "易读性（readability）：开头部分出现了约翰斯顿，没有任何身份说明。又堆了“里士满—林奇堡路”“法姆维尔—林奇堡路”“沃克教堂以西约四英里”等读者此时用不上的路名和里程。",
   "evidence": [
    {
     "id": "GRANT671-E7",
     "quote": "Johnston was marching up from North Carolina now"
    },
    {
     "id": "GRANT671-E6",
     "quote": "from the Richmond and Lynchburg road to the Farmville and Lynchburg road"
    }
   ],
   "proposed": "约翰斯顿第一次出现时按证据说明为“正从北卡罗来纳北上、北军担心李要去会合的另一支南军”。路名可概括为“因为改走了另一条路”，具体路名和里程放到后文或删去，保留11点50分收信这一时间。"
  },
  {
   "id": "F5",
   "path": "sections.story.5",
   "category": "parity",
   "severity": "fix",
   "problem": "英文把格兰特斥为虚构的范围写成 \"much else said about the occasion\"，扩大成关于整场会面的说法。原文只指献剑一事及与之相关的说法（about it）。中文“关于它的许多其他说法”是准确的，中英不一致。",
   "evidence": [
    {
     "id": "GRANT671-E20",
     "quote": "this and much more that has been said about it is the purest romance"
    }
   ],
   "proposed": "英文改为 \"Grant dismissed it, and much else that had been said about it, as \\\"the purest romance.\\\"\""
  },
  {
   "id": "F6",
   "path": "sections.limits.2",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“本章没有写宣誓遣散和马骡宽许的实际执行经过”/\"this chapter does not describe...\" 是对整章内容的断言，而证据包只是该章节选，不能支持这一说法。",
   "evidence": [],
   "proposed": "改为“本文所据的段落没有写……实际执行经过”/\"the passages this piece draws on do not describe how ... was actually carried out\"。"
  },
  {
   "id": "F7",
   "path": "uncertainty_note",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“其落实情况原文没有交代”“未写执行经过”/\"its implementation is not reported\"/\"but not how it was carried out\" 都是对原文整体的断言，证据包只有节选，不能支持。",
   "evidence": [],
   "proposed": "改为“本文所据段落未交代其落实情况/执行经过”/\"is not reported in the passages used here\"。"
  },
  {
   "id": "F8",
   "path": "uncertainty_note",
   "category": "parity",
   "severity": "fix",
   "problem": "中文写“马匹宽许”，英文和正文其他各处都是马和骡（horses and mules）。中文缩小了宽许范围，与英文不一致。",
   "evidence": [
    {
     "id": "GRANT671-E18",
     "quote": "who claimed to own a horse or mule"
    }
   ],
   "proposed": "中文改为“马骡宽许”。"
  }
 ],
