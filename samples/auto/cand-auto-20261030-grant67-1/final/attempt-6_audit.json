 "issues": [
  {
   "id": "F1",
   "path": "sections.context.0",
   "category": "chronology",
   "severity": "fix",
   "problem": "原文顺序是：米德、谢里登起初犹豫，最终同意停火两小时；接着发现按格兰特所走的路线，信使无法在这一时限内往返；李因此派卫队护送信使穿过战线。稿件把护送一事放在前面，又用“另据／Separately”引出停火两小时，割断了两者的联系。读者因此看不出“约定时间／time fixed”就是这两小时。",
   "evidence": [
    {
     "id": "GRANT671-E26",
     "quote": "They, however, finally consented to a suspension of hostilities for two hours"
    },
    {
     "id": "GRANT671-E4",
     "quote": "It was found that, from the route I had taken, they would probably not be able to communicate with me and get an answer back within the time fixed"
    },
    {
     "id": "GRANT671-E4",
     "quote": "Lee, therefore, sent an escort"
    }
   ],
   "proposed": "调整为原文顺序：先写米德、谢里登犹豫，最终同意停火两小时；再写在这一时限内信使按格兰特的路线来不及往返，因此李派人护送信使穿过自己的战线。删去“另据／Separately”。不要补入证据中没有的白旗等细节。"
  },
  {
   "id": "F2",
   "path": "sections.analysis.2",
   "category": "causality",
   "severity": "fix",
   "problem": "句中“因为真正要办的事——交名册、办宣誓、放人回乡——都得靠对方的人去做”是以事实口吻写的因果判断，与证据不符。证据记载，宣誓遣散由格兰特指定的北军将领吉本、格里芬、梅里特执行，李的将领只是留下与之协商、以便利此事。名册也有一份交给格兰特指定的军官。另外，把叫停鸣炮说成“胜利方当天说的第一句话”与记载不符，叫停是在受降消息传开之后。",
   "evidence": [
    {
     "id": "GRANT671-E28",
     "quote": "Generals Gibbon, Griffin and Merritt were designated by me to carry into effect the paroling of Lee′s troops"
    },
    {
     "id": "GRANT671-E28",
     "quote": "General Lee leaving Generals Longstreet, Gordon and Pendleton for them to confer with in order to facilitate this work"
    },
    {
     "id": "GRANT671-E22",
     "quote": "When news of the surrender first reached our lines"
    }
   ],
   "proposed": "改为“部分执行环节需要对方配合（如连、团长官为所部具结，李留下的将领协助宣誓遣散）”，并整句标为作者推断。“第一句话”改为“受降消息传开后的第一个表态”之类的说法，并保留“一种解释是”。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "style",
   "severity": "fix",
   "problem": "易读性问题：开头只写“8日／On the 8th”，没有年月，也没有交代是哪场战争的哪个阶段。不了解背景的读者无法给事件定位。证据所录电报注明次日为1865年4月9日。",
   "evidence": [
    {
     "id": "GRANT671-E28",
     "quote": "April 9th, 1865"
    },
    {
     "id": "GRANT671-E1",
     "quote": "On the 8th I had followed the Army of the Potomac in rear of Lee"
    }
   ],
   "proposed": "首句改为“1865年4月8日（据原文所录电报推定月份与年份）”，或在首段注明会面在次日即1865年4月9日。不增加其他事实。"
  },
  {
   "id": "F4",
   "path": "sections.context.1",
   "category": "style",
   "severity": "note",
   "problem": "易读性问题：约翰斯顿首次出现时没有任何身份说明，却写作“这位约翰斯顿／this Johnston”，仿佛前文已介绍过此人。证据只说他正从北卡罗来纳北上。",
   "evidence": [
    {
     "id": "GRANT671-E7",
     "quote": "they believed that Johnston was marching up from North Carolina now"
    }
   ],
   "proposed": "去掉“这位／this”，写作“他们相信约翰斯顿正率部从北卡罗来纳北上”。不补写证据以外的身份信息。"
  }
 ],
