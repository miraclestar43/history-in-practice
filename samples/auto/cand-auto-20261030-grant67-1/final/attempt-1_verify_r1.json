 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "中英不对等。英文有三处内容中文没有：①农舍在大部队后方一段距离；②回信说求和条件众所周知；③关于日期写法的说明（the date is given the way Grant gives it）。",
   "evidence": [
    {
     "id": "GRANT671-E1",
     "quote": "some distance in rear of the main body of the army"
    },
    {
     "id": "GRANT671-E2",
     "quote": "The terms upon which peace can be had are well understood"
    }
   ],
   "proposed": "中文补上「离大部队有一段距离」和「和平的条件众所周知」；英文删去日期写法的插入语，或在中文对应补一句。"
  },
  {
   "id": "V2",
   "path": "sections.context.1",
   "category": "parity",
   "severity": "fix",
   "problem": "中文少了两处英文有的内容：①信迟到是因为改走了另一条路；②格兰特随后被带到李所在处。中英信息量不一致。",
   "evidence": [
    {
     "id": "GRANT671-E6",
     "quote": "in consequence of my having passed from the Richmond and Lynchburg road to the Farmville and Lynchburg road"
    },
    {
     "id": "GRANT671-E7",
     "quote": "pretty soon was conducted to where he was"
    }
   ],
   "proposed": "中文补上「因为他已从里士满—林奇堡路转到法姆维尔—林奇堡路」，句末补「不久便被领到李所在之处」。"
  },
  {
   "id": "V3",
   "path": "sections.story.heading",
   "category": "unsupported",
   "severity": "fix",
   "problem": "标题里的「桌子／Table」在证据中没有出现，属于证据之外的具体细节。",
   "evidence": [
    {
     "id": "GRANT671-E8",
     "quote": "I found him at the house of a Mr. McLean, at Appomattox Court House"
    }
   ],
   "proposed": "改为「麦克莱恩家的会面／The Meeting at the McLean House」。"
  },
  {
   "id": "V4",
   "path": "sections.analysis.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文末句把话说成是格兰特本人断言条款会有良好效果，丢掉了「这是李说的话、格兰特只是转述」这一层；也漏掉了 with some feeling, I thought 的限定。中文末句没有这个问题。",
   "evidence": [
    {
     "id": "GRANT671-E16",
     "quote": "he remarked, with some feeling, I thought, that this would have a happy effect upon his army"
    }
   ],
   "proposed": "英文改为：When Lee read that passage, Grant recorded, he remarked that this would have a happy effect upon his army."
  },
  {
   "id": "V5",
   "path": "sections.analysis.2",
   "category": "parity",
   "severity": "fix",
   "problem": "中文用「代价可能是」作推测性表述，英文写成 The cost would be，语气更接近定论，中英强度不一致。",
   "evidence": [],
   "proposed": "英文改为 The cost might be an unwillingness to cooperate…"
  },
  {
   "id": "V6",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "证据只给出回忆录标注的年份 1885–86，看不出这是写作时间还是出版时间，文中写成「写于」证据不足。英文的 some years after 还隐含了事件年份，而证据并未提供。",
   "evidence": [
    {
     "id": "GRANT671-E1",
     "quote": "Ulysses S. Grant, Personal Memoirs (1885–86)"
    }
   ],
   "proposed": "改为「回忆录（1885–86年出版），成书于事后」；英文改为 published in 1885–86, after the events。"
  },
  {
   "id": "V7",
   "path": "uncertainty_note",
   "category": "attribution",
   "severity": "fix",
   "problem": "「不替任何一方写心理／does not write psychology for either side」的主语接在「他（格兰特）」之后，读来像是格兰特不写心理。但格兰特明确写了自己的心情，这一说法与证据不符；原意应是本文不替任何一方补写心理。",
   "evidence": [
    {
     "id": "GRANT671-E10",
     "quote": "but my own feelings, which had been quite jubilant on the receipt of his letter, were sad and depressed"
    }
   ],
   "proposed": "中文改为「他明言不知李的心情；本文不替任何一方补写心理」；英文改为 …did not know Lee's feelings, and this piece does not supply psychology for either side."
  }
 ],
 "overall": "定稿史实整体有证据支撑，引语逐字无误，解释段也已标注为解释；但仍有中英不对等、一处证据外细节（桌子）、两处归属错位和出版年份表述不准，需按以上建议小改后放行。"
}