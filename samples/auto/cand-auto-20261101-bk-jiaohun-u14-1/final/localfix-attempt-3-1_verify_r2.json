 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.3",
   "category": "attribution",
   "severity": "fix",
   "problem": "稿件说“孔飞力把江西也算作这样的例子”，又写“这最接近因不信其事而轻视此案的一种。这是孔飞力从档案作出的推断”。这样一来，把江西归入抵制类型的归类判断也被算到了孔飞力名下。证据只显示孔飞力分别列举了几种抵制情形（E5），并另外推断吴绍诗不打算查缉（E15）。证据中没有孔飞力把江西归入其中某一类的表述。这个归类是本文作者的解读，英文版同样有此问题。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E5",
     "quote": "还有一些可能是某些官员因不可知论而产生的轻视使他们不把叫魂案件当作一回事"
    },
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "巡抚吴绍诗根本就不打算查缉这个他认为是误传的案子"
    }
   ],
   "proposed": "中文改为：“对江西，孔飞力的推断是，吴绍诗‘根本就不打算查缉这个他认为是误传的案子’。本文作者认为，这最接近因不信其事而轻视此案的一种。”并删去“孔飞力把江西也算作这样的例子”和“这是孔飞力从档案作出的推断”。英文相应改为：\"For Jiangxi, Kuhn infers that Wu Shaoshi never intended to pursue a case he regarded as a false rumour; in my reading this comes closest to the officials who doubted the whole thing.\" 同时删去 \"Kuhn counts Jiangxi among these cases\" 和 \"That is Kuhn's inference from the archives.\""
  },
  {
   "id": "V2",
   "path": "sections.story.5",
   "category": "readability",
   "severity": "note",
   "problem": "中文引语「恐属空言，实难信矣口」末尾的“口”是排印残字，读者读到会卡住，因此还需要在 uncertainty_note 里专门解释一句。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E13",
     "quote": "恐属空言，实难信矣口"
    }
   ],
   "proposed": "引语改为逐字片段「恐属空言，实难信矣」，这仍是证据原文的连续片段。uncertainty_note 中关于“口”字照录的那半句随之删去，中英文同步。"
  },
  {
   "id": "V3",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "中文这里用“臬司”，story.3 和 story.7 用“按察使”。读者无法知道两者是同一职位，也就看不出冯钤所交办的官职正是吴坛担任的官职。英文两处都用 judicial commissioner，表述是一致的。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E3",
     "quote": "汝按例交臬司"
    }
   ],
   "proposed": "首次出现时改为“已让省按察使（即臬司）去调查妖术嫌犯”，引语原文保持不动。"
  },
  {
   "id": "V4",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头直接写“叫魂的谣言”，全文始终没有说明叫魂是什么。不了解背景的读者不知道它是一种妖术恐慌，后文的“剪辫”也因此显得突兀。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E3",
     "quote": "他让省臬司去调查妖术嫌犯"
    }
   ],
   "proposed": "中文改为“叫魂妖术的谣言传进了江西”，英文改为 \"rumours of soulstealing sorcery\"。不补写其他细节。"
  },
  {
   "id": "V5",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits 与 uncertainty_note 几乎逐项重复：依据范围、“装模作样”是推断、高晋袒护是推测。这与“宁短勿凑”的要求不符。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "他在先前奏报中提出的忧心忡忡的警告和精心布置的查缉都只是装模作样而已"
    }
   ],
   "proposed": "二者择一保留完整表述。uncertainty_note 可以缩成一句：“本文只依据孔飞力《叫魂》中译本；‘装模作样’与高晋袒护分别是孔飞力的推断与推测。”"
  }
 ],
 "overall": "引语、日期、人物和因果大体都有证据支持，推断也标注清楚；须修正 analysis.3 把作者自己的归类说成孔飞力判断的问题，其余为易读性建议。"
}