 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“从浙江传进了江西”/“crossed from Zhejiang into Jiangxi”沿用了已知污染K1的说法。证据只写谣言经信江河谷这条通往浙江的通道传入江西，没有写谣言来自浙江。下一句已经交代了这条通道，所以这半句也是重复。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "江西东面的信江河谷是连接邻省浙江的便捷通道，叫魂的谣言早在6月中旬就从这里悄悄地传人了江西"
    }
   ],
   "proposed": "中文改为“1768年6月中旬，叫魂的谣言传进了江西。”英文改为“In the middle of June 1768, rumours of soulstealing reached Jiangxi.”后句保留。"
  },
  {
   "id": "F2",
   "path": "sections.story.2",
   "category": "facts",
   "severity": "fix",
   "problem": "“只回了一句「汝误矣」”/“wrote a single line”断言弘历的回应只有这一句。证据只说弘历“只是温和地驳斥了他”，并引了“汝误矣”，没有说回应只有一句。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E11",
     "quote": "只是温和地驳斥了他：对谣言来加奏报是“汝误矣”"
    }
   ],
   "proposed": "中文改为“弘历只是温和地驳斥他：「汝误矣」，意思是你做错了。”英文改为“the emperor rebuked him only mildly: \"You were wrong.\"”"
  },
  {
   "id": "F3",
   "path": "sections.story.4",
   "category": "attribution",
   "severity": "fix",
   "problem": "英文把吴绍诗奏报里的部署写成了已经发生的事实，并把“每旬报告”指定为密查人员所报。“they reported every ten days”和“The search ran from religious houses ... into the remotest forest”都是这种写法。证据只是吴绍诗报告中的安排，没有写明由谁报告；孔飞力还提出这张警网可能从未动用过。中文“从寺庙道观……一直查到深山密林”也宜明确为奏报所说的查访范围。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E12",
     "quote": "并每旬一次报告有无可疑人物"
    },
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "要么是吴的警网从来就没有真正地动用过"
    }
   ],
   "proposed": "英文改为“with a report every ten days on whether anyone suspicious had appeared”，删去“The search ran from ... forest.”或改为“The places named ran from religious houses ... to the remotest forest.”中文末句改为“查访范围从寺庙道观、祠堂书馆，一直到深山密林”。"
  },
  {
   "id": "F4",
   "path": "sections.story.5",
   "category": "chronology",
   "severity": "fix",
   "problem": "“报告里还有一段警告”把E13的警告和朱批直接归入10月初那份警网报告，并说朱批“针对的正是这份奏报”/“aimed squarely at this report”。证据没有说明E13出自哪一份奏报；孔飞力只称之为“先前奏报”中的警告。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "他在先前奏报中提出的忧心忡忡的警告和精心布置的查缉"
    }
   ],
   "proposed": "中文改为“吴绍诗的奏报里还有一段警告”，末句改为“这是一句明白的怀疑。”英文改为“In his memorials Wu Shaoshi also issued a warning.”，末句改为“It was open doubt.”"
  },
  {
   "id": "F5",
   "path": "sections.analysis.2",
   "category": "chronology",
   "severity": "fix",
   "problem": "“弘历在那份奏报上写下了「恐属空言」”/“on that very report”同样把朱批固定在某一份奏报上，证据不支持。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E13",
     "quote": "朱批：“恐属空言，实难信矣口”"
    }
   ],
   "proposed": "中文改为“弘历在吴绍诗的警告旁批下了「恐属空言」”。英文改为“Hongli wrote \"I fear these are empty words\" beside Wu Shaoshi's warning.”"
  },
  {
   "id": "F6",
   "path": "sections.limits.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "“倾向于装模作样的解释”/“leaned toward”弱化了孔飞力的说法。孔飞力据江西没有刑求和伪证，说的是“只能相信”。这也与analysis.0的转述不一致。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "据此，我们只能相信，巡抚吴绍诗根本就不打算查缉这个他认为是误传的案子"
    }
   ],
   "proposed": "中文改为“但据江西没有刑求和伪证，认为只能相信装模作样的解释”。英文改为“but, finding no torture or false testimony in Jiangxi, concluded that only the explanation of a show was credible.”"
  },
  {
   "id": "F7",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "note",
   "problem": "末句“他先列出过……认为只能相信前一种”与本段前文重复，读起来像核查说明。",
   "evidence": [],
   "proposed": "末句只保留“这是孔飞力的推断，不是档案记载。”英文同步删去最后一句。"
  },
  {
   "id": "F8",
   "path": "sections.story.7",
   "category": "readability",
   "severity": "note",
   "problem": "story.6已经写到10月之后六个星期，story.7又回到9月28日，读者可能误以为吴坛查经堂发生在江西报告之后。",
   "evidence": [],
   "proposed": "开头改为“早在9月底，吴坛走的是另一条路。”英文改为“Back in late September, Wu Tan went another way.”"
  },
  {
   "id": "F9",
   "path": "uncertainty_note",
   "category": "readability",
   "severity": "note",
   "problem": "uncertainty_note与limits.0基本重复：唯一依据、装模作样是推断、高晋袒护是推测。",
   "evidence": [],
   "proposed": "只保留关于“口”字照录的说明，其余删去，因为limits已有。"
  },
  {
   "id": "F10",
   "path": "sections.hook.1",
   "category": "readability",
   "severity": "note",
   "problem": "hook.1重复了dek的前提，即追捕不存在的妖首、抓不到人挨骂，摘要与开头有部分重叠。",
   "evidence": [],
   "proposed": "可以把dek的前半句改为只提处境，例如“皇帝追得很紧，巡抚们怎么回话都可能挨骂”，把“妖首并不存在”留给hook.1。"
  },
  {
   "id": "F11",
   "path": "sections.analysis.3",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“feared that a purge would endanger their careers”把“清剿”（对妖党的清剿，全文英文作campaign/suppression）译成purge，容易被读成对官员的整肃，与中文意思不一致。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E5",
     "quote": "害怕清剿会危及自己的仕途"
    }
   ],
   "proposed": "改为“feared that the suppression campaign would endanger their careers”。"
  }
 ],
