 "issues": [
  {
   "id": "V1",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头直接用“叫魂的谣言”，没有说明叫魂指什么。读者到 story.2 才第一次看到“剪辫”，而且全文没有把两者联系起来。这不妨碍读者说清处境，但会让人对案情感到模糊。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "也没有在本省发现剪辫情事"
    },
    {
     "id": "BK-JIAOHUN-U141-E14",
     "quote": "江西没有发现一起剪辫案"
    }
   ],
   "proposed": "在 hook.0 首句后补半句说明，例如“叫魂的谣言（传说有术士剪人发辫、摄人魂魄）”。英文同步补上。不要补造其他细节。"
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头第二句交代信江河谷这条路线，读者此时用不上，冲淡了“谣言入境、巡抚未报”这条主线。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "江西东面的信江河谷是连接邻省浙江的便捷通道"
    }
   ],
   "proposed": "可压缩为“谣言从邻省浙江传进了江西”，删去信江河谷细节。英文同步修改。"
  },
  {
   "id": "V3",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 重复交代同两点：“装模作样”是孔飞力的推断，高晋袒护一项是推测。文末局限说明略显重复。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E16",
     "quote": "也可能由于他的顶头上司、弘历的姻亲高晋的袒护"
    }
   ],
   "proposed": "uncertainty_note 只保留依据范围和“口”字照录的说明，删去与 limits.0 重复的两句。英文同步修改。"
  }
 ],
 "overall": "事实、引文、归属和中英对应逐项核对均有证据支持，推断已用自然句子标明。仅有三处不影响理解的易读性建议（note），可以发布。"
