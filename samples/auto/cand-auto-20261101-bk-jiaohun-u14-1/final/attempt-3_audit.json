 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.1",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“an emperor who meant every word of his orders”比中文“一位认真追究的皇帝”说得更重。证据只说弘历当时没有察觉案件的荒谬，没有说他对每道命令都字字当真。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E21",
     "quote": "叫魂案件虽如此荒谬，但弘历在当时却对此并无察觉"
    }
   ],
   "proposed": "英文改为“The governors faced an emperor who was in earnest about the hunt, and a quarry that could not be caught.”，与中文对齐。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头直接写“叫魂的谣言”，不了解背景的读者不知道谣言具体指什么。正文到 story.2 才出现“剪辫”。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "也没有在本省发现剪辫情事"
    }
   ],
   "proposed": "可在首次提到时用半句点明，这类谣言与“剪辫”有关（英文 queue-clipping）。不要另加背景。"
  },
  {
   "id": "F3",
   "path": "sections.story.8",
   "category": "causality",
   "severity": "fix",
   "problem": "稿件把苏尔德受罚写成单纯“收场时被挑出来重罚”，漏掉了孔飞力交代的处罚性质：案子基础崩溃后，弘历在官僚中找替罪羊来结束清剿，并借处罚证明清剿正确。同时受罚的还有富尼汉。缺了这一层，读者会把苏尔德的下场当成对“不报、阻挠”的常规惩处，判断会改变。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E22",
     "quote": "恼羞成怒的弘历以在官僚中寻找替罪羊来结束对叫魂案的清剿"
    },
    {
     "id": "BK-JIAOHUN-U141-E22",
     "quote": "只有通过处罚这些官员的失职，他才能向世人和后代昭告，他的清剿是正确的"
    },
    {
     "id": "BK-JIAOHUN-U141-E19",
     "quote": "苏尔德被单独挑出来受到特别惩处"
    }
   ],
   "proposed": "在首句前补一句：“孔飞力写道，弘历以在官僚中寻找替罪羊来结束清剿，借处罚失职官员证明清剿正确。”然后接现有苏尔德一句。英文同步补入。富尼汉可不展开。"
  },
  {
   "id": "F4",
   "path": "sections.analysis.2",
   "category": "causality",
   "severity": "fix",
   "problem": "“苏尔德的下场则说明，不报和阻挠可以被单独挑出来重罚”省去了孔飞力对这次处罚的定性（收场时找替罪羊、借此证明清剿正确），把它写成了对不报、阻挠的一般后果。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E22",
     "quote": "恼羞成怒的弘历以在官僚中寻找替罪羊来结束对叫魂案的清剿"
    }
   ],
   "proposed": "改为“苏尔德的下场则说明，清剿收场时弘历要在官员中找替罪羊，不报和阻挠的人可能被单独挑出来重罚”。英文同步修改。"
  },
  {
   "id": "F5",
   "path": "sections.story.3",
   "category": "readability",
   "severity": "note",
   "problem": "context.1 用“臬司”，story.3 用“按察使”，指的是同一官职，中文读者未必知道二者相同。英文两处都写 judicial commissioner，没有这个问题。",
   "evidence": [],
   "proposed": "在 context.1 首次出现时写“省臬司（即按察使）”，或全文统一用“按察使”（引语除外）。"
  },
  {
   "id": "F6",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "limits.0 与 uncertainty_note 几乎重复同一组限定（唯一史源、装模作样是推断、高晋袒护是推测）。“高晋的后续报告未找到”一项对理解主线帮助不大。",
   "evidence": [],
   "proposed": "保留一处完整说明，另一处压缩为一两句。可删去“高晋答应的后续报告，孔飞力没有找到”。"
  }
 ],
