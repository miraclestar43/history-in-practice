 "issues": [
  {
   "id": "V1",
   "path": "sections.analysis.0",
   "category": "readability",
   "severity": "fix",
   "problem": "本段前文已写明这是孔飞力的推断（“孔飞力摆出两种可能……于是推断……”）。末句“这是孔飞力的推断，不是档案记载；他先列出过……认为只能相信前一种”把同一推理链几乎原样重复了一遍，读起来像正文里插进的核查说明（第8条），而且与 limits.0、uncertainty_note 重复。英文末两句同样如此。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "要么是吴的警网从来就没有真正地动用过，要么就是这样的警网根本就捕捉不到嫌犯"
    }
   ],
   "proposed": "删去中文末句“这是孔飞力的推断，不是档案记载；他先列出过警网根本捕捉不到嫌犯的可能，但据江西没有刑求和伪证，认为只能相信前一种。”英文同步删去“That is Kuhn's inference, not something the archives record. He first named … was credible.”这两句。"
  },
  {
   "id": "V2",
   "path": "sections.story.2",
   "category": "readability",
   "severity": "note",
   "problem": "“剪辫”在本段首次出现，前文只说“叫魂的谣言”，没有交代剪辫与叫魂的关系。不了解背景的读者不明白为什么“没发现剪辫”就等于没有叫魂案。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "但没有人被捕，也没有在本省发现剪辫情事"
    }
   ],
   "proposed": "在首次出现处改为“省内也没有发现叫魂谣言所说的剪辫的事”。英文相应写作“no cases of the queue-clipping the rumours spoke of”。"
  },
  {
   "id": "V3",
   "path": "sections.story.8",
   "category": "readability",
   "severity": "note",
   "problem": "苏尔德首次出场时没有交代他在苏州是什么身份。“他在任上”让读者不清楚他为何应当陈奏、和江苏有什么关系。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E19",
     "quote": "他在“江苏最久”"
    }
   ],
   "proposed": "改为“苏尔德在江苏任职最久。叫魂案在苏州刚发生时，他仍在苏州任上，却没有陈奏”。英文相应补上“who had served longest in Jiangsu”。"
  },
  {
   "id": "V4",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "“装模作样是孔飞力的推断，他先列出过……只能相信装模作样的解释”在 analysis.0 和 uncertainty_note 里都已出现，本段第三次复述，不符合“宁短勿凑”。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E15",
     "quote": "据此，我们只能相信"
    }
   ],
   "proposed": "把这句压缩为“‘只是装模作样’是孔飞力的推断”，删去重复的推理过程。英文同步压缩。"
  }
 ],
 "overall": "事实、引文和归属均有证据支持。需修改 analysis.0 末句对推断归属的重复说明（readability/fix），其余为易读性小建议。"
