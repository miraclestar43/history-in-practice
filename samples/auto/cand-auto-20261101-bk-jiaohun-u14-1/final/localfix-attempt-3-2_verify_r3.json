 "issues": [
  {
   "id": "V1",
   "path": "sections.story.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "证据里只有“口头命令属下留意可疑行旅”是吴绍诗后来向弘历报告的内容。“没有人被捕、省内没有发现剪辫”是孔飞力的叙述，不在吴的报告之内。稿件把后半句并进了吴绍诗的报告，中英文都是这样（\"He later told Hongli that ... but no one had been arrested and no cases ... had turned up\"）。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "他后来报告弘历说，他曾口头命令属下对可疑的行旅保持警觉。但没有人被捕，也没有在本省发现剪辫情事。"
    }
   ],
   "proposed": "中文拆成两句：“他后来向弘历报告说，自己曾口头命令属下留意可疑的行旅。但江西没有人被捕，省内也没有发现剪辫的事。”英文同样拆句：\"He later told Hongli that he had verbally ordered his subordinates to keep an eye on suspicious travellers. But no one was arrested, and no cases of queue-clipping turned up in the province.\""
  },
  {
   "id": "V2",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头直接写“叫魂的谣言”，没有说明叫魂指什么。到 story.2 才出现“剪辫”，读者不易把两者联系起来。开头的处境整体仍能看懂，所以只列为建议。",
   "evidence": [
    {
     "id": "BK-JIAOHUN-U141-E10",
     "quote": "也没有在本省发现剪辫情事"
    }
   ],
   "proposed": "在 story.2 首次出现“剪辫”时补半句，说明这正是叫魂谣言所指的案件，例如“省内也没有发现谣言里说的剪辫案”。英文同步修改。不补造证据以外的叫魂细节。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.1",
   "category": "readability",
   "severity": "note",
   "problem": "analysis.1、analysis.2、analysis.3 里“本文作者推断／认为／一种解读是”（英文 I would argue / My inference / in my reading / My own reading）反复出现了五次，与第6条“集中写，标一次”的要求不符。标注本身准确，不影响判断。",
   "evidence": [],
   "proposed": "在 analysis.1 开头保留一次“本文作者推断”。analysis.2、analysis.3 改用自然的承接句，例如“由此看”“这样看来”，仍须与孔飞力的说法分开。英文同步修改。"
  }
 ],
 "overall": "定稿的引文、日期、人物与因果归属基本都有证据支持。需修正 story.2 中把孔飞力的叙述并入吴绍诗报告的归属问题；另有两处不影响理解的易读性建议，修正后可发。"
}