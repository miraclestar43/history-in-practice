 "issues": [
  {
   "id": "F1",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "原文称郜云官为“裨將”，中文稿写成“副将”。后文“总兵副将等职”是许给降将的官职，同一个“副将”既指身份又指所许官职，读者容易混淆。英文 subordinate commander 与原文一致，但中英不一致。原文还写的是“郜云官等”，稿件丢了“等”。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E9",
     "quote": "其裨將郜云官等，猜疑攜貳，遂通款於程學啟，乞降"
    }
   ],
   "proposed": "改为“守军中的裨将（下级将领）郜云官等人”。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "facts",
   "severity": "fix",
   "problem": "原文只写“通款於程學啟”，没有写郜云官派人。中文“暗中派人联络”与英文 sent word 都补出了原文没有的细节。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E9",
     "quote": "遂通款於程學啟，乞降"
    }
   ],
   "proposed": "中文改为“暗中与城外的官军将领程学启通款，请求投降”；英文改为“secretly made overtures to Cheng Xueqi … offering to surrender”。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文加了公历年份“(1863)”。证据包没有这一年份，中文稿也没有，中英不一致。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E8",
     "quote": "十月十九日（二年）"
    }
   ],
   "proposed": "删去英文的“(1863)”。"
  },
  {
   "id": "F4",
   "path": "sections.hook.1",
   "category": "inner_life",
   "severity": "fix",
   "problem": "“城外的程学启想要的，不只是一扇打开的城门”和英文 Cheng Xueqi wanted more than an open gate，都把程学启的意图当作事实来写，证据中没有这一说法。",
   "evidence": [],
   "proposed": "删去这半句，中文直接从“城里的郜云官要拿什么来换……”写起，英文同步删去。"
  },
  {
   "id": "F5",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头一段连续出现李秀成、谭绍洸、郜云官、程学启四个人名，并带年号日期。读者此刻只需要知道“城里一名下级将领想向城外官军将领投降”。",
   "evidence": [],
   "proposed": "可只保留郜云官、程学启两个名字，守将用“城中守将”概称，名字留到 context.4 再交代；不增加其他内容。"
  },
  {
   "id": "F6",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "fix",
   "problem": "英文“Li turned to the men around him”只用姓氏“Li”。前文 hook 已出现 Li Xiucheng，读者分不清这里的 Li 指李鸿章还是李秀成。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E2",
     "quote": "鴻章徐語左右曰"
    }
   ],
   "proposed": "改为“Li Hongzhang turned to the men around him”。全文统一用 Li Hongzhang 与 Li Xiucheng 两个全称。"
  },
  {
   "id": "F7",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "context 前两段讲华尔建军和淮军衣帽受嘲，离主线较远。降约的关键人物戈登要到 context.2 才出场。",
   "evidence": [],
   "proposed": "可考虑压缩衣帽一段，只保留“常胜军后来服从李鸿章调度”这一点；不另加背景。"
  },
  {
   "id": "F8",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "英文“the second month of the same year”中的 same year 在本段没有明确所指。末句“也就是说，戈登是在……之后才接手”只是重复前句。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E3",
     "quote": "時同治二年二月也"
    }
   ],
   "proposed": "英文改为“the second month of the second year of the Tongzhi reign”；末句可删去，中英同步。"
  },
  {
   "id": "F9",
   "path": "sections.context.4",
   "category": "facts",
   "severity": "fix",
   "problem": "原文是李秀成派部将纠合八万余众、千余只船出运河口，他自己只率精锐数千据金匮援苏州。稿件写成李秀成本人调集八万多人回援，把两支兵力混为一体。英文同样有误。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E7",
     "quote": "使其部將糾合無錫、溧陽、宜興等處眾八萬餘，船千餘只，出運河口，而自率精銳數千，據金匱援蘇州"
    }
   ],
   "proposed": "改为“李秀成派部将纠合八万多人、一千多条船出运河口，自己率精锐数千人据金匮，回援苏州”，英文同步修改。"
  },
  {
   "id": "F10",
   "path": "sections.story.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "原文是程学启与戈登二人一同与郜云官等“面訂降約”，条件也出自这次共同订约。稿件写“程学启开出的条件是”，英文写 Cheng's terms，都把条件单独归于程学启。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "於是學啟與戈登親乘輕舸造城北之陽澄湖，與雲官等面訂降約"
    },
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "使殺秀成、紹洸以獻，許以二品之賞"
    }
   ],
   "proposed": "改为“双方约定的条件是”，英文改为“The terms agreed were these”。"
  },
  {
   "id": "F11",
   "path": "sections.story.0",
   "category": "interpretation_label",
   "severity": "fix",
   "problem": "record 段末句“不只是程学启的许诺，还有一位外国将领押上的信用”是作者的解释，没有标明，却写在记录段里。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "戈登爲之保人，故云官等不疑"
    }
   ],
   "proposed": "改为照实转述原文因果：“按梁启超的写法，降将肯信这份约，是因为戈登作保。”“押上的信用”一类解释移入 analysis 或删去，英文同步。"
  },
  {
   "id": "F12",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "英文对“二品之賞”加了注释 near the top of the official hierarchy，这一说法不在证据包内，中文也没有，中英不一致。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "許以二品之賞"
    }
   ],
   "proposed": "删去“near the top of the official hierarchy”。"
  },
  {
   "id": "F13",
   "path": "sections.story.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把译文放进引号，写成 follows immediately with the line \"...\"，看起来像原文。读者看不出这是译述。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "戈登爲之保人，故云官等不疑"
    }
   ],
   "proposed": "改为“Liang's next line, rendered in English, is that Gordon stood as their guarantor, and so…”，或去掉引号改为转述。"
  },
