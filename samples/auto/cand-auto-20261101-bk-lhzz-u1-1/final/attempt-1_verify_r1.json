 "issues": [
  {
   "id": "V1",
   "path": "sections.context.1",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文把李鸿章那句话的英译放进引号，读起来像是原话。其他段落都标明了 in translation，这里没有标。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E2",
     "quote": "軍之良窳，豈在服制耶？"
    }
   ],
   "proposed": "英文改为转述：Li Hongzhang asked the men around him, in effect, whether an army's quality was to be judged by its uniforms. 中文不改。"
  },
  {
   "id": "V2",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "“阳澄湖那条小船上的第三个人”与证据不符。乘小船去阳澄湖的只有程学启和戈登，证据没有说船上有第三人，这个说法会让读者误解当时的场面和人物。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "學啟與戈登親乘輕舸造城北之陽澄湖"
    }
   ],
   "proposed": "中文改为“现在回到阳澄湖订约时的保人戈登。”英文改为 Now return to Gordon, the guarantor of the pact made on Yangcheng Lake."
  },
  {
   "id": "V3",
   "path": "sections.story.6",
   "category": "attribution",
   "severity": "fix",
   "problem": "转述梁启超的按语时，只写到“或许有不得已之处”就结束了。原文是“虽……而……”的让步句式，落点是批评李鸿章平生好用小智小术。只保留让步的一半，会削弱梁启超的评判，改变读者对结局的看法。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "雖彼鑒於苗沛霖、李世忠故事，其個或有所大不得已者存，而文忠生平好用小智小術，亦可以見其概矣。"
    }
   ],
   "proposed": "末尾补一句。中文：“但他随即说，从这件事也可以看出李鸿章平生喜欢用小聪明、小手段。”英文：But he concludes that the episode also shows Li Hongzhang's lifelong fondness for petty cleverness and small tricks."
  },
  {
   "id": "V4",
   "path": "sections.analysis.2",
   "category": "attribution",
   "severity": "fix",
   "problem": "本段同样只引了梁启超按语里“不得已”的让步部分，漏掉了他在同一句里对李鸿章“好用小智小术”的批评。分析因此偏向替李鸿章开脱。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "而文忠生平好用小智小術，亦可以見其概矣"
    }
   ],
   "proposed": "在“有不得已之处”后补“但同一句里他也说，这可见李鸿章平生好用小聪明、小手段”。英文同步补上。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.2",
   "category": "causality",
   "severity": "fix",
   "problem": "先提示“降将只交出一个首级、李秀成也走了”，暗示这可能是杀降的原因，接着又说本文不把它当理由。证据没有把这一点与杀降联系起来。这样写既暗示了无据的因果，又在正文里露出了审核过程。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E14",
     "quote": "學啟細察此八人，謂狼子野心，恐後不可制。乃與李鴻章密謀"
    }
   ],
   "proposed": "删去“另有一点可以留意……但本文不把这一点当作杀降的理由。”这两句，英文同步删去。"
  },
  {
   "id": "V6",
   "path": "sections.analysis.3",
   "category": "facts",
   "severity": "fix",
   "problem": "“长远那笔，书中只留下片段”／the book leaves only fragments 是在断言完整来源写了什么、没写什么，而本文看到的只是证据包。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E15",
     "quote": "數日後，怒漸解，乃止。"
    }
   ],
   "proposed": "中文改为“长远那笔，本文依据的记载只涉及几件事：”，英文改为 Of the longer account, the material this article draws on mentions only a few things:"
  },
  {
   "id": "V7",
   "path": "sections.analysis.3",
   "category": "readability",
   "severity": "note",
   "problem": "“代价也分两笔”之后，列出的眼前一笔是收获（苏州到手、李鸿章加衔），不是代价，读者容易困惑。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E14",
     "quote": "蘇州定，鴻章以功加太子少保"
    }
   ],
   "proposed": "改为“得失也分两笔。眼前那笔很清楚……”，英文 costs 改为 gains and costs。"
  }
 ],
 "overall": "定稿整体有证据支持，人物和转折也清楚。需修正以下几处：阳澄湖“第三个人”的错误说法、两处只取梁启超按语让步半句的片面转述、analysis.2 暗示无据因果的两句、一处关于完整来源的断言，以及 context.1 英文引语冒充原话。"
}