 "issues": [
  {
   "id": "V1",
   "path": "sections.story.6",
   "category": "facts",
   "severity": "fix",
   "problem": "故事以戈登息怒作结，漏掉了梁启超紧接着对杀降的明确道德评判。梁启超列出李鸿章的“三罪”，认为戈登的愤恨理所当然；他也承认李鸿章或许借鉴了苗沛霖、李世忠的旧事，有不得已之处，但认为此事正见出李鸿章一生好用小智小术。这段评判决定读者如何看待结局，缺了它会改变判断。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "殺降背公理一也，負約食言二也，欺戈登負友人三也"
    },
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "雖彼鑒於苗沛霖、李世忠故事，其個或有所大不得已者存，而文忠生平好用小智小術，亦可以見其概矣"
    }
   ],
   "proposed": "在本段末补一两句（中英同步），例如：“梁启超对此评论说，李鸿章这件事有愧于心：杀降违背公理，背约食言，又欺骗了作为朋友的戈登，戈登恨到想杀他，并不奇怪。他也承认，李鸿章或许借鉴了苗沛霖、李世忠两人的旧事，有不得已的地方，但认为这正显出李鸿章一生好用小聪明、小手段。”"
  },
  {
   "id": "V2",
   "path": "sections.analysis.0",
   "category": "attribution",
   "severity": "fix",
   "problem": "本段只用“一种解释是”推测戈登为何把账算在李鸿章头上。梁启超本人已明确把“負約食言”“欺戈登負友人”归于李鸿章，正文没有照实转述作者自己的评价，容易让读者以为把责任归给统帅只是本文推断。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "負約食言二也，欺戈登負友人三也"
    },
    {
     "id": "BK-LHZZ-U11-E15",
     "quote": "聞鴻章之食言也"
    }
   ],
   "proposed": "在“书里用的词也是「鴻章之食言」”后加一句：“梁启超在评论里也把背约、欺骗戈登算作李鸿章的罪过。”保留其后的“一种解释是”作为本文对戈登视角的推断。英文同步。"
  },
  {
   "id": "V3",
   "path": "sections.analysis.3",
   "category": "facts",
   "severity": "fix",
   "problem": "“长远那笔，本文依据的记载只涉及几件事”与证据不符：证据包里还有梁启超的道德评判（E20），以及他对常胜军和戈登作用的总评（E23）。这句关于来源范围的断言不准确，也会让读者误以为原书对此事没有评价。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "李文忠於是有慚德矣"
    },
    {
     "id": "BK-LHZZ-U11-E23",
     "quote": "其得力於華爾、戈登者實多"
    }
   ],
   "proposed": "改为：“长远那笔，本文依据的记载写到：李鸿章躲了几天，戈登怒气消退，常胜军之后仍与淮军并肩作战；梁启超则在评论中认定此举有愧。”删去“只涉及几件事”。英文同步。"
  },
  {
   "id": "V4",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头一段同时出现李秀成、谭绍洸、郜云官、程学启四个人名，“攻破外郭、退入内城死守”又在 context.4 重复一遍。读者仍能看懂“守军将领想投降、需要可信的约定”，但人名有些堆叠。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E8",
     "quote": "秀成及譚紹洸等引入內城，死守不屈"
    }
   ],
   "proposed": "hook.0 可改称“守城主将”，让李秀成、谭绍洸到 context.4 再点名；或删去 context.4 末句的重复。"
  },
  {
   "id": "V5",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "末句“也就是说，戈登是在李鸿章与英方交涉之后，才接手这支队伍的”只是复述前一句，没有增加信息。英文“the second month of the same year”紧接在 hook 的“第二年十月”之后，读者不易对上是哪一年。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E3",
     "quote": "時同治二年二月也"
    }
   ],
   "proposed": "删去末句；英文改为“the second month of the second year of the Tongzhi reign”。"
  },
  {
   "id": "V6",
   "path": "sections.context.4",
   "category": "readability",
   "severity": "note",
   "problem": "八万多人、一千多条船、无锡、溧阳、宜兴、金匮等数字和地名对理解降约没有作用，开头部分略显堆砌。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E7",
     "quote": "糾合無錫、溧陽、宜興等處眾八萬餘，船千餘只"
    }
   ],
   "proposed": "可压缩为“李秀成调集大军回援苏州，与官军连战，互有胜负”，具体数字可删去或后置。"
  }
 ],
 "overall": "引文和史实基本有证据支持，但漏掉了梁启超对杀降的明确道德评判，analysis.3 的来源范围表述也不准确，需补正后才能通过；易读性只有若干 note。"
}