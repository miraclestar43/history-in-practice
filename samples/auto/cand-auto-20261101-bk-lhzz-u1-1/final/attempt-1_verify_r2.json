 "issues": [
  {
   "id": "V1",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "本段写“双方约定的条件是：杀掉李秀成、谭绍洸……”（英文 The terms agreed were these），等于说降将接受了杀两人的条件。原文中这是城外一方提出的要求，降将最后只答应斩谭绍洸。下一段 story.1 又写“约定并没有被全盘接受”，两段前后矛盾。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "使殺秀成、紹洸以獻，許以二品之賞"
    },
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "然卒不忍害秀成，乃許斬紹洸而別"
    }
   ],
   "proposed": "中文改为“城外一方提出的条件是：杀掉李秀成、谭绍洸，把首级献上来；作为交换，许给二品的官赏。”英文改为“The terms put to them were these: …”。"
  },
  {
   "id": "V2",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“十几万部众、一千多余党等数字，也都只出自这一处记载”（英文 come from this one account alone）是在断言这些数字在全部来源中只有这一处出处，超出了证据包能支持的范围。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E14",
     "quote": "此八將所部兵在城中者尚十餘萬人"
    }
   ],
   "proposed": "中文改为“十几万部众、一千多余党等数字，都取自这部书，本文未与其他记载核对。”英文改为“The figures … are taken from this book and have not been checked against other records.”"
  },
  {
   "id": "V3",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "“相关数字也只有这一个来源”（英文 the figures cited have only this one source）断言这些数字在全部来源中只有一个出处，属于对完整来源的断言。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E14",
     "quote": "此八將所部兵在城中者尚十餘萬人"
    }
   ],
   "proposed": "中文改为“文中数字均取自这部书，未另行核对。”英文改为“the figures cited are taken from this book and have not been checked elsewhere.”"
  },
  {
   "id": "V4",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头只写了“官军”和“守将李秀成”，没有说明守城的一方是谁的军队。不了解背景的读者不清楚交战双方各是谁。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E1",
     "quote": "洪軍蹂躪江蘇，蘇、常俱陷"
    }
   ],
   "proposed": "在“守将李秀成、谭绍洸”前加一个简短身份，如“占据苏州的洪军（太平军）守将”，英文同步补上。"
  },
  {
   "id": "V5",
   "path": "sections.analysis.2",
   "category": "readability",
   "severity": "note",
   "problem": "梁启超按语中“鉴于苗沛霖、李世忠旧事”和“好用小智小术”两点，在 story.6 已经完整转述，analysis.2 又几乎原样复述一遍。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E20",
     "quote": "雖彼鑒於苗沛霖、李世忠故事，其個或有所大不得已者存，而文忠生平好用小智小術"
    }
   ],
   "proposed": "analysis.2 第二句压缩为一句指回，例如“梁启超在按语里同时给了开脱与批评（见上）”。也可以只在一处完整转述。"
  },
  {
   "id": "V6",
   "path": "sections.context.2",
   "category": "readability",
   "severity": "note",
   "problem": "末句“也就是说，戈登是在李鸿章与英方交涉之后，才接手这支队伍的”重复了前一句的内容，没有增加信息。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E3",
     "quote": "立與英領事交涉。黜白齊文，使償所攫金，而以英國將官戈登代之"
    }
   ],
   "proposed": "删去末句，中英同步。"
  },
  {
   "id": "V7",
   "path": "reflection.example.steps",
   "category": "style",
   "severity": "note",
   "problem": "格式中英不一致：中文分行且不编号，英文挤在一行并带“1. 2. 3.”编号。",
   "evidence": [],
   "proposed": "统一格式：都分行编号，或都分行不编号。"
  }
 ],
 "overall": "定稿史实整体有证据支持，引文逐字、解释已标明。需修正 story.0 把城外提出的条件写成“双方约定”的问题，以及 limits 和 uncertainty_note 中关于数字“只有这一个来源”的断言；其余为易读性和格式小问题。"
}