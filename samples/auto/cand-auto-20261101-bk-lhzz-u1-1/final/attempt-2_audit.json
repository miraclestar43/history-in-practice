 "issues": [
  {
   "id": "F1",
   "path": "dek",
   "category": "facts",
   "severity": "fix",
   "problem": "“当面许下官职／promised office face to face”把两种许诺合成了一种。湖上当面订约时许的是“二品之赏”；“总兵副将等职”只说是程学启“既許”，没有说是当面许下的。limits 也承认两者关系无法判断。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "與雲官等面訂降約，使殺秀成、紹洸以獻，許以二品之賞"
    },
    {
     "id": "BK-LHZZ-U11-E14",
     "quote": "程學啟既許以總兵副將等職"
    }
   ],
   "proposed": "中文改为“前线将领当面许下封赏”；英文改为“A field commander promised rewards face to face”。"
  },
  {
   "id": "F2",
   "path": "sections.hook.0",
   "category": "parity",
   "severity": "fix",
   "problem": "英文“The two commanders defending the city”暗示守城的只有这两人。原文是“秀成及譚紹洸等”，后文还有八名降将在城中。中文“守将李秀成、谭绍洸”没有这层排他含义，中英不一致。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E8",
     "quote": "秀成及譚紹洸等引入內城"
    }
   ],
   "proposed": "英文改为“Two of the city's commanders, Li Xiucheng and Tan Shaoguang, fell back…”。"
  },
  {
   "id": "F3",
   "path": "sections.hook.0",
   "category": "readability",
   "severity": "note",
   "problem": "开头一段连续抛出李秀成、谭绍洸、郜云官、程学启四个人名。读者此时只需要知道“城里想投降的郜云官”和“城外接洽的程学启”。",
   "evidence": [],
   "proposed": "可把李秀成、谭绍洸改称“城中主将”，人名留到 context.4 或 story 再出现；不增加其他背景。"
  },
  {
   "id": "F4",
   "path": "sections.context.4",
   "category": "readability",
   "severity": "note",
   "problem": "末两句（十月十九日攻破外郭、李秀成和谭绍洸退入内城死守）与 hook.0 重复同一情节。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E8",
     "quote": "遂破其外郭"
    }
   ],
   "proposed": "末句可压缩为“十月十九日官军攻破外郭，回到了开头那一幕”，或保留日期、删去与 hook 重复的退守描写。"
  },
  {
   "id": "F5",
   "path": "sections.context.1",
   "category": "readability",
   "severity": "note",
   "problem": "context 的前两段中，这一段（淮军衣帽被嘲笑）是开头部分。它与降约主线关系较远，会推迟读者进入“谁遇到什么难处”。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E2",
     "quote": "常勝軍之在部下者，亦始帖然服李之節制矣"
    }
   ],
   "proposed": "可只保留末句“常胜军也开始服从李鸿章的调度”，并入 context.0 或 context.2；不增加新内容。"
  },
  {
   "id": "F6",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“双方约定的条件是：杀掉李秀成、谭绍洸……”（英文 The terms agreed were these）等于说降将已经接受杀两人的条件。原文中这是城外一方的要求，降将最后只答应斩谭绍洸。这与 story.1“约定并没有被全盘接受”互相矛盾。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "使殺秀成、紹洸以獻，許以二品之賞"
    },
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "然卒不忍害秀成，乃許斬紹洸而別"
    }
   ],
   "proposed": "中文改为“城外一方提出的条件是：杀掉李秀成、谭绍洸，把首级献上来；作为交换，许以二品之赏。”英文改为“The terms put to them were these: …”。"
  },
  {
   "id": "F7",
   "path": "sections.story.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“许给二品的官赏”多出一个“官”字。原文只说“二品之賞”。limits 明说它与“总兵副将等职”的关系无法判断，正文不宜先把它写成官职。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "許以二品之賞"
    }
   ],
   "proposed": "改为“许给二品的封赏”；英文 rewards of the second rank 不变。"
  },
  {
   "id": "F8",
   "path": "sections.story.6",
   "category": "unsupported",
   "severity": "fix",
   "problem": "本段后半转述梁启超按语，包括有愧于德、三罪、苗沛霖和李世忠旧事、好用小智小术。这些全部出自 BK-LHZZ-U11-E20。已知污染 K2 说明该锚点未通过逐字核对，已删除，不得写入相关内容。证据包中的 E20 文本本身也有可疑字（“其個或有所”）。",
   "evidence": [],
   "proposed": "发稿前按原书逐字复核这段按语；无法复核时，删去从“梁启超在按语中评论说”到段末的内容，只保留 E15 所载戈登大怒、寻李鸿章、数日后作罢。"
  },
  {
   "id": "F9",
   "path": "sections.story.7",
   "category": "facts",
   "severity": "fix",
   "problem": "“常胜军没有离开／did not leave”暗示当时出现过常胜军离去的可能或决定，证据没有这层意思。证据只记载此后常胜军与刘铭传、郭松林等部共同作战。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E19",
     "quote": "與常勝軍共略常州"
    }
   ],
   "proposed": "中文改为“这件事之后，常胜军仍与淮军一同作战”；英文改为“After this, the Ever-Victorious Army still fought alongside the Huai Army.”"
  },
  {
   "id": "F10",
   "path": "sections.analysis.0",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“梁启超自己也把这笔账记在李鸿章名下（Liang himself, in his note, lays the account…）”依据的是按语 E20，属于 K2 所列已剔除内容。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E15",
     "quote": "至是聞鴻章之食言也"
    }
   ],
   "proposed": "删去这一句。前一句已用 E15 的“鴻章之食言”说明书中把食言归于李鸿章，足以支撑后面的解释。"
  },
  {
   "id": "F11",
   "path": "sections.analysis.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "中文用“”引“鸿章之食言”，并改成了简体。按规则，中文引语应使用「」并照原文逐字。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E15",
     "quote": "聞鴻章之食言也"
    }
   ],
   "proposed": "改为“书里用的词也是「鴻章之食言」”。"
  },
  {
   "id": "F12",
   "path": "sections.analysis.0",
   "category": "quotes",
   "severity": "fix",
   "problem": "英文 the defectors had \"no doubts\" 用引号标出译文，读者会以为这是原文英语引语，看不出是译述。",
   "evidence": [
    {
     "id": "BK-LHZZ-U11-E10",
     "quote": "故云官等不疑"
    }
   ],
   "proposed": "去掉引号：“the book says plainly that the defectors had no doubts because of him.”"
  },
  {
   "id": "F13",
   "path": "sections.analysis.1",
   "category": "unsupported",
   "severity": "fix",
   "problem": "“梁启超也把这件事算作「欺戈登」”（英文 Liang, too, counts the episode as a deception of Gordon）引自 E20，属于 K2 所列已剔除、未通过逐字核对的内容。",
   "evidence": [],
   "proposed": "删去末句；若按原书复核确认，再恢复。"
  },
  {
   "id": "F14",
   "path": "sections.analysis.2",
   "category": "unsupported",
   "severity": "fix",
   "problem": "第二句关于苗沛霖、李世忠旧事和“小聪明、小手段”的转述出自 E20，属于 K2 所列已剔除内容。",
   "evidence": [],
   "proposed": "删去“梁启超在按语里还说……”整句，段落停在“书中给出的是一笔控制风险的账”；若按原书复核确认，再恢复。"
  },
  {
   "id": "F15",
   "path": "sections.limits.0",
   "category": "facts",
   "severity": "fix",
   "problem": "“也都只出自这一处记载／come from this one account alone”是在断言这些数字在全部来源中只有一处出处，超出证据包能支持的范围。",
   "evidence": [],
   "proposed": "中文改为“十几万部众、一千多余党等数字，都取自这部书，本文未与其他记载核对。”英文改为“The figures … are taken from this book and have not been checked against other records.”"
  },
  {
   "id": "F16",
   "path": "sections.limits.0",
   "category": "readability",
   "severity": "note",
   "problem": "“都没有进入证据／is among the evidence”是审核流程用语，读者不需要。",
   "evidence": [],
   "proposed": "中文改为“本文没有用到降将一方和戈登本人的叙述”；英文改为“this article draws on no account from the defectors or from Gordon himself”。"
  },
  {
   "id": "F17",
   "path": "uncertainty_note",
   "category": "facts",
   "severity": "fix",
   "problem": "“相关数字也只有这一个来源／the figures cited have only this one source”是对完整来源的断言。",
   "evidence": [],
   "proposed": "中文改为“文中数字均取自这部书，未另行核对。”英文改为“the figures cited are taken from this book and have not been checked elsewhere.”"
  },
  {
   "id": "F18",
   "path": "sections.context.2",
   "category": "style",
   "severity": "note",
   "problem": "末句“也就是说，戈登是在李鸿章与英方交涉之后，才接手这支队伍的”只是重复前句。",
   "evidence": [],
   "proposed": "可删去末句。"
  }
 ],
