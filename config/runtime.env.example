# Copy to ~/.config/history-in-practice/runtime.env and chmod 600. NEVER commit the real file.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=resend
SMTP_PASSWORD=REPLACE_WITH_SENDING_KEY
EMAIL_FROM=没事儿多读书 <history@read.starhub.vip>
EMAIL_RECIPIENTS=reader1@example.invalid,reader2@example.invalid
# REQUIRED for any real send: the footer asks readers to reply, and the From address has no mailbox.
EMAIL_REPLY_TO=REPLACE_WITH_AN_ADDRESS_YOU_READ
# Keep false until `hip send-test ... --confirm-real-email` has been checked in both inboxes.
EMAIL_SEND_ENABLED=false
# Site: SITE_REPO_PATH=/path/to/clean/website/checkout ; SITE_PUSH_ENABLED=false until the deploy path is confirmed.
SITE_BASE_URL=https://starhub.vip
