# TEMPLATE — not enabled. Resumes today's publish run (idempotent: never re-archives,
# never resends an accepted or unknown delivery) while a site deploy is still landing
# or a send partially failed. Stops being useful at send_deadline (11:00 LA), after
# which publish-today marks the edition overdue.
[Unit]
Description=History in Practice: resume today's publish before the deadline

[Timer]
OnCalendar=*-*-* 08,09,10:00:00 America/Los_Angeles
OnCalendar=*-*-* 08,09,10:30:00 America/Los_Angeles
Unit=hip-send.service

[Install]
WantedBy=timers.target
