# Launched 2026-11-01 (22:08 Asia/Shanghai). Publishes today's scheduled edition:
# archive -> site export/commit -> verify live JSON (content_sha256) -> email.
# Requires EMAIL_SEND_ENABLED=true and a complete mail config (recipients,
# SMTP, From, Reply-To); otherwise it stops before email and exits non-zero.
# The live check retries with bounded backoff (~22 min, project.json site_wait);
# if the deploy is still not live it exits 5 (waiting) and hip-send-retry.timer
# resumes it. Past send_deadline (23:40 Asia/Shanghai) or on a later day an unfinished
# edition becomes `overdue` (exit 6, alert) and is never sent late.
# Exit codes: 0 complete, 3 partial, 4 skipped (no approved edition), 5 waiting, 6 overdue.
[Unit]
Description=History in Practice: publish and send today's edition
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/history-in-practice
ExecStartPre=%h/history-in-practice/bin/hip recover
ExecStart=%h/history-in-practice/bin/hip publish-today
TimeoutStartSec=40min
Nice=5
LimitAS=2G
StandardOutput=append:%h/history-in-practice/data/logs/send.log
StandardError=append:%h/history-in-practice/data/logs/send.log
# Maintainer alert (alert.py): skipped / overdue / partial / still waiting near the deadline / Claude
# unavailable / low inventory -> one email to the maintainer (never subscribers), once per problem per day.
ExecStopPost=-%h/history-in-practice/bin/hip alert --source send
